[47.879911, "o", "        const p_vaddr = Number(buf.readBigUInt64LE(ph_offset + 16));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.880557, "o", "        const p_filesz = Number(buf.readBigUInt64LE(ph_offset + 32));\r\n\u001b[?2004l\r\u001b[?2004h> "]
