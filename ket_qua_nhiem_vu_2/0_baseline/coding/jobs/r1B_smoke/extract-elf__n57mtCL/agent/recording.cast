[47.881972, "o", "        let segData = Buffer.alloc(p_memsz);\r\n\u001b[?2004l\r\u001b[?2004h>         buf.copy(segData, 0, p_offset, p_offset + p_filesz);\r\n\u001b[?2004l\r"]
[47.882503, "o", "\u001b[?2004h>         for (let off = 0; off < segData.length; off += 4) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.884811, "o", "            if (off + 4 <= segData.length) {\r\n\u001b[?2004l\r\u001b[?2004h>                 const val = segData.readUInt32LE(off);\r\n\u001b[?2004l\r\u001b[?2004h>                 const addr = base + p_vaddr + off;\r\n\u001b[?2004l\r\u001b[?2004h>                 memory[addr.toString()] = val;\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n"]
[47.885507, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[47.886478, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
