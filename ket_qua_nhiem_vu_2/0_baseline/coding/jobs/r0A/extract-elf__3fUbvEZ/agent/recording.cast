[39.520917, "i", "cat << 'EOF' > extract.js\nconst fs = require('fs');\n\nfunction extract(filename) {\n  const buf = fs.readFileSync(filename);\n  // Basic ELF parsing to extract loadable segments or sections, or whole file loaded at 0x400000\n  // Let's check program headers\n  const e_phoff = buf.readBigUInt64LE(0x20);\n  const e_phentsize = buf.readUInt16LE(0x36);\n  const e_phnum = buf.readUInt16LE(0x38);\n\n  const result = {};\n  const baseAddr = 0x400000;\n\n  // If we map loadable segments or the whole file:\n  // Let's parse program headers for LOAD segments\n  for (let i = 0; i < e_phnum; i++) {\n    const phoff = Number(e_phoff) + i * e_phentsize;\n    const p_type = buf.readUInt32LE(phoff);\n    if (p_type === 1) { // PT_LOAD\n      const p_offset = Number(buf.readBigUInt64LE(phoff + 0x08));\n      const p_vaddr = Number(buf.readBigUInt64LE(phoff + 0x10));\n      const p_filesz = Number(buf.readBigUInt64LE(phoff + 0x20));\n      const p_memsz = Number(buf.readBigUInt64LE(phoff + 0x28));\n\n      const startAddr = baseAddr + p_vaddr;\n      for (let offset = 0; offset < p_filesz; offset += 4) {\n        if (p_offset + offset + 4 <= buf.length) {\n          const val = buf.readInt32LE(p_offset + offset);\n          result[(startAddr + offset).toString()] = val;\n        }\n      }\n    }\n  }\n\n  console.log(JSON.stringify(result, null, 2));\n}\n\nextract(process.argv[2] || 'a.out');\nEOF\nnode extract.js /app/a.out > out.json\nhead -n 20 out.json\n"]
