Sending keys: ["cat << 'EOF' > /app/extract.js\nconst fs = require('fs');\n\nfunction extract(filePath) {\n    const buffer = fs.readFileSync(filePath);\n    // Parse ELF header\n    const e_phoff = buffer.readBigUInt64LE(32);\n    const e_phentsize = buffer.readUInt16LE(54);\n    const e_phnum = buffer.readUInt16LE(56);\n\n    const result = {};\n\n    for (let i = 0; i < e_phnum; i++) {\n        const offset = Number(e_phoff) + i * e_phentsize;\n        const p_type = buffer.readUInt32LE(offset);\n        if (p_type === 1) { // PT_LOAD\n            const p_offset = Number(buffer.readBigUInt64LE(offset + 8));\n            const p_vaddr = Number(buffer.readBigUInt64LE(offset + 16));\n            const p_filesz = Number(buffer.readBigUInt64LE(offset + 32));\n            \n            const baseAddr = 0x400000 + p_vaddr;\n            for (let off = 0; off < p_filesz; off += 4) {\n                if (p_offset + off + 4 <= buffer.length) {\n                    const val = buffer.readUInt32LE(p_offset + off);\n                    const addr = baseAddr + off;\n                    result[addr.toString()] = val;\n                }\n            }\n        }\n    }\n    return result;\n}\n\nconst res = extract(process.argv[2]);\nconsole.log(JSON.stringify(res, null, 2));\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
