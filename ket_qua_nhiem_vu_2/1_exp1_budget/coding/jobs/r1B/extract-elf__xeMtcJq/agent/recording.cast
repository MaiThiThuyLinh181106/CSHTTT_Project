[50.622272, "i", "cat << 'EOF' > extract.js\nconst fs = require('fs');\n\nfunction parseELF(filename) {\n  const buf = fs.readFileSync(filename);\n  if (buf.readUInt32BE(0) !== 0x7f454c46) {\n    console.error('Not an ELF file');\n    process.exit(1);\n  }\n  const is64 = buf[4] === 2;\n  if (!is64) {\n    console.error('Only ELF64 supported');\n    process.exit(1);\n  }\n\n  const phoff = Number(buf.readBigUInt64LE(32));\n  const phentsize = buf.readUInt16LE(54);\n  const phnum = buf.readUInt16LE(56);\n\n  const result = {};\n\n  for (let i = 0; i < phnum; i++) {\n    const p_offset = phoff + i * phentsize;\n    const p_type = buf.readUInt32LE(p_offset);\n    if (p_type === 1) { \n      const offset = Number(buf.readBigUInt64LE(p_offset + 8));\n      const vaddr = Number(buf.readBigUInt64LE(p_offset + 16));\n      const filesz = Number(buf.readBigUInt64LE(p_offset + 32));\n\n      for (let off = 0; off < filesz; off += 4) {\n        const addr = vaddr + off;\n        if (off + 4 <= filesz) {\n          const val = buf.readUInt32LE(offset + off);\n          result[addr] = val;\n        } else {\n          let val = 0;\n          for (let b = 0; b < (filesz - off); b++) {\n            val |= buf[offset + off + b] << (b * 8);\n          }\n          result[addr] = val;\n        }\n      }\n    }\n  }\n\n  console.log(JSON.stringify(result));\n}\n\nparseELF(process.argv[2] || 'a.out');\nEOF\nnode extract.js a.out > out.json\nhead -c 200 out.json\n"]
