[75.245985, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.246115, "o", "> "]
[75.24674, "o", "    for (let i = 0; i < e_phnum; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         const offset = Number(e_phoff) + i * e_phentsize;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.246863, "o", "        const p_type = buffer.readUInt32LE(offset);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.247314, "o", "        if (p_type === 1) { // PT_LOAD\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.247601, "o", "            const p_offset = Number(buffer.readBigUInt64LE(offset + 8));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.24786, "o", "            const p_vaddr = Number(buffer.readBigUInt64LE(offset + 16));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.248135, "o", "            const p_filesz = Number(buffer.readBigUInt64LE(offset + 32));\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.24859, "o", "            const baseAddr = 0x400000 + p_vaddr;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.248838, "o", "            for (let off = 0; off < p_filesz; off += 4) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.24943, "o", "                if (p_offset + off + 4 <= buffer.length) {\r\n\u001b[?2004l\r\u001b[?2004h>                     const val = buffer.readUInt32LE(p_offset + off);\r\n\u001b[?2004l\r\u001b[?2004h>                     const addr = baseAddr + off;\r\n\u001b[?2004l\r\u001b[?2004h>                     result[addr.toString()] = val;\r\n\u001b[?2004l\r"]
[75.249725, "o", "\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.249903, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.250389, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return result;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.25097, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> const res = extract(process.argv[2]);\r\n\u001b[?2004l\r"]
[75.252049, "o", "\u001b[?2004h> console.log(JSON.stringify(res));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.252298, "o", "EOF\r\n\u001b[?2004l\r"]
