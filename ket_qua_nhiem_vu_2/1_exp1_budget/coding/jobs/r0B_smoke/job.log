Sending keys: ["cat << 'EOF' > extract.js\nconst fs = require('fs');\n\nfunction parseElf(filename) {\n  const buf = fs.readFileSync(filename);\n  const is64 = buf.readUInt8(4) === 2;\n  const le = buf.readUInt8(5) === 1;\n\n  // Parse ELF header\n  const phoff = is64 ? Number(buf.readBigUInt64LE(32)) : buf.readUInt32LE(28);\n  const phentsize = is64 ? buf.readUInt16LE(54) : buf.readUInt16LE(42);\n  const phnum = is64 ? buf.readUInt16LE(56) : buf.readUInt16LE(44);\n\n  const result = {};\n  const baseAddr = 0x400000; // standard base address for executables\n\n  for (let i = 0; i < phnum; i++) {\n    const phoff_i = phoff + i * phentsize;\n    const type = buf.readUInt32LE(phoff_i);\n    if (type === 1) { // PT_LOAD\n      const offset = is64 ? Number(buf.readBigUInt64LE(phoff_i + 8)) : buf.readUInt32LE(phoff_i + 4);\n      const vaddr = is64 ? Number(buf.readBigUInt64LE(phoff_i + 16)) : buf.readUInt32LE(phoff_i + 8);\n      const filesz = is64 ? Number(buf.readBigUInt64LE(phoff_i + 32)) : buf.readUInt32LE(phoff_i + 16);\n      const memsz = is64 ? Number(buf.readBigUInt64LE(phoff_i + 40)) : buf.readUInt32LE(phoff_i + 20);\n\n      const startAddr = vaddr + baseAddr;\n      for (let off = 0; off < filesz; off += 4) {\n        if (offset + off + 4 <= buf.length) {\n          const val = buf.readUInt32LE(offset + off);\n          result[String(startAddr + off)] = val;\n        }\n      }\n    }\n  }\n  console.log(JSON.stringify(result, null, 2));\n}\n\nparseElf(process.argv[2] || '/app/a.out');\nEOF\nnode extract.js /app/a.out | head -n 20\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
