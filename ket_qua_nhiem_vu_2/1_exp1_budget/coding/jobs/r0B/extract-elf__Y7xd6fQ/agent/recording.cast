[123.989819, "o", "cat extract.js\r\n\u001b[?2004l\r"]
[123.99084, "o", "const fs = require('fs');\r\n\r\nconst filename = process.argv[2] || '/app/a.out';\r\nconst buf = fs.readFileSync(filename);\r\n\r\n// Parse ELF header\r\nconst magic = buf.readUInt32LE(0);\r\nif (magic !== 0x464c457f) {\r\n    console.error('Not an ELF file');\r\n    process.exit(1);\r\n}\r\n\r\nconst classType = buf[4]; // 1 for 32-bit, 2 for 64-bit\r\nconst e_phoff = Number(buf.readBigUInt64LE(32));\r\nconst e_phentsize = buf.readUInt16LE(54);\r\nconst e_phnum = buf.readUInt16LE(56);\r\n\r\nconst result = {};\r\n\r\nfor (let i = 0; i < e_phnum; i++) {\r\n    const phoff = e_phoff + i * e_phentsize;\r\n    const p_type = buf.readUInt32LE(phoff);\r\n    if (p_type === 1) { // PT_LOAD\r\n        const p_offset = Number(buf.readBigUInt64LE(phoff + 8));\r\n        const p_vaddr = Number(buf.readBigUInt64LE(phoff + 16));\r\n        const p_filesz = Number(buf.readBigUInt64LE(phoff + 32));\r\n        const p_memsz = Number(buf.readBigUInt64LE(phoff + 40));\r\n        \r\n        // Read file data for this load segment\r\n        for (let off = 0; off < p_filesz; off += 4) {\r\n            if (p_offset + off + 4 <= buf.length) {\r\n                const val = buf.readUInt32LE(p_offset + off);\r\n                const addr = p_vaddr + off;\r\n                result[addr.toString()] = val;\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\nconsole.log(JSON.stringify(result));\r\n"]
[123.991208, "o", "\u001b[?2004hroot@7fe7eaf1e314:/app# "]
