[?2004lconst fs = require('fs');

const filename = process.argv[2] || '/app/a.out';
const buf = fs.readFileSync(filename);

// Parse ELF header
const magic = buf.readUInt32LE(0);
if (magic !== 0x464c457f) {
    console.error('Not an ELF file');
    process.exit(1);
}

const classType = buf[4]; // 1 for 32-bit, 2 for 64-bit
const e_phoff = Number(buf.readBigUInt64LE(32));
const e_phentsize = buf.readUInt16LE(54);
const e_phnum = buf.readUInt16LE(56);

const result = {};

for (let i = 0; i < e_phnum; i++) {
    const phoff = e_phoff + i * e_phentsize;
    const p_type = buf.readUInt32LE(phoff);
    if (p_type === 1) { // PT_LOAD
        const p_offset = Number(buf.readBigUInt64LE(phoff + 8));
        const p_vaddr = Number(buf.readBigUInt64LE(phoff + 16));
        const p_filesz = Number(buf.readBigUInt64LE(phoff + 32));
        const p_memsz = Number(buf.readBigUInt64LE(phoff + 40));
        
        // Read file data for this load segment
        for (let off = 0; off < p_filesz; off += 4) {
            if (p_offset + off + 4 <= buf.length) {
                const val = buf.readUInt32LE(p_offset + off);
                const addr = p_vaddr + off;
                result[addr.toString()] = val;
            }
        }
    }
}

console.log(JSON.stringify(result));
