[?2004l[?2004h>                         const partial = Buffer.alloc(4, 0);
[?2004l[?2004h>                         buffer.copy(partial, 0, filePos, buffer.length);
[?2004l[?2004h>                         val = partial.readUInt32LE(0);
[?2004l[?2004h>                     }
[?2004l[?2004h>                 } else {
[?2004l[?2004h>                     val = 0;
[?2004l[?2004h>                 }
[?2004l[?2004h>                 memory[currentVaddr.toString()] = val;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>     }
