[?2004l[?2004h>     for (let i = 0; i < e_phnum; i++) {
[?2004l[?2004h>         const phoff = e_phoff + i * e_phentsize;
[?2004l[?2004h>         const p_type = buffer.readUInt32LE(phoff);
[?2004l[?2004h>         if (p_type === 1) {
[?2004l[?2004h>             const p_offset = Number(buffer.readBigUInt64LE(phoff + 8));
[?2004l[?2004h>             const p_vaddr = Number(buffer.readBigUInt64LE(phoff + 16));
[?2004l[?2004h>             const p_filesz = Number(buffer.readBigUInt64LE(phoff + 32));
[?2004l[?2004h>             const p_memsz = Number(buffer.readBigUInt64LE(phoff + 40));
[?2004l[?2004h>             const startVaddr = p_vaddr + baseAddress;
[?2004l[?2004h>             for (let offset = 0; offset < p_memsz; offset += 4) {
[?2004l[?2004h>                 const currentVaddr = startVaddr + offset;
[?2004l[?2004h>                 let val = 0;
[?2004l[?2004h>                 if (offset < p_filesz) {
[?2004l[?2004h>                     const filePos = p_offset + offset;
