[?2004l[?2004h>   for (let i = 0; i < e_phnum; i++) {
[?2004l[?2004h>     const phoff = Number(e_phoff) + i * e_phentsize;
[?2004l[?2004h>     const p_type = buf.readUInt32LE(phoff);
[?2004l[?2004h>     if (p_type === 1) { // PT_LOAD
[?2004l[?2004h>       const p_offset = Number(buf.readBigUInt64LE(phoff + 0x08));
[?2004l[?2004h>       const p_vaddr = Number(buf.readBigUInt64LE(phoff + 0x10));
[?2004l[?2004h>       const p_filesz = Number(buf.readBigUInt64LE(phoff + 0x20));
[?2004l[?2004h>       const p_memsz = Number(buf.readBigUInt64LE(phoff + 0x28));
[?2004l[?2004h> 
