[?2004l[?2004h>   const e_phentsize = buf.readUInt16LE(0x36);
[?2004l[?2004h>   const e_phnum = buf.readUInt16LE(0x38);
[?2004l[?2004h> 
[?2004l[?2004h>   const result = {};
[?2004l[?2004h>   const baseAddr = 0x400000;
[?2004l[?2004h> 
[?2004l[?2004h>   // If we map loadable segments or the whole file:
