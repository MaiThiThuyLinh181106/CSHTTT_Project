[?2004hroot@811441ed8e20:/app# cat << 'EOF' > test_parse.py
[?2004l[?2004h> import struct
[?2004l[?2004h> 
[?2004l[?2004h> with open('a.out', 'rb') as f:
[?2004l[?2004h>     data = f.read()
[?2004l[?2004h> 
[?2004l[?2004h> # ELF Header
[?2004l[?2004h> # e_ident (16), e_type (2), e_machine (2), e_version (4), e_entry (8), e_phoff (8), e_shoff (8)
[?2004l[?2004h> e_phoff = struct.unpack_from('<Q', data, 32)[0]
[?2004l[?2004h> e_phentsize = struct.unpack_from('<H', data, 54)[0]
[?2004l[?2004h> e_phnum = struct.unpack_from('<H', data, 56)[0]
[?2004l[?2004h> 
[?2004l[?2004h> print(f'phoff: {e_phoff}, phentsize: {e_phentsize}, phnum: {e_phnum}')
[?2004l[?2004h> 
[?2004l[?2004h> base = 0x400000
[?2004l[?2004h> memory = {}
[?2004l[?2004h> 
[?2004l[?2004h> for i in range(e_phnum):
[?2004l[?2004h>     ph_offset = e_phoff + i * e_phentsize
[?2004l[?2004h>     p_type = struct.unpack_from('<I', data, ph_offset)[0]
[?2004l[?2004h>     if p_type == 1: # PT_LOAD
[?2004l[?2004h>         p_flags = struct.unpack_from('<I', data, ph_offset + 4)[0]
[?2004l[?2004h>         p_offset = struct.unpack_from('<Q', data, ph_offset + 8)[0]
[?2004l[?2004h>         p_vaddr = struct.unpack_from('<Q', data, ph_offset + 16)[0]
[?2004l[?2004h>         p_filesz = struct.unpack_from('<Q', data, ph_offset + 32)[0]
[?2004l[?2004h>         p_memsz = struct.unpack_from('<Q', data, ph_offset + 40)[0]
[?2004l[?2004h>         
[?2004l[?2004h>         print(f'LOAD seg: vaddr=0x{p_vaddr:x}, offset=0x{p_offset:x}, filesz={p_filesz}, memsz={p_memsz}')
[?2004l[?2004h>         
[?2004l[?2004h>         seg_data = data[p_offset : p_offset + p_filesz]
[?2004l[?2004h>         # Pad with zeros up to memsz
[?2004l[?2004h>         if len(seg_data) < p_memsz:
[?2004l[?2004h>             seg_data += b'\x00' * (p_memsz - len(seg_data))
[?2004l[?2004h>             
[?2004l[?2004h>         # Extract 32-bit integers aligned by 4
[?2004l[?2004h>         for off in range(0, len(seg_data), 4):
[?2004l[?2004h>             if off + 4 <= len(seg_data):
[?2004l[?2004h>                 val = struct.unpack_from('<I', seg_data, off)[0]
[?2004l[?2004h>                 addr = base + p_vaddr + off
[?2004l[?2004h>                 memory[str(addr)] = val
[?2004l[?2004h> 
[?2004l[?2004h> import json
[?2004l[?2004h> print(json.dumps(dict(list(memory.items())[:5]), indent=2))
[?2004l[?2004h> EOF
[?2004l[?2004hroot@811441ed8e20:/app# python3 test_parse.py
