[?2004hroot@811441ed8e20:/app# cat << 'EOF' > extract.js
[?2004l[?2004h> const fs = require('fs');
[?2004l[?2004h> const filename = process.argv[2] || '/app/a.out';
[?2004l[?2004h> const buf = fs.readFileSync(filename);
[?2004l[?2004h> const e_phoff = Number(buf.readBigUInt64LE(32));
[?2004l[?2004h> const e_phentsize = buf.readUInt16LE(54);
[?2004l[?2004h> const e_phnum = buf.readUInt16LE(56);
[?2004l[?2004h> const base = 0x400000;
[?2004l[?2004h> const memory = {};
[?2004l[?2004h> for (let i = 0; i < e_phnum; i++) {
[?2004l[?2004h>     const ph_offset = e_phoff + i * e_phentsize;
[?2004l[?2004h>     const p_type = buf.readUInt32LE(ph_offset);
[?2004l[?2004h>     if (p_type === 1) {
[?2004l[?2004h>         const p_offset = Number(buf.readBigUInt64LE(ph_offset + 8));
[?2004l[?2004h>         const p_vaddr = Number(buf.readBigUInt64LE(ph_offset + 16));
[?2004l[?2004h>         const p_filesz = Number(buf.readBigUInt64LE(ph_offset + 32));
[?2004l[?2004h>         const p_memsz = Number(buf.readBigUInt64LE(ph_offset + 40));
[?2004l[?2004h>         let segData = Buffer.alloc(p_memsz);
[?2004l[?2004h>         buf.copy(segData, 0, p_offset, p_offset + p_filesz);
[?2004l[?2004h>         for (let off = 0; off < segData.length; off += 4) {
[?2004l[?2004h>             if (off + 4 <= segData.length) {
[?2004l[?2004h>                 const val = segData.readUInt32LE(off);
[?2004l[?2004h>                 const addr = base + p_vaddr + off;
[?2004l[?2004h>                 memory[addr.toString()] = val;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> console.log(JSON.stringify(memory));
[?2004l[?2004h> EOF
[?2004l[?2004hroot@811441ed8e20:/app# node extract.js /app/a.out > out.json
