[38.314911, "i", "cat << 'EOF' > extract.js\nconst fs = require('fs');\n\nfunction parseElf(filePath) {\n  const buffer = fs.readFileSync(filePath);\n  \n  if (buffer.readUInt32BE(0) !== 0x7f454c46) {\n    throw new Error('Not a valid ELF file');\n  }\n\n  const is64Bit = buffer[4] === 2;\n  const isLittleEndian = buffer[5] === 1;\n\n  const readU16 = (offset) => isLittleEndian ? buffer.readUInt16LE(offset) : buffer.readUInt16BE(offset);\n  const readU32 = (offset) => isLittleEndian ? buffer.readUInt32LE(offset) : buffer.readUInt32BE(offset);\n  const readU64 = (offset) => {\n    const low = readU32(offset);\n    const high = readU32(offset + 4);\n    return Number(BigInt(low) + (BigInt(high) << 32n));\n  };\n\n  const phoff = is64Bit ? readU64(32) : readU32(28);\n  const phentsize = readU16(is64Bit ? 54 : 42);\n  const phnum = readU16(is64Bit ? 56 : 44);\n\n  const memory = {};\n\n  for (let i = 0; i < phnum; i++) {\n    const phOffset = phoff + i * phentsize;\n    const p_type = readU32(phOffset);\n    \n    if (p_type === 1) {\n      const p_offset = is64Bit ? readU64(phOffset + 8) : readU32(phOffset + 4);\n      const p_vaddr = is64Bit ? readU64(phOffset + 16) : readU32(phOffset + 8);\n      const p_filesz = is64Bit ? readU64(phOffset + 32) : readU32(phOffset + 16);\n      const p_memsz = is64Bit ? readU64(phOffset + 40) : readU32(phOffset + 20);\n\n      const segmentData = Buffer.alloc(Number(p_memsz));\n      if (p_filesz > 0) {\n        buffer.copy(segmentData, 0, Number(p_offset), Number(p_offset + p_filesz));\n      }\n\n      const startAddr = Number(p_vaddr);\n      const memSize = Number(p_memsz);\n      \n      const remainder = startAddr % 4;\n      const alignedStart = remainder === 0 ? startAddr : startAddr + (4 - remainder);\n\n      for (let addr = alignedStart; addr + 4 <= startAddr + memSize; addr += 4) {\n        const fileOffsetInSegment = addr - startAddr;\n        const val = isLittleEndian ? segmentData.readInt32LE(fileOffsetInSegment) : segmentData.readInt32BE(fileOffsetInSegment);\n        memory[addr.toString()] = val;\n      }\n    }\n  }\n\n  return memory;\n}\n\nconst args = process.argv.slice(2);\nif (args.length === 0) {\n  console.error('Usage: node extract.js <binary>');\n  process.exit(1);\n}\n\nconst result = parseElf(args[0]);\nconsole.log(JSON.stringify(result));\nEOF\n"]
