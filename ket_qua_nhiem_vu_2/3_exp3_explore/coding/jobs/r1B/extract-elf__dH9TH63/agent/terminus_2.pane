with open("/app/a.out", "rb") as f:
    d = f.read()
# ELF header parsing for 64-bit
e_phoff = struct.unpack_from("<Q", d, 32)[0]
e_phentsize = struct.unpack_from("<H", d, 54)[0]
e_phnum = struct.unpack_from("<H", d, 56)[0]
print(f"phoff: {e_phoff}, phentsize: {e_phentsize}, phnum: {e_phnum}")
for i in range(e_phnum):
    offset = e_phoff + i * e_phentsize
    p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align = struct.unpack_from("<IIQQQQQQ", d, offset)
    if p_type == 1: # PT_LOAD
        print(f"PT_LOAD: vaddr=0x{p_vaddr:x}, offset=0x{p_offset:x}, filesz=0x{p_filesz:x}, memsz=0x{p_memsz:x}")
'
