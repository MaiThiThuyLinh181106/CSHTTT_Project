[32.562426, "i", "cat << 'EOF' > extract.js\nconst fs = require('fs');\n\nfunction extract(filename) {\n  const buf = fs.readFileSync(filename);\n  \n  // Check ELF magic\n  if (buf.readUInt32BE(0) !== 0x7f454c46) {\n    console.error('Not an ELF file');\n    return;\n  }\n  \n  const is64 = buf.readUInt8(4) === 2;\n  const isLE = buf.readUInt8(5) === 1;\n  \n  if (!is64 || !isLE) {\n    console.error('Only 64-bit Little Endian ELF supported');\n    return;\n  }\n  \n  const e_phoff = Number(buf.readBigUInt64LE(32));\n  const e_phentsize = buf.readUInt16LE(54);\n  const e_phnum = buf.readUInt16LE(56);\n  \n  const result = {};\n  \n  // Check if addresses need base 0x400000\n  // For PIE, vaddr starts at 0\n  let baseAddress = 0;\n  // Let's check first LOAD vaddr\n  for (let i = 0; i < e_phnum; i++) {\n    const phoff = e_phoff + i * e_phentsize;\n    const p_type = buf.readUInt32LE(phoff);\n    if (p_type === 1) { // PT_LOAD\n      const p_vaddr = Number(buf.readBigUInt64LE(phoff + 16));\n      if (p_vaddr === 0) {\n        baseAddress = 0x400000;\n      }\n      break;\n    }\n  }\n  \n  for (let i = 0; i < e_phnum; i++) {\n    const phoff = e_phoff + i * e_phentsize;\n    const p_type = buf.readUInt32LE(phoff);\n    if (p_type === 1) { // PT_LOAD\n      const p_offset = Number(buf.readBigUInt64LE(phoff + 8));\n      const p_vaddr = Number(buf.readBigUInt64LE(phoff + 16));\n      const p_filesz = Number(buf.readBigUInt64LE(phoff + 32));\n      const p_memsz = Number(buf.readBigUInt64LE(phoff + 40));\n      \n      const startAddr = p_vaddr + baseAddress;\n      \n      // Read file data\n      const segmentData = Buffer.alloc(p_memsz);\n      buf.copy(segmentData, 0, p_offset, p_offset + p_filesz);\n      \n      // Extract 32-bit ints aligned by 4\n      for (let offset = 0; offset < p_memsz; offset += 4) {\n        // Ensure 4-byte alignment relative to startAddr\n        const addr = startAddr + offset;\n        const val = segmentData.readInt32LE(offset);\n        // Or readUInt32LE? Usually memory values can be signed or unsigned. Let's check if readInt32LE or readUInt32LE or both work. JSON numbers are floating point up to 2^53-1, so unsigned 32-bit fits perfectly.\n        result[addr.toString()] = segmentData.readUInt32LE(offset);\n      }\n    }\n  }\n  \n  console.log(JSON.stringify(result));\n}\n\nextract(process.argv[2]);\nEOF\nnode extract.js a.out > out.json\nhead -c 200 out.json\n"]
