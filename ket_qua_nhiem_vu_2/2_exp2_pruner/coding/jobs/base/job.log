Sending keys: ['cat << \'EOF\' > extract.js\nconst fs = require(\'fs\');\n\nfunction parseELF(filePath) {\n  const buf = fs.readFileSync(filePath);\n  if (buf[0] !== 0x7f || buf.slice(1, 4).toString() !== \'ELF\') {\n    throw new Error(\'Not an ELF file\');\n  }\n  const is64 = buf[4] === 2;\n  if (!is64) throw new Error(\'Only 64-bit ELF supported\');\n  \n  const e_type = buf.readUInt16LE(16);\n  const e_phoff = Number(buf.readBigUInt64LE(32));\n  const e_phentsize = buf.readUInt16LE(54);\n  const e_phnum = buf.readUInt16LE(56);\n  \n  const memory = {};\n  const baseAddr = (e_type === 3) ? 0x400000 : 0;\n  \n  for (let i = 0; i < e_phnum; i++) {\n    const phOffset = e_phoff + i * e_phentsize;\n    const p_type = buf.readUInt32LE(phOffset);\n    if (p_type === 1) {\n      const p_offset = Number(buf.readBigUInt64LE(phOffset + 8));\n      const p_vaddr = Number(buf.readBigUInt64LE(phOffset + 16));\n      const p_filesz = Number(buf.readBigUInt64LE(phOffset + 32));\n      const p_memsz = Number(buf.readBigUInt64LE(phOffset + 40));\n      \n      const startAddr = baseAddr + p_vaddr;\n      const segmentData = Buffer.alloc(p_memsz);\n      if (p_filesz > 0) {\n        buf.copy(segmentData, 0, p_offset, p_offset + p_filesz);\n      }\n      \n      for (let offset = 0; offset + 4 <= p_memsz; offset += 4) {\n        const addr = startAddr + offset;\n        const val = segmentData.readInt32LE(offset);\n        memory[addr.toString()] = val;\n      }\n    }\n  }\n  console.log(JSON.stringify(memory));\n}\n\nparseELF(process.argv[2]);\nEOF\nnode extract.js /app/a.out > out.json\nnode -e "const d = require(\'./out.json\'); console.log(Object.keys(d).length);"\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
