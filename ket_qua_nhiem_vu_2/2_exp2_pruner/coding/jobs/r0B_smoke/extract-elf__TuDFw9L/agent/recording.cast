[41.258565, "i", "cat << 'EOF' > extract.js\nconst fs = require('fs');\n\nfunction extract(filePath) {\n  const buf = fs.readFileSync(filePath);\n  const phoff = Number(buf.readBigUInt64LE(0x20));\n  const phentsize = buf.readUInt16LE(0x36);\n  const phnum = buf.readUInt16LE(0x38);\n\n  const result = {};\n\n  for (let i = 0; i < phnum; i++) {\n    const p_off = phoff + i * phentsize;\n    const p_type = buf.readUInt32LE(p_off);\n    if (p_type === 1) { // PT_LOAD\n      const p_offset = Number(buf.readBigUInt64LE(p_off + 8));\n      const p_vaddr = Number(buf.readBigUInt64LE(p_off + 16));\n      const p_filesz = Number(buf.readBigUInt64LE(p_off + 32));\n      const p_memsz = Number(buf.readBigUInt64LE(p_off + 40));\n\n      // Read from file buffer for filesz, and pad with 0 up to memsz if needed\n      // But wait, are we extracting 32-bit integers (4 bytes) at 4-byte aligned addresses?\n      for (let offset = 0; offset < p_filesz; offset += 4) {\n        // If we cross p_filesz by less than 4 bytes, what happens?\n        if (offset + 4 <= p_filesz) {\n          const addr = p_vaddr + offset;\n          const val = buf.readInt32LE(p_offset + offset); // or readUInt32LE? Let's check signed vs unsigned or int32 vs uint32\n          result[addr.toString()] = val;\n        }\n      }\n    }\n  }\n  return result;\n}\n\nconst res = extract(process.argv[2]);\nconsole.log(JSON.stringify(res, null, 2));\nEOF\nnode extract.js a.out > out.json\nhead -n 20 out.json\n"]
