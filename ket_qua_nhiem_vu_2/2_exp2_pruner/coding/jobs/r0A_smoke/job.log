Sending keys: ["cat << 'EOF' > extract.js\nconst fs = require('fs');\n\nfunction extract(filename) {\n    const buffer = fs.readFileSync(filename);\n    const result = {};\n\n    // Parse ELF Header\n    const is64 = buffer.readUInt8(4) === 2;\n    const phoff = is64 ? Number(buffer.readBigUInt64LE(32)) : buffer.readUInt32LE(28);\n    const phentsize = buffer.readUInt16LE(is64 ? 54 : 42);\n    const phnum = buffer.readUInt16LE(is64 ? 56 : 44);\n\n    for (let i = 0; i < phnum; i++) {\n        const phOffset = phoff + i * phentsize;\n        const p_type = buffer.readUInt32LE(phOffset);\n        if (p_type === 1) { // PT_LOAD\n            const p_offset = Number(is64 ? buffer.readBigUInt64LE(phOffset + 8) : buffer.readUInt32LE(phOffset + 4));\n            const p_vaddr = Number(is64 ? buffer.readBigUInt64LE(phOffset + 16) : buffer.readUInt32LE(phOffset + 8));\n            const p_filesz = Number(is64 ? buffer.readBigUInt64LE(phOffset + 32) : buffer.readUInt32LE(phOffset + 16));\n            const p_memsz = Number(is64 ? buffer.readBigUInt64LE(phOffset + 40) : buffer.readUInt32LE(phOffset + 20));\n\n            // Base address adjustment if vaddr is small (PIE binary loaded at 0x400000)\n            // Let\\'s check if base needs 0x400000 or not. If p_vaddr < 0x10000, maybe add 0x400000?\n            const base = (p_vaddr < 0x10000) ? 0x400000 : 0;\n\n            for (let off = 0; off < p_memsz; off += 4) {\n                const addr = p_vaddr + off + base;\n                let val = 0;\n                if (off < p_filesz && (p_offset + off + 4) <= buffer.length) {\n                    val = buffer.readInt32LE(p_offset + off);\n                }\n                result[addr.toString()] = val;\n            }\n        }\n    }\n    return result;\n}\n\nconst out = extract(process.argv[2] || '/app/a.out');\nconsole.log(JSON.stringify(out, null, 2));\nEOF\nnode extract.js /app/a.out | head -n 20\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
