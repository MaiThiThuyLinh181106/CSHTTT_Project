Sending keys: ['python3 -c \'\nwith open("a.out", "rb") as f:\n    e = f.read()\n# ELF64 header\n# e_ident (16), e_type (2), e_machine (2), e_version (4), e_entry (8), e_phoff (8), e_shoff (8), e_flags (4), e_ehsize (2), e_phentsize (2), e_phnum (2), e_shentsize (2), e_shnum (2), e_shstrndx (2)\nimport struct\nfmt = "<16sHHIQQQIHHHHHH"\nheader = struct.unpack_from(fmt, e, 0)\nprint("e_type:", header[1])\nprint("e_entry:", hex(header[4]))\nprint("e_phoff:", header[5])\nprint("e_phentsize:", header[9])\nprint("e_phnum:", header[10])\n\nphoff = header[5]\nphentsize = header[9]\nphnum = header[10]\nfor i in range(phnum):\n    ph = e[phoff + i*phentsize : phoff + (i+1)*phentsize]\n    # p_type (4), p_flags (4), p_offset (8), p_vaddr (8), p_paddr (8), p_filesz (8), p_memsz (8), p_align (8)\n    p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align = struct.unpack_from("<IIQQQQQQ", ph, 0)\n    if p_type == 1: # PT_LOAD\n        print(f"LOAD: offset={hex(p_offset)}, vaddr={hex(p_vaddr)}, filesz={hex(p_filesz)}, memsz={hex(p_memsz)}")\n\'\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
