[29.237283, "o", "history\r\n\u001b[?2004l\r    1  clear\r\n    2  ls -la\r\n    3  cat hi.c\r\n    4  readelf -l a.out\r\n    5  readelf -S a.out\r\n    6  find / -name \"*extract*\" -o -name \"*test*\" 2>/dev/null\r\n    7  npm list -g --depth=0\r\n"]
[29.237382, "o", "    8  python3 -c 'with open(\"a.out\", \"rb\") as f: print(len(f.read()))'\r\n    9  python3 -c 'import elftools; print(elftools.__file__)' 2>/dev/null || echo 'no pyelftools'\r\n   10  python3 -c '\r\nwith open(\"a.out\", \"rb\") as f:\r\n    e = f.read()\r\n# ELF64 header\r\n# e_ident (16), e_type (2), e_machine (2), e_version (4), e_entry (8), e_phoff (8), e_shoff (8), e_flags (4), e_ehsize (2), e_phentsize (2), e_phnum (2), e_shentsize (2), e_shnum (2), e_shstrndx (2)\r\nimport struct\r\nfmt = \"<16sHHIQQQIHHHHHH\"\r\nheader = struct.unpack_from(fmt, e, 0)\r\nprint(\"e_type:\", header[1])\r\nprint(\"e_entry:\", hex(header[4]))\r\nprint(\"e_phoff:\", header[5])\r\nprint(\"e_phentsize:\", header[9])\r\nprint(\"e_phnum:\", header[10])\r\n\r\nphoff = header[5]\r\nphentsize = header[9]\r\nphnum = header[10]\r\nfor i in range(phnum):\r\n    ph = e[phoff + i*phentsize : phoff + (i+1)*phentsize]\r\n    # p_type (4), p_flags (4), p_offset (8), p_vaddr (8), p_paddr (8), p_filesz (8), p_memsz (8), p_align (8)\r\n    p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align = struct.unpack_from(\"<IIQQQQQQ\", ph, 0)\r\n    if p_type == 1: # PT_LOAD\r\n        print(f\"LOAD: offset={hex(p_offset)}, vaddr={hex(p_vaddr)}, filesz={hex(p_filesz)}, memsz={hex(p_memsz)}\")\r\n'\r\n   11  history\r\n"]
