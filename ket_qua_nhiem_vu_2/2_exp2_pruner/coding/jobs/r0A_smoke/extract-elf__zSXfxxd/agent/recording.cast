[53.00493, "i", "cat << 'EOF' > test_extract.js\nconst fs = require('fs');\nconst filename = process.argv[2] || '/app/a.out';\nconst buf = fs.readFileSync(filename);\nconsole.log('Buffer length:', buf.length);\nEOF\nnode test_extract.js\n"]
[53.005264, "o", "cat << 'EOF' > test_extract.js\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.00539, "o", "> const fs = require('fs');\r\n\u001b[?2004l\r\u001b[?2004h> "]
