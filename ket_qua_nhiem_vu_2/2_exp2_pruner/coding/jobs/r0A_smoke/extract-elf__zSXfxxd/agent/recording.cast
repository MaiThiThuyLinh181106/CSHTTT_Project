[75.13827, "o", "const fs = require('fs');\r\n\r\nfunction extract(filename) {\r\n    const buffer = fs.readFileSync(filename);\r\n    const result = {};\r\n\r\n    const is64 = buffer.readUInt8(4) === 2;\r\n    const phoff = is64 ? Number(buffer.readBigUInt64LE(32)) : buffer.readUInt32LE(28);\r\n    const phentsize = buffer.readUInt16LE(is64 ? 54 : 42);\r\n    const phnum = buffer.readUInt16LE(is64 ? 56 : 44);\r\n\r\n    for (let i = 0; i < phnum; i++) {\r\n        const phOffset = phoff + i * phentsize;\r\n        const p_type = buffer.readUInt32LE(phOffset);\r\n        if (p_type === 1) { // PT_LOAD\r\n            const p_offset = Number(is64 ? buffer.readBigUInt64LE(phOffset + 8) : buffer.readUInt32LE(phOffset + 4));\r\n            const p_vaddr = Number(is64 ? buffer.readBigUInt64LE(phOffset + 16) : buffer.readUInt32LE(phOffset + 8));\r\n            const p_filesz = Number(is64 ? buffer.readBigUInt64LE(phOffset + 32) : buffer.readUInt32LE(phOffset + 16));\r\n            const p_memsz = Number(is64 ? buffer.readBigUInt64LE(phOffset + 40) : buffer.readUInt32LE(phOffset + 20));\r\n\r\n            const base = (p_vaddr < 0x10000) ? 0x400000 : 0;\r\n\r\n            for (let off = 0; off < p_memsz; off += 4) {\r\n                const addr = p_vaddr + off + base;\r\n                let val = 0;\r\n                if (off < p_filesz && (p_offset + off + 4) <= buffer.length) {\r\n                    val = buffer.readUInt32LE(p_offset + off);\r\n                }\r\n                result[addr.toString()] = val;\r\n            }\r\n        }\r\n    }\r\n    return result;\r\n}\r\n\r\nconst out = extract(process.argv[2] || '/app/a.out');\r\nconsole.log(JSON.stringify(out));\r\n"]
