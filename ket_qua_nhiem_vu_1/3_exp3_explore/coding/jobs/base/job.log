Sending keys: ['cat << \'EOF\' > /app/ars.R\n# Adaptive Rejection Sampling (ARS) Implementation in R\n# Based on Gilks & Wild (1992)\n\nlog_density_grad <- function(density_func, x, h_eps = 1e-5) {\n  vals <- density_func(x)\n  if (any(!is.finite(vals)) || any(vals <= 0)) {\n    stop("Density function must return positive finite values within domain.")\n  }\n  h <- log(vals)\n  h_plus <- log(density_func(x + h_eps))\n  h_minus <- log(density_func(x - h_eps))\n  dh <- (h_plus - h_minus) / (2 * h_eps)\n  list(h = h, dh = dh)\n}\n\nars_init <- function(density_func, domain, x_init = NULL) {\n  if (is.null(x_init)) {\n    if (is.infinite(domain[1]) && is.infinite(domain[2])) {\n      x_init <- c(-1, 0, 1)\n    } else if (is.infinite(domain[1])) {\n      x_init <- c(domain[2] - 2, domain[2] - 1, domain[2] - 0.5)\n    } else if (is.infinite(domain[2])) {\n      x_init <- c(domain[1] + 0.5, domain[1] + 1, domain[1] + 2)\n    } else {\n      x_init <- seq(domain[1], domain[2], length.out = 4)[2:3]\n    }\n  }\n  x_init <- sort(unique(x_init))\n  x_init <- x_init[x_init >= domain[1] & x_init <= domain[2]]\n  if (length(x_init) < 2) {\n    stop("Initialization requires at least 2 valid points within domain.")\n  }\n  evals <- lapply(x_init, function(x) log_density_grad(density_func, x))\n  h <- sapply(evals, function(e) e$h)\n  dh <- sapply(evals, function(e) e$dh)\n  for (i in 1:(length(x_init) - 1)) {\n    if (dh[i] < dh[i+1] - 1e-3) {\n      stop(paste0("Non-log-concavity detected during initialization at x = ", x_init[i]))\n    }\n  }\n  list(x = x_init, h = h, dh = dh, domain = domain)\n}\n\nget_upper_hull_z <- function(hull) {\n  x <- hull$x\n  h <- hull$h\n  dh <- hull$dh\n  K <- length(x)\n  z <- numeric(K + 1)\n  z[1] <- hull$domain[1]\n  z[K + 1] <- hull$domain[2]\n  if (K > 1) {\n    for (i in 1:(K - 1)) {\n      denom <- dh[i] - dh[i+1]\n      if (abs(denom) < 1e-12) {\n        z[i+1] <- (x[i] + x[i+1]) / 2\n      } else {\n        z_val <- (h[i+1] - h[i] - x[i+1]*dh[i+1] + x[i]*dh[i]) / denom\n        if (z_val <= x[i] || z_val >= x[i+1]) {\n          z_val <- (x[i] + x[i+1]) / 2\n        }\n        z[i+1] <- z_val\n      }\n    }\n    for (i in 2:K) {\n      if (z[i] <= z[i-1]) {\n        z[i] <- (x[i-1] + x[i]) / 2\n      }\n    }\n  }\n  z\n}\n\nars <- function(density_function, domain, n = 1000) {\n  if (!is.function(density_function)) stop("density_function must be a function.")\n  if (!is.numeric(domain) || length(domain) != 2 || domain[1] >= domain[2]) stop("Invalid domain.")\n  if (!is.numeric(n) || length(n) != 1 || n <= 0 || n != round(n)) stop("Invalid n.")\n  \n  hull <- ars_init(density_function, domain)\n  samples <- numeric(n)\n  accepted <- 0\n  max_iters <- n * 50\n  iters <- 0\n  \n  while (accepted < n && iters < max_iters) {\n    iters <- iters + 1\n    z <- get_upper_hull_z(hull)\n    x <- hull$x\n    h <- hull$h\n    dh <- hull$dh\n    K <- length(x)\n    \n    log_weights <- numeric(K)\n    for (i in 1:K) {\n      zi <- z[i]\n      zi1 <- z[i+1]\n      dhi <- dh[i]\n      hi <- h[i]\n      xi <- x[i]\n      if (abs(dhi) < 1e-10) {\n        log_weights[i] <- hi - dhi*xi + log(zi1 - zi)\n      } else {\n        term1 <- dhi * (zi1 - xi)\n        term2 <- dhi * (zi - xi)\n        if (dhi > 0) {\n          log_w <- hi - dhi*xi + term1 + log(1 - exp(term2 - term1))\n        } else {\n          log_w <- hi - dhi*xi + term2 + log(exp(term1 - term2) - 1)\n        }\n        log_weights[i] <- log_w\n      }\n    }\n    \n    max_lw <- max(log_weights)\n    weights <- exp(log_weights - max_lw)\n    probs <- weights / sum(weights)\n    \n    interval_idx <- sample(K, 1, prob = probs)\n    zi <- z[interval_idx]\n    zi1 <- z[interval_idx+1]\n    dhi <- dh[interval_idx]\n    xi <- x[interval_idx]\n    \n    u_rand <- runif(1)\n    if (abs(dhi) < 1e-10) {\n      x_star <- zi + u_rand * (zi1 - zi)\n    } else {\n      term_low <- dhi * (zi - xi)\n      term_high <- dhi * (zi1 - xi)\n      if (dhi > 0) {\n        arg <- exp(term_low) + u_rand * (exp(term_high) - exp(term_low))\n        if (arg <= 0) arg <- 1e-12\n        x_star <- xi + log(arg) / dhi\n      } else {\n        arg <- exp(term_low) - u_rand * (exp(term_low) - exp(term_high))\n        if (arg <= 0) arg <- 1e-12\n        x_star <- xi + log(arg) / dhi\n      }\n    }\n    \n    x_star <- max(zi, min(zi1, x_star))\n    eval_star <- tryCatch(log_density_grad(density_function, x_star), error = function(e) NULL)\n    if (is.null(eval_star)) next\n    \n    h_star <- eval_star$h\n    dh_star <- eval_star$dh\n    u_star <- h[interval_idx] + dh[interval_idx] * (x_star - x[interval_idx])\n    \n    u_rand2 <- runif(1)\n    if (log(u_rand2) <= h_star - u_star) {\n      accepted <- accepted + 1\n      samples[accepted] <- x_star\n    }\n    \n    new_x <- sort(c(x, x_star))\n    new_evals <- lapply(new_x, function(xx) {\n      if (xx == x_star) list(h = h_star, dh = dh_star)\n      else {\n        idx <- which(x == xx)\n        list(h = h[idx], dh = dh[idx])\n      }\n    })\n    new_dh <- sapply(new_evals, function(e) e$dh)\n    \n    log_concave_ok <- TRUE\n    for (i in 1:(length(new_x) - 1)) {\n      if (new_dh[i] < new_dh[i+1] - 1e-2) {\n        log_concave_ok <- FALSE\n        break\n      }\n    }\n    \n    if (!log_concave_ok) {\n      stop(paste0("Non-log-concave density detected at x = ", x_star))\n    }\n    \n    hull$x <- new_x\n    hull$h <- sapply(new_evals, function(e) e$h)\n    hull$dh <- sapply(new_evals, function(e) e$dh)\n  }\n  \n  if (accepted < n) {\n    warning("Reached max iterations.")\n    samples <- samples[1:accepted]\n  }\n  samples\n}\n\ntest <- function() {\n  cat("Running Adaptive Rejection Sampling (ARS) Formal Tests...\\n\\n")\n  passed_tests <- 0\n  total_tests <- 3\n  \n  cat("Test 1: Standard Normal Distribution\\n")\n  dnorm_unnorm <- function(x) exp(-0.5 * x^2)\n  set.seed(42)\n  samples_norm <- tryCatch(ars(dnorm_unnorm, c(-4, 4), n = 1000), error = function(e) NULL)\n  \n  if (!is.null(samples_norm) && length(samples_norm) > 100) {\n    mean_val <- mean(samples_norm)\n    sd_val <- sd(samples_norm)\n    cat(sprintf("  Generated %d samples.\\n  Mean: %.4f (Expected: 0)\\n  SD: %.4f (Expected: 1)\\n", length(samples_norm), mean_val, sd_val))\n    if (abs(mean_val) < 0.2 && abs(sd_val - 1.0) < 0.2) {\n      cat("NORMAL_TEST: PASS\\n")\n      passed_tests <- passed_tests + 1\n      writeLines(as.character(samples_norm), "/app/normal_samples.txt")\n    } else {\n      cat("NORMAL_TEST: FAIL\\n")\n    }\n  } else {\n    cat("NORMAL_TEST: FAIL\\n")\n  }\n  cat("\\n")\n  \n  cat("Test 2: Exponential Distribution\\n")\n  dexp_unnorm <- function(x) ifelse(x >= 0, exp(-x), 0)\n  set.seed(42)\n  samples_exp <- tryCatch(ars(dexp_unnorm, c(0.01, 10), n = 1000), error = function(e) NULL)\n  \n  if (!is.null(samples_exp) && length(samples_exp) > 100) {\n    mean_val <- mean(samples_exp)\n    sd_val <- sd(samples_exp)\n    cat(sprintf("  Generated %d samples.\\n  Mean: %.4f (Expected: 1)\\n  SD: %.4f (Expected: 1)\\n", length(samples_exp), mean_val, sd_val))\n    if (abs(mean_val - 1.0) < 0.2 && abs(sd_val - 1.0) < 0.2) {\n      cat("EXPONENTIAL_TEST: PASS\\n")\n      passed_tests <- passed_tests + 1\n      writeLines(as.character(samples_exp), "/app/exponential_samples.txt")\n    } else {\n      cat("EXPONENTIAL_TEST: FAIL\\n")\n    }\n  } else {\n    cat("EXPONENTIAL_TEST: FAIL\\n")\n  }\n  cat("\\n")\n  \n  cat("Test 3: Non-log-concave density error detection\\n")\n  d_nonlogconcave <- function(x) exp(-x^2) + 0.5 * exp(-(x - 3)^2)\n  error_caught <- FALSE\n  tryCatch(ars(d_nonlogconcave, c(-3, 5), n = 100), error = function(e) {\n    cat(sprintf("  Caught expected error: %s\\n", e$message))\n    error_caught <- TRUE\n  })\n  \n  if (error_caught) {\n    cat("NON_LOG_CONCAVE_TEST: PASS\\n")\n    passed_tests <- passed_tests + 1\n  } else {\n    cat("NON_LOG_CONCAVE_TEST: FAIL\\n")\n  }\n  cat("\\n")\n  \n  cat(sprintf("Test Summary: %d / %d tests passed.\\n", passed_tests, total_tests))\n  if (passed_tests == total_tests) {\n    cat("ALL TESTS PASSED\\n")\n  } else {\n    cat("SOME TESTS FAILED\\n")\n  }\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
