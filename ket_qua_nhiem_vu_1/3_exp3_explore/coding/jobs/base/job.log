Sending keys: ['cat << \'EOF\' > process_dag.py\nimport pandas as pd\nimport networkx as nx\nfrom pgmpy.models import LinearGaussianBayesianNetwork\nfrom pgmpy.estimators import MaximumLikelihoodEstimator\nfrom pgmpy.sampling import BayesianModelSampling\n\n# Corrected edges (child, parent) -> (to, from)\nedges = [\n    (\'M\', \'U\'),\n    (\'Y\', \'U\'),\n    (\'D\', \'U\'),\n    (\'D\', \'Y\'),\n    (\'R\', \'U\'), # wait, U has no parents, so parent of R is U -> (R, U)\n    (\'M\', \'R\')\n]\n\n# Let\'s check correctness of (to, from):\n# U -> M  => M is to, U is from -> (\'M\', \'U\')\n# U -> Y  => Y is to, U is from -> (\'Y\', \'U\')\n# U -> D  => D is to, U is from -> (\'D\', \'U\')\n# Y -> D  => D is to, Y is from -> (\'D\', \'Y\')\n# U -> R  => R is to, U is from -> (\'R\', \'U\')\n# R -> M  => M is to, R is from -> (\'M\', \'R\')\n\ncorrected_edges = [\n    (\'M\', \'U\'),\n    (\'Y\', \'U\'),\n    (\'D\', \'U\'),\n    (\'D\', \'Y\'),\n    (\'R\', \'U\'),\n    (\'M\', \'R\')\n]\n\nG = nx.DiGraph()\nG.add_edges_from([(f, t) for t, f in corrected_edges])\nassert nx.is_directed_acyclic_graph(G), "Graph must be DAG"\nprint("DAG is valid!")\n\n# Save learned_dag.csv\ndf_dag = pd.DataFrame(corrected_edges, columns=[\'to\', \'from\'])\ndf_dag.to_csv(\'/app/learned_dag.csv\', index=False)\nprint("Saved /app/learned_dag.csv")\n\nEOF\n./venv/bin/python process_dag.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
