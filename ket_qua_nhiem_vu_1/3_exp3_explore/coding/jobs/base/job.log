Sending keys: ['cat << \'EOF\' > full_pipeline.py\nimport pandas as pd\nimport numpy as np\nfrom pgmpy.models import BayesianNetwork, LinearGaussianBayesianNetwork\nfrom pgmpy.estimators import MaximumLikelihoodEstimator\nfrom pgmpy.sampling import BayesianModelSampling\nfrom pgmpy.factors.continuous import LinearGaussianCPD\n\ndf = pd.read_csv(\'/app/bn_sample_10k.csv\')\n\ncorrected_edges = [\n    (\'M\', \'U\'),\n    (\'Y\', \'U\'),\n    (\'D\', \'U\'),\n    (\'D\', \'Y\'),\n    (\'R\', \'U\'),\n    (\'M\', \'R\')\n]\n\n# 2) Learn Bayesian Network\nmodel = BayesianNetwork(corrected_edges)\nmodel.fit(df, estimator=MaximumLikelihoodEstimator)\nprint("Fitted model nodes/edges:", model.nodes(), model.edges())\n\n# 3) Perform causal intervention on Y, setting its value to 0.0 (variance 1e-9)\n# Intervened DAG removes edges into Y\nintervened_edges = [e for e in corrected_edges if e[0] != \'Y\']\nprint("Intervened edges:", intervened_edges)\n\n# Save intervened_dag.csv\ndf_intervened = pd.DataFrame(intervened_edges, columns=[\'to\', \'from\'])\ndf_intervened.to_csv(\'/app/intervened_dag.csv\', index=False)\nprint("Saved /app/intervened_dag.csv")\n\n# Create intervened model\nintervened_model = BayesianNetwork(intervened_edges)\nintervened_model.fit(df, estimator=MaximumLikelihoodEstimator)\n\n# Set CPD of Y to mean 0.0, variance 1e-9 (no parents now)\n# For LinearGaussianCPD: variable, beta, variance, evidence=None, beta_vector=None\n# Since Y has no parents in intervened model, beta=[0.0] (intercept), variance=1e-9\ncpd_y = LinearGaussianCPD(\'Y\', beta=[0.0], variance=1e-9)\nintervened_model.add_cpds(cpd_y)\n\n# Also fit other CPDs from data or use fitted ones (excluding Y which we just set)\nfor node in intervened_model.nodes():\n    if node != \'Y\':\n        # fit CPD using MLE\n        mle = MaximumLikelihoodEstimator(intervened_model, df)\n        cpd = mle.estimate_cpd(node)\n        intervened_model.add_cpds(cpd)\n\nprint("Intervened model check:", intervened_model.check_model())\n\n# 5) Sample 10k points\nsampler = BayesianModelSampling(intervened_model)\nsamples = sampler.forward_sample(size=10000)\n# ensure columns match original order\nsamples = samples[df.columns]\nsamples.to_csv(\'/app/final_bn_sample.csv\', index=False)\nprint("Saved /app/final_bn_sample.csv with shape:", samples.shape)\nprint(samples.head())\n\nEOF\n./venv/bin/python full_pipeline.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
