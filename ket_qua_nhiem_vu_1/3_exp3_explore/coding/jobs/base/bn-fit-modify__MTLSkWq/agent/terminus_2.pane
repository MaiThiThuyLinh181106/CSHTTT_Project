 |      --------
 |      >>> from pgmpy.base import DAG
 |      >>> dag = DAG([("X", "Y"), ("Z", "Y")])
 |      >>> print(dag.to_lavaan())
 |      Y ~ X + Z
 |
 |      >>> dag2 = DAG([("A", "B"), ("B", "C")])
 |      >>> print(dag2.to_lavaan())
 |      B ~ A
