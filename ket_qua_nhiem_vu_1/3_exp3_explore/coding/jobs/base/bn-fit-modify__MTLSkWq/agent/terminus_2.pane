[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> # 2) Learn Bayesian Network
[?2004l[?2004h> model = BayesianNetwork(corrected_edges)
[?2004l[?2004h> model.fit(df, estimator=MaximumLikelihoodEstimator)
[?2004l[?2004h> print("Fitted model nodes/edges:", model.nodes(), model.edges())
[?2004l[?2004h> 
[?2004l[?2004h> # 3) Perform causal intervention on Y, setting its value to 0.0 (variance 1e-9)
[?2004l[?2004h> # Intervened DAG removes edges into Y
[?2004l[?2004h> intervened_edges = [e for e in corrected_edges if e[0] != 'Y']
[?2004l[?2004h> print("Intervened edges:", intervened_edges)
[?2004l[?2004h> 
[?2004l[?2004h> # Save intervened_dag.csv
[?2004l[?2004h> df_intervened = pd.DataFrame(intervened_edges, columns=['to', 'from'])
[?2004l[?2004h> df_intervened.to_csv('/app/intervened_dag.csv', index=False)
[?2004l[?2004h> print("Saved /app/intervened_dag.csv")
[?2004l[?2004h> 
[?2004l[?2004h> # Create intervened model
[?2004l[?2004h> intervened_model = BayesianNetwork(intervened_edges)
[?2004l[?2004h> intervened_model.fit(df, estimator=MaximumLikelihoodEstimator)
[?2004l[?2004h> 
[?2004l[?2004h> # Set CPD of Y to mean 0.0, variance 1e-9 (no parents now)
[?2004l[?2004h> # For LinearGaussianCPD: variable, beta, variance, evidence=None, beta_vector=None
[?2004l[?2004h> # Since Y has no parents in intervened model, beta=[0.0] (intercept), variance=1e-9
[?2004l[?2004h> cpd_y = LinearGaussianCPD('Y', beta=[0.0], variance=1e-9)
[?2004l[?2004h> intervened_model.add_cpds(cpd_y)
[?2004l[?2004h> 
[?2004l[?2004h> # Also fit other CPDs from data or use fitted ones (excluding Y which we just set)
[?2004l[?2004h> for node in intervened_model.nodes():
[?2004l[?2004h>     if node != 'Y':
[?2004l[?2004h>         # fit CPD using MLE
[?2004l[?2004h>         mle = MaximumLikelihoodEstimator(intervened_model, df)
[?2004l[?2004h>         cpd = mle.estimate_cpd(node)
[?2004l[?2004h>         intervened_model.add_cpds(cpd)
[?2004l[?2004h> 
[?2004l[?2004h> print("Intervened model check:", intervened_model.check_model())
[?2004l[?2004h> 
[?2004l[?2004h> # 5) Sample 10k points
[?2004l[?2004h> sampler = BayesianModelSampling(intervened_model)
[?2004l[?2004h> samples = sampler.forward_sample(size=10000)
[?2004l[?2004h> # ensure columns match original order
[?2004l[?2004h> samples = samples[df.columns]
[?2004l[?2004h> samples.to_csv('/app/final_bn_sample.csv', index=False)
