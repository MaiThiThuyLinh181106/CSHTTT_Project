import pandas as pd
import numpy as np
from pgmpy.estimators import HillClimbSearch, BIC

df = pd.read_csv('/app/bn_sample_10k.csv')
nodes = list(df.columns)
bic = BIC(df)
hc = HillClimbSearch(df)
best_model = hc.estimate(scoring_method=bic, max_iter=10000)
edges = list(best_model.edges())
print("Learned edges before filtering U:", edges)

# Filter out edges where U is child (i.e. (parent, U) where U is second element)
filtered_edges = [e for e in edges if e[1] != 'U']
print("Filtered edges:", filtered_edges)
EOF
