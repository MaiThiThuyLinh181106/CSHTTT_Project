Installing collected packages: wrapt, typing-extensions, truststore, tqdm, threadpoolctl, six, scikit-base, pyyaml, pyparsing, packaging, opt_einsum, numpy, networkx, narwhals, interface-meta, idna, hf-xet, h11, fsspec, filelock, cloudpickle, click, scipy, python-dateutil, patsy, joblib, httpcore2, anyio, scikit-learn, pandas, httpx2, huggingface_hub, formulaic, statsmodels, pgmpy
cat << 'EOF' > /app/solve.py
import pandas as pd
import numpy as np
from pgmpy.estimators import HillClimbingSearch, BicScore, MaximumLikelihoodEstimator
from pgmpy.models import BayesianNetwork
from pgmpy.sampling import BayesianModelSampling

# 1. Load data
df = pd.read_csv('/app/bn_sample_10k.csv')
print("Data shape:", df.shape)
print("Columns:", list(df.columns))

# Structure Learning using Hill Climbing and BIC Score
bic = BicScore(df)
hc = HillClimbingSearch(df)
best_model = hc.estimate(scoring_method=bic, max_indegree=4)
print("Learned edges:", best_model.edges())

EOF
python3 /app/solve.py
