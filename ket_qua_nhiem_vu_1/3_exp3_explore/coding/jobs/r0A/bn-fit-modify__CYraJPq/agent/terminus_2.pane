[?2004hroot@661d6f088f0f:/app# cat << 'EOF' > /app/complete_task.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from pgmpy.models import BayesianNetwork
[?2004l[?2004h> from pgmpy.estimators import MaximumLikelihoodEstimator
[?2004l[?2004h> from pgmpy.sampling import BayesianModelSampling
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Define learned DAG edges (parent, child)
[?2004l[?2004h> edges = [
[?2004l[?2004h>     ('U', 'D'),
[?2004l[?2004h>     ('U', 'M'),
[?2004l[?2004h>     ('U', 'R'),
[?2004l[?2004h>     ('U', 'Y'),
[?2004l[?2004h>     ('Y', 'D'),
[?2004l[?2004h>     ('R', 'M')
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> # Save learned_dag.csv in format: to,from (child, parent)
[?2004l[?2004h> learned_rows = []
[?2004l[?2004h> for parent, child in edges:
[?2004l[?2004h>     learned_rows.append(f"{child},{parent}")
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/learned_dag.csv', 'w') as f:
[?2004l[?2004h>     f.write("to,from\n")
[?2004l[?2004h>     f.write("\n".join(learned_rows) + "\n")
[?2004l[?2004h> print("Saved /app/learned_dag.csv")
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Learn Bayesian Network from data using the recovered DAG
[?2004l[?2004h> df = pd.read_csv('/app/bn_sample_10k.csv')
[?2004l[?2004h> model = BayesianNetwork(edges)
[?2004l[?2004h> model.fit(df, estimator=MaximumLikelihoodEstimator)
[?2004l[?2004h> print(
[?2004l[?2004h>     "Fitted model nodes:",
[?2004l[?2004h>     model.nodes(),
[?2004l[?2004h>     "\nFitted model edges:",
[?2004l[?2004h>     model.edges(),
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Perform causal intervention on Y, setting its value to 0.0 (or extremely small variance)
[?2004l[?2004h> # In pgmpy, intervention on continuous BN: we can modify the CPD of Y or use do-intervention / BayesianModelSampling with evidence or fix CPD.
[?2004l[?2004h> # For a Linear Gaussian CPD in pgmpy, the CPD of Y has parents (U). If we intervene on Y = 0.0, Y becomes a constant or has mean 0 and tiny variance (e.g., 10ee-9).
[?2004l[?2004h> # Let's inspect CPD of Y:
[?2004l[?2004h> print("CPD of Y before intervention:", model.get_cpds('Y'))
[?2004l[?2004h> 
[?2004l[?2004h> # Intervene on Y: set Y CPD to NormalDistribution(0, 10e-9) with no parents.
[?2004l[?2004h> from pgmpy.factors.continuous import LinearGaussianCPD
[?2004l[?2004h> # Y has parent U. If we set do(Y = 0.0), Y is disconnected from its parents and its distribution is N(0, 10e-9).
[?2004l[?2004h> # Wait, what are the parents of Y in the intervened DAG?
[?2004l[?2004h> # When performing a causal intervention do(Y = 0.0), incoming edges to Y are removed.
[?2004l[?2004h> intervened_edges = [e for e in edges if e[1] != 'Y']
[?2004l[?2004h> print("Intervened DAG edges:", intervened_edges)
[?2004l[?2004h> 
[?2004l[?2004h> # Save intervened_dag.csv in format: to,from
[?2004l[?2004h> intervened_rows = []
[?2004l[?2004h> for parent, child in intervened_edges:
[?2004l[?2004h>     intervened_rows.append(f"{child},{parent}")
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/intervened_dag.csv', 'w') as f:
[?2004l[?2004h>     f.write("to,from\n")
[?2004l[?2004h>     f.write("\n".join(intervened_rows) + "\n")
[?2004l[?2004h> print("Saved /app/intervened_dag.csv")
[?2004l[?2004h> 
[?2004l[?2004h> # Build intervened model
[?2004l[?2004h> intervened_model = BayesianNetwork(intervened_edges)
[?2004l[?2004h> # Copy CPDs for all nodes except Y, and set Y CPD to N(0, 10e-9)
[?2004l[?2004h> for cpd in model.get_cpds():
[?2004l[?2004h>     if cpd.variable != 'Y':
[?2004l[?2004h>         intervened_model.add_cpds(cpd.copy())
[?2004l[?2004h> 
[?2004l[?2004h> # For Y, Y has no parents in intervened DAG. LinearGaussianCPD for Y with 0 parents:
[?2004l[?2004h> # LinearGaussianCPD(variable, beta, variance, evidence=None)
[?2004l[?2004h> # beta = [mean] for intercept, or just mean value 0.0, variance 10e-9
[?2004l[?2004h> from pgmpy.factors.continuous import LinearGaussianCPD
[?2004l[?2004h> y_cpd = LinearGaussianCPD('Y', [0.0], 10e-9, evidence=[])
[?2004l[?2004h> intervened_model.add_cpds(y_cpd)
[?2004l[?2004h> intervened_model.check_model()
[?2004l[?2004h> print("Intervened model check passed!")
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Sample 10k points from intervened BN and save to /app/final_bn_sample.csv
[?2004l[?2004h> sampler = BayesianModelSampling(intervened_model)
[?2004l[?2004h> samples = sampler.sample(size=10000)
[?2004l[?2004h> # Ensure column names match original data order: ['U', 'Y', 'R', 'D', 'M']
[?2004l[?2004h> samples = samples[['U', 'Y', 'R', 'D', 'M']]
[?2004l[?2004h> samples.to_csv('/app/final_bn_sample.csv', index=False)
[?2004l[?2004h> print("Saved /app/final_bn_sample.csv with shape:", samples.shape)
[?2004l[?2004h> print(samples.head())
