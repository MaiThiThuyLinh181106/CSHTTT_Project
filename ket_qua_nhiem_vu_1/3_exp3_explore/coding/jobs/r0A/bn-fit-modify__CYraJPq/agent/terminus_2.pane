import pandas as pd
import numpy as np
from pgmpy.estimators import BICGauss
from pgmpy.base import DAG

df = pd.read_csv('/app/bn_sample_10k.csv')
nodes = sorted(list(df.columns))
bic_scorer = BICGauss(df)

base_edges = [('U', 'D'), ('U', 'M'), ('U', 'R'), ('U', 'Y')]

for d_y in [('D', 'Y'), ('Y', 'D')]:
    for m_r in [('M', 'R'), ('R', 'M')]:
        edges = base_edges + [d_y, m_r]
        d = DAG()
        d.add_nodes_from(nodes)
        d.add_edges_from(edges)
        if d.is_directed_acyclic_graph():
            s = bic_scorer.score(d)
            print(f"{edges} -> score: {s}")
