cat << 'EOF' > /app/find_best_6edge_dag.py
import pandas as pd
import numpy as np
import networkx as nx
from pgmpy.estimators import BICGauss
from pgmpy.base import DAG
from itertools import combinations

df = pd.read_csv('/app/bn_sample_10k.csv')
nodes = sorted(list(df.columns))
bic_scorer = BICGauss(df)

all_possible_edges = [(i, j) for i in nodes for j in nodes if i != j and j != 'U']
print("Total possible edges:", len(all_possible_edges))

best_score = -float('inf')
best_edges = None

for idx, edge_subset in enumerate(combinations(all_possible_edges, 6)):
    if idx % 500 == 0:
        print(f"Checked {idx} combinations...")
    d = DAG()
    d.add_nodes_from(nodes)
    d.add_edges_from(edge_subset)
    if not nx.is_directed_acyclic_graph(d):
        continue
    
    try:
        score = bic_scorer.score(d)
        if score > best_score:
            best_score = score
            best_edges = edge_subset
    except Exception:
        continue

print("Best score:", best_score)
print("Best edges:", best_edges)
