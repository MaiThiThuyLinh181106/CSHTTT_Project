Sending keys: ['cat << \'EOF\' > /app/check_orientations.py\nimport pandas as pd\nimport numpy as np\nimport networkx as nx\nfrom pgmpy.estimators import BICGauss\nfrom pgmpy.base import DAG\n\ndf = pd.read_csv(\'/app/bn_sample_10k.csv\')\nnodes = sorted(list(df.columns))\nbic_scorer = BICGauss(df)\n\nbase_edges = [(\'U\', \'D\'), (\'U\', \'M\'), (\'U\', \'R\'), (\'U\', \'Y\')]\n\nfor d_y in [(\'D\', \'Y\'), (\'Y\', \'D\')]:\n    for m_r in [(\'M\', \'R\'), (\'R\', \'M\')]:\n        edges = base_edges + [d_y, m_r]\n        d = DAG()\n        d.add_nodes_from(nodes)\n        d.add_edges_from(edges)\n        if nx.is_directed_acyclic_graph(d):\n            s = bic_scorer.score(d)\n            print(f"{edges} -> score: {s}")\nEOF\n/app/venv/bin/python /app/check_orientations.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
