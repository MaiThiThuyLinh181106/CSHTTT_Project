Sending keys: ['cat << \'EOF\' > /app/complete_task.py\nimport pandas as pd\nimport numpy as np\nfrom pgmpy.models import BayesianNetwork\nfrom pgmpy.estimators import MaximumLikelihoodEstimator\nfrom pgmpy.sampling import BayesianModelSampling\n\n# 1. Define learned DAG edges (parent, child)\nedges = [\n    (\'U\', \'D\'),\n    (\'U\', \'M\'),\n    (\'U\', \'R\'),\n    (\'U\', \'Y\'),\n    (\'Y\', \'D\'),\n    (\'R\', \'M\')\n]\n\n# Save learned_dag.csv in format: to,from (child, parent)\nlearned_rows = []\nfor parent, child in edges:\n    learned_rows.append(f"{child},{parent}")\n\nwith open(\'/app/learned_dag.csv\', \'w\') as f:\n    f.write("to,from\\n")\n    f.write("\\n".join(learned_rows) + "\\n")\nprint("Saved /app/learned_dag.csv")\n\n# 2. Learn Bayesian Network from data using the recovered DAG\ndf = pd.read_csv(\'/app/bn_sample_10k.csv\')\nmodel = BayesianNetwork(edges)\nmodel.fit(df, estimator=MaximumLikelihoodEstimator)\nprint(\n    "Fitted model nodes:",\n    model.nodes(),\n    "\\nFitted model edges:",\n    model.edges(),\n)\n\n# 3. Perform causal intervention on Y, setting its value to 0.0 (or extremely small variance)\n# In pgmpy, intervention on continuous BN: we can modify the CPD of Y or use do-intervention / BayesianModelSampling with evidence or fix CPD.\n# For a Linear Gaussian CPD in pgmpy, the CPD of Y has parents (U). If we intervene on Y = 0.0, Y becomes a constant or has mean 0 and tiny variance (e.g., 10e-9).\n# Let\'s inspect CPD of Y:\nprint("CPD of Y before intervention:", model.get_cpds(\'Y\'))\n\n# Intervene on Y: set Y CPD to NormalDistribution(0, 10e-9) with no parents.\nfrom pgmpy.factors.continuous import LinearGaussianCPD\n# Y has parent U. If we set do(Y = 0.0), Y is disconnected from its parents and its distribution is N(0, 10e-9).\n# Wait, what are the parents of Y in the intervened DAG?\n# When performing a causal intervention do(Y = 0.0), incoming edges to Y are removed.\nintervened_edges = [e for e in edges if e[1] != \'Y\']\nprint("Intervened DAG edges:", intervened_edges)\n\n# Save intervened_dag.csv in format: to,from\nintervened_rows = []\nfor parent, child in intervened_edges:\n    intervened_rows.append(f"{child},{parent}")\n\nwith open(\'/app/intervened_dag.csv\', \'w\') as f:\n    f.write("to,from\\n")\n    f.write("\\n".join(intervened_rows) + "\\n")\nprint("Saved /app/intervened_dag.csv")\n\n# Build intervened model\nintervened_model = BayesianNetwork(intervened_edges)\n# Copy CPDs for all nodes except Y, and set Y CPD to N(0, 10e-9)\nfor cpd in model.get_cpds():\n    if cpd.variable != \'Y\':\n        intervened_model.add_cpds(cpd.copy())\n\n# For Y, Y has no parents in intervened DAG. LinearGaussianCPD for Y with 0 parents:\n# LinearGaussianCPD(variable, beta, variance, evidence=None)\n# beta = [mean] for intercept, or just mean value 0.0, variance 10e-9\nfrom pgmpy.factors.continuous import LinearGaussianCPD\ny_cpd = LinearGaussianCPD(\'Y\', [0.0], 10e-9, evidence=[])\nintervened_model.add_cpds(y_cpd)\nintervened_model.check_model()\nprint("Intervened model check passed!")\n\n# 4. Sample 10k points from intervened BN and save to /app/final_bn_sample.csv\nsampler = BayesianModelSampling(intervened_model)\nsamples = sampler.sample(size=10000)\n# Ensure column names match original data order: [\'U\', \'Y\', \'R\', \'D\', \'M\']\nsamples = samples[[\'U\', \'Y\', \'R\', \'D\', \'M\']]\nsamples.to_csv(\'/app/final_bn_sample.csv\', index=False)\nprint("Saved /app/final_bn_sample.csv with shape:", samples.shape)\nprint(samples.head())\n\nEOF\n/app/venv/bin/python /app/complete_task.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
