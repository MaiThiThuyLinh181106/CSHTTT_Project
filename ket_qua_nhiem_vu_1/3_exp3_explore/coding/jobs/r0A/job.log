Sending keys: ['cat << \'EOF\' > /app/ars.R\n# Adaptive Rejection Sampler (ARS) based on Gilks & Wild (1992)\n\ncompute_z <- function(x, h_val, dh_val) {\n  k <- length(x)\n  z <- numeric(k + 1)\n  z[1] <- -Inf\n  z[k + 1] <- Inf\n  if (k > 1) {\n    for (j in 1:(k - 1)) {\n      xj <- x[j]\n      xjp1 <- x[j + 1]\n      hj <- h_val[j]\n      hjp1 <- h_val[j + 1]\n      dhj <- dh_val[j]\n      dhjp1 <- dh_val[j + 1]\n      \n      denom <- dhj - dhjp1\n      if (abs(denom) < 1e-12) {\n        z[j + 1] <- (xj + xjp1) / 2\n      } else {\n        z[j + 1] <- (hjp1 - hj - xjp1 * dhjp1 + xj * dhj) / denom\n      }\n    }\n  }\n  return(z)\n}\n\nars <- function(density_function, domain, n = 1000, derivative_function = NULL, initial_points = NULL) {\n  if (!is.function(density_function)) {\n    stop("density_function must be a function.")\n  }\n  if (!is.numeric(domain) || length(domain) != 2 || domain[1] >= domain[2]) {\n    stop("domain must be a numeric vector of length 2 with domain[1] < domain[2].")\n  }\n  if (!is.numeric(n) || length(n) != 1 || n <= 0 || n != round(n)) {\n    stop("n must be a positive integer sample count.")\n  }\n\n  log_density <- function(x) {\n    res <- density_function(x)\n    if (any(is.na(res) | res <= 0)) {\n      return(rep(-Inf, length(x)))\n    }\n    return(log(res))\n  }\n\n  d_log_density <- function(x) {\n    if (!is.null(derivative_function)) {\n      return(derivative_function(x))\n    }\n    h <- 1e-6\n    (log_density(x + h) - log_density(x - h)) / (2 * h)\n  }\n\n  if (is.null(initial_points)) {\n    lower <- max(domain[1], -10)\n    upper <- min(domain[2], 10)\n    if (lower >= upper) {\n      lower <- domain[1]\n      upper <- domain[2]\n    }\n    pts <- seq(lower, upper, length.out = 3)\n    pts <- pts[pts > domain[1] & pts < domain[2]]\n    if (length(pts) < 2) {\n      pts <- c(domain[1] + 0.1 * (domain[2] - domain[1]),\n               domain[1] + 0.5 * (domain[2] - domain[1]),\n               domain[1] + 0.9 * (domain[2] - domain[1]))\n    }\n    initial_points <- pts\n  }\n\n  x <- sort(unique(initial_points))\n  x <- x[x > domain[1] & x < domain[2]]\n  if (length(x) < 2) {\n    stop("Initialization failed: need at least 2 valid points within domain where density > 0.")\n  }\n\n  h_val <- sapply(x, log_density)\n  dh_val <- sapply(x, d_log_density)\n\n  if (any(!is.finite(h_val) | !is.finite(dh_val))) {\n    stop("Initial points yield non-finite log density or derivative.")\n  }\n\n  samples <- numeric(n)\n  accepted <- 0\n\n  while (accepted < n) {\n    k <- length(x)\n    z <- compute_z(x, h_val, dh_val)\n    z[1] <- max(z[1], domain[1])\n    z[k + 1] <- min(z[k + 1], domain[2])\n\n    log_weights <- numeric(k)\n    for (j in 1:k) {\n      zj <- z[j]\n      zjp1 <- z[j + 1]\n      if (zj >= zjp1) {\n        log_weights[j] <- -Inf\n        next\n      }\n      dh <- dh_val[j]\n      hj <- h_val[j]\n      xj <- x[j]\n      \n      if (abs(dh) < 1e-12) {\n        log_weights[j] <- hj + log(zjp1 - zj)\n      } else {\n        term1 <- dh * zjp1\n        term2 <- dh * zj\n        max_t <- max(term1, term2)\n        lw <- hj - xj * dh + max_t + log(abs(exp(term1 - max_t) - exp(term2 - max_t))) - log(abs(dh))\n        log_weights[j] <- lw\n      }\n    }\n\n    max_lw <- max(log_weights)\n    if (!is.finite(max_lw) || max_lw == -Inf) {\n      stop("Sampling failed: invalid upper envelope weights.")\n    }\n    weights <- exp(log_weights - max_lw)\n    total_w <- sum(weights)\n    probs <- weights / total_w\n\n    j <- sample.int(k, size = 1, prob = probs)\n\n    zj <- z[j]\n    zjp1 <- z[j + 1]\n    dh <- dh_val[j]\n    \n    if (zj >= zjp1) {\n      next\n    }\n\n    u <- runif(1)\n    if (abs(dh) < 1e-12) {\n      x_star <- zj + u * (zjp1 - zj)\n    } else {\n      max_t <- max(dh * zjp1, dh * zj)\n      x_star <- (max_t + log(u * exp(dh * zjp1 - max_t) + (1 - u) * exp(dh * zj - max_t))) / dh\n    }\n\n    if (x_star < domain[1] || x_star > domain[2]) {\n      next\n    }\n\n    h_star <- log_density(x_star)\n    if (!is.finite(h_star)) {\n      next\n    }\n\n    if (x_star >= x[1] && x_star <= x[k]) {\n      idx <- findInterval(x_star, x)\n      idx <- max(1, min(idx, k - 1))\n      x_l <- x[idx]\n      x_r <- x[idx + 1]\n      h_l <- h_val[idx]\n      h_r <- h_val[idx + 1]\n      s_star <- h_l + (x_star - x_l) * (h_r - h_l) / (x_r - x_l)\n    } else {\n      s_star <- -Inf\n    }\n\n    u_star <- runif(1)\n    u_val_star <- h_val[j] + (x_star - x[j]) * dh_val[j]\n\n    if (log(u_star) + s_star <= u_val_star && log(u_star) + h_star >= u_val_star) {\n      if (s_star > u_val_star + 1e-7) {\n        stop("Non-log-concave density detected: lower envelope exceeds upper envelope.")\n      }\n    }\n\n    if (log(u_star) + u_val_star <= s_star) {\n      accepted <- accepted + 1\n      samples[accepted] <- x_star\n    } else {\n      if (log(u_star) + u_val_star <= h_star) {\n        accepted <- accepted + 1\n        samples[accepted] <- x_star\n      }\n      \n      dh_star <- d_log_density(x_star)\n      insert_pos <- findInterval(x_star, x) + 1\n      x <- append(x, x_star, after = insert_pos - 1)\n      h_val <- append(h_val, h_star, after = insert_pos - 1)\n      dh_val <- append(dh_val, dh_star, after = insert_pos - 1)\n\n      for (i in 1:(length(x) - 1)) {\n        if (dh_val[i] < dh_val[i + 1] - 1e-6) {\n          stop("Non-log-concave density detected: derivative condition violated.")\n        }\n      }\n    }\n  }\n\n  return(samples)\n}\n\ntest <- function() {\n  cat("Running Adaptive Rejection Sampling (ARS) tests...\\n\\n")\n  all_passed <- TRUE\n\n  dnorm_unnorm <- function(x) exp(-0.5 * x^2)\n  set.seed(42)\n  n_samples <- 2000\n  \n  tryCatch({\n    samples_norm <- ars(dnorm_unnorm, domain = c(-5, 5), n = n_samples)\n    m <- mean(samples_norm)\n    s <- sd(samples_norm)\n    \n    mean_pass <- abs(m - 0) < 0.1\n    sd_pass <- abs(s - 1) < 0.1\n    \n    if (mean_pass && sd_pass && length(samples_norm) == n_samples) {\n      cat(sprintf("NORMAL_DISTRIBUTION_TEST: PASS (mean = %.4f, sd = %.4f)\\n", m, s))\n      writeLines(as.character(samples_norm), "/app/normal_samples.txt")\n    } else {\n      cat(sprintf("NORMAL_DISTRIBUTION_TEST: FAIL (mean = %.4f, sd = %.4f)\\n", m, s))\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf("NORMAL_DISTRIBUTION_TEST: FAIL (Error: %s)\\n", e$message))\n    all_passed <- FALSE\n  })\n\n  dexp_unnorm <- function(x) ifelse(x >= 0, exp(-x), 0)\n  tryCatch({\n    samples_exp <- ars(dexp_unnorm, domain = c(0, 20), n = n_samples)\n    m <- mean(samples_exp)\n    s <- sd(samples_exp)\n    \n    mean_pass <- abs(m - 1) < 0.1\n    sd_pass <- abs(s - 1) < 0.1\n    \n    if (mean_pass && sd_pass && length(samples_exp) == n_samples) {\n      cat(sprintf("EXPONENTIAL_DISTRIBUTION_TEST: PASS (mean = %.4f, sd = %.4f)\\n", m, s))\n      writeLines(as.character(samples_exp), "/app/exponential_samples.txt")\n    } else {\n      cat(sprintf("EXPONENTIAL_DISTRIBUTION_TEST: FAIL (mean = %.4f, sd = %.4f)\\n", m, s))\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf("EXPONENTIAL_DISTRIBUTION_TEST: FAIL (Error: %s)\\n", e$message))\n    all_passed <- FALSE\n  })\n\n  tryCatch({\n    ars(function(x) -1, domain = c(-1, 1), n = -10)\n    cat("INPUT_VALIDATION_TEST: FAIL (Accepted negative sample count)\\n")\n    all_passed <- FALSE\n  }, error = function(e) {\n    cat("INPUT_VALIDATION_TEST: PASS (Correctly rejected invalid input)\\n")\n  })\n\n  d_nonlogconcave <- function(x) exp(x^2)\n  tryCatch({\n    ars(d_nonlogconcave, domain = c(-2, 2), n = 100)\n    cat("NON_LOG_CONCAVE_TEST: FAIL (Accepted non-log-concave density)\\n")\n    all_passed <- FALSE\n  }, error = function(e) {\n    cat(sprintf("NON_LOG_CONCAVE_TEST: PASS (Correctly caught: %s)\\n", e$message))\n  })\n\n  if (all_passed) {\n    cat("\\nALL TESTS PASSED SUCCESSFULLY.\\n")\n  } else {\n    cat(\n      "\\nSOME TESTS FAILED.\\n")\n  }\n}\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
