Sending keys: ['cat << \'EOF\' > /app/run_all.py\nimport pandas as pd\nimport numpy as np\nfrom pgmpy.models import LinearGaussianBayesianNetwork\nfrom pgmpy.parameter_estimator import LinearGaussianMLE\n\n# Learned DAG edges (parent, child)\nedges = [\n    (\'U\', \'D\'),\n    (\'U\', \'M\'),\n    (\'U\', \'R\'),\n    (\'U\', \'Y\'),\n    (\'Y\', \'D\'),\n    (\'R\', \'M\')\n]\n\n# 1. Save learned_dag.csv (format: to,from i.e. child,parent)\nlearned_rows = []\nfor parent, child in edges:\n    learned_rows.append(f"{child},{parent}")\n\nwith open(\'/app/learned_dag.csv\', \'w\') as f:\n    f.write("to,from\\n")\n    f.write("\\n".join(learned_rows) + "\\n")\nprint("Saved /app/learned_dag.csv")\n\n# 2. Learn BN\ndf = pd.read_csv(\'/app/bn_sample_10k.csv\')\nmodel = LinearGaussianBayesianNetwork(edges)\nmodel.fit(df, estimator=LinearGaussianMLE())\n\n# 3. Intervened DAG edges (remove incoming edges to Y)\nintervened_edges = [e for e in edges if e[1] != \'Y\']\n\n# 4. Save intervened_dag.csv\nintervened_rows = []\nfor parent, child in intervened_edges:\n    intervened_rows.append(f"{child},{parent}")\n\nwith open(\'/app/intervened_dag.csv\', \'w\') as f:\n    f.write("to,from\\n")\n    f.write("\\n".join(intervened_rows) + "\\n")\nprint("Saved /app/intervened_dag.csv")\n\n# 5. Sample 10k points from intervened BN\nsamples = model.simulate(n_samples=10000, do={\'Y\': 0.0})\nsamples = samples[[\'U\', \'Y\', \'R\', \'D\', \'M\']]\nsamples.to_csv(\'/app/final_bn_sample.csv\', index=False)\nprint("Saved /app/final_bn_sample.csv")\n\nEOF\n/app/venv/bin/python /app/run_all.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
