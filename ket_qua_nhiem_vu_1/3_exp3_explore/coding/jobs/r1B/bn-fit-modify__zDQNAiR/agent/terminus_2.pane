import pandas as pd
import numpy as np
from pgmpy.estimators import HillClimbSearch, BicScore
from pgmpy.models import BayesianNetwork
from pgmpy.estimators import MaximumLikelihoodEstimator

df = pd.read_csv('/app/bn_sample_10k.csv')
print("Data columns:", df.columns.tolist())

# Let's use HillClimbSearch with BicScore
# Constraint: U has no parents. We can specify blacklists or whitelist if needed, or filter learned edges.
# Let's run HillClimbSearch.
sc = HillClimbSearch(df)
bic = BicScore(df)

# To enforce U has no parents: blacklist any edge TO 'U'
variables = df.columns.tolist()
black_list = [(v, 'U') for v in variables if v != 'U']

best_model = sc.estimate(scoring_method=bic, black_list=black_list, max_indegree=3)
edges = list(best_model.edges())
print("Learned edges (to, from):", edges)

# Note: pgmpy edges are (from, to). The output format requested is: to,from
# Let's check if there are 6 edges. If not 6 edges, or if we need to adjust, let's see.
EOF
