cat << 'EOF' > /app/test_mle.py
import pandas as pd
from pgmpy.models import BayesianNetwork
from pgmpy.estimators import MaximumLikelihoodEstimator

df = pd.read_csv('/app/bn_sample_10k.csv')
# Discretize continuous data into bins for discrete Bayesian network estimation
df_disc = df.apply(lambda x: pd.qcut(x, 3, labels=[0, 1, 2]))
edges = [('U', 'D'), ('U', 'M'), ('U', 'R'), ('U', 'Y'), ('R', 'D'), ('Y', 'M')]
bn = BayesianNetwork(edges)
bn.fit(df_disc, estimator=MaximumLikelihoodEstimator)
print("Fitted successfully!")
print(bn.get_cpds('D'))
EOF
