import pandas as pd
from pgmpy.models import BayesianNetwork
from pgmpy.estimators import LinearGaussianMLE

df = pd.read_csv('/app/bn_sample_10k.csv')
edges = [('U', 'D'), ('U', 'M'), ('U', 'R'), ('U', 'Y'), ('R', 'D'), ('Y', 'M')]
bn = BayesianNetwork(edges)
est = LinearGaussianMLE(bn, df)
params = est.get_parameters()
print(params)
EOF
