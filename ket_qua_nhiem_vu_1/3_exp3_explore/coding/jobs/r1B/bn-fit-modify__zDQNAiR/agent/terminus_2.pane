cat << 'EOF' > /app/pipeline.py
import pandas as pd
import numpy as np
from pgmpy.models import BayesianNetwork
from pgmpy.estimators import HillClimbSearch, BIC, MaximumLikelihoodEstimator
from pgmpy.factors.discrete import TabularCPD

df = pd.read_csv('/app/bn_sample_10k.csv')
cols = df.columns.tolist()

df_disc = pd.DataFrame()
bins_dict = {}
for col in cols:
    df_disc[col], bins = pd.qcut(df[col], q=3, labels=[0, 1, 2], retbins=True, duplicates='drop')
    df_disc[col] = df_disc[col].astype(int)
    bins_dict[col] = bins

sc = HillClimbSearch(df_disc)
bic = BIC(df_disc)
best_model = sc.estimate(scoring_method=bic, show_progress=False)
edges = list(best_model.edges())
edges = [e for e in edges if e[1] != 'U']

learned_list = [{'to': to, 'from': frm} for frm, to in edges]
pd.DataFrame(learned_list).to_csv('/app/learned_dag.csv', index=False)
print("Saved /app/learned_dag.csv")

intervened_edges = [e for e in edges if e[1] != 'Y']
intervened_list = [{'to': to, 'from': frm} for frm, to in intervened_edges]
pd.DataFrame(intervened_list).to_csv('/app/intervened_dag.csv', index=False)
print("Saved /app/intervened_dag.csv")

bn_int = BayesianNetwork(intervened_edges)
bn_int.fit(df_disc, estimator=MaximumLikelihoodEstimator)

cpd_y = TabularCPD(variable='Y', variable_card=3, values=[[1.0], [0.0], [0.0]])
bn_int.add_cpds(cpd_y)

samples_disc = bn_int.simulate(n_samples=10000)

samples_cont = pd.DataFrame()
for col in cols:
    bins = bins_dict[col]
    midpoints = [(bins[i] + bins[i+1])/2 for i in range(len(bins)-1)]
    col_states = samples_disc[col].values
    mapped = np.array([midpoints[s] for s in col_states])
    noise = np.random.normal(0, np.sqrt(10e-9), size=len(mapped))
    samples_cont[col] = mapped + noise

samples_cont = samples_cont[cols]
samples_cont.to_csv('/app/final_bn_sample.csv', index=False)
print("Saved /app/final_bn_sample.csv with shape:", samples_cont.shape)
