cat << 'EOF' > /app/find_dag.py
import pandas as pd
import numpy as np
from pgmpy.models import BayesianNetwork
from pgmpy.estimators import LinearGaussianMLE
from itertools import combinations

df = pd.read_csv('/app/bn_sample_10k.csv')
vars = sorted(df.columns.tolist())
non_u = [v for v in vars if v != 'U']
all_pairs = list(combinations(non_u, 2))

best_score = -np.inf
best_edges = None

for p1, p2 in combinations(all_pairs, 2):
    edges = [('U', v) for v in non_u]
    for x, y in [p1, p2]:
        if x < y:
            edges.append((y, x))
        else:
            edges.append((x, y))
    try:
        bn = BayesianNetwork(edges)
        est = LinearGaussianMLE(bn, df)
        params = est.get_parameters()
        ll = 0
        for node, cpd in params.items():
            ll += cpd.log_likelihood(df)
        score = ll
        if score > best_score:
            best_score = score
            best_edges = edges
    except Exception as e:
        continue

print("Best score:", best_score)
print("Best edges (from, to):", best_edges)
EOF
/app/venv/bin/python /app/find_dag.py
