import pandas as pd
import numpy as np
from pgmpy.estimators import HillClimbSearch, AIC, BDeu

df = pd.read_csv('/app/bn_sample_10k.csv')
print(df.corr())

for name, score in [('AIC', AIC(df)), ('BDeu', BDeu(df))]:
    sc = HillClimbSearch(df)
    model = sc.estimate(scoring_method=score, show_progress=False)
    print(name, list(model.edges()))
