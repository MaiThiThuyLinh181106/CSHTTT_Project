import pandas as pd
import numpy as np
from pgmpy.estimators import HillClimbSearch, BICGauss

df = pd.read_csv('/app/bn_sample_10k.csv')
sc = HillClimbSearch(df)
bic_g = BICGauss(df)
best_model = sc.estimate(scoring_method=bic_g, show_progress=False)
edges = list(best_model.edges())
print("Learned edges (from, to):", edges)
print("Number of edges:", len(edges))
EOF
