Sending keys: ['cat << \'EOF\' > /app/ars.R\ncompute_log_density <- function(density_function, x) {\n  val <- density_function(x)\n  log_val <- log(val)\n  return(log_val)\n}\n\nnum_deriv <- function(density_function, x, h = 1e-5) {\n  (compute_log_density(density_function, x + h) - compute_log_density(density_function, x - h)) / (2 * h)\n}\n\nars_init <- function(density_function, domain, n_init = 4) {\n  lower <- domain[1]\n  upper <- domain[2]\n  if (is.finite(lower) && is.finite(upper)) {\n    x <- seq(lower + 1e-4, upper - 1e-4, length.out = n_init)\n  } else if (is.finite(lower)) {\n    x <- lower + seq(0.1, 3.0, length.out = n_init)\n  } else if (is.finite(upper)) {\n    x <- upper - seq(3.0, 0.1, length.out = n_init)\n  } else {\n    x <- seq(-1.5, 1.5, length.out = n_init)\n  }\n  hx <- compute_log_density(density_function, x)\n  dhx <- num_deriv(density_function, x)\n  ord <- order(x)\n  list(x = x[ord], hx = hx[ord], dhx = dhx[ord], lower = lower, upper = upper)\n}\n\nupdate_hulls <- function(state, x_new, density_function) {\n  hx_new <- compute_log_density(density_function, x_new)\n  dhx_new <- num_deriv(density_function, x_new)\n  x <- c(state$x, x_new)\n  hx <- c(state$hx, hx_new)\n  dhx <- c(state$dhx, dhx_new)\n  ord <- order(x)\n  x <- x[ord]\n  hx <- hx[ord]\n  dhx <- dhx[ord]\n  k <- length(x)\n  for (i in 1:(k - 1)) {\n    if (dhx[i] < dhx[i+1] - 1e-7) {\n      stop("Non-log-concave density detected.")\n    }\n  }\n  state$x <- x\n  state$hx <- hx\n  state$dhx <- dhx\n  return(state)\n}\n\nsample_upper_hull <- function(state) {\n  x <- state$x\n  hx <- state$hx\n  dhx <- state$dhx\n  k <- length(x)\n  z <- numeric(k + 1)\n  z[1] <- state$lower\n  z[k+1] <- state$upper\n  for (i in 1:(k - 1)) {\n    denom <- dhx[i] - dhx[i+1]\n    if (abs(denom) < 1e-12) {\n      z[i+1] <- (x[i] + x[i+1]) / 2\n    } else {\n      z[i+1] <- (hx[i+1] - hx[i] - x[i+1]*dhx[i+1] + x[i]*dhx[i]) / denom\n    }\n  }\n  z[1] <- max(z[1], state$lower)\n  z[k+1] <- min(z[k+1], state$upper)\n  for (i in 2:k) {\n    if (z[i] <= x[i-1]) z[i] <- x[i-1] + 1e-6\n    if (z[i] >= x[i]) z[i] <- x[i] - 1e-6\n  }\n  log_weights <- numeric(k)\n  for (i in 1:k) {\n    d <- dhx[i]\n    c_val <- hx[i] - d * x[i]\n    if (abs(d) < 1e-10) {\n      log_weights[i] <- c_val + log(z[i+1] - z[i])\n    } else {\n      term1 <- d * z[i+1]\n      term2 <- d * z[i]\n      max_t <- max(term1, term2)\n      log_diff <- max_t + log(abs(exp(term1 - max_t) - exp(term2 - max_t))) - log(abs(d))\n      log_weights[i] <- c_val + log_diff\n    }\n  }\n  max_lw <- max(log_weights)\n  weights <- exp(log_weights - max_lw)\n  probs <- weights / sum(weights)\n  i <- sample(k, 1, prob = probs)\n  d <- dhx[i]\n  z_left <- z[i]\n  z_right <- z[i+1]\n  u_uni <- runif(1)\n  if (abs(d) < 1e-10) {\n    x_star <- z_left + u_uni * (z_right - z_left)\n  } else {\n    x_star <- z_left + log(1.0 + u_uni * (exp(d * (z_right - z_left)) - 1.0)) / d\n  }\n  list(x_star = x_star, z = z)\n}\n\neval_lower_hull <- function(state, x_star) {\n  x <- state$x\n  hx <- state$hx\n  k <- length(x)\n  if (x_star < x[1] || x_star > x[k]) return(-Inf)\n  idx <- max(which(x <= x_star))\n  if (idx == k) idx <- k - 1\n  hx[idx] + (hx[idx+1] - hx[idx]) * (x_star - x[idx]) / (x[idx+1] - x[idx])\n}\n\nars <- function(density_function, domain, n = 1000) {\n  if (!is.function(density_function)) stop("density_function must be a function.")\n  if (!is.numeric(domain) || length(domain) != 2 || domain[1] >= domain[2]) stop("Invalid domain.")\n  if (!is.numeric(n) || length(n) != 1 || n <= 0 || n != round(n)) stop("Invalid n.")\n  state <- ars_init(density_function, domain)\n  samples <- numeric(n)\n  accepted <- 0\n  while (accepted < n) {\n    res <- sample_upper_hull(state)\n    x_star <- res$x_star\n    x <- state$x\n    hx <- state$hx\n    dhx <- state$dhx\n    idx <- max(which(res$z <= x_star))\n    if (idx > length(dhx)) idx <- length(dhx)\n    if (idx < 1) idx <- 1\n    u_star <- hx[idx] + dhx[idx] * (x_star - x[idx])\n    w <- runif(1)\n    l_star <- eval_lower_hull(state, x_star)\n    if (log(w) <= l_star - u_star) {\n      accepted <- accepted + 1\n      samples[accepted] <- x_star\n      next\n    }\n    h_star <- compute_log_density(density_function, x_star)\n    if (!is.finite(h_star)) {\n      state <- update_hulls(state, x_star, density_function)\n      next\n    }\n    if (log(w) <= h_star - u_star) {\n      accepted <- accepted + 1\n      samples[accepted] <- x_star\n    }\n    state <- update_hulls(state, x_star, density_function)\n  }\n  return(samples)\n}\n\ntest <- function() {\n  cat("Running Adaptive Rejection Sampling Tests...\\n")\n  all_passed <- TRUE\n  tryCatch({\n    set.seed(42)\n    samples_norm <- ars(function(x) dnorm(x), domain = c(-4, 4), n = 500)\n    m <- mean(samples_norm)\n    s <- sd(samples_norm)\n    writeLines(as.character(samples_norm), "/app/normal_samples.txt")\n    if (abs(m) < 0.3 && abs(s - 1) < 0.3) {\n      cat(sprintf("NORMAL_TEST: PASS (mean = %.4f, sd = %.4f)\\n", m, s))\n    } else {\n      cat(sprintf("NORMAL_TEST: FAIL (mean = %.4f, sd = %.4f)\\n", m, s))\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf("NORMAL_TEST: FAIL (Error: %s)\\n", e$message))\n    all_passed <- FALSE\n  })\n  \n  tryCatch({\n    set.seed(42)\n    samples_exp <- ars(function(x) dexp(x), domain = c(0.01, 10), n = 500)\n    m <- mean(samples_exp)\n    s <- sd(samples_exp)\n    writeLines(as.character(samples_exp), "/app/exponential_samples.txt")\n    if (abs(m - 1) < 0.3 && abs(s - 1) < 0.3) {\n      cat(sprintf("EXPONENTIAL_TEST: PASS (mean = %.4f, sd = %.4f)\\n", m, s))\n    } else {\n      cat(sprintf("EXPONENTIAL_TEST: FAIL (mean = %.4f, sd = %.4f)\\n", m, s))\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf("EXPONENTIAL_TEST: FAIL (Error: %s)\\n", e$message))\n    all_passed <- FALSE\n  })\n  \n  tryCatch({\n    ars(function(x) dnorm(x), domain = c(-3, 3), n = -10)\n    cat("INPUT_VALIDATION_TEST: FAIL\\n")\n    all_passed <- FALSE\n  }, error = function(e) {\n    cat("INPUT_VALIDATION_TEST: PASS\\n")\n  })\n  \n  tryCatch({\n    ars(function(x) dcauchy(x), domain = c(-5, 5), n = 100)\n    cat("NON_LOG_CONCAVE_TEST: FAIL\\n")\n    all_passed <- FALSE\n  }, error = function(e) {\n    cat(sprintf("NON_LOG_CONCAVE_TEST: PASS (Error: %s)\\n", e$message))\n  })\n  \n  if (all_passed) {\n    cat("OVERALL_TEST_RESULT: PASS\\n")\n  } else {\n    cat("OVERALL_TEST_RESULT: FAIL\\n")\n  }\n}\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
