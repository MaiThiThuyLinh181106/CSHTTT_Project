Sending keys: ['cat << \'EOF\' > /app/find_dag.py\nimport pandas as pd\nimport numpy as np\nfrom pgmpy.models import BayesianNetwork\nfrom pgmpy.estimators import LinearGaussianMLE\nfrom itertools import combinations\n\ndf = pd.read_csv(\'/app/bn_sample_10k.csv\')\nvars = sorted(df.columns.tolist())\nnon_u = [v for v in vars if v != \'U\']\nall_pairs = list(combinations(non_u, 2))\n\nbest_score = -np.inf\nbest_edges = None\n\nfor p1, p2 in combinations(all_pairs, 2):\n    edges = [(\'U\', v) for v in non_u]\n    for x, y in [p1, p2]:\n        if x < y:\n            edges.append((y, x))\n        else:\n            edges.append((x, y))\n    try:\n        bn = BayesianNetwork(edges)\n        est = LinearGaussianMLE(bn, df)\n        params = est.get_parameters()\n        ll = 0\n        for node, cpd in params.items():\n            ll += cpd.log_likelihood(df)\n        score = ll\n        if score > best_score:\n            best_score = score\n            best_edges = edges\n    except Exception as e:\n        continue\n\nprint("Best score:", best_score)\nprint("Best edges (from, to):", best_edges)\nEOF\n/app/venv/bin/python /app/find_dag.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
