Sending keys: ['cat << \'EOF\' > /app/pipeline.py\nimport pandas as pd\nimport numpy as np\nfrom pgmpy.models import BayesianNetwork\nfrom pgmpy.estimators import HillClimbSearch, BIC, MaximumLikelihoodEstimator\nfrom pgmpy.factors.discrete import TabularCPD\n\ndf = pd.read_csv(\'/app/bn_sample_10k.csv\')\ncols = df.columns.tolist()\n\ndf_disc = pd.DataFrame()\nbins_dict = {}\nfor col in cols:\n    df_disc[col], bins = pd.qcut(df[col], q=3, labels=[0, 1, 2], retbins=True, duplicates=\'drop\')\n    df_disc[col] = df_disc[col].astype(int)\n    bins_dict[col] = bins\n\nsc = HillClimbSearch(df_disc)\nbic = BIC(df_disc)\nbest_model = sc.estimate(scoring_method=bic, show_progress=False)\nedges = list(best_model.edges())\nedges = [e for e in edges if e[1] != \'U\']\n\nlearned_list = [{\'to\': to, \'from\': frm} for frm, to in edges]\npd.DataFrame(learned_list).to_csv(\'/app/learned_dag.csv\', index=False)\nprint("Saved /app/learned_dag.csv")\n\nintervened_edges = [e for e in edges if e[1] != \'Y\']\nintervened_list = [{\'to\': to, \'from\': frm} for frm, to in intervened_edges]\npd.DataFrame(intervened_list).to_csv(\'/app/intervened_dag.csv\', index=False)\nprint("Saved /app/intervened_dag.csv")\n\nbn_int = BayesianNetwork(intervened_edges)\nbn_int.fit(df_disc, estimator=MaximumLikelihoodEstimator)\n\ncpd_y = TabularCPD(variable=\'Y\', variable_card=3, values=[[1.0], [0.0], [0.0]])\nbn_int.add_cpds(cpd_y)\n\nsamples_disc = bn_int.simulate(n_samples=10000)\n\nsamples_cont = pd.DataFrame()\nfor col in cols:\n    bins = bins_dict[col]\n    midpoints = [(bins[i] + bins[i+1])/2 for i in range(len(bins)-1)]\n    col_states = samples_disc[col].values\n    mapped = np.array([midpoints[s] for s in col_states])\n    noise = np.random.normal(0, np.sqrt(10e-9), size=len(mapped))\n    samples_cont[col] = mapped + noise\n\nsamples_cont = samples_cont[cols]\nsamples_cont.to_csv(\'/app/final_bn_sample.csv\', index=False)\nprint("Saved /app/final_bn_sample.csv with shape:", samples_cont.shape)\nEOF\n/app/venv/bin/python /app/pipeline.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
