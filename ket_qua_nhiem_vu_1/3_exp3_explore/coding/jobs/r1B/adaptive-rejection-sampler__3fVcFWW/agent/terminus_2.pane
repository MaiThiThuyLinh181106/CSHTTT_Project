[?2004l[?2004h> ars <- function(density_function, domain, n = 1000) {
[?2004l[?2004h>   if (!is.function(density_function)) stop("density_function must be a function.")
[?2004l[?2004h>   if (!is.numeric(domain) || length(domain) != 2 || domain[1] >= domain[2]) stop("Invalid domain.")
[?2004l[?2004h>   if (!is.numeric(n) || length(n) != 1 || n <= 0 || n != round(n)) stop("Invalid n.")
[?2004l[?2004h>   state <- ars_init(density_function, domain)
[?2004l[?2004h>   samples <- numeric(n)
[?2004l[?2004h>   accepted <- 0
[?2004l[?2004h>   while (accepted < n) {
[?2004l[?2004h>     res <- sample_upper_hull(state)
[?2004l[?2004h>     x_star <- res$x_star
[?2004l[?2004h>     x <- state$x
[?2004l[?2004h>     hx <- state$hx
[?2004l[?2004h>     dhx <- state$dhx
[?2004l[?2004h>     idx <- max(which(res$z <= x_star))
[?2004l[?2004h>     if (idx > length(dhx)) idx <- length(dhx)
[?2004l[?2004h>     if (idx < 1) idx <- 1
[?2004l[?2004h>     u_star <- hx[idx] + dhx[idx] * (x_star - x[idx])
[?2004l[?2004h>     w <- runif(1)
[?2004l[?2004h>     l_star <- eval_lower_hull(state, x_star)
[?2004l[?2004h>     if (log(w) <= l_star - u_star) {
[?2004l[?2004h>       accepted <- accepted + 1
[?2004l[?2004h>       samples[accepted] <- x_star
[?2004l[?2004h>       next
[?2004l[?2004h>     }
[?2004l[?2004h>     h_star <- compute_log_density(density_function, x_star)
[?2004l[?2004h>     if (!is.finite(h_star)) {
[?2004l[?2004h>       state <- update_hulls(state, x_star, density_function)
[?2004l[?2004h>       next
[?2004l[?2004h>     }
[?2004l[?2004h>     if (log(w) <= h_star - u_star) {
[?2004l[?2004h>       accepted <- accepted + 1
[?2004l[?2004h>       samples[accepted] <- x_star
[?2004l[?2004h>     }
[?2004l[?2004h>     state <- update_hulls(state, x_star, density_function)
[?2004l[?2004h>   }
[?2004l[?2004h>   return(samples)
[?2004l[?2004h> }
