[?2004l[?2004h> eval_lower_hull <- function(state, x_star) {
[?2004l[?2004h>   x <- state$x
[?2004l[?2004h>   hx <- state$hx
[?2004l[?2004h>   k <- length(x)
[?2004l[?2004h>   if (x_star < x[1] || x_star > x[k]) return(-Inf)
[?2004l[?2004h>   idx <- max(which(x <= x_star))
[?2004l[?2004h>   if (idx == k) idx <- k - 1
[?2004l[?2004h>   hx[idx] + (hx[idx+1] - hx[idx]) * (x_star - x[idx]) / (x[idx+1] - x[idx])
[?2004l[?2004h> }
