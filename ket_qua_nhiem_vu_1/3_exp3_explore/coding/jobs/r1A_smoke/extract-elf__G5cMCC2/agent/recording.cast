[59.997891, "i", "cat << 'EOF' > test_elf.js\nconst fs = require('fs');\nconst buf = fs.readFileSync('/app/a.out');\nconsole.log('Magic:', buf.subarray(0, 4));\n// ELF Header 64-bit\nconst e_phoff = buf.readBigUInt64LE(32);\nconst e_phentsize = buf.readUInt16LE(54);\nconst e_phnum = buf.readUInt16LE(56);\nconsole.log({ e_phoff: Number(e_phoff), e_phentsize, e_phnum });\nfor (let i = 0; i < e_phnum; i++) {\n  const offset = Number(e_phoff) + i * e_phentsize;\n  const p_type = buf.readUInt32LE(offset);\n  const p_flags = buf.readUInt32LE(offset + 4);\n  const p_offset = buf.readBigUInt64LE(offset + 8);\n  const p_vaddr = buf.readBigUInt64LE(offset + 16);\n  const p_filesz = buf.readBigUInt64LE(offset + 32);\n  const p_memsz = buf.readBigUInt64LE(offset + 40);\n  console.log(`PT ${p_type}: vaddr=0x${p_vaddr.toString(16)}, offset=0x${p_offset.toString(16)}, filesz=0x${p_filesz.toString(16)}, memsz=0x${p_memsz.toString(16)}`);\n}\nEOF\nnode test_elf.js\n"]
[59.998564, "o", "cat << 'EOF' > test_elf.js\r\n\u001b[?2004l\r\u001b[?2004h> "]
