[93.278329, "i", "cat << 'EOF' > extract.js\nconst fs = require('fs');\n\nfunction parseELF(filename) {\n  const buf = fs.readFileSync(filename);\n  const e_phoff = Number(buf.readBigUInt64LE(32));\n  const e_phentsize = buf.readUInt16LE(54);\n  const e_phnum = buf.readUInt16LE(56);\n\n  const result = {};\n\n  for (let i = 0; i < e_phnum; i++) {\n    const phoff = e_phoff + i * e_phentsize;\n    const p_type = buf.readUInt32LE(phoff);\n    if (p_type !== 1) continue; // PT_LOAD = 1\n\n    const p_offset = Number(buf.readBigUInt64LE(phoff + 8));\n    let p_vaddr = Number(buf.readBigUInt64LE(phoff + 16));\n    const p_filesz = Number(buf.readBigUInt64LE(phoff + 32));\n    const p_memsz = Number(buf.readBigUInt64LE(phoff + 40));\n\n    // If vaddr starts at 0 (PIE executable), standard load address is 0x400000\n    if (p_vaddr < 0x400000) {\n      p_vaddr += 0x400000;\n    }\n\n    for (let off = 0; off < p_filesz; off += 4) {\n      if (off + 4 <= p_filesz) {\n        const val = buf.readInt32LE(p_offset + off);\n        const addr = p_vaddr + off;\n        result[addr.toString()] = val;\n      }\n    }\n  }\n  return result;\n}\n\nconst filename = process.argv[2] || '/app/a.out';\nconst res = parseELF(filename);\nconsole.log(JSON.stringify(res, null, 2));\nEOF\nnode extract.js /app/a.out | head -n 20\n"]
