[93.295024, "o", "\u001b[?2004h>         const val = buf.readInt32LE(p_offset + off);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.295984, "o", "        const addr = p_vaddr + off;\r\n\u001b[?2004l\r\u001b[?2004h>         result[addr.toString()] = val;\r\n\u001b[?2004l\r"]
[93.296263, "o", "\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.296817, "o", "  return result;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.297372, "o", "const filename = process.argv[2] || '/app/a.out';\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.297835, "o", "const res = parseELF(filename);\r\n\u001b[?2004l\r\u001b[?2004h> console.log(JSON.stringify(res, null, 2));\r\n\u001b[?2004l\r"]
