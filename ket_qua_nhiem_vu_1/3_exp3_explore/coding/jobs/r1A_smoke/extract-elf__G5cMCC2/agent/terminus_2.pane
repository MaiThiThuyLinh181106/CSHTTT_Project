[?2004l[?2004h> const fs = require('fs');
[?2004l[?2004h> 
[?2004l[?2004h> function parseELF(filename) {
[?2004l[?2004h>   const buf = fs.readFileSync(filename);
[?2004l[?2004h>   const e_phoff = Number(buf.readBigUInt64LE(32));
[?2004l[?2004h>   const e_phentsize = buf.readUInt16LE(54);
[?2004l[?2004h>   const e_phnum = buf.readUInt16LE(56);
[?2004l[?2004h> 
[?2004l[?2004h>   const result = {};
[?2004l[?2004h> 
[?2004l[?2004h>   for (let i = 0; i < e_phnum; i++) {
[?2004l[?2004h>     const phoff = e_phoff + i * e_phentsize;
[?2004l[?2004h>     const p_type = buf.readUInt32LE(phoff);
[?2004l[?2004h>     if (p_type !== 1) continue; // PT_LOAD = 1
[?2004l[?2004h> 
[?2004l[?2004h>     const p_flags = buf.readUInt32LE(phoff + 4);
[?2004l[?2004h>     const p_offset = Number(buf.readBigUInt64LE(phoff + 8));
