import pandas as pd
import numpy as np
from pgmpy.estimators import PC, HillClimbSearch, BGeScore
from pgmpy.models import BayesianNetwork

df = pd.read_csv('/app/bn_sample_10k.csv')

# Try PC algorithm first
pc = PC(df)
estimated_dag = pc.estimate(variant='stable', ci_test='pearsonr', significance_level=0.01)
print("PC Edges:", estimated_dag.edges())

# Try HillClimbSearch with BGeScore
score = BGeScore(df)
hcs = HillClimbSearch(df)
estimated_dag_bge = hcs.estimate(scoring_method=score, black_list=[(node, 'U') for node in df.columns if node != 'U'])
print("BGe Edges:", estimated_dag_bge.edges())
EOF
