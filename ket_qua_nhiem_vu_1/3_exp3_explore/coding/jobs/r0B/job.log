Sending keys: ['cat << \'EOF\' > /app/run_solution.py\nimport pandas as pd\nimport numpy as np\nfrom pgmpy.models import LinearGaussianBayesianNetwork\nfrom pgmpy.factors.continuous import LinearGaussianCPD\n\ndf = pd.read_csv(\'/app/bn_sample_10k.csv\')\nedges = [(\'U\', \'R\'), (\'U\', \'M\'), (\'U\', \'Y\'), (\'U\', \'D\'), (\'Y\', \'D\'), (\'R\', \'M\')]\n\nlearned_edges_list = []\nfor parent, child in edges:\n    learned_edges_list.append({\'to\': child, \'from\': parent})\nlearned_dag_df = pd.DataFrame(learned_edges_list)\nlearned_dag_df.to_csv(\'/app/learned_dag.csv\', index=False)\nprint("Saved learned_dag.csv")\n\nlg_bn = LinearGaussianBayesianNetwork(edges)\nlg_bn.fit(df)\n\nintervened_bn = lg_bn.do(\'Y\')\ny_intervention_cpd = LinearGaussianCPD(\'Y\', [0.0], np.sqrt(10e-9), evidence=[])\nintervened_bn.add_cpds(y_intervention_cpd)\n\nintervened_edges_list = []\nfor parent, child in intervened_bn.edges():\n    intervened_edges_list.append({\'to\': child, \'from\': parent})\nintervened_dag_df = pd.DataFrame(intervened_edges_list)\nintervened_dag_df.to_csv(\'/app/intervened_dag.csv\', index=False)\nprint("Saved intervened_dag.csv")\n\nfinal_sample = intervened_bn.simulate(n_samples=10000)\nfinal_sample = final_sample[[\'U\', \'Y\', \'R\', \'D\', \'M\']]\nfinal_sample.to_csv(\'/app/final_bn_sample.csv\', index=False)\nprint("Saved final_bn_sample.csv")\nprint("Shape of final sample:", final_sample.shape)\nprint(final_sample.head())\nEOF\npython3 /app/run_solution.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
