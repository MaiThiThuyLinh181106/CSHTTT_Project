Sending keys: ['cat << \'EOF\' > /app/ars.R\n# Adaptive Rejection Sampling (ARS) as described in Gilks et al. (1992)\n\n# Helper function: Check input validity\nvalidate_inputs <- function(density_function, domain, n) {\n  if (!is.function(density_function)) {\n    stop("density_function must be a function.")\n  }\n  if (!is.numeric(domain) || length(domain) != 2 || domain[1] >= domain[2]) {\n    stop("domain must be a numeric vector of length 2 representing c(lower, upper).")\n  }\n  if (!is.numeric(n) || length(n) != 1 || n <= 0 || n != round(n)) {\n    stop("n must be a positive integer representing sample count.")\n  }\n}\n\n# Helper function: Check log-concavity (second derivative of log-density <= 0)\n# We check this numerically at evaluation points using finite differences.\ncheck_log_concavity <- function(log_density_fn, x) {\n  h <- 1e-4\n  val_mid <- log_density_fn(x)\n  val_plus <- log_density_fn(x + h)\n  val_minus <- log_density_fn(x - h)\n  \n  # Second derivative approximation: f\'\'(x) = (f(x+h) - 2f(x) + f(x-h)) / h^2\n  d2 <- (val_plus - 2 * val_mid + val_minus) / (h^2)\n  \n  # If second derivative is significantly positive, log-density is convex (not concave)\n  if (d2 > 1e-2) {\n    stop(paste0("Density function is not log-concave at x = ", x, ", second derivative of log-density is ", d2))\n  }\n}\n\n# Adaptive Rejection Sampler main implementation\nars <- function(density_function, domain, n) {\n  validate_inputs(density_function, domain, n)\n  \n  log_density <- function(x) {\n    # vectorized or scalar\n    res <- log(pmax(density_function(x), 1e-300))\n    return(res)\n  }\n  \n  # Initialize starting points (e.g., 3 points in the domain)\n  # If domain has infinite bounds, bound them for initial points\n  lower <- if (is.infinite(domain[1])) -3 else domain[1]\n  upper <- if (is.infinite(domain[2])) 3 else domain[2]\n  \n  # Ensure initial points are well spaced\n  x_pts <- sort(unique(c(lower, (lower + upper) / 2, upper)))\n  if (length(x_pts) < 3) {\n    x_pts <- seq(lower, upper, length.out = 3)\n  }\n  \n  # Evaluate log density and derivative at initial points\n  h <- 1e-4\n  y_pts <- log_density(x_pts)\n  \n  # Check initial log-concavity\n  for (xp in x_pts) {\n    check_log_concavity(log_density, xp)\n  }\n  \n  # Numerical derivative (slope) at initial points\n  d_pts <- (log_density(x_pts + h) - log_density(x_pts - h)) / (2 * h)\n  \n  samples <- numeric(n)\n  accepted <- 0\n  \n  while (accepted < n) {\n    # Construct hulls (lower hull l(x) and upper hull u(x))\n    # For each interval between x_pts, upper hull is linear tangent lines intersection\n    k <- length(x_pts)\n    \n    # Calculate upper hull tangents\n    # u_j(x) = y_j + d_j * (x - x_j)\n    # Intersection of tangent at j and j+1:\n    # z_j = (y_{j+1} - y_j - d_{j+1}*x_{j+1} + d_j*x_j) / (d_j - d_{j+1})\n    z <- numeric(k - 1)\n    for (j in 1:(k - 1)) {\n      denom <- d_pts[j] - d_pts[j+1]\n      if (abs(denom) < 1e-12) {\n        z[j] <- (x_pts[j] + x_pts[j+1]) / 2\n      } else {\n        z[j] <- (y_pts[j+1] - y_pts[j] - d_pts[j+1] * x_pts[j+1] + d_pts[j] * x_pts[j]) / denom\n      }\n    }\n    \n    # Add outer bounds\n    z_all <- c(domain[1], z, domain[2])\n    \n    # Calculate integrals of exp(u(x)) over each interval to sample from upper hull envelope\n    # Intervals are [z_all[j], z_all[j+1]] for j = 1 to k\n    interval_integrals <- numeric(k)\n    for (j in 1:k) {\n      z_l <- z_all[j]\n      z_u <- z_all[j+1]\n      yj <- y_pts[j]\n      dj <- d_pts[j]\n      \n      if (is.infinite(z_l) || is.infinite(z_u)) {\n        # Handle infinite bounds conservatively or approximate\n        # For standard domains, z_l and z_u are finite due to initial bounds/extrapolation\n        # But if infinite, use exponential approximation\n        if (dj > 0) {\n          interval_integrals[j] <- exp(yj + dj * (z_u - x_pts[j])) / dj\n        } else if (dj < 0) {\n          interval_integrals[j] <- -exp(yj + dj * (z_l - x_pts[j])) / dj\n        } else {\n          interval_integrals[j] <- exp(yj) * (z_u - z_l)\n        }\n      } else {\n        if (abs(dj) < 1e-12) {\n          interval_integrals[j] <- exp(yj) * (z_u - z_l)\n        } else {\n          interval_integrals[j] <- (exp(yj + dj * (z_u - x_pts[j])) - exp(yj + dj * (z_l - x_pts[j]))) / dj\n        }\n      }\n    }\n    \n    # Normalize to get probabilities\n    total_integral <- sum(interval_integrals)\n    if (total_integral <= 0 || is.na(total_integral)) {\n      # Fallback sampling if numerical issues occur\n      total_integral <- 1\n      probs <- rep(1 / k, k)\n    } else {\n      probs <- interval_integrals / total_integral\n    }\n    \n    # Sample an interval index\n    j_sampled <- sample.int(k, size = 1, prob = probs)\n    \n    # Sample x from upper hull in interval j_sampled using inverse CDF method for truncated exponential\n    z_l <- z_all[j_sampled]\n    z_u <- z_all[j_sampled + 1]\n    yj <- y_pts[j_sampled]\n    dj <- d_pts[j_sampled]\n    xj <- x_pts[j_sampled]\n    \n    # Generate uniform for inverse CDF\n    u_rand <- runif(1)\n    \n    if (is.infinite(z_l) || is.infinite(z_u)) {\n      # Fallback uniform on bounded approximation\n      x_cand <- runif(1, if(is.infinite(z_l)) -10 else z_l, if(is.infinite(z_u)) 10 else z_u)\n    } else {\n      if (abs(dj) < 1e-12) {\n        x_cand <- z_l + u_rand * (z_u - z_l)\n      } else {\n        # CDF of exp(yj + dj*(x - xj)) from z_l to x_cand\n        # Integral proportion = (exp(dj*(x_cand - xj)) - exp(dj*(z_l - xj))) / (exp(dj*(z_u - xj)) - exp(dj*(z_l - xj)))\n        term1 <- exp(dj * (z_l - xj))\n        term2 <- exp(dj * (z_u - xj))\n        val <- term1 + u_rand * (term2 - term1)\n        x_cand <- xj + log(pmax(val, 1e-300)) / dj\n      }\n    }\n    \n    # Ensure x_cand is within domain and z bounds\n    x_cand <- max(domain[1], min(domain[2], x_cand))\n    \n    # Evaluate log density at candidate\n    log_f_cand <- log_density(x_cand)\n    \n    # Check log concavity dynamically\n    check_log_concavity(log_density, x_cand)\n    \n    # Calculate lower hull l(x_cand) at x_cand\n    # Find which interval x_cand falls into\n    # Lower hull is linear interpolation between adjacent x_pts\n    l_val <- -Inf\n    for (i in 1:(k - 1)) {\n      if (x_cand >= x_pts[i] && x_cand <= x_pts[i+1]) {\n        # Linear interpolation between (x_pts[i], y_pts[i]) and (x_pts[i+1], y_pts[i+1])\n        slope <- (y_pts[i+1] - y_pts[i]) / (x_pts[i+1] - x_pts[i])\n        l_val <- y_pts[i] + slope * (x_cand - x_pts[i])\n        break\n      }\n    }\n    \n    # Upper hull value at x_cand\n    u_val <- yj + dj * (x_cand - xj)\n    \n    # Squeeze test / rejection test\n    w <- runif(1)\n    \n    # Lower hull test (squeeze)\n    if (log(w) <= l_val - u_val) {\n      accepted <- accepted + 1\n      samples[accepted] <- x_cand\n    } else {\n      # Exact rejection test\n      if (log(w) <= log_f_cand - u_val) {\n        accepted <- accepted + 1\n        samples[accepted] <- x_cand\n      }\n      \n      # Update hull with new point x_cand\n      x_pts <- sort(c(x_pts, x_cand))\n      # Re-evaluate y_pts, d_pts\n      y_pts <- log_density(x_pts)\n      for (xp in x_pts) {\n        check_log_concavity(log_density, xp)\n      }\n      d_pts <- (log_density(x_pts + h) - log_density(x_pts - h)) / (2 * h)\n    }\n  }\n  \n  return(samples)\n}\n\n# Formal testing function\ntest <- function() {\n  cat("Running Adaptive Rejection Sampling (ARS) tests...\\n\\n")\n  passed_tests <- 0\n  total_tests <- 0\n  \n  # Test 1: Normal Distribution\n  total_tests <- total_tests + 1\n  test_name <- "TEST_NORMAL_DISTRIBUTION"\n  tryCatch({\n    set.seed(42)\n    dnorm_fn <- function(x) dnorm(x, mean = 0, sd = 1)\n    samples <- ars(dnorm_fn, domain = c(-5, 5), n = 1000)\n    \n    mu <- mean(samples)\n    sigma <- sd(samples)\n    \n    # Save samples to file as requested\n    writeLines(as.character(samples), "/app/normal_samples.txt")\n    \n    # Check if mean is close to 0 and sd close to 1\n    if (abs(mu - 0) < 0.2 && abs(sigma - 1) < 0.2) {\n      cat(paste0(test_name, ": PASS (Mean: ", round(mu, 4), ", SD: ", round(sigma, 4), ")\\n"))\n      passed_tests <- passed_tests + 1\n    } else {\n      cat(paste0(test_name, ": FAIL (Mean: ", round(mu, 4), ", SD: ", round(sigma, 4), ")\\n"))\n    }\n  }, error = function(e) {\n    cat(paste0(test_name, ": FAIL (Error: ", e$message, ")\\n"))\n  })\n  \n  # Test 2: Exponential Distribution\n  total_tests <- total_tests + 1\n  test_name <- "TEST_EXPONENTIAL_DISTRIBUTION"\n  tryCatch({\n    set.seed(42)\n    dexp_fn <- function(x) dexp(x, rate = 1)\n    samples <- ars(dexp_fn, domain = c(0.01, 10), n = 1000)\n    \n    mu <- mean(samples)\n    sigma <- sd(samples)\n    \n    # Save samples to file\n    writeLines(as.character(samples), "/app/exponential_samples.txt")\n    \n    # For Exp(1), mean = 1, sd = 1\n    if (abs(mu - 1) < 0.2 && abs(sigma - 1) < 0.2) {\n      cat(paste0(test_name, ": PASS (Mean: ", round(mu, 4), ", SD: ", round(sigma, 4), ")\\n"))\n      passed_tests <- passed_tests + 1\n    } else {\n      cat(paste0(test_name, ": FAIL (Mean: ", round(mu, 4), ", SD: ", round(sigma, 4), ")\\n"))\n    }\n  }, error = function(e) {\n    cat(paste0(test_name, ": FAIL (Error: ", e$message, ")\\n"))\n  })\n  \n  # Test 3: Input Validation (Negative sample count)\n  total_tests <- total_tests + 1\n  test_name <- "TEST_INPUT_VALIDATION_NEGATIVE_N"\n  tryCatch({\n    ars(function(x) dnorm(x), domain = c(-3, 3), n = -10)\n    cat(paste0(test_name, ": FAIL (Should have rejected negative n)\\n"))\n  }, error = function(e) {\n    cat(paste0(test_name, ": PASS (Correctly caught invalid input: ", e$message, ")\\n"))\n    passed_tests <- passed_tests + 1\n  })\n  \n  # Test 4: Non-log-concave density check (e.g., Student\'s t or mixture of normals which is non-log-concave)\n  total_tests <- total_tests + 1\n  test_name <- "TEST_NON_LOG_CONCAVE_DETECTION"\n  tryCatch({\n    # Mixture of two normals: not log-concave\n    non_log_concave_fn <- function(x) dnorm(x, mean = -2, sd = 0.5) + dnorm(x, mean = 2, sd = 0.5)\n    ars(non_log_concave_fn, domain = c(-5, 5), n = 100)\n    cat(paste0(test_name, ": FAIL (Should have detected non-log-concavity)\\n"))\n  }, error = function(e) {\n    cat(paste0(test_name, ": PASS (Correctly detected non-log-concave density: ", e$message, ")\\n"))\n    passed_tests <- passed_tests + 1\n  })\n  \n  cat(sprintf("\\nTest Summary: %d / %d tests passed.\\n", passed_tests, total_tests))\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
