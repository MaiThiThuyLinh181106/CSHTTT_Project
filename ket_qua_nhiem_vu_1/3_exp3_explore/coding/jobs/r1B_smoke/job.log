Sending keys: ["cat << 'EOF' > extract.js\nconst fs = require('fs');\n\nfunction extract(filePath) {\n  const buf = fs.readFileSync(filePath);\n  const result = {};\n\n  if (buf.readUInt32LE(0) !== 0x464c457f) {\n    console.error('Not an ELF file');\n    return;\n  }\n\n  const is64 = buf.readUInt8(0x4) === 2;\n  const e_phoff = is64 ? Number(buf.readBigUInt64LE(0x20)) : buf.readUInt32LE(0x1c);\n  const e_phentsize = buf.readUInt16LE(is64 ? 0x36 : 0x2a);\n  const e_phnum = buf.readUInt16LE(is64 ? 0x38 : 0x2c);\n\n  for (let i = 0; i < e_phnum; i++) {\n    const off = e_phoff + i * e_phentsize;\n    const p_type = buf.readUInt32LE(off);\n    if (p_type === 1) { // PT_LOAD\n      const p_offset = is64 ? Number(buf.readBigUInt64LE(off + 8)) : buf.readUInt32LE(off + 4);\n      const p_vaddr = is64 ? Number(buf.readBigUInt64LE(off + 16)) : buf.readUInt32LE(off + 8);\n      const p_filesz = is64 ? Number(buf.readBigUInt64LE(off + 32)) : buf.readUInt32LE(off + 16);\n      const p_memsz = is64 ? Number(buf.readBigUInt64LE(off + 40)) : buf.readUInt32LE(off + 20);\n\n      const segmentBuf = Buffer.alloc(Number(p_memsz));\n      if (p_filesz > 0) {\n        buf.copy(segmentBuf, 0, Number(p_offset), Number(p_offset) + Number(p_filesz));\n      }\n\n      let start = Number(p_vaddr);\n      let rem = start % 4;\n      if (rem !== 0) {\n        start += (4 - rem);\n      }\n\n      for (let addr = start; addr + 4 <= Number(p_vaddr) + Number(p_memsz); addr += 4) {\n        const val = segmentBuf.readInt32LE(addr - Number(p_vaddr));\n        result[addr.toString()] = val;\n      }\n    }\n  }\n\n  console.log(JSON.stringify(result));\n}\n\nif (process.argv[2]) {\n  extract(process.argv[2]);\n}\nEOF\nnode extract.js /app/a_nopie.out > out.json\nhead -n 20 out.json\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
