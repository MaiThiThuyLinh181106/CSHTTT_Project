[?2004l[?2004h>       let start = Number(p_vaddr);
[?2004l[?2004h>       let rem = start % 4;
[?2004l[?2004h>       if (rem !== 0) {
[?2004l[?2004h>         start += (4 - rem);
[?2004l[?2004h>       }
[?2004l[?2004h> 
[?2004l[?2004h>       for (let addr = start; addr + 4 <= Number(p_vaddr) + Number(p_memsz); addr += 4) {
[?2004l[?2004h>         const val = segmentBuf.readInt32LE(addr - Number(p_vaddr));
[?2004l[?2004h>         result[addr.toString()] = val;
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   console.log(JSON.stringify(result));
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> if (process.argv[2]) {
[?2004l[?2004h>   extract(process.argv[2]);
[?2004l[?2004h> }
