[50.632413, "i", "printf '%s\n' 'const fs = require(\"fs\");' 'const filename = process.argv[2] || \"/app/a.out\";' 'const buf = fs.readFileSync(filename);' 'const e_phoff = Number(buf.readBigUInt64LE(32));' 'const e_phentsize = buf.readUInt16LE(54);' 'const e_phnum = buf.readUInt16LE(56);' 'const BASE = 0x400000;' 'const mem = {};' 'for (let i = 0; i < e_phnum; i++) {' '    const off = e_phoff + i * e_phentsize;' '    const p_type = buf.readUInt32LE(off);' '    if (p_type === 1) {' '        const p_offset = Number(buf.readBigUInt64LE(off + 8));' '        const p_vaddr = Number(buf.readBigUInt64LE(off + 16));' '        const p_filesz = Number(buf.readBigUInt64LE(off + 32));' '        const p_memsz = Number(buf.readBigUInt64LE(off + 40));' '        let segment_data = buf.subarray(p_offset, p_offset + p_filesz);' '        if (segment_data.length < p_memsz) {' '            const padded = Buffer.alloc(p_memsz);' '            segment_data.copy(padded);' '            segment_data = padded;' '        }' '        const start_addr = BASE + p_vaddr;' '        for (let idx = 0; idx < segment_data.length; idx += 4) {' '            if (idx + 4 <= segment_data.length) {' '                const val = segment_data.readUInt32LE(idx);' '                const addr = start_addr + idx;' '                mem[addr.toString()] = val;' '            }' '        }' '    }' '}' 'console.log(JSON.stringify(mem));' > extract.js\n"]
[50.632772, "o", "printf '%s\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.632959, "o", "> "]
[50.635327, "o", "' 'const fs = require(\"fs\");' 'const filename = process.argv[2] || \"/app/a.out\";' 'const buf = fs.readFileSync(filename);' 'const e_phoff = Number(buf.readBigUInt64LE(32));' 'const e_phentsize = buf.readUInt16LE(54);' 'const e_phnum = buf.readUInt16LE(56);' 'const BASE = 0x400000;' 'const mem = {};' 'for (let i = 0; i < e_phnum; i++) {' '    const off = e_phoff + i * e_phentsize;' '    const p_type = buf.readUInt32LE(off);' '    if (p_type === 1) {' '        const p_offset = Number(buf.readBigUInt64LE(off + 8));' '        const p_vaddr = Number(buf.readBigUInt64LE(off + 16));' '        const p_filesz = Number(buf.readBigUInt64LE(off + 32));' '        const p_memsz = Number(buf.readBigUInt64LE(off + 40));' '        let segment_data = buf.subarray(p_offset, p_offset + p_filesz);' '        if (segment_data.length < p_memsz) {' '            const padded = Buffer.alloc(p_memsz);' '            segment_data.copy(padded);' '            segment_data = padded;' '        }' '        const start_addr = BASE + p_vaddr;' '        for (let idx = 0; idx < segment_data.length; idx += 4) {' '            if (idx + 4 <= segment_data.length) {' '                const val = segment_data.readUInt32LE(idx);' '                const addr = start_addr + idx;' '                mem[addr.toString()] = val;' '            }' '        }' '    }' '}' 'console.log(JSON.stringify(mem));' > extract.js\r\n\u001b[?2004l\r"]
[50.635691, "o", "\u001b[?2004hroot@99c2545791ca:/app# "]
