[?2004l[?2004h>         const p_offset = Number(buf.readBigUInt64LE(phOffset + 8));
[?2004l[?2004h>         const p_vaddr = Number(buf.readBigUInt64LE(phOffset + 16));
[?2004l[?2004h>         const p_filesz = Number(buf.readBigUInt64LE(phOffset + 32));
