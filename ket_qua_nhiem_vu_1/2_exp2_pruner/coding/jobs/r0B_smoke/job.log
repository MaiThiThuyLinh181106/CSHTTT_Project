Sending keys: ["cat << 'EOF' > extract.js\nconst fs = require('fs');\n\nconst filename = process.argv[2] || '/app/a.out';\nconst buf = fs.readFileSync(filename);\n\n// Read ELF header for 64-bit\nconst e_phoff = Number(buf.readBigUInt64LE(32));\nconst e_phentsize = buf.readUInt16LE(54);\nconst e_phnum = buf.readUInt16LE(56);\n\nconst baseAddr = 0x400000;\nconst result = {};\n\nfor (let i = 0; i < e_phnum; i++) {\n    const phOffset = e_phoff + i * e_phentsize;\n    const p_type = buf.readUInt32LE(phOffset);\n    if (p_type === 1) { // PT_LOAD\n        const p_offset = Number(buf.readBigUInt64LE(phOffset + 8));\n        const p_vaddr = Number(buf.readBigUInt64LE(phOffset + 16));\n        const p_filesz = Number(buf.readBigUInt64LE(phOffset + 32));\n        const p_memsz = Number(buf.readBigUInt64LE(phOffset + 40));\n\n        const startAddr = baseAddr + p_vaddr;\n        \n        for (let off = 0; off < p_memsz; off += 4) {\n            const addr = startAddr + off;\n            let val = 0;\n            if (off < p_filesz) {\n                if (off + 4 <= p_filesz) {\n                    val = buf.readUInt32LE(p_offset + off);\n                } else {\n                    // partial bytes at the end of file content\n                    for (let b = 0; b < (p_filesz - off); b++) {\n                        val |= buf[p_offset + off + b] << (8 * b);\n                    }\n                }\n            } else {\n                val = 0; // BSS / zero-filled\n            }\n            result[addr.toString()] = val;\n        }\n    }\n}\n\nconsole.log(JSON.stringify(result, null, 2));\nEOF\nnode extract.js /app/a.out | head -n 30\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
