[?2004lconst fs = require('fs');

function extract(filename) {
    const buffer = fs.readFileSync(filename);
    const result = {};

    const is64 = buffer.readUInt8(4) === 2;
    const phoff = is64 ? Number(buffer.readBigUInt64LE(32)) : buffer.readUInt32LE(28);
    const phentsize = buffer.readUInt16LE(is64 ? 54 : 42);
    const phnum = buffer.readUInt16LE(is64 ? 56 : 44);

    for (let i = 0; i < phnum; i++) {
        const phOffset = phoff + i * phentsize;
        const p_type = buffer.readUInt32LE(phOffset);
        if (p_type === 1) { // PT_LOAD
            const p_offset = Number(is64 ? buffer.readBigUInt64LE(phOffset + 8) : buffer.readUInt32LE(phOffset + 4));
            const p_vaddr = Number(is64 ? buffer.readBigUInt64LE(phOffset + 16) : buffer.readUInt32LE(phOffset + 8));
            const p_filesz = Number(is64 ? buffer.readBigUInt64LE(phOffset + 32) : buffer.readUInt32LE(phOffset + 16));
            const p_memsz = Number(is64 ? buffer.readBigUInt64LE(phOffset + 40) : buffer.readUInt32LE(phOffset + 20));

            const base = (p_vaddr < 0x10000) ? 0x400000 : 0;

            for (let off = 0; off < p_memsz; off += 4) {
                const addr = p_vaddr + off + base;
                let val = 0;
                if (off < p_filesz && (p_offset + off + 4) <= buffer.length) {
                    val = buffer.readUInt32LE(p_offset + off);
                }
                result[addr.toString()] = val;
            }
        }
    }
    return result;
}

const out = extract(process.argv[2] || '/app/a.out');
console.log(JSON.stringify(out));
