   10  python3 -c '
with open("a.out", "rb") as f:
    e = f.read()
# ELF64 header
# e_ident (16), e_type (2), e_machine (2), e_version (4), e_entry (8), e_phoff (8), e_shoff (8), e_flags (4), e_ehsize (2), e_phentsize (2), e_phnum (2), e_shentsize (2), e_shnum (2), e_shstrndx (2)
import struct
fmt = "<16sHHIQQQIHHHHHH"
header = struct.unpack_from(fmt, e, 0)
print("e_type:", header[1])
print("e_entry:", hex(header[4]))
print("e_phoff:", header[5])
print("e_phentsize:", header[9])
print("e_phnum:", header[10])

phoff = header[5]
phentsize = header[9]
phnum = header[10]
for i in range(phnum):
    ph = e[phoff + i*phentsize : phoff + (i+1)*phentsize]
    # p_type (4), p_flags (4), p_offset (8), p_vaddr (8), p_paddr (8), p_filesz (8), p_memsz (8), p_align (8)
    p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align = struct.unpack_from("<IIQQQQQQ", ph, 0)
    if p_type == 1: # PT_LOAD
        print(f"LOAD: offset={hex(p_offset)}, vaddr={hex(p_vaddr)}, filesz={hex(p_filesz)}, memsz={hex(p_memsz)}")
'
