[65.34913, "i", "cat << 'EOF' > extract.js\nconst fs = require('fs');\n\nfunction extract(filePath) {\n  const buf = fs.readFileSync(filePath);\n  const result = {};\n  const base = 0x400000;\n  for (let i = 0; i <= buf.length - 4; i += 4) {\n    result[base + i] = buf.readInt32LE(i);\n  }\n  console.log(JSON.stringify(result));\n}\n\nif (process.argv[2]) {\n  extract(process.argv[2]);\n}\nEOF\n"]
