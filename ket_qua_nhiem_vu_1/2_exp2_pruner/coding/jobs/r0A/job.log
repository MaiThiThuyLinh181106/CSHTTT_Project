Sending keys: ['cat << \'EOF\' > /app/full_pipeline.py\nimport pandas as pd\nimport numpy as np\nfrom pgmpy.models import BayesianNetwork\nfrom pgmpy.estimators import MaximumLikelihoodEstimator\nfrom pgmpy.sampling import BayesianModelSampling\n\ndf = pd.read_csv(\'/app/bn_sample_10k.csv\')\n\n# Learned edges (from, to)\n# fixed_edges: [(\'U\', \'M\'), (\'U\', \'Y\'), (\'U\', \'D\'), (\'Y\', \'D\'), (\'U\', \'R\'), (\'R\', \'M\')]\nedges = [(\'U\', \'M\'), (\'U\', \'Y\'), (\'U\', \'D\'), (\'Y\', \'D\'), (\'U\', \'R\'), (\'R\', \'M\')]\n\nmodel = BayesianNetwork(edges)\nmodel.fit(df, estimator=MaximumLikelihoodEstimator)\n\nprint("Fitted model CPDs:", model.get_cpds())\n\n# 1) learned_dag.csv already saved, but let\'s re-save properly\nlearned_lines = ["to,from"]\nfor u, v in edges:\n    learned_lines.append(f"{v},{u}")\nwith open(\'/app/learned_dag.csv\', \'w\') as f:\n    f.write(\'\\n\'.join(learned_lines) + \'\\n\')\n\n# 3) Intervention on Y: setting Y = 0.0 (or variance 10e-9)\n# In a Bayesian Network, do(Y=0.0) means removing parents of Y and setting Y CPD to constant 0.0 (or Gaussian with mean 0, var 10e-9)\nintervened_edges = [e for e in edges if e[1] != \'Y\']\nprint("Intervened edges:", intervened_edges)\n\nintervened_lines = ["to,from"]\nfor u, v in intervened_edges:\n    intervened_lines.append(f"{v},{u}")\nwith open(\'/app/intervened_dag.csv\', \'w\') as f:\n    f.write(\'\\n\'.join(intervened_lines) + \'\\n\')\n\nintervened_model = BayesianNetwork(intervened_edges)\nintervened_model.fit(df, estimator=MaximumLikelihoodEstimator)\n\n# Override CPD for Y to be 0 with tiny variance (or constant 0)\n# Since pgmpy LinearGaussianCPD expects mean as linear combination of parents (none for Y now) and variance\nfrom pgmpy.factors.continuous import LinearGaussianCPD\n# Y has no parents now\ny_cpd = LinearGaussianCPD(\'Y\', beta=[0.0], std=np.sqrt(10e-9), evidence=[])\nintervened_model.add_cpds(y_cpd)\n\n# Sample 10k points\nfrom pgmpy.sampling import BayesianModelSampling\nsampler = BayesianModelSampling(intervened_model)\nsamples = sampler.forward_sample(size=10000)\n\n# Ensure column order matches original data\nsamples = samples[df.columns]\nsamples.to_csv(\'/app/final_bn_sample.csv\', index=False)\nprint("Saved final_bn_sample.csv with shape:", samples.shape)\nEOF\npython3 /app/full_pipeline.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
