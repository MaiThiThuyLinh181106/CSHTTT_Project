_norm <- ars(function(x) dnorm(x), domain = c(-Inf, Inf), n = 1000)\n    mean_val <- mean(samples_norm)\n    sd_val <- sd(samples_norm)\n    cat(sprintf("NORMAL_DISTRIBUTION_TEST: Mean = %.4f, SD = %.4f\\n", mean_val, sd_val))\n    writeLines(as.character(samples_norm), "/app/normal_samples.txt")\n    if (abs(mean_val) < 0.2 && abs(sd_val - 1.0) < 0.25 && length(samples_norm) == 1000) {\n      cat("NORMAL_DISTRIBUTION_TEST: PASS\\n")\n    } else {\n      cat("NORMAL_DISTRIBUTION_TEST: FAIL\\n")\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf("NORMAL_DISTRIBUTION_TEST: FAIL (Error: %s)\\n", e$message))\n    all_passed <- FALSE\n  })\n  \n  tryCatch({\n    set.seed(42)\n    samples_exp <- ars(function(x) dexp(x, rate = 1), domain = c(0.01, 20), n = 1000, initial_points = c(0.5, 1.5, 3.0))\n    mean_val <- mean(samples_exp)\n    sd_val <- sd(samples_exp)\n    cat(sprintf("EXPONENTIAL_DISTRIBUTION_TEST: Mean = %.4f, SD = %.4f\\n", mean_val, sd_val))\n    writeLines(as.character(samples_exp), "/app/exponential_samples.txt")\n    if (abs(mean_val - 1.0) < 0.3 && abs(sd_val - 1.0) < 0.3 && length(samples_exp) == 1000) {\n      cat("EXPONENTIAL_DISTRIBUTION_TEST: PASS\\n")\n    } else {\n      cat("EXPONENTIAL_DISTRIBUTION_TEST: FAIL\\n")\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf("EXPONENTIAL_DISTRIBUTION_TEST: FAIL (Error: %s)\\n", e$message))\n    all_passed <- FALSE\n  })\n  \n  tryCatch({\n    res <- tryCatch(ars(function(x) dnorm(x), domain = c(-Inf, Inf), n = -10), error = function(e) "CAUGHT")\n    res2 <- tryCatch(ars(function(x) dnorm(x), domain = c(5, 1), n = 100), error = function(e) "CAUGHT")\n    if (res == "CAUGHT" && res2 == "CAUGHT") {\n      cat("INPUT_VALIDATION_TEST: Mean = NA, SD = NA\\n")\n      cat("INPUT_VALIDATION_TEST: PASS\\n")\n    } else {\n      cat("INPUT_VALIDATION_TEST: FAIL\\n")\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf("INPUT_VALIDATION_TEST: FAIL (Error: %s)\\n", e$message))\n    all_passed <- FALSE\n  })\n  \n  tryCatch({\n    cauchy_density <- function(x) dcauchy(x)\n    res <- tryCatch(ars(cauchy_density, domain = c(-5, 5), n = 100), error = function(e) "CAUGHT")\n    if (res == "CAUGHT") {\n      cat("NON_LOG_CONCAVE_TEST: Mean = NA, SD = NA\\n")\n      cat("NON_LOG_CONCAVE_TEST: PASS\\n")\n    } else {\n      cat("NON_LOG_CONCAVE_TEST: FAIL\\n")\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf("NON_LOG_CONCAVE_TEST: FAIL (Error: %s)\\n", e$message))\n    all_passed <- FALSE\n  })\n  \n  cat("\\nOverall Test Status: ")\n  if (all_passed) {\n    cat("ALL TESTS PASSED\\n")\n  } else {\n    cat("SOME TESTS FAILED\\n")\n  }\n}\nEOF\nRscript -e \'source("/app/ars.R"); test()\'\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
