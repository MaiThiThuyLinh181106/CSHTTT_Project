, domain[1] + 2.5)\n    }\n  }\n  \n  h <- sapply(x, f_log)\n  s <- sapply(x, function(xi) h_prime(f_log, xi))\n  \n  samples <- numeric(n)\n  count <- 0\n  max_iter <- n * 300\n  iter <- 0\n  \n  while (count < n && iter < max_iter) {\n    iter <- iter + 1\n    k <- length(x)\n    \n    z <- numeric(k + 1)\n    z[1] <- domain[1]\n    z[k + 1] <- domain[2]\n    \n    for (i in 1:(k - 1)) {\n      den <- s[i] - s[i+1]\n      if (abs(den) < 1e-8) {\n        z[i+1] <- (x[i] + x[i+1]) / 2\n      } else {\n        val <- (h[i+1] - h[i] - s[i+1]*x[i+1] + s[i]*x[i]) / den\n        if (is.finite(val) && val > x[i] && val < x[i+1]) {\n          z[i+1] <- val\n        } else {\n          z[i+1] <- (x[i] + x[i+1]) / 2\n        }\n      }\n    }\n    \n    z[is.na(z) | !is.finite(z)] <- (x[1] + x[k]) / 2\n    z <- sort(unique(z))\n    if (length(z) != k + 1) {\n      z <- c(domain[1], seq(min(x), max(x), length.out = k - 1), domain[2])\n      z[is.na(z) | !is.finite(z)] <- 0\n      z <- sort(unique(z))\n      if (length(z) != k + 1) {\n        z <- seq(domain[1], domain[2], length.out = k + 1)\n      }\n    }\n    \n    log_w <- numeric(k)\n    for (i in 1:k) {\n      zi_l <- z[i]\n      zi_r <- z[i+1]\n      hi <- h[i]\n      si <- s[i]\n      if (!is.finite(zi_l) || !is.finite(zi_r) || zi_l >= zi_r) {\n        log_w[i] <- -Inf\n        next\n      }\n      if (abs(si) < 1e-8) {\n        log_w[i] <- hi + log(zi_r - zi_l)\n      } else {\n        term1 <- hi - si * x[i]\n        diff_exp <- exp(si * zi_r) - exp(si * zi_l)\n        if (si < 0) {\n          diff_exp <- exp(si * zi_l) * (exp(si * (zi_r - zi_l)) - 1)\n        }\n        log_w[i] <- term1 + log(max(1e-300, abs(diff_exp))) - log(abs(si))\n      }\n    }\n    \n    if (all(!is.finite(log_w)) || all(log_w == -Inf)) next\n    \n    max_lw <- max(log_w[is.finite(log_w)])\n    w <- exp(log_w - max_lw)\n    if (sum(w) == 0) next\n    prob <- w / sum(w)\n    \n    chosen_int <- sample.int(k, 1, prob = prob)\n    i <- chosen