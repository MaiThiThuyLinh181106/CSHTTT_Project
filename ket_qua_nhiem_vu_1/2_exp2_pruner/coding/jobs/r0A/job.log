Sending keys: ['cat << \'EOF\' > /app/process_dag.py\nimport pandas as pd\nimport networkx as di\n\nedges = [(\'U\', \'M\'), (\'U\', \'Y\'), (\'U\', \'D\'), (\'Y\', \'D\'), (\'R\', \'U\'), (\'R\', \'M\')]\n# Enforce U has no parents: replace (\'R\', \'U\') with (\'U\', \'R\')\nfixed_edges = []\nfor u, v in edges:\n    if v == \'U\':\n        fixed_edges.append((v, u))\n    else:\n        fixed_edges.append((u, v))\n\nprint("Fixed edges:", fixed_edges)\n\n# Check if acyclic\nG = di.DiGraph(fixed_edges)\nprint("Is DAG?", di.is_directed_acyclic_graph(G))\n\n# Format: to,from\n# In pgmpy / networkx edge (u, v) means u -> v, where u is from and v is to.\n# So to=v, from=u.\nlines = ["to,from"]\nfor u, v in fixed_edges:\n    lines.append(f"{v},{u}")\n\nwith open(\'/app/learned_dag.csv\', \'w\') as f:\n    f.write(\'\\n\'.join(lines) + \'\\n\')\n\nprint("Saved learned_dag.csv")\nEOF\npython3 /app/process_dag.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
