l_points <- c(domain[1] + 0.2, domain[1] + 1.0, domain[1] + 2.0)\n  }\n  \n  k <- length(initial_points)\n  x <- initial_points\n  h <- sapply(x, f_log)\n  if (any(!is.finite(h))) {\n    stop("Density evaluated to zero or non-finite value at initial points.")\n  }\n  s <- sapply(x, function(xi) h_prime(f_log, xi))\n  \n  for (i in 1:(k - 1)) {\n    if (s[i] < s[i+1] - 1e-5) {\n      stop("Density is not log-concave: slopes are not monotonically decreasing.")\n    }\n  }\n  \n  samples <- numeric(n)\n  count <- 0\n  max_iterations <- n * 200\n  iter <- 0\n  \n  while (count < n && iter < max_iterations) {\n    iter <- iter + 1\n    k_curr <- length(x)\n    z <- numeric(k_curr + 1)\n    z[1] <- domain[1]\n    z[k_curr + 1] <- domain[2]\n    \n    for (i in 1:(k_curr - 1)) {\n      num <- h[i+1] - h[i] - s[i+1]*x[i+1] + s[i]*x[i]\n      den <- s[i] - s[i+1]\n      if (abs(den) < 1e-12) {\n        z[i+1] <- (x[i] + x[i+1]) / 2\n      } else {\n        z[i+1] <- num / den\n      }\n      if (is.na(z[i+1]) || z[i+1] <= x[i] || z[i+1] >= x[i+1]) {\n        z[i+1] <- (x[i] + x[i+1]) / 2\n      }\n    }\n    \n    log_weights <- numeric(k_curr)\n    for (i in 1:k_curr) {\n      hi <- h[i]\n      si <- s[i]\n      zi_left <- z[i]\n      zi_right <- z[i+1]\n      \n      if (!is.finite(zi_left) || !is.finite(zi_right)) {\n        log_weights[i] <- -Inf\n        next\n      }\n      \n      if (abs(si) < 1e-12) {\n        log_weights[i] <- hi + log(max(1e-300, zi_right - zi_left))\n      } else {\n        term1 <- hi - si * x[i]\n        diff_exp <- exp(si * zi_right) - exp(si * zi_left)\n        if (si < 0) {\n          diff_exp <- exp(si * zi_left) * (exp(si * (zi_right - zi_left)) - 1)\n        }\n        term2 <- log(max(1e-300, abs(diff_exp)))\n        log_weights[i] <- term1 + term2 - log(abs(si))\n      }\n    }\n    \n    if (all(!is.finite(log_weights)) || all(log_weights == -Inf)) {\n      next\n    }\n    \n    max_lw <- max(log_weights[is.finite(log_weights)])\n    weights <- exp(log_weights - max_lw)\n    weights[!is.finite(weights)] <- 0\n    sum_w <- sum(weights)\n    if (sum_w == 0) next\n    prob <- weights / sum_w\n    \n    chosen_interval <- sample.int(k_curr, 1, prob = prob)\n    \n    i <- chosen_interval\n    zi_l <- z[i]\n    zi_r <- z[i+1]\n    hi <- h[i]\n    si <- s[i]\n    \n    u_unif <- runif(1)\n    if (abs(si) < 1e-12) {\n      x_star <- zi_l + u_unif * (zi_r - zi_l)\n    } else {\n      term_l <- si * (zi_l - x[i])\n      term_r <- si * (zi_r - x[i])\n      diff_er <- exp(term_r) - exp(term_l)\n      if (abs(diff_er) < 1e-300) {\n        x_star <- (zi_l + zi_r) / 2\n      } else {\n        val <- term_l + log(max(1e-300, u_unif * diff_er + exp(term_l)))\n        x_star <- x[i] + val / si\n      }\n    }\n    \n    if (!is.finite(x_star) || x_star < domain[1] || x_star > domain[2]) {\n      next\n    }\n    \n    h_star <- f_log(x_star)\n    if (!is.finite(h_star)) {\n      next\n    }\n    \n    interval_idx <- findInterval(x_star, z, rightmost.closed = TRUE)\n    interval_idx <- max(1, min(interval_idx, k_curr))\n    u_star <- h[interval_idx] + s[interval_idx] * (x_star - x[interval_idx])\n    \n    if (h_star > u_star + 1e-5) {\n      stop("Density is not log-concave: evaluated log-density exceeds upper envelope.")\n    }\n    \n    l_star <- -Inf\n    if (x_star >= x[1] && x_star <= x[k]) {\n      j <- max(which(x <= x_star))\n      if (j < k_curr || (j == k_curr && x_star == x[k])) {\n        if (j == k_curr) j <- k_curr - 1\n        l_star <- h[j] + (h[j+1] - h[j]) / (x[j+1] - x[j]) * (x_star - x[j])\n      }\n    }\n    \n    v <- runif(1)\n    accepted <- FALSE\n    if (is.finite(l_star) && v <= exp(l_star - u_star)) {\n      accepted <- TRUE\n    } else if (v <= exp(h_star - u_star)) {\n      accepted <- TRUE\n    }\n    \n    s_star <- h_prime(f_log, x_star)\n    insert_idx <- findInterval(x_star, x) + 1\n    x <- c(x[1:(insert_idx-1)], x_star, x[insert_idx:k_curr])\n    h <- c(h[1:(insert_idx-1)]