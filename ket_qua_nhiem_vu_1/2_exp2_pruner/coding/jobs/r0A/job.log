Sending keys: ['python3 -c \'\ncode = """# Adaptive Rejection Sampling (ARS) in R\n# Based on Gilks & Wild (1992)\n\nh_prime <- function(f_log, x, eps = 1e-4) {\n  val1 <- f_log(x + eps)\n  val2 <- f_log(x - eps)\n  if (!is.finite(val1) || !is.finite(val2)) return(0)\n  (val1 - val2) / (2 * eps)\n}\n\nvalidate_ars_inputs <- function(density_function, domain, n) {\n  if (!is.function(density_function)) {\n    stop(\\"density_function must be a valid R function.\\")\n  }\n  if (!is.numeric(domain) || length(domain) != 2 || domain[1] >= domain[2]) {\n    stop(\\"domain must be a numeric vector of length 2 with domain[1] < domain[2].\\")\n  }\n  if (!is.numeric(n) || length(n) != 1 || n <= 0 || n != round(n)) {\n    stop(\\"n must be a positive integer.\\")\n  }\n}\n\nars <- function(density_function, domain, n = 1000, initial_points = NULL) {\n  validate_ars_inputs(density_function, domain, n)\n  \n  f_log <- function(x) {\n    res <- density_function(x)\n    res[is.na(res)] <- 0\n    res[res < 0] <- 0\n    res[res == 0] <- 1e-300\n    log_res <- log(res)\n    log_res[x < domain[1] | x > domain[2]] <- -Inf\n    return(log_res)\n  }\n  \n  if (is.null(initial_points)) {\n    if (is.finite(domain[1]) && is.finite(domain[2])) {\n      initial_points <- seq(domain[1] + 0.2 * (domain[2] - domain[1]), \n                            domain[2] - 0.2 * (domain[2] - domain[1]), length.out = 4)\n    } else if (is.infinite(domain[1]) && is.infinite(domain[2])) {\n      initial_points <- c(-2, -1, 0, 1, 2)\n    } else if (is.infinite(domain[1])) {\n      initial_points <- c(domain[2] - 3, domain[2] - 2, domain[2] - 1, domain[2])\n    } else {\n      initial_points <- c(domain[1], domain[1] + 1, domain[1] + 2, domain[1] + 3)\n    }\n  }\n  \n  initial_points <- sort(unique(initial_points))\n  if (length(initial_points) < 2) {\n    stop(\\"At least 2 unique initial points are required.\\")\n  }\n  \n  k <- length(initial_points)\n  x <- initial_points\n  h <- sapply(x, f_log)\n  if (any(!is.finite(h))) {\n    stop(\\"Density evaluated to zero or non-finite value at initial points.\\")\n  }\n  s <- sapply(x, function(xi) h_prime(f_log, xi))\n  \n  for (i in 1:(k - 1)) {\n    if (s[i] < s[i+1]) {\n      stop(\\"Density is not log-concave: slopes are not monotonically decreasing.\\")\n    }\n  }\n  \n  samples <- numeric(n)\n  count <- 0\n  max_iterations <- n * 200\n  iter <- 0\n  \n  while (count < n && iter < max_iterations) {\n    iter <- iter + 1\n    k_curr <- length(x)\n    z <- numeric(k_curr + 1)\n    z[1] <- domain[1]\n    z[k_curr + 1] <- domain[2]\n    \n    for (i in 1:(k_curr - 1)) {\n      num <- h[i+1] - h[i] - s[i+1]*x[i+1] + s[i]*x[i]\n      den <- s[i] - s[i+1]\n      if (abs(den) < 1e-12) {\n        z[i+1] <- (x[i] + x[i+1]) / 2\n      } else {\n        z[i+1] <- num / den\n      }\n      if (is.na(z[i+1]) || z[i+1] <= x[i] || z[i+1] >= x[i+1]) {\n        z[i+1] <- (x[i] + x[i+1]) / 2\n      }\n    }\n    \n    log_weights <- numeric(k_curr)\n    for (i in 1:k_curr) {\n      hi <- h[i]\n      si <- s[i]\n      zi_left <- z[i]\n      zi_right <- z[i+1]\n      \n      if (!is.finite(zi_left) || !is.finite(zi_right)) {\n        log_weights[i] <- -Inf\n        next\n      }\n      \n      if (abs(si) < 1e-12) {\n        log_weights[i] <- hi + log(max(1e-300, zi_right - zi_left))\n      } else {\n        term1 <- hi - si * x[i]\n        diff_exp <- exp(si * zi_right) - exp(si * zi_left)\n        if (si < 0) {\n          diff_exp <- exp(si * zi_left) * (exp(si * (zi_right - zi_left)) - 1)\n        }\n        term2 <- log(max(1e-300, abs(diff_exp)))\n        log_weights[i] <- term1 + term2 - log(abs(si))\n      }\n    }\n    \n    if (all(!is.finite(log_weights)) || all(log_weights == -Inf)) {\n      next\n    }\n    \n    max_lw <- max(log_weights[is.finite(log_weights)])\n    weights <- exp(log_weights - max_lw)\n    weights[!is.finite(weights)] <- 0\n    sum_w <- sum(weights)\n    if (sum_w == 0) next\n    prob <- weights / sum_w\n    \n    chosen_interval <- sample.int(k_curr, 1, prob = prob)\n    \n    i <- chosen_interval\n    zi_l <- z[i]\n    zi_r <- z[i+1]\n    hi <- h[i]\n    si <- s[i]\n    \n    u_unif <- runif(1)\n    if (abs(si) < 1e-12) {\n      x_star <- zi_l + u_unif * (zi_r - zi_l)\n    } else {\n      term_l <- si * (zi_l - x[i])\n      term_r <- si * (zi_r - x[i])\n      diff_er <- exp(term_r) - exp(term_l)\n      if (abs(diff_er) < 1e-300) {\n        x_star <- (zi_l + zi_r) / 2\n      } else {\n        val <- term_l + log(max(1e-300, u_unif * diff_er + exp(term_l)))\n        x_star <- x[i] + val / si\n      }\n    }\n    \n    if (!is.finite(x_star) || x_star < domain[1] || x_star > domain[2]) {\n      next\n    }\n    \n    h_star <- f_log(x_star)\n    if (!is.finite(h_star)) {\n      next\n    }\n    \n    interval_idx <- findInterval(x_star, z, rightmost.closed = TRUE)\n    interval_idx <- max(1, min(interval_idx, k_curr))\n    u_star <- h[interval_idx] + s[interval_idx] * (x_star - x[interval_idx])\n    \n    if (h_star > u_star + 1e-5) {\n      stop(\\"Density is not log-concave: evaluated log-density exceeds upper envelope.\\")\n    }\n    \n    l_star <- -Inf\n    if (x_star >= x[1] && x_star <= x[k]) {\n      j <- max(which(x <= x_star))\n      if (j < k_curr || (j == k_curr && x_star == x[k])) {\n        if (j == k_curr) j <- k_curr - 1\n        l_star <- h[j] + (h[j+1] - h[j]) / (x[j+1] - x[j]) * (x_star - x[j])\n      }\n    }\n    \n    v <- runif(1)\n    accepted <- FALSE\n    if (is.finite(l_star) && v <= exp(l_star - u_star)) {\n      accepted <- TRUE\n    } else if (v <= exp(h_star - u_star)) {\n      accepted <- TRUE\n    }\n    \n    s_star <- h_prime(f_log, x_star)\n    insert_idx <- findInterval(x_star, x) + 1\n    x <- c(x[1:(insert_idx-1)], x_star, x[insert_idx:k_curr])\n    h <- c(h[1:(insert_idx-1)], h_star, h[insert_idx:k_curr])\n    s <- c(s[1:(insert_idx-1)], s_star, s[insert_idx:k_curr])\n    k_curr <- length(x)\n    \n    for (i in 1:(k_curr - 1)) {\n      if (s[i] < s[i+1]) {\n        stop(\\"Density is not log-concave: slopes are not monotonically decreasing after adding abscissa.\\")\n      }\n    }\n    \n    if (accepted) {\n      count <- count + 1\n      samples[count] <- x_star\n    }\n  }\n  \n  if (count < n) {\n    warning(\\"Maximum iterations reached before collecting all samples.\\")\n    samples <- samples[1:count]\n  }\n  \n  return(samples)\n}\n\ntest <- function() {\n  cat(\\"Running Adaptive Rejection Sampling Tests...\\\\n\\\\n\\")\n  all_passed <- TRUE\n  \n  tryCatch({\n    set.seed(42)\n    samples_norm <- ars(function(x) dnorm(x, mean = 0, sd = 1), domain = c(-Inf, Inf), n = 1000)\n    mean_val <- mean(samples_norm)\n    sd_val <- sd(samples_norm)\n    cat(sprintf(\\"NORMAL_DISTRIBUTION_TEST: Mean = %.4f, SD = %.4f\\\\n\\", mean_val, sd_val))\n    writeLines(as.character(samples_norm), \\"/app/normal_samples.txt\\")\n    if (abs(mean_val) < 0.2 && abs(sd_val - 1.0) < 0.2 && length(samples_norm) == 1000) {\n      cat(\\"NORMAL_DISTRIBUTION_TEST: PASS\\\\n\\")\n    } else {\n      cat(\\"NORMAL_DISTRIBUTION_TEST: FAIL\\\\n\\")\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf(\\"NORMAL_DISTRIBUTION_TEST: FAIL (Error: %s)\\\\n\\", e$message))\n    all_passed <- FALSE\n  })\n  \n  tryCatch({\n    set.seed(42)\n    samples_exp <- ars(function(x) dexp(x, rate = 1), domain = c(0, Inf), n = 1000)\n    mean_val <- mean(samples_exp)\n    sd_val <- sd(samples_exp)\n    cat(sprintf(\\"EXPONENTIAL_DISTRIBUTION_TEST: Mean = %.4f, SD = %.4f\\\\n\\", mean_val, sd_val))\n    writeLines(as.character(samples_exp), \\"/app/exponential_samples.txt\\")\n    if (abs(mean_val - 1.0) < 0.2 && abs(sd_val - 1.0) < 0.2 && length(samples_exp) == 1000) {\n      cat(\\"EXPONENTIAL_DISTRIBUTION_TEST: PASS\\\\n\\")\n    } else {\n      cat(\\"EXPONENTIAL_DISTRIBUTION_TEST: FAIL\\\\n\\")\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf(\\"EXPONENTIAL_DISTRIBUTION_TEST: FAIL (Error: %s)\\\\n\\", e$message))\n    all_passed <- FALSE\n  })\n  \n  tryCatch({\n    res <- tryCatch(ars(function(x) dnorm(x), domain = c(-Inf, Inf), n = -10), error = function(e) \\"CAUGHT\\")\n    res2 <- tryCatch(ars(function(x) dnorm(x), domain = c(5, 1), n = 100), error = function(e) \\"CAUGHT\\")\n    if (res == \\"CAUGHT\\" && res2 == \\"CAUGHT\\") {\n      cat(\\"INPUT_VALIDATION_TEST: Mean = NA, SD = NA\\\\n\\")\n      cat(\\"INPUT_VALIDATION_TEST: PASS\\\\n\\")\n    } else {\n      cat(\\"INPUT_VALIDATION_TEST: FAIL\\\\n\\")\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf(\\"INPUT_VALIDATION_TEST: FAIL (Error: %s)\\\\n\\", e$message))\n    all_passed <- FALSE\n  })\n  \n  tryCatch({\n    cauchy_density <- function(x) dcauchy(x)\n    res <- tryCatch(ars(cauchy_density, domain = c(-5, 5), n = 100), error = function(e) \\"CAUGHT\\")\n    if (res == \\"CAUGHT\\") {\n      cat(\\"NON_LOG_CONCAVE_TEST: Mean = NA, SD = NA\\\\n\\")\n      cat(\\"NON_LOG_CONCAVE_TEST: PASS\\\\n\\")\n    } else {\n      cat(\\"NON_LOG_CONCAVE_TEST: FAIL\\\\n\\")\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf(\\"NON_LOG_CONCAVE_TEST: FAIL (Error: %s)\\\\n\\", e$message))\n    all_passed <- FALSE\n  })\n  \n  cat("\\\\nOverall Test Status: ")\n  if (all_passed) {\n    cat("ALL TESTS PASSED\\\\n\\")\n  } else {\n    cat("SOME TESTS FAILED\\\\n\\")\n  }\n}\n"""\nwith open("/app/ars.R", "w") as f:\n    f.write(code)\n\'\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
