[?2004l[?2004h>         fixed_edges.append((u, v))
[?2004l[?2004h> 
[?2004l[?2004h> print("Fixed edges:", fixed_edges)
[?2004l[?2004h> 
[?2004l[?2004h> # Check if acyclic
[?2004l[?2004h> G = di.DiGraph(fixed_edges)
[?2004l[?2004h> print("Is DAG?", di.is_directed_acyclic_graph(G))
[?2004l[?2004h> 
[?2004l[?2004h> # Format: to,from
[?2004l[?2004h> # In pgmpy / networkx edge (u, v) means u -> v, where u is from and v is to.
[?2004l[?2004h> # So to=v, from=u.
[?2004l[?2004h> lines = ["to,from"]
[?2004l[?2004h> for u, v in fixed_edges:
