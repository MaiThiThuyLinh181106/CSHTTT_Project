[?2004l[?2004h> edges = [('U', 'M'), ('U', 'Y'), ('U', 'D'), ('Y', 'D'), ('U', 'R'), ('R', 'M')]
[?2004l[?2004h> 
[?2004l[?2004h> model = BayesianNetwork(edges)
[?2004l[?2004h> model.fit(df, estimator=MaximumLikelihoodEstimator)
[?2004l[?2004h> 
[?2004l[?2004h> print("Fitted model CPDs:", model.get_cpds())
[?2004l[?2004h> 
[?2004l[?2004h> # 1) learned_dag.csv already saved, but let's re-save properly
[?2004l[?2004h> learned_lines = ["to,from"]
[?2004l[?2004h> for u, v in edges:
[?2004l[?2004h>     learned_lines.append(f"{v},{u}")
[?2004l[?2004h> with open('/app/learned_dag.csv', 'w') as f:
[?2004l[?2004h>     f.write('\n'.join(learned_lines) + '\n')
[?2004l[?2004h> 
[?2004l[?2004h> # 3) Intervention on Y: setting Y = 0.0 (or variance 10e-9)
[?2004l[?2004h> # In a Bayesian Network, do(Y=0.0) means removing parents of Y and setting Y CPD to constant 0.0 (or Gaussian with mean 0, var 10e-9)
[?2004l[?2004h> intervened_edges = [e for e in edges if e[1] != 'Y']
[?2004l[?2004h> print("Intervened edges:", intervened_edges)
