[?2004l[?2004h> intervened_lines = ["to,from"]
[?2004l[?2004h> for u, v in intervened_edges:
[?2004l[?2004h>     intervened_lines.append(f"{v},{u}")
[?2004l[?2004h> with open('/app/intervened_dag.csv', 'w') as f:
[?2004l[?2004h>     f.write('\n'.join(intervened_lines) + '\n')
[?2004l[?2004h> 
[?2004l[?2004h> intervened_model = BayesianNetwork(intervened_edges)
[?2004l[?2004h> intervened_model.fit(df, estimator=MaximumLikelihoodEstimator)
[?2004l[?2004h> 
[?2004l[?2004h> # Override CPD for Y to be 0 with tiny variance (or constant 0)
[?2004l[?2004h> # Since pgmpy LinearGaussianCPD expects mean as linear combination of parents (none for Y now) and variance
[?2004l[?2004h> from pgmpy.factors.continuous import LinearGaussianCPD
[?2004l[?2004h> # Y has no parents now
[?2004l[?2004h> y_cpd = LinearGaussianCPD('Y', beta=[0.0], std=np.sqrt(10e-9), evidence=[])
[?2004l[?2004h> intervened_model.add_cpds(y_cpd)
[?2004l[?2004h> 
[?2004l[?2004h> # Sample 10k points
