Sending keys: ['cat << \'EOF\' > /app/ars.R\n# Adaptive Rejection Sampling (ARS) in R\n# Reference: Gilks, W. R., & Wild, P. (1992). Adaptive rejection sampling for Gibbs sampling.\n\nars <- function(density_function, domain, n = 1000, x = NULL, lb = TRUE, ub = TRUE, max_points = 100) {\n  # 1. Input Validation\n  if (!is.function(density_function)) {\n    stop("density_function must be a valid R function.")\n  }\n  if (!is.numeric(domain) || length(domain) != 2 || domain[1] >= domain[2]) {\n    stop("domain must be a numeric vector of length 2 representing (lower, upper).")\n  }\n  if (!is.numeric(n) || length(n) != 1 || n <= 0 || n %% 1 != 0) {\n    stop("n must be a positive integer representing sample count.")\n  }\n\n  # Initialize initial evaluation points if not provided\n  if (is.null(x)) {\n    lower <- domain[1]\n    upper <- domain[2]\n    if (is.infinite(lower)) lower <- -5\n    if (is.infinite(upper)) upper <- 5\n    if (lower >= upper) {\n      lower <- -2\n      upper <- 2\n    }\n    x <- sort(unique(c(lower, (lower + upper) / 2, upper)))\n    if (length(x) < 3) {\n      x <- sort(unique(c(lower, lower + (upper - lower) * 0.25, lower + (upper - lower) * 0.75, upper)))\n    }\n  } else {\n    x <- sort(unique(x))\n    if (any(x < domain[1] | x > domain[2])) {\n      stop("Initial points x must fall within domain.")\n    }\n    if (length(x) < 2) {\n      stop("At least 2 initial points are required.")\n    }\n  }\n\n  # Evaluate log density and derivatives (finite differences)\n  eval_log_density <- function(pts) {\n    vals <- density_function(pts)\n    if (any(is.na(vals) | vals < 0)) {\n      stop("Density function returned NA or negative values.")\n    }\n    vals[vals == 0] <- .Machine$double.xmin\n    log_vals <- log(vals)\n    if (any(is.infinite(log_vals))) {\n      stop("Log density resulted in infinite values.")\n    }\n    return(log_vals)\n  }\n\n  h <- eval_log_density(x)\n  calc_derivatives <- function(pts, vals) {\n    k <- length(pts)\n    derivs <- numeric(k)\n    for (i in 1:k) {\n      if (i == 1) {\n        derivs[i] <- (vals[2] - vals[1]) / (pts[2] - pts[1])\n      } else if (i == k) {\n        derivs[i] <- (vals[k] - vals[k-1]) / (pts[k] - pts[k-1])\n      } else {\n        derivs[i] <- (vals[i+1] - vals[i-1]) / (pts[i+1] - pts[i-1])\n      }\n    }\n    return(derivs)\n  }\n\n  h_prime <- calc_derivatives(x, h)\n\n  check_log_concavity <- function(pts, vals, derivs) {\n    k <- length(pts)\n    for (i in 1:(k - 1)) {\n      if (derivs[i] < derivs[i+1] - 1e-5) {\n        return(FALSE)\n      }\n    }\n    return(TRUE)\n  }\n\n  if (!check_log_concavity(x, h, h_prime)) {\n    stop("Error: Density function is not log-concave across initial points.")\n  }\n\n  update_hulls <- function(pts, vals, derivs) {\n    k <- length(pts)\n    z <- numeric(k + 1)\n    z[1] <- domain[1]\n    z[k + 1] <- domain[2]\n\n    for (i in 1:(k - 1)) {\n      denom <- derivs[i] - derivs[i+1]\n      if (abs(denom) < 1e-12) {\n        z[i+1] <- (pts[i] + pts[i+1]) / 2\n      } else {\n        z[i+1] <- (vals[i+1] - vals[i] - derivs[i+1]*pts[i+1] + derivs[i]*pts[i]) / denom\n        if (z[i+1] < pts[i] || z[i+1] > pts[i+1]) {\n          z[i+1] <- (pts[i] + pts[i+1]) / 2\n        }\n      }\n    }\n    return(z)\n  }\n\n  samples <- numeric(n)\n  count <- 0\n\n  while (count < n) {\n    z <- update_hulls(x, h, h_prime)\n    k <- length(x)\n\n    integrals <- numeric(k)\n    for (i in 1:k) {\n      hi <- h[i]\n      hpi <- h_prime[i]\n      zi <- z[i]\n      zip1 <- z[i+1]\n      xi_val <- x[i]\n      if (abs(hpi) < 1e-12) {\n        integrals[i] <- exp(hi) * (zip1 - zi)\n      } else {\n        integrals[i] <- (exp(hi) / hpi) * (exp(hpi * (zip1 - xi_val)) - exp(hpi * (zi - xi_val)))\n      }\n      if (is.na(integrals[i]) || integrals[i] < 0) integrals[i] <- 0\n    }\n\n    total_integral <- sum(integrals)\n    if (total_integral <= 0 || is.na(total_integral)) {\n      stop("Upper hull integral calculation failed or is zero.")\n    }\n\n    probs <- integrals / total_integral\n    interval_idx <- sample.int(k, size = 1, prob = probs)\n\n    hi <- h[interval_idx]\n    hpi <- h_prime[interval_idx]\n    zi <- z[interval_idx]\n    zip1 <- z[interval_idx+1]\n    xi <- x[interval_idx]\n\n    u_rand <- runif(1)\n    if (abs(hpi) < 1e-12) {\n      x_star <- zi + u_rand * (zip1 - zi)\n    } else {\n      term1 <- exp(hpi * (zi - xi))\n      term2 <- exp(hpi * (zip1 - xi))\n      x_star <- xi + (1 / hpi) * log(term1 + u_rand * (term2 - term1))\n    }\n\n    if (is.na(x_star) || x_star < domain[1] || x_star > domain[2]) {\n      next\n    }\n\n    h_star <- eval_log_density(x_star)\n\n    pos <- findInterval(x_star, x)\n    if (pos > 0 && pos < length(x)) {\n      slope_left <- (h_star - h[pos]) / (x_star - x[pos])\n      slope_right <- (h[pos+1] - h_star) / (x[pos+1] - x_star)\n      if (slope_left < slope_right - 1e-4) {\n        stop(paste0("Non-log-concave density detected at sample x = ", x_star))\n      }\n    }\n\n    s_star <- -Inf\n    if (x_star >= x[1] && x_star <= x[k]) {\n      if (pos == 0) pos <- 1\n      if (pos >= k) pos <- k - 1\n      t_val <- (x_star - x[pos]) / (x[pos+1] - x[pos])\n      s_star <- (1 - t_val) * h[pos] + t_val * h[pos+1]\n    }\n\n    u_star <- hi + hpi * (x_star - xi)\n\n    w <- runif(1)\n    accepted <- FALSE\n\n    if (w <= exp(s_star - u_star)) {\n      accepted <- TRUE\n    } else {\n      if (w <= exp(h_star - u_star)) {\n        accepted <- TRUE\n      }\n    }\n\n    if (accepted) {\n      count <- count + 1\n      samples[count] <- x_star\n    }\n\n    if (!(x_star %in% x)) {\n      x <- c(x, x_star)\n      ord <- order(x)\n      x <- x[ord]\n      h <- eval_log_density(x)\n      h_prime <- calc_derivatives(x, h)\n\n      if (!check_log_concavity(x, h, h_prime)) {\n        stop("Error: Non-log-concave density encountered during hull expansion.")\n      }\n\n      if (length(x) > max_points) {\n        x <- x[seq(1, length(x), by = max(1, floor(length(x) / 30)))]\n        h <- eval_log_density(x)\n        h_prime <- calc_derivatives(x, h)\n      }\n    }\n  }\n\n  return(samples)\n}\n\ntest <- function() {\n  cat("Running Adaptive Rejection Sampling (ARS) tests...\\n\\n")\n  all_passed <- TRUE\n\n  set.seed(42)\n  tryCatch({\n    norm_samples <- ars(function(z) dnorm(z, mean = 0, sd = 1), domain = c(-4, 4), n = 1000)\n    mean_val <- mean(norm_samples)\n    sd_val <- sd(norm_samples)\n    \n    if (abs(mean_val) < 0.2 && abs(sd_val - 1) < 0.2) {\n      cat(sprintf("NORMAL_TEST: PASS (mean: %.4f, sd: %.4f)\\n", mean_val, sd_val))\n      writeLines(as.character(norm_samples), "/app/normal_samples.txt")\n    } else {\n      cat(sprintf("NORMAL_TEST: FAIL (mean: %.4f, sd: %.4f)\\n", mean_val, sd_val))\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf("NORMAL_TEST: FAIL (Error: %s)\\n", e$message))\n    all_passed <- FALSE\n  })\n\n  set.seed(42)\n  tryCatch({\n    exp_samples <- ars(function(z) dexp(z, rate = 1), domain = c(0.01, 10), n = 1000)\n    mean_val <- mean(exp_samples)\n    sd_val <- sd(exp_samples)\n    \n    if (abs(mean_val - 1) < 0.2 && abs(sd_val - 1) < 0.2) {\n      cat(sprintf("EXPONENTIAL_TEST: PASS (mean: %.4f, sd: %.4f)\\n", mean_val, sd_val))\n      writeLines(as.character(exp_samples), "/app/exponential_samples.txt")\n    } else {\n      cat(sprintf("EXPONENTIAL_TEST: FAIL (mean: %.4f, sd: %.4f)\\n", mean_val, sd_val))\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf("EXPONENTIAL_TEST: FAIL (Error: %s)\\n", e$message))\n    all_passed <- FALSE\n  })\n\n  tryCatch({\n    ars(function(z) dnorm(z), domain = c(-3, 3), n = -10)\n    cat("INPUT_VALIDATION_TEST: FAIL (Should have rejected negative n)\\n")\n    all_passed <- FALSE\n  }, error = function(e) {\n    cat("INPUT_VALIDATION_TEST: PASS (Correctly caught invalid input)\\n")\n  })\n\n  tryCatch({\n    ars(function(z) exp(z^2), domain = c(-2, 2), n = 100)\n    cat("NON_LOG_CONCAVE_TEST: FAIL (Should have detected non-log-concave density)\\n")\n    all_passed <- FALSE\n  }, error = function(e) {\n    cat("NON_LOG_CONCAVE_TEST: PASS (Correctly detected non-log-concave density)\\n")\n  })\n\n  if (all_passed) {\n    cat("\\nOVERALL_TEST_STATUS: PASS\\n")\n  } else {\n    cat("\\nOVERALL_TEST_STATUS: FAIL\\n")\n  }\n}\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
