[21.994156, "i", "cat << 'EOF' > parse_elf.js\nconst fs = require('fs');\nconst buf = fs.readFileSync('/app/a.out');\n\nconst e_phoff = buf.readBigUInt64LE(0x20);\nconst e_phentsize = buf.readUInt16LE(0x36);\nconst e_phnum = buf.readUInt16LE(0x38);\n\nconsole.log({ e_phoff: Number(e_phoff), e_phentsize, e_phnum });\n\nfor (let i = 0; i < e_phnum; i++) {\n  const offset = Number(e_phoff) + i * e_phentsize;\n  const p_type = buf.readUInt32LE(offset);\n  const p_flags = buf.readUInt32LE(offset + 4);\n  const p_offset = buf.readBigUInt64LE(offset + 8);\n  const p_vaddr = buf.readBigUInt64LE(offset + 16);\n  const p_filesz = buf.readBigUInt64LE(offset + 32);\n  const p_memsz = buf.readBigUInt64LE(offset + 40);\n  \n  if (p_type === 1) { // PT_LOAD\n    console.log(`LOAD: vaddr=0x${p_vaddr.toString(16)}, offset=0x${p_offset.toString(16)}, filesz=0x${p_filesz.toString(16)}, memsz=0x${p_memsz.toString(16)}`);\n  }\n}\nEOF\nnode parse_elf.js\n"]
