Sending keys: ["cat << 'EOF' > /app/extract.js\nconst fs = require('fs');\n\nfunction extract(filePath) {\n    const content = fs.readFileSync(filePath);\n    const e_phoff = content.readBigUInt64LE(32);\n    const e_phentsize = content.readUInt16LE(54);\n    const e_phnum = content.readUInt16LE(56);\n\n    const base = 0x400000;\n    const res = {};\n\n    for (let i = 0; i < e_phnum; i++) {\n        const ph_offset = Number(e_phoff) + i * e_phentsize;\n        const p_type = content.readUInt32LE(ph_offset);\n        // p_flags is at +4\n        const p_offset = content.readBigUInt64LE(ph_offset + 8);\n        const p_vaddr = content.readBigUInt64LE(ph_offset + 16);\n        // p_paddr at +24\n        const p_filesz = content.readBigUInt64LE(ph_offset + 32);\n        const p_memsz = content.readBigUInt64LE(ph_offset + 40);\n\n        if (p_type === 1) { // PT_LOAD\n            let filesz = Number(p_filesz);\n            let memsz = Number(p_memsz);\n            let fileoff = Number(p_offset);\n            let vaddr = Number(p_vaddr);\n\n            let seg_data = Buffer.alloc(memsz);\n            content.copy(seg_data, 0, fileoff, fileoff + filesz);\n\n            for (let off = 0; off < memsz; off += 4) {\n                if (off + 4 <= seg_data.length) {\n                    const val = seg_data.readUInt32LE(off);\n                    const addr = base + vaddr + off;\n                    res[addr] = val;\n                }\n            }\n        }\n    }\n\n    console.log(JSON.stringify(res));\n}\n\nconst args = process.argv.slice(2);\nif (args.length > 0) {\n    extract(args[0]);\n}\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
