[53.085869, "i", "cat << 'EOF' > /app/extract.js\nconst fs = require('fs');\n\nfunction extract(filePath) {\n    const content = fs.readFileSync(filePath);\n    const e_phoff = content.readBigUInt64LE(32);\n    const e_phentsize = content.readUInt16LE(54);\n    const e_phnum = content.readUInt16LE(56);\n\n    const base = 0x400000;\n    const res = {};\n\n    for (let i = 0; i < e_phnum; i++) {\n        const ph_offset = Number(e_phoff) + i * e_phentsize;\n        const p_type = content.readUInt32LE(ph_offset);\n        // p_flags is at +4\n        const p_offset = content.readBigUInt64LE(ph_offset + 8);\n        const p_vaddr = content.readBigUInt64LE(ph_offset + 16);\n        // p_paddr at +24\n        const p_filesz = content.readBigUInt64LE(ph_offset + 32);\n        const p_memsz = content.readBigUInt64LE(ph_offset + 40);\n\n        if (p_type === 1) { // PT_LOAD\n            let filesz = Number(p_filesz);\n            let memsz = Number(p_memsz);\n            let fileoff = Number(p_offset);\n            let vaddr = Number(p_vaddr);\n\n            let seg_data = Buffer.alloc(memsz);\n            content.copy(seg_data, 0, fileoff, fileoff + filesz);\n\n            for (let off = 0; off < memsz; off += 4) {\n                if (off + 4 <= seg_data.length) {\n                    const val = seg_data.readUInt32LE(off);\n                    const addr = base + vaddr + off;\n                    res[addr] = val;\n                }\n            }\n        }\n    }\n\n    console.log(JSON.stringify(res));\n}\n\nconst args = process.argv.slice(2);\nif (args.length > 0) {\n    extract(args[0]);\n}\nEOF\n"]
[53.086212, "o", "cat << 'EOF' > /app/extract.js\r\n\u001b[?2004l\r"]
[53.086331, "o", "\u001b[?2004h> const fs = require('fs');\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.086539, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.086767, "o", "function extract(filePath) {\r\n\u001b[?2004l\r\u001b[?2004h>     const content = fs.readFileSync(filePath);\r\n\u001b[?2004l\r\u001b[?2004h>     const e_phoff = content.readBigUInt64LE(32);\r\n\u001b[?2004l\r"]
[53.086876, "o", "\u001b[?2004h>     const e_phentsize = content.readUInt16LE(54);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.087117, "o", "    const e_phnum = content.readUInt16LE(56);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.087351, "o", "    const base = 0x400000;\r\n\u001b[?2004l\r\u001b[?2004h>     const res = {};\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.087552, "o", "    for (let i = 0; i < e_phnum; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         const ph_offset = Number(e_phoff) + i * e_phentsize;\r\n\u001b[?2004l\r"]
[53.087707, "o", "\u001b[?2004h> "]
[53.087812, "o", "        const p_type = content.readUInt32LE(ph_offset);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.088093, "o", "        // p_flags is at +4\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.08821, "o", "        const p_offset = content.readBigUInt64LE(ph_offset + 8);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.088474, "o", "        const p_vaddr = content.readBigUInt64LE(ph_offset + 16);\r\n\u001b[?2004l\r\u001b[?2004h>         // p_paddr at +24\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.088667, "o", "        const p_filesz = content.readBigUInt64LE(ph_offset + 32);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.088865, "o", "        const p_memsz = content.readBigUInt64LE(ph_offset + 40);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[53.089064, "o", "\u001b[?2004l\r\u001b[?2004h>         if (p_type === 1) { // PT_LOAD\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.089179, "o", "            let filesz = Number(p_filesz);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.089383, "o", "            let memsz = Number(p_memsz);\r\n\u001b[?2004l\r\u001b[?2004h>             let fileoff = Number(p_offset);\r\n\u001b[?2004l\r"]
[53.089454, "o", "\u001b[?2004h"]
[53.089707, "o", ">             let vaddr = Number(p_vaddr);\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.089859, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>             let seg_data = Buffer.alloc(memsz);\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.089969, "o", ">             content.copy(seg_data, 0, fileoff, fileoff + filesz);\r\n\u001b[?2004l\r"]
[53.09008, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.090307, "o", "            for (let off = 0; off < memsz; off += 4) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.090402, "o", "                if (off + 4 <= seg_data.length) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.090552, "o", "                    const val = seg_data.readUInt32LE(off);\r\n\u001b[?2004l\r"]
[53.090801, "o", "\u001b[?2004h>                     const addr = base + vaddr + off;\r\n\u001b[?2004l\r\u001b[?2004h>                     res[addr] = val;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.090911, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[53.091127, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.09124, "o", "    console.log(JSON.stringify(res));\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.091428, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> const args = process.argv.slice(2);\r\n\u001b[?2004l\r"]
[53.091642, "o", "\u001b[?2004h> if (args.length > 0) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.091854, "o", ">     extract(args[0]);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.092088, "o", "EOF\r\n\u001b[?2004l\r"]
