[48.589443, "i", "python3 -c \"\nimport struct\nwith open('/app/a.out', 'rb') as f:\n    content = f.read()\ne_phoff, = struct.unpack_from('<Q', content, 32)\ne_phentsize, = struct.unpack_from('<H', content, 54)\ne_phnum, = struct.unpack_from('<H', content, 56)\nbase = 0x400000\nres = {}\nfor i in range(e_phnum):\n    ph_offset = e_phoff + i * e_phentsize\n    p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align = struct.unpack_from('<IIQQQQQQ', content, ph_offset)\n    if p_type == 1:\n        seg_data = content[p_offset:p_offset+p_filesz]\n        if p_memsz > p_filesz:\n            seg_data += b'\\x00' * (p_memsz - p_filesz)\n        for off in range(0, len(seg_data), 4):\n            if off + 4 <= len(seg_data):\n                val = struct.unpack_from('<I', seg_data, off)[0]\n                addr = base + p_vaddr + off\n                res[addr] = val\nprint(4194304 in res, res.get(4194304))\n\"\n"]
