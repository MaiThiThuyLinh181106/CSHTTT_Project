[40.392123, "i", "python3 -c \"\nimport struct\n\nwith open('/app/a.out', 'rb') as f:\n    content = f.read()\n\n# Parse ELF header\n# e_ident (16), e_type (2), e_machine (2), e_version (4), e_entry (8)\n# e_phoff (8), e_shoff (8), e_flags (4), e_ehsize (2), e_phentsize (2)\n# e_phnum (2), e_shentsize (2), e_shnum (2), e_shstrndx (2)\n\ne_phoff, = struct.unpack_from('<Q', content, 32)\ne_phentsize, = struct.unpack_from('<H', content, 54)\ne_phnum, = struct.unpack_from('<H', content, 56)\n\nprint(f'phoff: {e_phoff}, phentsize: {e_phentsize}, phnum: {e_phnum}')\n\nfor i in range(e_phnum):\n    ph_offset = e_phoff + i * e_phentsize\n    p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align = struct.unpack_from('<IIQQQQQQ', content, ph_offset)\n    print(f'Segment {i}: type={p_type}, vaddr=0x{p_vaddr:x}, filesz={p_filesz}, memsz={p_memsz}')\n\"\n"]
