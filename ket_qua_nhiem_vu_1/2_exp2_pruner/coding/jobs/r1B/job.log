:\n        val += coef * sampled_data[parent]\n    sampled_data[node] = val\n\nsampled_df = pd.DataFrame(sampled_data)[cols]\nsampled_df.to_csv(\'/app/final_bn_sample.csv\', index=False)\nprint("Saved /app/final_bn_sample.csv")\nEOF\npython3 /app/full_solution.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
