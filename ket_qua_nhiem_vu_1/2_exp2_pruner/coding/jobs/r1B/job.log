Sending keys: ['cat << \'EOF\' > /app/ars.R\n# Adaptive Rejection Sampler (ARS) implementation in R based on Gilks & Wild (1992)\n\n# Helper function: evaluate log-density and its derivative (numerical or analytical)\n# If derivative not provided, use finite differences\n\nlog_density_deriv <- function(density_func, x, h = 1e-5) {\n  # Numerical derivative of log(density(x))\n  val1 <- log(max(density_func(x - h), .Machine$double.xmin))\n  val2 <- log(max(density_func(x + h), .Machine$double.xmin))\n  return((val2 - val1) / (2 * h))\n}\n\n# Initialize ARS envelope and squeezing functions\n# domain: c(lower, upper), can be infinite (-Inf, Inf)\nars_init <- function(density_func, domain, n_init = 4) {\n  lower <- domain[1]\n  upper <- domain[2]\n  \n  # Choose initial points within domain\n  if (is.infinite(lower) && is.infinite(upper)) {\n    x <- seq(-1.5, 1.5, length.out = n_init)\n  } else if (is.infinite(lower)) {\n    x <- seq(upper - 3, upper - 0.5, length.out = n_init)\n  } else if (is.infinite(upper)) {\n    x <- seq(lower + 0.5, lower + 3, length.out = n_init)\n  } else {\n    x <- seq(lower + (upper - lower) * 0.1, lower + (upper - lower) * 0.9, length.out = n_init)\n  }\n  \n  hx <- sapply(x, function(val) log(max(density_func(val), .Machine$double.xmin)))\n  dhx <- sapply(x, function(val) log_density_deriv(density_func, val))\n  \n  # Check log-concavity at initial points: dhx should be monotonically decreasing\n  # (i.e. dhx[i] >= dhx[j] when x[i] <= x[j])\n  # Sort x, hx, dhx by x\n  ord <- order(x)\n  x <- x[ord]\n  hx <- hx[ord]\n  dhx <- dhx[ord]\n  \n  list(x = x, hx = hx, dhx = dhx, lower = lower, upper = upper)\n}\n\n# Build piecewise linear upper envelope u(x) and lower envelope l(x)\n# Construct intersections of tangents\nupdate_envelope <- function(state, density_func, new_x) {\n  # Insert new_x into state\n  hx_new <- log(max(density_func(new_x), .Machine$double.xmin))\n  dhx_new <- log_density_deriv(density_func, new_x)\n  \n  x <- c(state$x, new_x)\n  hx <- c(state$hx, hx_new)\n  dhx <- c(state$dhx, dhx_new)\n  \n  ord <- order(x)\n  x <- x[ord]\n  hx <- hx[ord]\n  dhx <- dhx[ord]\n  \n  # Check log-concavity check: derivative dhx must be non-increasing with x\n  for (i in 1:(length(x) - 1)) {\n    if (dhx[i] < dhx[i+1] - 1e-4) {\n      stop("Non-log-concave density detected: derivative is increasing between points.")\n    }\n  }\n  \n  list(x = x, hx = hx, dhx = dhx, lower = state$lower, upper = state$upper)\n}\n\n# Compute upper envelope function values / integrals for sampling\n# Sample from upper envelope exponential regions\nsample_upper <- function(state) {\n  k <- length(state$x)\n  x <- state$x\n  hx <- state$hx\n  dhx <- state$dhx\n  lower <- state$lower\n  upper <- state$upper\n  \n  # Compute intersection points z of tangents\n  # z[0] = lower\n  # z[i] = (hx[i+1] - hx[i] - x[i+1]*dhx[i+1] + x[i]*dhx[i]) / (dhx[i] - dhx[i+1])\n  z <- numeric(k + 1)\n  z[1] <- lower\n  z[k + 1] <- upper\n  \n  if (k > 1) {\n    for (i in 1:(k - 1)) {\n      denom <- dhx[i] - dhx[i+1]\n      if (abs(denom) < 1e-12) {\n        z[i + 1] <- (x[i] + x[i+1]) / 2\n      } else {\n        z[i + 1] <- (hx[i+1] - hx[i] - x[i+1]*dhx[i+1] + x[i]*dhx[i]) / denom\n      }\n    }\n  }\n  \n  # Ensure z bounds are consistent\n  for (i in 2:k) {\n    if (z[i] <= x[i-1]) z[i] <- x[i-1]\n    if (z[i] >= x[i]) z[i] <- x[i]\n  }\n  \n  # Compute integral of exp(u(x)) on each interval [z[i], z[i+1]]\n  # u(x) on [z[i], x[i]] is hx[i] + dhx[i]*(x - x[i])\n  # u(x) on [x[i], z[i+1]] is hx[i] + dhx[i+1]*(x - x[i])\n  \n  integrals <- numeric(k)\n  for (i in 1:k) {\n    # integrate exp(hx[i] + dhx[i]*(x - x[i])) from z[i] to x[i]\n    # and exp(hx[i] + dhx[i+1]*(x - x[i])) from x[i] to z[i+1]\n    int1 <- 0\n    if (z[i] != x[i]) {\n      if (abs(dhx[i]) < 1e-12) {\n        int1 <- exp(hx[i]) * (x[i] - z[i])\n      } else {\n        int1 <- exp(hx[i] - dhx[i]*x[i]) * (exp(dhx[i]*x[i]) - exp(dhx[i]*z[i])) / dhx[i]\n      }\n    }\n    int2 <- 0\n    if (x[i] != z[i+1]) {\n      # Note: slope for right interval is dhx[i] actually? Wait, in standard ARS, between x[i] and x[i+1], \n      # the upper envelope is min of tangent at i and tangent at i+1.\n      # Tangent at i is active on [z[i], x[i]]. Tangent at i+1 is active on [x[i], z[i+1]].\n      # Let\'s fix slope: for interval [x[i], z[i+1]], the tangent used is from point i+1!\n    }\n  }\n  \n  # Let\'s use a robust implementation of ARS sampling\n  # Alternatively, sample via rejection from envelope using inverse CDF or numerical CDF of u(x)\n  # Let\'s write clear segment integration:\n  \n  # Envelope segments:\n  # For i in 1:k:\n  # Left part [z[i], x[i]] has slope s_left = dhx[i] (or if i=1 and lower=-Inf, handled)\n  # Right part [x[i], z[i+1]] has slope s_right = dhx[i] (Wait, tangent at i has slope dhx[i] for x >= x[i] until z[i+1])\n  # Correct: tangent at i is u(x) = hx[i] + dhx[i]*(x - x[i]) valid on [z[i], z[i+1]].\n  \n  # Let\'s re-verify ARS definition:\n  # u(x) = hx[i] + dhx[i]*(x - x[i]) for z[i] <= x <= z[i+1]\n  # Yes! The upper envelope on [z[i], z[i+1]] is simply the tangent line at x[i]!\n  # Let\'s check: at x[i], u(x[i]) = hx[i]. For x in [z[i], z[i+1]], u(x) is the tangent at x[i].\n  \n  int_vals <- numeric(k)\n  for (i in 1:k) {\n    a <- z[i]\n    b <- z[i+1]\n    slope <- dhx[i]\n    intercept <- hx[i] - slope * x[i]\n    \n    if (is.infinite(a) && is.infinite(b)) {\n      stop("Domain cannot be entirely infinite without bounds.")\n    } else if (is.infinite(a)) {\n      # int exp(intercept + slope*x) from -Inf to b\n      if (slope <= 0) {\n        int_vals[i] <- exp(intercept + slope * b) / slope # slope is negative\n      } else {\n        int_vals[i] <- Inf\n      }\n    } else if (is.infinite(b)) {\n      # int exp(intercept + slope*x) from a to Inf\n      if (slope >= 0) {\n        int_vals[i] <- Inf\n      } else {\n        int_vals[i] <- -exp(intercept + slope * a) / slope # slope is negative\n      }\n    } else {\n      if (abs(slope) < 1e-12) {\n        int_vals[i] <- exp(intercept) * (b - a)\n      } else {\n        int_vals[i] <- (exp(intercept + slope * b) - exp(intercept + slope * a)) / slope\n      }\n    }\n    if (is.nan(int_vals[i]) || int_vals[i] < 0) int_vals[i] <- 0\n  }\n  \n  tot_int <- sum(int_vals)\n  if (tot_int <= 0 || is.infinite(tot_int)) {\n    # Fallback or uniform weights\n    probs <- rep(1/k, k)\n  } else {\n    probs <- int_vals / tot_int\n  }\n  \n  # Choose interval i with probability probs[i]\n  chosen_i <- sample(1:k, size = 1, prob = probs)\n  \n  # Sample x from truncated exponential on [z[chosen_i], z[chosen_i+1]] with slope dhx[chosen_i]\n  a <- z[chosen_i]\n  b <- z[chosen_i+1]\n  slope <- dhx[chosen_i]\n  intercept <- hx[chosen_i] - slope * x[chosen_i]\n  \n  # Inverse CDF sampling of truncated exponential\n  u_rand <- runif(1)\n  if (is.infinite(a)) {\n    # exp(slope*x) from -Inf to b\n    # CDF(x) = exp(slope*(x - b))\n    # u_rand = exp(slope*(x - b)) => x = b + log(u_rand) / slope\n    prop_x <- b + log(u_rand) / slope\n  } else if (is.infinite(b)) {\n    # exp(slope*x) from a to Inf (slope < 0)\n    # CDF(x) = 1 - exp(slope*(x - a)) if slope < 0\n    # u_rand = 1 - exp(slope*(x - a)) => x = a + log(1 - u_rand) / slope\n    prop_x <- a + log(1 - u_rand) / slope\n  } else {\n    if (abs(slope) < 1e-12) {\n      prop_x <- a + u_rand * (b - a)\n    } else {\n      ea <- exp(slope * a)\n      eb <- exp(slope * b)\n      prop_x <- log(ea + u_rand * (eb - ea)) / slope\n    }\n  }\n  \n  list(prop_x = prop_x, z = z, chosen_i = chosen_i)\n}\n\n# Main ars function\nars <- function(density_function, domain, n = 1000) {\n  # Input validation\n  if (!is.function(density_function)) {\n    stop("density_function must be a valid R function.")\n  }\n  if (!is.numeric(domain) || length(domain) != 2 || domain[1] >= domain[2]) {\n    stop("domain must be a numeric vector of length 2: c(lower, upper) with lower < upper.")\n  }\n  if (!is.numeric(n) || length(n) != 1 || n <= 0 || n %% 1 != 0) {\n    stop("n must be a positive integer representing sample count.")\n  }\n  \n  # Initialize ARS state\n  state <- ars_init(density_function, domain, n_init = 4)\n  \n  samples <- numeric(n)\n  accepted <- 0\n  \n  while (accepted < n) {\n    # Sample from upper envelope\n    res <- tryCatch({\n      sample_upper(state)\n    }, error = function(e) {\n      NULL\n    })\n    \n    if (is.null(res) || is.nan(res$prop_x) || is.infinite(res$prop_x)) {\n      next\n    }\n    \n    prop_x <- res$prop_x\n    \n    # Check if prop_x is within domain\n    if (prop_x < domain[1] || prop_x > domain[2]) {\n      next\n    }\n    \n    # Evaluate density at proposal\n    h_prop <- tryCatch({\n      log(max(density_function(prop_x), .Machine$double.xmin))\n    }, error = function(e) {\n      NA\n    })\n    \n    if (is.na(h_prop)) next\n    \n    # Compute lower envelope l(prop_x) for squeezing test\n    # Lower envelope is linear interpolation between evaluated x points that bracket prop_x\n    x_pts <- state$x\n    hx_pts <- state$hx\n    \n    # Find interval enclosing prop_x\n    l_prop <- -Inf\n    if (prop_x >= x_pts[1] && prop_x <= x_pts[length(x_pts)]) {\n      idx <- max(which(x_pts <= prop_x))\n      if (idx < length(x_pts)) {\n        x1 <- x_pts[idx]; x2 <- x_pts[idx+1]\n        h1 <- hx_pts[idx]; h2 <- hx_pts[idx+1]\n        l_prop <- h1 + (h2 - h1) * (prop_x - x1) / (x2 - x1)\n      }\n    }\n    \n    # Squeezing test\n    u_unif <- runif(1)\n    \n    # Upper envelope value at prop_x\n    chosen_i <- res$chosen_i\n    slope <- state$dhx[chosen_i]\n    intercept <- state$hx[chosen_i] - slope * state$x[chosen_i]\n    u_prop <- intercept + slope * prop_x\n    \n    if (log(u_unif) <= l_prop - u_prop) {\n      # Accept via squeezing test (no need to evaluate density_function again, wait, h_prop is already evaluated)\n      accepted <- accepted + 1\n      samples[accepted] <- prop_x\n    } else if (log(u_unif) <= h_prop - u_prop) {\n      # Accept via rejection test\n      accepted <- accepted + 1\n      samples[accepted] <- prop_x\n      # Update envelope with new evaluated point\n      state <- update_envelope(state, density_function, prop_x)\n    } else {\n      # Reject, but update envelope with evaluated point\n      state <- update_envelope(state, density_function, prop_x)\n    }\n  }\n  \n  return(samples)\n}\n\n# Test function performing formal testing with known distributions\ntest <- function() {\n  cat("Running Adaptive Rejection Sampler Tests...\\n")\n  all_passed <- TRUE\n  \n  # Test 1: Standard Normal Distribution\n  cat("Test 1: Standard Normal Distribution sampling...\\n")\n  set.seed(42)\n  dnorm_unnorm <- function(x) exp(-x^2 / 2)\n  norm_samples <- tryCatch({\n    ars(dnorm_unnorm, c(-5, 5), n = 2000)\n  }, error = function(e) {\n    message("Error in normal sampling: ", e$message)\n    NULL\n  })\n  \n  if (!is.null(norm_samples) && length(norm_samples) == 2000) {\n    m <- mean(norm_samples)\n    s <- sd(norm_samples)\n    cat(sprintf("  Mean: %.4f (Expected: 0.0000)\\n", m))\n    cat(sprintf("  Standard Deviation: %.4f (Expected: 1.0000)\\n", s))\n    if (abs(m) < 0.1 && abs(s - 1.0) < 0.1) {\n      cat("NORMAL_TEST: PASS\\n")\n      writeLines(as.character(norm_samples), "/app/normal_samples.txt")\n    } else {\n      cat("NORMAL_TEST: FAIL\\n")\n      all_passed <- FALSE\n    }\n  } else {\n    cat("NORMAL_TEST: FAIL\\n")\n    all_passed <- FALSE\n  }\n  \n  # Test 2: Exponential Distribution\n  cat("Test 2: Exponential Distribution sampling (rate = 1)...\\n")\n  set.seed(42)\n  dexp_unnorm <- function(x) exp(-x)\n  exp_samples <- tryCatch({\n    ars(dexp_unnorm, c(0, 10), n = 2000)\n  }, error = function(e) {\n    message("Error in exponential sampling: ", e$message)\n    NULL\n  })\n  \n  if (!is.null(exp_samples) && length(exp_samples) == 2000) {\n    m <- mean(exp_samples)\n    s <- sd(exp_samples)\n    cat(sprintf("  Mean: %.4f (Expected: 1.0000)\\n", m))\n    cat(sprintf("  Standard Deviation: %.4f (Expected: 1.0000)\\n", s))\n    if (abs(m - 1.0) < 0.15 && abs(s - 1.0) < 0.15) {\n      cat("EXPONENTIAL_TEST: PASS\\n")\n      writeLines(as.character(exp_samples), "/app/exponential_samples.txt")\n    } else {\n      cat("EXPONENTIAL_TEST: FAIL\\n")\n      all_passed <- FALSE\n    }\n  } else {\n    cat("EXPONENTIAL_TEST: FAIL\\n")\n    all_passed <- FALSE\n  }\n  \n  # Test 3: Input validation tests\n  cat("Test 3: Input validation checks...\\n")\n  passed_validation <- TRUE\n  tryCatch({\n    ars("not a function", c(-1, 1), 100)\n    passed_validation <- FALSE\n  }, error = function(e) {})\n  \n  tryCatch({\n    ars(dnorm_unnorm, c(1, -1), 100)\n    passed_validation <- FALSE\n  }, error = function(e) {})\n  \n  tryCatch({\n    ars(dnorm_unnorm, c(-1, 1), -5)\n    passed_validation <- FALSE\n  }, error = function(e) {})\n  \n  if (passed_validation) {\n    cat("INPUT_VALIDATION_TEST: PASS\\n")\n  } else {\n    cat("INPUT_VALIDATION_TEST: FAIL\\n")\n    all_passed <- FALSE\n  }\n  \n  # Test 4: Non-log-concave density check\n  cat("Test 4: Non-log-concave density check (Cauchy/Student-t or mixture)...\\n")\n  passed_nonlogconcave <- FALSE\n  # Cauchy density is not log-concave: let\'s test a density that is definitely not log-concave (e.g. mixture or bimodal exp(x^2))\n  annon_concave <- function(x) exp(x^2)\n  tryCatch({\n    ars(annon_concave, c(-2, 2), 100)\n  }, error = function(e) {\n    passed_nonlogconcave <- TRUE\n  })\n  \n  if (passed_nonlogconcave) {\n    cat("NON_LOG_CONCAVE_TEST: PASS\\n")\n  } else {\n    cat("NON_LOG_CONCAVE_TEST: FAIL\\n")\n    all_passed <- FALSE\n  }\n  \n  if (all_passed) {\n    cat("OVERALL_TEST: PASS\\n")\n  } else {\n    cat("OVERALL_TEST: FAIL\\n")\n  }\n}\n\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
