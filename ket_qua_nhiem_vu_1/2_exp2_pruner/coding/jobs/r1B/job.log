Sending keys: ['cat << \'EOF\' > /app/ars.R\n# Adaptive Rejection Sampler (ARS) implementation in R based on Gilks & Wild (1992)\n\nlog_density_deriv <- function(density_func, x, h = 1e-5) {\n  val1 <- log(max(density_func(x - h), .Machine$double.xmin))\n  val2 <- log(max(density_func(x + h), .Machine$double.xmin))\n  return((val2 - val1) / (2 * h))\n}\n\nars_init <- function(density_func, domain, n_init = 4) {\n  lower <- domain[1]\n  upper <- domain[2]\n  \n  if (is.infinite(lower) && is.infinite(upper)) {\n    x <- seq(-1.5, 1.5, length.out = n_init)\n  } else if (is.infinite(lower)) {\n    x <- seq(upper - 3, upper - 0.5, length.out = n_init)\n  } else if (is.infinite(upper)) {\n    x <- seq(lower + 0.5, lower + 3, length.out = n_init)\n  } else {\n    x <- seq(lower + (upper - lower) * 0.1, lower + (upper - lower) * 0.9, length.out = n_init)\n  }\n  \n  hx <- sapply(x, function(val) log(max(density_func(val), .Machine$double.xmin)))\n  dhx <- sapply(x, function(val) log_density_deriv(density_func, val))\n  \n  ord <- order(x)\n  x <- x[ord]\n  hx <- hx[ord]\n  dhx <- dhx[ord]\n  \n  # Check log-concavity at initial points: derivative dhx must be non-increasing with x\n  for (i in 1:(length(x) - 1)) {\n    if (dhx[i] < dhx[i+1] - 1e-4) {\n      stop("Non-log-concave density detected: derivative is increasing between initial points.")\n    }\n  }\n  \n  list(x = x, hx = hx, dhx = dhx, lower = lower, upper = upper)\n}\n\nupdate_envelope <- function(state, density_func, new_x) {\n  hx_new <- log(max(density_func(new_x), .Machine$double.xmin))\n  dhx_new <- log_density_deriv(density_func, new_x)\n  \n  x <- c(state$x, new_x)\n  hx <- c(state$hx, hx_new)\n  dhx <- c(state$dhx, dhx_new)\n  \n  ord <- order(x)\n  x <- x[ord]\n  hx <- hx[ord]\n  dhx <- dhx[ord]\n  \n  for (i in 1:(length(x) - 1)) {\n    if (dhx[i] < dhx[i+1] - 1e-4) {\n      stop("Non-log-concave density detected: derivative is increasing between points.")\n    }\n  }\n  \n  list(x = x, hx = hx, dhx = dhx, lower = state$lower, upper = state$upper)\n}\n\nsample_upper <- function(state) {\n  k <- length(state$x)\n  x <- state$x\n  hx <- state$hx\n  dhx <- state$dhx\n  lower <- state$lower\n  upper <- state$upper\n  \n  z <- numeric(k + 1)\n  z[1] <- lower\n  z[k + 1] <- upper\n  \n  if (k > 1) {\n    for (i in 1:(k - 1)) {\n      denom <- dhx[i] - dhx[i+1]\n      if (abs(denom) < 1e-12) {\n        z[i + 1] <- (x[i] + x[i+1]) / 2\n      } else {\n        z[i + 1] <- (hx[i+1] - hx[i] - x[i+1]*dhx[i+1] + x[i]*dhx[i]) / denom\n      }\n    }\n  }\n  \n  for (i in 2:k) {\n    if (z[i] <= x[i-1]) z[i] <- x[i-1]\n    if (z[i] >= x[i]) z[i] <- x[i]\n  }\n  \n  int_vals <- numeric(k)\n  for (i in 1:k) {\n    a <- z[i]\n    b <- z[i+1]\n    slope <- dhx[i]\n    intercept <- hx[i] - slope * x[i]\n    \n    if (is.infinite(a) && is.infinite(b)) {\n      stop("Domain cannot be entirely infinite without bounds.")\n    } else if (is.infinite(a)) {\n      if (slope <= 0) {\n        int_vals[i] <- exp(intercept + slope * b) / slope\n      } else {\n        int_vals[i] <- Inf\n      }\n    } else if (is.infinite(b)) {\n      if (slope >= 0) {\n        int_vals[i] <- Inf\n      } else {\n        int_vals[i] <- -exp(intercept + slope * a) / slope\n      }\n    } else {\n      if (abs(slope) < 1e-12) {\n        int_vals[i] <- exp(intercept) * (b - a)\n      } else {\n        int_vals[i] <- (exp(intercept + slope * b) - exp(intercept + slope * a)) / slope\n      }\n    }\n    if (is.nan(int_vals[i]) || int_vals[i] < 0) int_vals[i] <- 0\n  }\n  \n  tot_int <- sum(int_vals)\n  if (tot_int <= 0 || is.infinite(tot_int)) {\n    probs <- rep(1/k, k)\n  } else {\n    probs <- int_vals / tot_int\n  }\n  \n  chosen_i <- sample(1:k, size = 1, prob = probs)\n  \n  a <- z[chosen_i]\n  b <- z[chosen_i+1]\n  slope <- dhx[chosen_i]\n  intercept <- hx[chosen_i] - slope * x[chosen_i]\n  \n  u_rand <- runif(1)\n  if (is.infinite(a)) {\n    prop_x <- b + log(u_rand) / slope\n  } else if (is.infinite(b)) {\n    prop_x <- a + log(1 - u_rand) / slope\n  } else {\n    if (abs(slope) < 1e-12) {\n      prop_x <- a + u_rand * (b - a)\n    } else {\n      ea <- exp(slope * a)\n      eb <- exp(slope * b)\n      prop_x <- log(ea + u_rand * (eb - ea)) / slope\n    }\n  }\n  \n  list(prop_x = prop_x, z = z, chosen_i = chosen_i)\n}\n\nars <- function(density_function, domain, n = 1000) {\n  if (!is.function(density_function)) {\n    stop("density_function must be a valid R function.")\n  }\n  if (!is.numeric(domain) || length(domain) != 2 || domain[1] >= domain[2]) {\n    stop("domain must be a numeric vector of length 2: c(lower, upper) with lower < upper.")\n  }\n  if (!is.numeric(n) || length(n) != 1 || n <= 0 || n %% 1 != 0) {\n    stop("n must be a positive integer representing sample count.")\n  }\n  \n  state <- ars_init(density_function, domain, n_init = 4)\n  \n  samples <- numeric(n)\n  accepted <- 0\n  \n  while (accepted < n) {\n    res <- tryCatch({\n      sample_upper(state)\n    }, error = function(e) {\n      NULL\n    })\n    \n    if (is.null(res) || is.nan(res$prop_x) || is.infinite(res$prop_x)) {\n      next\n    }\n    \n    prop_x <- res$prop_x\n    \n    if (prop_x < domain[1] || prop_x > domain[2]) {\n      next\n    }\n    \n    h_prop <- tryCatch({\n      log(max(density_function(prop_x), .Machine$double.xmin))\n    }, error = function(e) {\n      NA\n    })\n    \n    if (is.na(h_prop)) next\n    \n    x_pts <- state$x\n    hx_pts <- state$hx\n    \n    l_prop <- -Inf\n    if (prop_x >= x_pts[1] && prop_x <= x_pts[length(x_pts)]) {\n      idx <- max(which(x_pts <= prop_x))\n      if (idx < length(x_pts)) {\n        x1 <- x_pts[idx]; x2 <- x_pts[idx+1]\n        h1 <- hx_pts[idx]; h2 <- hx_pts[idx+1]\n        l_prop <- h1 + (h2 - h1) * (prop_x - x1) / (x2 - x1)\n      }\n    }\n    \n    u_unif <- runif(1)\n    chosen_i <- res$chosen_i\n    slope <- state$dhx[chosen_i]\n    intercept <- state$hx[chosen_i] - slope * state$x[chosen_i]\n    u_prop <- intercept + slope * prop_x\n    \n    if (log(u_unif) <= l_prop - u_prop) {\n      accepted <- accepted + 1\n      samples[accepted] <- prop_x\n    } else if (log(u_unif) <= h_prop - u_prop) {\n      accepted <- accepted + 1\n      samples[accepted] <- prop_x\n      state <- update_envelope(state, density_function, prop_x)\n    } else {\n      state <- update_envelope(state, density_function, prop_x)\n    }\n  }\n  \n  return(samples)\n}\n\ntest <- function() {\n  cat("Running Adaptive Rejection Sampler Tests...\\n")\n  all_passed <- TRUE\n  \n  cat("Test 1: Standard Normal Distribution sampling...\\n")\n  set.seed(42)\n  dnorm_unnorm <- function(x) exp(-x^2 / 2)\n  norm_samples <- tryCatch({\n    ars(dnorm_unnorm, c(-5, 5), n = 2000)\n  }, error = function(e) {\n    message("Error in normal sampling: ", e$message)\n    NULL\n  })\n  \n  if (!is.null(norm_samples) && length(norm_samples) == 2000) {\n    m <- mean(norm_samples)\n    s <- sd(norm_samples)\n    cat(sprintf("  Mean: %.4f (Expected: 0.0000)\\n", m))\n    cat(sprintf("  Standard Deviation: %.4f (Expected: 1.0000)\\n", s))\n    if (abs(m) < 0.1 && abs(s - 1.0) < 0.1) {\n      cat("NORMAL_TEST: PASS\\n")\n      writeLines(as.character(norm_samples), "/app/normal_samples.txt")\n    } else {\n      cat("NORMAL_TEST: FAIL\\n")\n      all_passed <- FALSE\n    }\n  } else {\n    cat("NORMAL_TEST: FAIL\\n")\n    all_passed <- FALSE\n  }\n  \n  cat("Test 2: Exponential Distribution sampling (rate = 1)...\\n")\n  set.seed(42)\n  dexp_unnorm <- function(x) exp(-x)\n  exp_samples <- tryCatch({\n    ars(dexp_unnorm, c(0, 10), n = 2000)\n  }, error = function(e) {\n    message("Error in exponential sampling: ", e$message)\n    NULL\n  })\n  \n  if (!is.null(exp_samples) && length(exp_samples) == 2000) {\n    m <- mean(exp_samples)\n    s <- sd(exp_samples)\n    cat(sprintf("  Mean: %.4f (Expected: 1.0000)\\n", m))\n    cat(sprintf("  Standard Deviation: %.4f (Expected: 1.0000)\\n", s))\n    if (abs(m - 1.0) < 0.15 && abs(s - 1.0) < 0.15) {\n      cat("EXPONENTIAL_TEST: PASS\\n")\n      writeLines(as.character(exp_samples), "/app/exponential_samples.txt")\n    } else {\n      cat("EXPONENTIAL_TEST: FAIL\\n")\n      all_passed <- FALSE\n    }\n  } else {\n    cat("EXPONENTIAL_TEST: FAIL\\n")\n    all_passed <- FALSE\n  }\n  \n  cat("Test 3: Input validation checks...\\n")\n  passed_validation <- TRUE\n  tryCatch({\n    ars("not a function", c(-1, 1), 100)\n    passed_validation <- FALSE\n  }, error = function(e) {})\n  \n  tryCatch({\n    ars(dnorm_unnorm, c(1, -1), 100)\n    passed_validation <- FALSE\n  }, error = function(e) {})\n  \n  tryCatch({\n    ars(dnorm_unnorm, c(-1, 1), -5)\n    passed_validation <- FALSE\n  }, error = function(e) {})\n  \n  if (passed_validation) {\n    cat("INPUT_VALIDATION_TEST: PASS\\n")\n  } else {\n    cat("INPUT_VALIDATION_TEST: FAIL\\n")\n    all_passed <- FALSE\n  }\n  \n  cat("Test 4: Non-log-concave density check...\\n")\n  passed_nonlogconcave <- FALSE\n  annon_concave <- function(x) exp(x^2)\n  tryCatch({\n    ars(annon_concave, c(-2, 2), 100)\n  }, error = function(e) {\n    passed_nonlogconcave <- TRUE\n  })\n  \n  if (passed_nonlogconcave) {\n    cat("NON_LOG_CONCAVE_TEST: PASS\\n")\n  } else {\n    cat("NON_LOG_CONCAVE_TEST: FAIL\\n")\n    all_passed <- FALSE\n  }\n  \n  if (all_passed) {\n    cat("OVERALL_TEST: PASS\\n")\n  } else {\n    cat("OVERALL_TEST: FAIL\\n")\n  }\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
