[?2004l[?2004h>     'D': ['U', 'Y']
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> params = {}
[?2004l[?2004h> np.random.seed(42)
[?2004l[?2004h> 
[?2004l[?2004h> for node, pars in parents.items():
[?2004l[?2004h>     if len(pars) == 0:
[?2004l[?2004h>         mean = df[node].mean()
[?2004l[?2004h>         var = df[node].var()
[?2004l[?2004h>         params[node] = {'intercept': mean, 'coefs': {}, 'variance': var}
[?2004l[?2004h>     else:
[?2004l[?2004h>         X = df[pars].values
[?2004l[?2004h>         X_design = np.column_stack([np.ones(len(df)), X])
[?2004l[?2004h>         y = df[node].values
[?2004l[?2004h>         beta, residuals, rank, s = np.linalg.lstsq(X_design, y, rcond=None)
[?2004l[?2004h>         intercept = beta[0]
[?2004l[?2004h>         coefs = {p: beta[i+1] for i, p in enumerate(pars)}
[?2004l[?2004h>         pred = X_design @ beta
[?2004l[?2004h>         res = y - pred
[?2004l[?2004h>         var = np.var(res)
[?2004l[?2004h>         params[node] = {'intercept': intercept, 'coefs': coefs, 'variance': var}
[?2004l[?2004h> 
