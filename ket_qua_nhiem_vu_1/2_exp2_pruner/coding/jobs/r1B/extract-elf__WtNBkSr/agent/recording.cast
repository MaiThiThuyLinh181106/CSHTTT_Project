[30.994687, "i", "cat << 'EOF' > test_parse.js\nconst fs = require('fs');\nfunction parse(filename) {\n  const buf = fs.readFileSync(filename);\n  const is64 = buf[4] === 2;\n  const isLE = buf[5] === 1;\n  if (!isLE) throw new Error('Only little endian supported');\n  \n  const e_phoff = is64 ? Number(buf.readBigUInt64LE(0x20)) : buf.readUInt32LE(0x1c);\n  const e_phentsize = is64 ? buf.readUInt16LE(0x36) : buf.readUInt16LE(0x2a);\n  const e_phnum = is64 ? buf.readUInt16LE(0x38) : buf.readUInt16LE(0x2c);\n  \n  const result = {};\n  for (let i = 0; i < e_phnum; i++) {\n    const phoff = e_phoff + i * e_phentsize;\n    const p_type = buf.readUInt32LE(phoff);\n    if (p_type === 1) { // PT_LOAD\n      let p_offset, p_vaddr, p_filesz, p_memsz;\n      if (is64) {\n        p_offset = Number(buf.readBigUInt64LE(phoff + 0x08));\n        p_vaddr = Number(buf.readBigUInt64LE(phoff + 0x10));\n        p_filesz = Number(buf.readBigUInt64LE(phoff + 0x20));\n        p_memsz = Number(buf.readBigUInt64LE(phoff + 0x28));\n      } else {\n        p_offset = buf.readUInt32LE(phoff + 0x04);\n        p_vaddr = buf.readUInt32LE(phoff + 0x08);\n        p_filesz = buf.readUInt32LE(phoff + 0x10);\n        p_memsz = buf.readUInt32LE(phoff + 0x14);\n      }\n      \n      const mem = Buffer.alloc(p_memsz);\n      buf.copy(mem, 0, p_offset, p_offset + p_filesz);\n      \n      // Align vaddr to 4 bytes\n      let start = p_vaddr;\n      let padding = start % 4;\n      if (padding !== 0) {\n        start += (4 - padding);\n      }\n      \n      for (let addr = start; addr <= p_vaddr + p_memsz - 4; addr += 4) {\n        const offsetInMem = addr - p_vaddr;\n        const val = mem.readUInt32LE(offsetInMem);\n        result[addr.toString()] = val;\n      }\n    }\n  }\n  return result;\n}\n\nconsole.log(JSON.stringify(parse('a_nopie.out'), null, 2).slice(0, 200));\nEOF\nnode test_parse.js\n"]
[30.995027, "o", "cat << 'EOF' > test_parse.js\r\n\u001b[?2004l\r"]
