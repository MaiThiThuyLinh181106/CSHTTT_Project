[34.653791, "i", "cat << 'EOF' > extract.js\nconst fs = require('fs');\n\nfunction parseELF(filepath) {\n    const buf = fs.readFileSync(filepath);\n    const phoff = buf.readBigUInt64LE(32);\n    const phentsize = buf.readUInt16LE(54);\n    const phnum = buf.readUInt16LE(56);\n\n    const result = {};\n    const baseAddress = 0x400000;\n\n    for (let i = 0; i < phnum; i++) {\n        const phOffset = Number(phoff) + i * phentsize;\n        const p_type = buf.readUInt32LE(phOffset);\n        if (p_type === 1) {\n            const p_offset = Number(buf.readBigUInt64LE(phOffset + 8));\n            const p_vaddr = Number(buf.readBigUInt64LE(phOffset + 16));\n            const p_filesz = Number(buf.readBigUInt64LE(phOffset + 32));\n\n            for (let off = 0; off < p_filesz; off += 4) {\n                if (p_offset + off + 4 <= buf.length) {\n                    const val = buf.readInt32LE(p_offset + off);\n                    const addr = baseAddress + p_vaddr + off;\n                    result[addr.toString()] = val;\n                }\n            }\n        }\n    }\n    return result;\n}\n\nconst args = process.argv.slice(2);\nconst filepath = args[0] || 'a.out';\nconst res = parseELF(filepath);\nconsole.log(JSON.stringify(res));\nEOF\n"]
