[23.112227, "i", "python3 -c '\nwith open(\"a.out\", \"rb\") as f:\n    data = f.read()\n# ELF header 64-bit: e_phoff is at offset 32 (8 bytes), e_phentsize at 54 (2 bytes), e_phnum at 56 (2 bytes)\nimport struct\nphoff, = struct.unpack_from(\"<Q\", data, 32)\nphentsize, = struct.unpack_from(\"<H\", data, 54)\nphnum, = struct.unpack_from(\"<H\", data, 56)\nprint(f\"phoff={phoff}, phentsize={phentsize}, phnum={phnum}\")\nfor i in range(phnum):\n    ph = data[phoff + i * phentsize : phoff + (i + 1) * phentsize]\n    p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align = struct.unpack_from(\"<IIQQQQQQ\", ph, 0)\n    print(f\"type={p_type}, flags={p_flags}, offset={p_offset}, vaddr={p_vaddr}, filesz={p_filesz}, memsz={p_memsz}\")\n'\n"]
