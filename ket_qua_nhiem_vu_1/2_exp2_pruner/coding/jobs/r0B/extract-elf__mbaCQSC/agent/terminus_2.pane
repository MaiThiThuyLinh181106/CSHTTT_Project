[?2004l[?2004h> const fs = require('fs');
[?2004l[?2004h> 
[?2004l[?2004h> function parseELF(filepath) {
[?2004l[?2004h>     const buf = fs.readFileSync(filepath);
[?2004l[?2004h>     const phoff = buf.readBigUInt64LE(32);
[?2004l[?2004h>     const phentsize = buf.readUInt16LE(54);
[?2004l[?2004h>     const phnum = buf.readUInt16LE(56);
[?2004l[?2004h> 
[?2004l[?2004h>     const result = {};
[?2004l[?2004h>     const baseAddress = 0x400000;
[?2004l[?2004h> 
[?2004l[?2004h>     for (let i = 0; i < phnum; i++) {
[?2004l[?2004h>         const phOffset = Number(phoff) + i * phentsize;
[?2004l[?2004h>         const p_type = buf.readUInt32LE(phOffset);
[?2004l[?2004h>         if (p_type === 1) {
[?2004l[?2004h>             const p_offset = Number(buf.readBigUInt64LE(phOffset + 8));
[?2004l[?2004h>             const p_vaddr = Number(buf.readBigUInt64LE(phOffset + 16));
[?2004l[?2004h>             const p_filesz = Number(buf.readBigUInt64LE(phOffset + 32));
[?2004l[?2004h> 
[?2004l[?2004h>             for (let off = 0; off < p_filesz; off += 4) {
[?2004l[?2004h>                 if (p_offset + off + 4 <= buf.length) {
[?2004l[?2004h>                     const val = buf.readInt32LE(p_offset + off);
[?2004l[?2004h>                     const addr = baseAddress + p_vaddr + off;
[?2004l[?2004h>                     result[addr.toString()] = val;
[?2004l[?2004h>                 }
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h>     return result;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> const args = process.argv.slice(2);
