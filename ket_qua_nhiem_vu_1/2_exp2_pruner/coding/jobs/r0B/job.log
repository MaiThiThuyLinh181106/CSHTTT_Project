Sending keys: ['cat << \'EOF\' > /app/ars.R\n# Adaptive Rejection Sampling (ARS) implementation in R\n# Based on Gilks & Wild (1992)\n\n# Helper: numerical derivative or log-concavity check\n# Log-concavity check: for points x1 < x2 < x3, log-density h(x) must satisfy chord condition:\n# (h(x3) - h(x2)) / (x3 - x2) <= (h(x2) - h(x1)) / (x2 - x1)\ncheck_log_concavity <- function(x_sorted, h_vals) {\n  if (length(x_sorted) < 3) return(TRUE)\n  for (i in 2:(length(x_sorted) - 1)) {\n    x1 <- x_sorted[i-1]\n    x2 <- x_sorted[i]\n    x3 <- x_sorted[i+1]\n    h1 <- h_vals[i-1]\n    h2 <- h_vals[i]\n    h3 <- h_vals[i+1]\n    slope1 <- (h2 - h1) / (x2 - x1)\n    slope2 <- (h3 - h2) / (x3 - x2)\n    # slope2 should be <= slope1 for log-concavity\n    if (slope2 > slope1 + 1e-7) {\n      return(FALSE)\n    }\n  }\n  return(TRUE)\n}\n\n# Initialize ARS envelope\nars_init <- function(h_func, h_prime_func, domain, x_init = NULL) {\n  xmin <- domain[1]\n  xmax <- domain[2]\n  \n  if (is.null(x_init)) {\n    # Choose initial points in domain\n    if (is.finite(xmin) && is.finite(xmax)) {\n      x_init <- sort(c(xmin + 0.2*(xmax-xmin), xmin + 0.5*(xmax-xmin), xmin + 0.8*(xmax-xmin)))\n    } else if (is.finite(xmin)) {\n      x_init <- c(xmin + 0.5, xmin + 1.5, xmin + 2.5)\n    } else if (is.finite(xmax)) {\n      x_init <- c(xmax - 2.5, xmax - 1.5, xmax - 0.5)\n    } else {\n      x_init <- c(-1, 0, 1)\n    }\n  }\n  \n  x <- sort(unique(x_init))\n  if (length(x) < 2) stop("At least 2 initial points required.")\n  \n  # Evaluate h(x) = log(f(x))\n  h_vals <- sapply(x, h_func)\n  if (any(!is.finite(h_vals))) {\n    stop("Initial points must yield finite log-density values.")\n  }\n  \n  # Evaluate derivatives h\'(x)\n  if (!is.null(h_prime_func)) {\n    h_prime <- sapply(x, h_prime_func)\n  } else {\n    # Numerical derivative\n    eps <- 1e-6\n    h_prime <- sapply(x, function(xi) (h_func(xi + eps) - h_func(xi - eps)) / (2 * eps))\n  }\n  \n  list(x = x, h_vals = h_vals, h_prime = h_prime, xmin = xmin, xmax = xmax)\n}\n\n# Construct upper envelope u(x) and lower envelope l(x)\n# For ARS, upper envelope is piecewise linear in h (piecewise exponential in f)\n# Defined by tangents at evaluation points x_k\n\n# Sample from upper envelope\nsample_upper <- function(env) {\n  x <- env$x\n  h <- env$h_vals\n  hp <- env$h_prime\n  xmin <- env$xmin\n  xmax <- env$xmax\n  \n  k <- length(x)\n  # Find intersection points z of tangents\n  # tangent j: u_j(x) = h(j) + hp(j)*(x - x(j))\n  # intersection z_j between j and j+1:\n  # h(j) + hp(j)*(z - x(j)) = h(j+1) + hp(j+1)*(z - x(j+1))\n  z <- numeric(k + 1)\n  z[1] <- xmin\n  z[k + 1] <- xmax\n  \n  for (j in 1:(k - 1)) {\n    num <- h[j+1] - h[j] - hp[j+1]*x[j+1] + hp[j]*x[j]\n    den <- hp[j] - hp[j+1]\n    if (abs(den) < 1e-12) {\n      z[j+1] <- (x[j] + x[j+1]) / 2\n    } else {\n      z[j+1] <- num / den\n    }\n    # Ensure z[j+1] is between x[j] and x[j+1]\n    if (z[j+1] <= x[j] || z[j+1] >= x[j+1]) {\n      z[j+1] <- (x[j] + x[j+1]) / 2\n    }\n  }\n  \n  # Calculate integral of exp(u(x)) on each interval [z_j, z_{j+1}]\n  # On [z_j, x_j] and [x_j, z_{j+1}], u(x) is linear: u(x) = a_j + b_j * x\n  # We integrate exp(u(x)) dx\n  integrals <- numeric(k)\n  for (j in 1:k) {\n    # interval [z[j], z[j+1]]\n    # slope is hp[j]\n    # let\'s integrate exp( h[j] + hp[j]*(x - x[j]) ) dx from z[j] to z[j+1]\n    # = exp(h[j] - hp[j]*x[j]) * [ exp(hp[j]*z[j+1]) - exp(hp[j]*z[j]) ] / hp[j] (if hp[j] != 0)\n    # If hp[j] == 0, exp(h[j]) * (z[j+1] - z[j])\n    b <- hp[j]\n    c_val <- h[j] - b * x[j]\n    z_left <- z[j]\n    z_right <- z[j+1]\n    \n    # Handle infinite bounds safely\n    if (is.infinite(z_left) || is.infinite(z_right)) {\n      # If semi-infinite interval, require appropriate sign of b\n      if (z_left == -Inf && b <= 0) stop("Upper envelope not integrable on (-Inf, ...)")\n      if (z_right == Inf && b >= 0) stop("Upper envelope not integrable on (..., Inf)")\n    }\n    \n    if (abs(b) < 1e-12) {\n      integrals[j] <- exp(c_val) * (z_right - z_left)\n    } else {\n      # To avoid overflow, factor out max exponent\n      # exp(c + b*z_right) - exp(c + b*z_left)\n      # = exp(c + b*mid) * (exp(b*(z_right - mid)) - exp(b*(z_left - mid)))\n      mid <- (z_left + z_right) / 2\n      if (!is.finite(mid)) mid <- 0\n      term1 <- c_val + b * mid\n      term2 <- exp(b * (z_right - mid)) - exp(b * (z_left - mid))\n      integrals[j] <- exp(term1) * term2 / b\n    }\n    if (!is.finite(integrals[j]) || integrals[j] < 0) {\n      integrals[j] <- 1e-12\n    }\n  }\n  \n  total_int <- sum(integrals)\n  probs <- integrals / total_int\n  \n  # Sample interval\n  chosen_int <- sample.int(k, 1, prob = probs)\n  \n  # Sample x from truncated exponential on [z[chosen_int], z[chosen_int+1]] with slope hp[chosen_int]\n  j <- chosen_int\n  b <- hp[j]\n  c_val <- h[j] - b * x[j]\n  z_l <- z[j]\n  z_r <- z[j+1]\n  \n  u_rand <- runif(1)\n  \n  if (abs(b) < 1e-12) {\n    x_sample <- z_l + u_rand * (z_r - z_l)\n  } else {\n    # CDF of exp(c + b*x) from z_l to x is (exp(b*x) - exp(b*z_l)) / (exp(b*z_r) - exp(b*z_l))\n    # Solve for x:\n    # exp(b*x) = exp(b*z_l) + u_rand * (exp(b*z_r) - exp(b*z_l))\n    # x = (1/b) * log( exp(b*z_l) + u_rand * (exp(b*z_r) - exp(b*z_l)) )\n    # To prevent overflow when b*z_r is large, use log1p or log-sum-exp\n    # Here let\'s do numerically stable formulation:\n    # Let a_max = b * z_l (or b*z_r)\n    # exp(b*x) = exp(b*z_l) * (1 - u_rand) + u_rand * exp(b*z_r)  if b > 0 etc.\n    # More simply:\n    val <- log(exp(b * z_l) + u_rand * (exp(b * z_r) - exp(b * z_l)))\n    x_sample <- val / b\n  }\n  \n  if (!is.finite(x_sample)) {\n    x_sample <- x[j]\n  }\n  \n  list(x = x_sample, interval = j, z = z)\n}\n\n# Evaluate upper envelope u(x)\neval_u <- function(x_eval, env) {\n  x <- env$x\n  h <- env$h_vals\n  hp <- env$h_prime\n  k <- length(x)\n  \n  # Find which interval x_eval falls into\n  # Construct z as in sample_upper\n  z <- numeric(k + 1)\n  z[1] <- env$xmin\n  z[k + 1] <- env$xmax\n  for (j in 1:(k - 1)) {\n    den <- hp[j] - hp[j+1]\n    if (abs(den) < 1e-12) {\n      z[j+1] <- (x[j] + x[j+1]) / 2\n    } else {\n      z[j+1] <- (h[j+1] - h[j] - hp[j+1]*x[j+1] + hp[j]*x[j]) / den\n    }\n    if (z[j+1] <= x[j] || z[j+1] >= x[j+1]) z[j+1] <- (x[j] + x[j+1]) / 2\n  }\n  \n  # Find interval index\n  j <- findInterval(x_eval, z)\n  if (j < 1) j <- 1\n  if (j > k) j <- k\n  \n  h[j] + hp[j] * (x_eval - x[j])\n}\n\n# Evaluate lower envelope l(x)\n# Lower envelope is piecewise linear connecting (x_j, h(x_j))\neval_l <- function(x_eval, env) {\n  x <- env$x\n  h <- env$h_vals\n  k <- length(x)\n  if (x_eval <= x[1] || x_eval >= x[k]) return(-Inf)\n  \n  j <- findInterval(x_eval, x)\n  if (j < 1) j <- 1\n  if (j >= k) j <- k-1\n  \n  # Linear interpolation between x[j] and x[j+1]\n  h[j] + (h[j+1] - h[j]) / (x[j+1] - x[j]) * (x_eval - x[j])\n}\n\n# Main ARS function\nars <- function(density_function, domain, n = 1000, h_prime_func = NULL, x_init = NULL) {\n  # Input validation\n  if (!is.function(density_function)) {\n    stop("density_function must be a function.")\n  }\n  if (!is.numeric(domain) || length(domain) != 2 || domain[1] >= domain[2]) {\n    stop("domain must be a numeric vector of length 2 with domain[1] < domain[2].")\n  }\n  if (!is.numeric(n) || length(n) != 1 || n <= 0 || n %% 1 != 0) {\n    stop("n (sample count) must be a positive integer.")\n  }\n  \n  # Wrap density function to log-density h(x) = log(f(x))\n  h_func <- function(x) {\n    val <- density_function(x)\n    if (any(val <= 0 | !is.finite(val))) return(-Inf)\n    log(val)\n  }\n  \n  # Initialize envelope\n  env <- ars_init(h_func, h_prime_func, domain, x_init)\n  \n  samples <- numeric(n)\n  count <- 0\n  max_iters <- n * 50\n  iter <- 0\n  \n  while (count < n && iter < max_iters) {\n    iter <- iter + 1\n    \n    # 1. Sample from upper envelope\n    s_res <- sample_upper(env)\n    x_star <- s_res$x\n    \n    # Check domain bounds\n    if (x_star < env$xmin || x_star > env$xmax) next\n    \n    # Evaluate h(x_star) and h\'(x_star)\n    h_star <- h_func(x_star)\n    if (!is.finite(h_star)) next\n    \n    if (!is.null(h_prime_func)) {\n      hp_star <- h_prime_func(x_star)\n    } else {\n      eps <- 1e-6\n      hp_star <- (h_func(x_star + eps) - h_func(x_star - eps)) / (2 * eps)\n    }\n    \n    u_val <- eval_u(x_star, env)\n    l_val <- eval_l(x_star, env)\n    \n    w <- runif(1)\n    \n    # 2. Squeezing test\n    if (log(w) <= l_val - u_val) {\n      # Accept without evaluating density\n      count <- count + 1\n      samples[count] <- x_star\n      # Update envelope with x_star anyway to improve approximation\n      new_x <- sort(c(env$x, x_star))\n      new_h <- sapply(new_x, h_func)\n      if (!check_log_concavity(new_x, new_h)) {\n        stop("Non-log-concave density detected during sampling (failed log-concavity check).")\n      }\n      env$x <- new_x\n      env$h_vals <- new_h\n      if (!is.null(h_prime_func)) {\n        env$h_prime <- sapply(new_x, h_prime_func)\n      } else {\n        env$h_prime <- sapply(new_x, function(xi) (h_func(xi + 1e-6) - h_func(xi - 1e-6)) / (2 * 1e-6))\n      }\n      next\n    }\n    \n    # 3. Rejection test\n    if (log(w) <= h_star - u_val) {\n      count <- count + 1\n      samples[count] <- x_star\n    }\n    \n    # Update envelope\n    new_x <- sort(c(env$x, x_star))\n    new_h <- sapply(new_x, h_func)\n    if (!check_log_concavity(new_x, new_h)) {\n      stop("Non-log-concave density detected during sampling (failed log-concavity check).")\n    }\n    env$x <- new_x\n    env$h_vals <- new_h\n    if (!is.null(h_prime_func)) {\n      env$h_prime <- sapply(new_x, h_prime_func)\n    } else {\n      env$h_prime <- sapply(new_x, function(xi) (h_func(xi + 1e-6) - h_func(xi - 1e-6)) / (2 * 1e-6))\n    }\n  }\n  \n  if (count < n) {\n    warning("Reached max iterations before generating all requested samples.")\n    samples <- samples[1:count]\n  }\n  \n  return(samples)\n}\n\n# Test function complying with requirements\ntest <- function() {\n  cat("Running Adaptive Rejection Sampling (ARS) tests...\\n\\n")\n  all_passed <- TRUE\n  \n  # Test 1: Normal distribution\n  tryCatch({\n    set.seed(42)\n    d_norm <- function(x) dnorm(x, mean = 0, sd = 1)\n    samples_norm <- ars(d_norm, domain = c(-4, 4), n = 1000, x_init = c(-1.5, 0, 1.5))\n    mean_val <- mean(samples_norm)\n    sd_val <- sd(samples_norm)\n    \n    # Expected mean ~ 0, sd ~ 1\n    if (abs(mean_val) < 0.2 && abs(sd_val - 1) < 0.2 && length(samples_norm) == 1000) {\n      cat(sprintf("NORMAL_DISTRIBUTION_TEST: PASS (mean = %.4f, sd = %.4f)\\n", mean_val, sd_val))\n      writeLines(as.character(samples_norm), "/app/normal_samples.txt")\n    } else {\n      cat(sprintf("NORMAL_DISTRIBUTION_TEST: FAIL (mean = %.4f, sd = %.4f)\\n", mean_val, sd_val))\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf("NORMAL_DISTRIBUTION_TEST: FAIL (Error: %s)\\n", e$message))\n    all_passed <- FALSE\n  })\n  \n  # Test 2: Exponential distribution\n  tryCatch({\n    set.seed(42)\n    d_exp <- function(x) dexp(x, rate = 1)\n    samples_exp <- ars(d_exp, domain = c(0.01, 10), n = 1000, x_init = c(0.5, 2, 4))\n    mean_val <- mean(samples_exp)\n    sd_val <- sd(samples_exp)\n    \n    # Expected mean ~ 1, sd ~ 1 for exp(rate=1)\n    if (abs(mean_val - 1) < 0.2 && abs(sd_val - 1) < 0.2 && length(samples_exp) == 1000) {\n      cat(sprintf("EXPONENTIAL_DISTRIBUTION_TEST: PASS (mean = %.4f, sd = %.4f)\\n", mean_val, sd_val))\n      writeLines(as.character(samples_exp), "/app/exponential_samples.txt")\n    } else {\n      cat(sprintf("EXPONENTIAL_DISTRIBUTION_TEST: FAIL (mean = %.4f, sd = %.4f)\\n", mean_val, sd_val))\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf("EXPONENTIAL_DISTRIBUTION_TEST: FAIL (Error: %s)\\n", e$message))\n    all_passed <- FALSE\n  })\n  \n  # Test 3: Input validation (negative sample count)\n  tryCatch({\n    ars(function(x) dnorm(x), c(-3, 3), n = -10)\n    cat("INPUT_VALIDATION_TEST_N: FAIL (Should have rejected negative n)\\n")\n    all_passed <- FALSE\n  }, error = function(e) {\n    cat("INPUT_VALIDATION_TEST_N: PASS (Correctly caught negative n)\\n")\n  })\n  \n  # Test 4: Input validation (invalid domain)\n  tryCatch({\n    ars(function(x) dnorm(x), c(3, -3), n = 100)\n    cat("INPUT_VALIDATION_TEST_DOMAIN: FAIL (Should have rejected invalid domain)\\n")\n    all_passed <- FALSE\n  }, error = function(e) {\n    cat("INPUT_VALIDATION_TEST_DOMAIN: PASS (Correctly caught invalid domain)\\n")\n  })\n  \n  # Test 5: Non-log-concave density check (e.g. Student\'s t or mixture of normals which is non-log-concave)\n  tryCatch({\n    # Mixture of two normals is not log-concave\n    d_mix <- function(x) 0.5 * dnorm(x, -2, 0.5) + 0.5 * dnorm(x, 2, 0.5)\n    ars(d_mix, c(-5, 5), n = 100, x_init = c(-3, 0, 3))\n    cat("NON_LOG_CONCAVE_TEST: FAIL (Should have detected non-log-concave density)\\n")\n    all_passed <- FALSE\n  }, error = function(e) {\n    cat(sprintf("NON_LOG_CONCAVE_TEST: PASS (Correctly detected non-log-concave density: %s)\\n", e$message))\n  })\n  \n  cat("\\nSummary:\\n")\n  if (all_passed) {\n    cat("ALL TESTS PASSED\\n")\n  } else {\n    cat("SOME TESTS FAILED\\n")\n  }\n}\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
