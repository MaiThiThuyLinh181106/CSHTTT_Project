[21.45394, "i", "python3 -c '\nimport numpy as np\nwith open(\"/app/image.ppm\", \"r\") as f:\n    tokens = f.read().split()\nimg = np.array([int(x) for x in tokens[4:]], dtype=np.uint8).reshape(1800, 2400, 3)\nprint(\"Shape:\", img.shape)\n# Check variance across rows/cols or find non-background pixels\nbg = img[0, 0]\nprint(\"Background color (0,0):\", bg)\ndiff = np.all(img != bg, axis=-1)\nprint(\"Non-bg pixel count:\", np.sum(diff))\n' \n"]
