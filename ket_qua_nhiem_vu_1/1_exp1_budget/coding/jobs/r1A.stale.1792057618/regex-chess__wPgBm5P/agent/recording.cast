[266.381596, "i", "cat << 'EOF' > /app/test_sub_debug.py\nimport re\nimport chess\n\nfen = \"rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1\"\nboard = chess.Board(fen)\nnext_fens = []\nfor move in board.legal_moves:\n    if move.promotion and move.promotion != chess.QUEEN:\n        continue\n    board_copy = board.copy()\n    board_copy.push(move)\n    next_fens.append(board_copy.fen())\n\ntarget_str = \"\\n\".join(next_fens)\npattern = re.escape(fen).replace(\"\\\\ \", \" \").replace(\"\\\\-\", \"-\")\nprint(\"Pattern:\", pattern)\nprint(\"Match found?\", bool(re.search(pattern, fen)))\nprint(\"Sub result:\", re.sub(pattern, target_str, fen))\nEOF\npython3 /app/test_sub_debug.py\n"]
