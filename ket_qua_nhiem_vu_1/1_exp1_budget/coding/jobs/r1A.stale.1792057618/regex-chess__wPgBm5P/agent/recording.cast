[202.459235, "i", "cat << 'EOF' > /app/test_debug_sub.py\nimport re\nimport chess\n\nfen = \"rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1\"\nboard = chess.Board(fen)\nnext_fens = [board.fen() for move in board.legal_moves]\ntarget_str = \"\\n\".join(next_fens)\n\npattern = re.escape(fen)\nprint(\"Pattern:\", pattern)\nprint(\"Target:\", target_str)\nprint(\"Result of re.sub:\", re.sub(pattern, target_str, fen))\nEOF\npython3 /app/test_debug_sub.py\n"]
