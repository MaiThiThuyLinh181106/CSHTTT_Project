[186.487605, "i", "cat << 'EOF' > /app/test_debug.py\nimport builtins\nimport io\nimport inspect\n\norig_open = builtins.open\n\ndef custom_open(file, *args, **kwargs):\n    if str(file).endswith(\"re.json\"):\n        print(\"--- STACK FRAMES ---\")\n        for i, frame_record in enumerate(inspect.stack()):\n            print(f\"{i}: {frame_record.function} locals: {list(frame_record.frame.f_locals.keys())}\")\n    return orig_open(file, *args, **kwargs)\n\nbuiltins.open = custom_open\n\nimport check\ncheck.run_solution(\"rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1\")\nEOF\npython3 /app/test_debug.py\n"]
