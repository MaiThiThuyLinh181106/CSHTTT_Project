[?2004h> import os
[?2004l[?2004h> from datetime import datetime, timedelta
[?2004l[?2004h> 
[?2004l[?2004h> log_dir = '/app/logs'
[?2004l[?2004h> ref_date = datetime(2025, 8, 12)
[?2004l[?2004h> 
[?2004l[?2004h> # Periods:
[?2004l[?2004h> # today: 2025-08-12
[?2004l[?2004h> # last_7_days: 2025-08-06 to 2025-08-12 (inclusive)
[?2004l[?2004h> # last_30_days: 2025-07-14 to 2025-08-12 (inclusive, 30 days including today)
[?2004l[?2004h> # month_to_date: 2025-08-01 to 2025-08-12
[?2004l[?2004h> # total: all
[?2004l[?2004h> 
[?2004l[?2004h> severities = ['ERROR', 'WARNING', 'INFO']
[?2004l[?2004h> 
[?2004l[?2004h> counts = {
[?2004l[?2004h>     'today': {s: 0 for s in severities},
[?2004l[?2004h>     'last_7_days': {s: 0 for s in severities},
[?2004l[?2004h>     'last_30_days': {s: 0 for s in severities},
[?2004l[?2004h>     'month_to_date': {s: 0 for s in severities},
[?2004l[?2004h>     'total': {s: 0 for s in severities}
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> for fname in os.listdir(log_dir):
[?2004l[?2004h>     if not fname.endswith('.log'):
[?2004l[?2004h>         continue
[?2004l[?2004h>     # Parse date from filename YYYY-MM-DD_<source>.log
[?2004l[?2004h>     date_str = fname.split('_')[0]
[?2004l[?2004h>     try:
[?2004l[?2004h>         file_date = datetime.strptime(date_str, '%Y-%m-%d')
[?2004l[?2004h>     except ValueError:
[?2004l[?2004h>         continue
[?2004l[?2004h> 
[?2004l[?2004h>     # Check inclusion in periods
[?2004l[?2004h>     is_today = (file_date == ref_date)
[?2004l[?2004h>     is_last_7 = (ref_date - timedelta(days=6) <= file_date <= ref_date)
[?2004l[?2004h>     is_last_30 = (ref_date - timedelta(days=29) <= file_date <= ref_date)
[?2004l[?2004h>     is_mtd = (file_date.year == ref_date.year and file_date.month == ref_date.month and datetime(2025, 8, 1) <= file_date <= ref_date)
[?2004l[?2004h> 
[?2004l[?2004h>     filepath = os.path.join(log_dir, fname)
[?2004l[?2004h>     with open(filepath, 'r') as f:
