[?2004hroot@835004a2e0d2:/app# cat << 'EOF' > parse_logs.py
[?2004lmedelta(days=6) <= file_date <= ref_date)
    is_last_30 = (ref_date - timedelta(days=29) <= file_date <= ref_date)
    is_mtd = (file_date.year == ref_date.year and file_date.month == ref_date.month and datetime(2025, 8, 1) <= file_date <= ref_date)

    filepath = os.path.join(log_dir, fname)
    with open(filepath, 'r') as f:
        for line in f:
            for s in severities:
                if f'[{s}]' in line:
                    if is_today:
                        counts['today'][s] += 1
                    if is_last_7:
                        counts['last_7_days'][s] += 1
                    if is_last_30:
                        counts['last_30_days'][s] += 1
                    if is_mtd:
                        counts['month_to_date'][s] += 1
                    counts['total'][s] += 1
                    break

import csv
with open('/app/summary.csv', 'w', newline='') as csvfile:
    writer = csv.writer(csvfile)
    writer.writerow(['period', 'severity', 'count'])
    for period in ['today', 'last_7_days', 'last_30_days', 'month_to_date', 'total']:
        for s in severities:
            writer.writerow([period, s, counts[period][s]])

print('Done writing summary.csv')
