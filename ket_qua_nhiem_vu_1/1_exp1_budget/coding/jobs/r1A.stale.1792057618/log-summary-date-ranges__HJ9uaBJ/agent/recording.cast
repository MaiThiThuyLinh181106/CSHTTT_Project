[16.0971, "i", "cat << 'EOF' > parse_logs.py\nimport os\nfrom datetime import datetime, timedelta\n\nlog_dir = '/app/logs'\nref_date = datetime(2025, 8, 12)\n\n# Periods:\n# today: 2025-08-12\n# last_7_days: 2025-08-06 to 2025-08-12 (inclusive)\n# last_30_days: 2025-07-14 to 2025-08-12 (inclusive, 30 days including today)\n# month_to_date: 2025-08-01 to 2025-08-12\n# total: all\n\nseverities = ['ERROR', 'WARNING', 'INFO']\n\ncounts = {\n    'today': {s: 0 for s in severities},\n    'last_7_days': {s: 0 for s in severities},\n    'last_30_days': {s: 0 for s in severities},\n    'month_to_date': {s: 0 for s in severities},\n    'total': {s: 0 for s in severities}\n}\n\nfor fname in os.listdir(log_dir):\n    if not fname.endswith('.log'):\n        continue\n    # Parse date from filename YYYY-MM-DD_<source>.log\n    date_str = fname.split('_')[0]\n    try:\n        file_date = datetime.strptime(date_str, '%Y-%m-%d')\n    except ValueError:\n        continue\n\n    # Check inclusion in periods\n    is_today = (file_date == ref_date)\n    is_last_7 = (ref_date - ti"]
[16.097334, "i", "medelta(days=6) <= file_date <= ref_date)\n    is_last_30 = (ref_date - timedelta(days=29) <= file_date <= ref_date)\n    is_mtd = (file_date.year == ref_date.year and file_date.month == ref_date.month and datetime(2025, 8, 1) <= file_date <= ref_date)\n\n    filepath = os.path.join(log_dir, fname)\n    with open(filepath, 'r') as f:\n        for line in f:\n            for s in severities:\n                if f'[{s}]' in line:\n                    if is_today:\n                        counts['today'][s] += 1\n                    if is_last_7:\n                        counts['last_7_days'][s] += 1\n                    if is_last_30:\n                        counts['last_30_days'][s] += 1\n                    if is_mtd:\n                        counts['month_to_date'][s] += 1\n                    counts['total'][s] += 1\n                    break\n\nimport csv\nwith open('/app/summary.csv', 'w', newline='') as csvfile:\n    writer = csv.writer(csvfile)\n    writer.writerow(['period', 'severity', 'count'])\n    for period in ['today',"]
[16.097471, "o", "cat << 'EOF' > parse_logs.py\r\n\u001b[?2004l\rmedelta(days=6) <= file_date <= ref_date)\r\n    is_last_30 = (ref_date - timedelta(days=29) <= file_date <= ref_date)\r\n    is_mtd = (file_date.year == ref_date.year and file_date.month == ref_date.month and datetime(2025, 8, 1) <= file_date <= ref_date)\r\n\r\n    filepath = os.path.join(log_dir, fname)\r\n    with open(filepath, 'r') as f:\r\n        for line in f:\r\n            for s in severities:\r\n                if f'[{s}]' in line:\r\n                    if is_today:\r\n                        counts['tod"]
[16.097609, "i", " 'last_7_days', 'last_30_days', 'month_to_date', 'total']:\n        for s in severities:\n            writer.writerow([period, s, counts[period][s]])\n\nprint('Done writing summary.csv')\nEOF\npython3 parse_logs.py\n"]
[16.097735, "o", "ay'][s] += 1\r\n                    if is_last_7:\r\n                        counts['last_7_days'][s] += 1\r\n                    if is_last_30:\r\n                        counts['last_30_days'][s] += 1\r\n                    if is_mtd:\r\n                        counts['month_to_date'][s] += 1\r\n                    counts['total'][s] += 1\r\n                    break\r\n\r\nimport csv\r\nwith open('/app/summary.csv', 'w', newline='') as csvfile:\r\n    writer = csv.writer(csvfile)\r\n    writer.writerow(['period', 'severity', 'count'])\r\n    for period in ['today', 'last_7_days', 'last_30_days', 'month_to_date', 'total']:\r\n        for s in severities:\r\n            writer.writerow([period, s, counts[period][s]])\r\n\r\nprint('Done writing summary.csv')\r\nEOF\r\npython3 parse_logs.py\r\n\u001b[?2004h> import os\r\n\u001b[?2004l\r"]
