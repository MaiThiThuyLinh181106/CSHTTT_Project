[16.10015, "o", "}\r\n\u001b[?2004l\r"]
[16.100222, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for fname in os.listdir(log_dir):\r\n\u001b[?2004l\r"]
[16.100252, "o", "\u001b[?2004h> "]
[16.100408, "o", "    if not fname.endswith('.log'):\r\n\u001b[?2004l\r\u001b[?2004h"]
[16.100439, "o", ">         continue\r\n\u001b[?2004l\r"]
[16.100577, "o", "\u001b[?2004h> "]
[16.100699, "o", "    # Parse date from filename YYYY-MM-DD_<source>.log\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.100813, "o", "    date_str = fname.split('_')[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[16.100849, "o", ">     try:\r\n\u001b[?2004l\r"]
[16.100977, "o", "\u001b[?2004h> "]
[16.101135, "o", "        file_date = datetime.strptime(date_str, '%Y-%m-%d')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.101203, "o", "    except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.101252, "o", "        continue\r\n\u001b[?2004l\r"]
[16.101283, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[16.101415, "o", "\u001b[?2004h> "]
[16.101521, "o", "    # Check inclusion in periods\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.101678, "o", "    is_today = (file_date == ref_date)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.101822, "o", "    is_last_7 = (ref_date - timedelta(days=6) <= file_date <= ref_date)\r\n\u001b[?2004l\r\u001b[?2004h"]
[16.101951, "o", "> "]
[16.102145, "o", "    is_last_30 = (ref_date - timedelta(days=29) <= file_date <= ref_date)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.102481, "o", "    is_mtd = (file_date.year == ref_date.year and file_date.month == ref_date.month and datetime(2025, 8, 1) <= file_date <= ref_date)\r\n\u001b[?2004l\r"]
[16.102638, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.102791, "o", "    filepath = os.path.join(log_dir, fname)\r\n\u001b[?2004l\r\u001b[?2004h>     with open(filepath, 'r') as f:\r\n\u001b[?2004l\r"]
[16.102933, "o", "\u001b[?2004h>         for line in f:\r\n\u001b[?2004l\r"]
[16.103029, "o", "\u001b[?2004h> "]
[16.103148, "o", "            for s in severities:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.103256, "o", "                if f'[{s}]' in line:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.103318, "o", "                    if is_today:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.103467, "o", "                        counts['today'][s] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.103625, "o", "                    if is_last_7:\r\n\u001b[?2004l\r\u001b[?2004h"]
[16.103746, "o", "> "]
[16.103866, "o", "                        counts['last_7_days'][s] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.104002, "o", "                    if is_last_30:\r\n\u001b[?2004l\r\u001b[?2004h"]
[16.104116, "o", "> "]
[16.104151, "o", "                        counts['last_30_days'][s] += 1\r\n\u001b[?2004l\r"]
[16.104278, "o", "\u001b[?2004h> "]
[16.104346, "o", "                    if is_mtd:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.104521, "o", "                        counts['month_to_date'][s] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[16.10462, "o", "> "]
[16.104896, "o", "                    counts['total'][s] += 1\r\n\u001b[?2004l\r\u001b[?2004h>                     break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.105197, "o", "with open('/app/summary.csv', 'w', newline='') as csvfile:\r\n\u001b[?2004l\r"]
[16.105333, "o", "\u001b[?2004h> "]
[16.105408, "o", "    writer = csv.writer(csvfile)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.105684, "o", "    writer.writerow(['period', 'severity', 'count'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.105795, "o", "    for period in ['today', 'last_7_days', 'last_30_days', 'month_to_date', 'total']:\r\n\u001b[?2004l\r"]
[16.105856, "o", "\u001b[?2004h"]
[16.106488, "o", ">         for s in severities:\r\n\u001b[?2004l\r"]
[16.106553, "o", "\u001b[?2004h> "]
[16.106989, "o", "            writer.writerow([period, s, counts[period][s]])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[16.10726, "o", "> print('Done writing summary.csv')\r\n\u001b[?2004l\r"]
[16.108131, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[16.11039, "o", "\u001b[?2004hroot@835004a2e0d2:/app# "]
[16.110452, "o", "python3 parse_logs.py\r\n\u001b[?2004l\r"]
[16.407685, "o", "Done writing summary.csv\r\n"]
[16.412433, "o", "\u001b[?2004hroot@835004a2e0d2:/app# "]
[23.839619, "i", "cat /app/summary.csv\n"]
[23.839807, "o", "cat /app/summary.csv\r\n\u001b[?2004l\r"]
[23.840974, "o", "period,severity,count\r\r\ntoday,ERROR,370\r\r\ntoday,WARNING,463\r\r\ntoday,INFO,1433\r\r\nlast_7_days,ERROR,2969\r\r\nlast_7_days,WARNING,4020\r\r\nlast_7_days,INFO,12203\r\r\nlast_30_days,ERROR,9594\r\r\nlast_30_days,WARNING,12847\r\r\nlast_30_days,INFO,38702\r\r\nmonth_to_date,ERROR,4682\r\r\nmonth_to_date,WARNING,6327\r\r\nmonth_to_date,INFO,19420\r\r\ntotal,ERROR,14160\r\r\ntotal,WARNING,18772\r\r\ntotal,INFO,56621\r\r\n"]
[23.841327, "o", "\u001b[?2004hroot@835004a2e0d2:/app# "]
