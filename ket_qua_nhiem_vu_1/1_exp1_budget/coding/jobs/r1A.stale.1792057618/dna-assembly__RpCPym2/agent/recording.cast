[608.622797, "o", "        # for rev primer annealing to template, we want Tm of the reverse complement or the template strand it anneals to.\r\n\u001b[?2004l\r"]
[608.623003, "o", "\u001b[?2004h> "]
[608.623167, "o", "        # oligotm takes 5' to 3' sequence of the oligo that anneals to the template. \r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.623379, "o", "        # The primer sequence itself anneals to the template. For rev primer, its 5'-to-3' sequence anneals to the reverse strand of the template.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.623644, "o", "        # Specifically, the annealing part of rev primer is the reverse complement of template[-l:].\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.623762, "o", "> "]
[608.62398, "o", "        # Let's write helper for reverse complement:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.624128, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def rc(dna):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.624289, "o", "    tr = str.maketrans(\"ATCGatcgNn\", \"TAGCtagcNn\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.624441, "o", "    return dna.translate(tr)[::-1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.624492, "o", "# Let's test finding valid annealing parts and Tms\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.624621, "o", "print(\"Helper functions defined.\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[608.627738, "o", "\u001b[?2004hroot@d69d6517eb0b:/app# python3 make_primers.py\r\n\u001b[?2004l\r"]
[608.678354, "o", "Helper functions defined.\r\n"]
[608.682375, "o", "\u001b[?2004hroot@d69d6517eb0b:/app# "]
[622.62209, "i", "cat << 'EOF' > generate_all.py\nimport subprocess\n\ndef get_tm(seq):\n    cmd = [\"oligotm\", \"-tp\", \"1\", \"-sc\", \"1\", \"-mv\", \"50\", \"-dv\", \"2\", \"-n\", \"0.8\", \"-d\", \"500\", seq]\n    res = subprocess.run(cmd, capture_output=True, text=True)\n    return float(res.stdout.strip())\n\ndef rc(dna):\n    tr = str.maketrans(\"ATCGatcgNn\", \"TAGCtagcNn\")\n    return dna.translate(tr)[::-1]\n\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\n# Define the exact template segments for each of the 4 parts:\n# 1. input (backbone): extracted from input plasmid, amplifying from index 690 to 214 (wrapping around).\n# So input template = seqs['input'][690:] + seqs['input'][:214]\n# 2. egfp: seqs['egfp'][:-3] (without stop codon)\n# 3. flag: seqs['flag'][3:-3] (without start and stop codon)\n# 4. snap: seqs['snap'][3:] (without start codon, keeps stop codon)\n\ntemplates = {\n    'input': seqs['input'][690:] + seqs['input'][:214],\n    'egfp': seqs['egfp'][:-3],\n    'flag': seqs['flag'][3:-3],\n    'snap': seqs['snap'][3:]\n}\n\n# Overhangs for assembly:\n# input -> egfp: overhang 'atga'\n# egfp -> flag: overhang 'ggta'\n# flag -> snap: overhang 'gaca'\n# snap -> input: overhang 'tgag'\n\noverhangs = {\n    'input': ('tgag', 'atga'), # fwd has tgag (or rev has tgag? Wait: fwd is at start of template, rev is at end of template).\n    # Let's check direction: \n    # input template starts at index 690 and ends at index 214.\n    # So input fwd primer anneals near index 690 (with overhang 'tgag' matching snap rev?). Wait, snap ends with 'tgag' or connects to backbone with 'tgag'?\n    # Let's verify junctions:\n    # Backbone part 2 starts at index 690 in input. In output, snap connects to backbone part 2. The overhang between snap and backbone is 'tgag' (or whatever was at 690).\n    # Let's write a python script to find optimal annealing regions for each part.\n}\n\nprint(\"Ready.\")\nEOF\npython3 generate_all.py\n"]
