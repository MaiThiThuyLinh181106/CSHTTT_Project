[131.326179, "i", "cat << 'EOF' > analyze4.py\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\nout = seqs['output']\n\n# Let's print out what is at:\n# egfp: from 210 to 924\n# flag: from 921 to 1010\n# snap: from 1004 to 1552 (let's check)\nprint(\"egfp in out:\", out[210:924] == seqs['egfp'][:-3])\nprint(\"flag in out:\", out[924:1014] == seqs['flag'])\nprint(\"snap in out:\", out[1014:1563] == seqs['snap'])\n\nEOF\npython3 analyze4.py\n"]
