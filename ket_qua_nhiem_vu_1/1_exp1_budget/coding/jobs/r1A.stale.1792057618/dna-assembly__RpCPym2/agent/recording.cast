[107.72048, "i", "cat << 'EOF' > analyze3.py\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\nout = seqs['output']\n\nfor name in ['flag', 'snap']:\n    s = seqs[name]\n    # search for pieces of s in out\n    for i in range(0, len(s)-20, 10):\n        chunk = s[i:i+20]\n        pos = out.find(chunk)\n        if pos != -1:\n            print(f\"{name} chunk {i} found at out pos {pos}\")\n\nEOF\npython3 analyze3.py\n"]
[107.720891, "o", "cat << 'EOF' > analyze3.py\r\n\u001b[?2004l\r"]
