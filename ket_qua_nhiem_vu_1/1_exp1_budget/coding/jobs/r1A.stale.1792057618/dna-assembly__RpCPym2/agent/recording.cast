[325.65329, "i", "cat << 'EOF' > analyze13.py\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\nout = seqs['output']\nsnap_no_atg = seqs['snap'][3:]\npos = out.find(snap_no_atg)\nprint(\"snap without atg in out at:\", pos, pos + len(snap_no_atg))\nprint(\"out after snap:\", out[pos + len(snap_no_atg):pos + len(snap_no_atg) + 50])\nprint(\"inp search for that suffix:\", inp.find(out[pos + len(snap_no_atg):pos + len(snap_no_atg) + 30]))\n\nEOF\npython3 analyze13.py\n"]
