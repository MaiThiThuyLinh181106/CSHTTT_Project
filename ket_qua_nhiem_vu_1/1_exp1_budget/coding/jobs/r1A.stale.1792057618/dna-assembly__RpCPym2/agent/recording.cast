[608.616681, "i", "cat << 'EOF' > make_primers.py\nimport subprocess\n\ndef get_tm(seq):\n    cmd = [\"oligotm\", \"-tp\", \"1\", \"-sc\", \"1\", \"-mv\", \"50\", \"-dv\", \"2\", \"-n\", \"0.8\", \"-d\", \"500\", seq]\n    res = subprocess.run(cmd, capture_output=True, text=True)\n    return float(res.stdout.strip())\n\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\n# Let's design primers for each template:\n# Templates:\n# 1. input (backbone): template is seqs['input']\n# 2. egfp: template is seqs['egfp']\n# 3. flag: template is seqs['flag']\n# 4. snap: template is seqs['snap']\n\n# We will search for annealing lengths (18 to 30 bp) for each primer (fwd and rev)\n# such that Tm is between 58 and 72, and |Tm_fwd - Tm_rev| <= 5.\n\ndef find_primer_region(template, target_len=20):\n    # try lengths from 18 to 35\n    best_sub = None\n    best_tm = 0\n    for l in range(18, 36):\n        sub = template[:l]\n        tm = get_tm(sub)\n        if 58 <= tm <= 72:\n            return sub, tm\n    return template[:20], get_tm(template[:20])\n\ndef find_primer_region_rev(template, target_len=20):\n    for l in range(18, 36):\n        sub = template[-l:]\n        # for rev primer annealing to template, we want Tm of the reverse complement or the template strand it anneals to.\n        # oligotm takes 5' to 3' sequence of the oligo that anneals to the template. \n        # The primer sequence itself anneals to the template. For rev primer, its 5'-to-3' sequence anneals to the reverse strand of the template.\n        # Specifically, the annealing part of rev primer is the reverse complement of template[-l:].\n        # Let's write helper for reverse complement:\n        pass\n\ndef rc(dna):\n    tr = str.maketrans(\"ATCGatcgNn\", \"TAGCtagcNn\")\n    return dna.translate(tr)[::-1]\n\n# Let's test finding valid annealing parts and Tms\nprint(\"Helper functions defined.\")\nEOF\npython3 make_primers.py\n"]
