[552.144058, "i", "cat << 'EOF' > check_junctions.py\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\nout = seqs['output']\n\nprint(\"Junction 1 (out[206:214]):\", out[206:214])\nprint(\"Junction 2 (out[920:928]):\", out[920:928])\nprint(\"Junction 3 (out[1004:1012]):\", out[1004:1012])\nprint(\"Junction 4 (out[1550:1558]):\", out[1550:1558])\n\nEOF\npython3 check_junctions.py\n"]
