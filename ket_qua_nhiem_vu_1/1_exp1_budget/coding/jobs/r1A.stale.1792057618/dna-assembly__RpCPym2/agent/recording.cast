[440.86304, "i", "cat << 'EOF' > find_parts.py\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\nout = seqs['output']\n\n# egfp in out\negfp = seqs['egfp'][:-3]\np_egfp = out.find(egfp)\nprint(\"egfp in out:\", p_egfp, p_egfp + len(egfp))\n\n# flag in out\nflag = seqs['flag'][3:-3]\np_flag = out.find(flag)\nprint(\"flag in out:\", p_flag, p_flag + len(flag))\n\n# snap in out\nsnap = seqs['snap'][3:]\np_snap = out.find(snap)\nprint(\"snap in out:\", p_snap, p_snap + len(snap))\n\n# backbone parts in out:\n# before egfp (0 to p_egfp)\n# after snap (p_snap + len(snap) to end of out)\nprint(\"Backbone part 1 (0 to p_egfp):\", out[:p_egfp])\nprint(\"Backbone part 2 (p_snap + len(snap) to end):\", out[p_snap + len(snap):])\n\nEOF\npython3 find_parts.py\n"]
