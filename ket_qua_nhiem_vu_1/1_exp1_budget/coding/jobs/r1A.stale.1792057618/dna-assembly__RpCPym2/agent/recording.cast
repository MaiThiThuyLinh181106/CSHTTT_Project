[641.53288, "o", "# input rev (end of input template, near 214) meets egfp fwd."]
[641.533033, "o", "\r\n\u001b[?2004l\r"]
[641.53308, "o", "\u001b[?2004h> "]
[641.534421, "o", "# egfp rev meets flag fwd.\r\n\u001b[?2004l\r\u001b[?2004h> # flag rev meets snap fwd.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's use exact overhangs from output:\r\n\u001b[?2004l\r\u001b[?2004h> # Between snap and input (around 1550): 'tgag'\r\n\u001b[?2004l\r\u001b[?2004h> # Between input and egfp (around 210): 'atga'\r\n\u001b[?2004l\r\u001b[?2004h> # Between egfp and flag (around 920): 'ggta'\r\n\u001b[?2004l\r\u001b[?2004h> # Between flag and snap (around 1004): 'gaca'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # So:\r\n\u001b[?2004l\r\u001b[?2004h> # input fwd has overhang 'tgag'\r\n\u001b[?2004l\r\u001b[?2004h> # input rev has overhang 'atga'\r\n\u001b[?2004l\r\u001b[?2004h> # egfp fwd has overhang 'atga'\r\n\u001b[?2004l\r\u001b[?2004h> # egfp rev has overhang 'ggta'\r\n\u001b[?2004l\r\u001b[?2004h> # flag fwd has overhang 'ggta'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.534835, "o", "# flag rev has overhang 'gaca'\r\n\u001b[?2004l\r\u001b[?2004h> # snap fwd has overhang 'gaca'\r\n\u001b[?2004l\r\u001b[?2004h> # snap rev has overhang 'tgag'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.534951, "o", "# Let's find annealing regions (length 18 to 35) for each template such that Tm is between 58 and 72\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.536683, "o", "parts = ['input', 'egfp', 'flag', 'snap']\r\n\u001b[?2004l\r\u001b[?2004h> primer_data = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for name in parts:\r\n\u001b[?2004l\r\u001b[?2004h>     tmpl = templates[name]\r\n\u001b[?2004l\r\u001b[?2004h>     # Find fwd annealing (start of template)\r\n\u001b[?2004l\r\u001b[?2004h>     best_fwd = None\r\n\u001b[?2004l\r\u001b[?2004h>     best_fwd_tm = 0\r\n\u001b[?2004l\r\u001b[?2004h>     for l in range(18, 36):\r\n\u001b[?2004l\r\u001b[?2004h>         ann = tmpl[:l]\r\n\u001b[?2004l\r\u001b[?2004h>         tm = get_tm(ann)\r\n\u001b[?2004l\r\u001b[?2004h>         if 58 <= tm <= 72:\r\n\u001b[?2004l\r\u001b[?2004h>             best_fwd = ann\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.536771, "o", "            best_fwd_tm = tm\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>     if not best_fwd:\r\n\u001b[?2004l\r\u001b[?2004h>         best_fwd = tmpl[:20]\r\n\u001b[?2004l\r\u001b[?2004h>         best_fwd_tm = get_tm(best_fwd)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.538034, "o", "    # Find rev annealing (end of template. Rev primer annealing sequence is rc of end of template)\r\n\u001b[?2004l\r\u001b[?2004h>     best_rev_ann = None\r\n\u001b[?2004l\r\u001b[?2004h>     best_rev_tm = 0\r\n\u001b[?2004l\r\u001b[?2004h>     for l in range(18, 36):\r\n\u001b[?2004l\r\u001b[?2004h>         ann_rc = rc(tmpl[-l:])\r\n\u001b[?2004l\r\u001b[?2004h>         tm = get_tm(ann_rc)\r\n\u001b[?2004l\r\u001b[?2004h>         if 58 <= tm <= 72:\r\n\u001b[?2004l\r\u001b[?2004h>             best_rev_ann = ann_rc\r\n\u001b[?2004l\r\u001b[?2004h>             best_rev_tm = tm\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>     if not best_rev_ann:\r\n\u001b[?2004l\r\u001b[?2004h>         best_rev_ann = rc(tmpl[-20:])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.5381, "o", "        best_rev_tm = get_tm(best_rev_ann)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.540973, "o", "    print(f\"{name}: fwd Tm={best_fwd_tm}, rev Tm={best_rev_tm}, diff={abs(best_fwd_tm - best_rev_tm)}\")\r\n\u001b[?2004l\r\u001b[?2004h>     primer_data[name] = (best_fwd, best_fwd_tm, best_rev_ann, best_rev_tm)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[641.544388, "o", "\u001b[?2004h"]
[641.545374, "o", "root@d69d6517eb0b:/app# python3 build_primers.py\r\n\u001b[?2004l\r"]
[641.601568, "o", "input: fwd Tm=59.806508, rev Tm=58.138529, diff=1.6679790000000025\r\n"]
[641.605324, "o", "egfp: fwd Tm=63.265142, rev Tm=59.139706, diff=4.1254360000000005\r\n"]
[641.610755, "o", "flag: fwd Tm=63.301116, rev Tm=59.489301, diff=3.811815000000003\r\n"]
[641.616376, "o", "snap: fwd Tm=58.251996, rev Tm=62.709354, diff=4.457357999999999\r\n"]
