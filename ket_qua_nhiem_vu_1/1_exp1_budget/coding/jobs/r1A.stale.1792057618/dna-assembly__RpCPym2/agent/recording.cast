[651.333166, "i", "cat << 'EOF' > write_fasta.py\nimport subprocess\n\ndef get_tm(seq):\n    cmd = [\"oligotm\", \"-tp\", \"1\", \"-sc\", \"1\", \"-mv\", \"50\", \"-dv\", \"2\", \"-n\", \"0.8\", \"-d\", \"500\", seq]\n    res = subprocess.run(cmd, capture_output=True, text=True)\n    return float(res.stdout.strip())\n\ndef rc(dna):\n    tr = str.maketrans(\"ATCGatcgNn\", \"TAGCtagcNn\")\n    return dna.translate(tr)[::-1]\n\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\ntemplates = {\n    'input': seqs['input'][690:] + seqs['input'][:214],\n    'egfp': seqs['egfp'][:-3],\n    'flag': seqs['flag'][3:-3],\n    'snap': seqs['snap'][3:]\n}\n\n# Overhangs:\n# input: fwd overhang 'tgag', rev overhang 'atga'\n# egfp: fwd overhang 'atga', rev overhang 'ggta'\n# flag: fwd overhang 'ggta', rev overhang 'gaca'\n# snap: fwd overhang 'gaca', rev overhang 'tgag'\n\noverhangs = {\n    'input': ('tgag', 'atga'),\n    'egfp': ('atga', 'ggta'),\n    'flag': ('ggta', 'gaca'),\n    'snap': ('gaca', 'tgag')\n}\n\nprimers = {}\n\nparts = ['input', 'egfp', 'flag', 'snap']\nfor name in parts:\n    tmpl = templates[\n        name\n    ]\n    # find fwd annealing\n    best_fwd = None\n    for l in range(18, 36):\n        ann = tmpl[:l]\n        tm = get_tm(ann)\n        if 58 <= tm <= 72:\n            best_fwd = ann\n            break\n    if not best_fwd:\n        best_fwd = tmpl[:20]\n\n    # find rev annealing\n    best_rev_ann = None\n    for l in range(18, 36):\n        ann_rc = rc(tmpl[-l:])\n        tm = get_tm(ann_rc)\n        if 58 <= tm <= 72:\n            best_rev_ann = ann_rc\n            break\n    if not best_rev_ann:\n        best_rev_ann = rc(tmpl[-20:])\n\n    oh_fwd, oh_rev = overhangs[name]\n    # Primer construction: 5'-ACCGGTCTC + oh + annealing-3'\n    fwd_seq = \"AGCGGTCTC\" + oh_fwd + best_fwd\n    rev_seq = \"AGCGGTCTC\" + oh_rev + best_rev_ann\n\n    primers[f\"{name}_fwd\"] = fwd_seq\n    primers[f\"{name}_rev\"] = rev_seq\n\n# Write to primers.fasta without blank lines\nwith open('primers.fasta', 'w') as f_out:\n    for p_name, p_seq in primers.items():\n        f_out.write(f\">{p_name}\\n{p_seq}\\n\")\n\nprint(\"primers.fasta written successfully.\")\n\nEOF\npython3 write_fasta.py\n"]
