[186.580331, "i", "cat << 'EOF' > analyze7.py\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\ninp = seqs['input']\nout = seqs['output']\n\nprint(\"Input length:\", len(inp))\nprint(\"Output length:\", len(out))\n\n# Let's find common chunks between input and output\n# Input has backbone. Let's find where output diverges from input.\n# E.g. output has egfp/flag/snap inserted between some positions in input.\n\n# Let's check prefix of input in output\npfx = inp[:50]\np = out.find(pfx)\nprint(\"Input prefix in output at:\", p)\n\nsfx = inp[-50:]\np2 = out.find(sfx)\nprint(\"Input suffix in output at:\", p2)\n\nEOF\npython3 analyze7.py\n"]
