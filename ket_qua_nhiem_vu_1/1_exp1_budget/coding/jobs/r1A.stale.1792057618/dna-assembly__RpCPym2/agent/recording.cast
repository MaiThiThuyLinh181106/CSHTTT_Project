[86.550945, "o", "\u001b[?2004hroot@d69d6517eb0b:/app# "]
[93.315433, "i", "cat << 'EOF' > analyze.py\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\nprint(\"Lengths:\")\nfor k, v in seqs.items():\n    print(k, len(v))\n\n# Let's check egfp vs output\n# maybe output has egfp without stop codon, or some changes?\n# Let's check substring matches of first 50 bps\nfor name in ['egfp', 'flag', 'snap']:\n    sub = seqs[name][:30]\n    p = seqs['output'].find(sub)\n    print(f\"{name} start ({sub}) in output at {p}\")\n    sub2 = seqs[name][-30:]\n    p2 = seqs['output'].find(sub2)\n    print(f\"{name} end ({sub2}) in output at {p2}\")\n\nEOF\npython3 analyze.py\n"]
