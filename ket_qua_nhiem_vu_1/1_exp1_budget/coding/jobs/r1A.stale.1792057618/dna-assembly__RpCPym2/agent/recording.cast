[333.626503, "i", "cat << 'EOF' > analyze14.py\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\ninp = seqs['input']\nout = seqs['output']\n\n# Let's verify the 4 parts in output:\n# Part 1: input backbone. Where does it start and end in output?\n# In output, part 1 goes from 0 to 214.\n# Where does part 1 resume in output? After snap, at pos 1554.\n\nprint(\"Part 1 start (0:214 in out):\", out[:214])\nprint(\"Part 1 end (1554: in out):\", out[1554:1554+100])\nprint(\"Does out[1554:] match inp corresponding part? Let's find out where out[1554:1554+30] is in input.\")\np_inp = inp.find(out[1554:1554+30])\nprint(\"Input index where backbone resumes:\", p_inp)\n\n# Let's check if inp[p_inp:] + inp[:214] matches out[1554:] + out[:214] (the whole backbone in output)\nbackbone_out = out[1554:] + out[:214]\nbackbone_inp = inp[p_inp:] + inp[:p_inp]\nprint(\"Backbone in out length:\", len(backbone_out))\nprint(\"Backbone in inp length:\", len(backbone_inp))\nprint(\"Backbone matches input?\", backbone_out == backbone_inp)\n\nEOF\npython3 analyze14.py\n"]
