[660.67976, "i", "cat << 'EOF' > verify_primers.py\nimport subprocess\n\ndef get_tm(seq):\n    cmd = [\"oligotm\", \"-tp\", \"1\", \"-sc\", \"1\", \"-mv\", \"50\", \"-dv\", \"2\", \"-n\", \"0.8\", \"-d\", \"500\", seq]\n    res = subprocess.run(cmd, capture_output=True, text=True)\n    return float(res.stdout.strip())\n\nwith open('primers.fasta') as f:\n    content = f.read()\n\nprint(\"--- primers.fasta content ---:\")\nprint(content)\n\nlines = content.splitlines()\nprint(\"Blank lines present?\", \"\" in lines)\n\n# Let's verify Tm and annealing lengths for each primer\n# In our primer design, prefix is 'AGCGGTCTC' (9 bp) + overhang (4 bp) = 13 bp. Annealing region is everything after 13 bp.\n\nwith open('sequences.fasta') as f:\n    seq_lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in seq_lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\ntemplates = {\n    'input': seqs['input'][690:] + seqs['input'][:214],\n    'egfp': seqs['egfp'][:-3],\n    'flag': seqs['flag'][3:-3],\n    'snap': seqs['snap'][3:]\n}\n\n# Parse primers.fasta\ni = 0\nwhile i < len(lines):\n    header = lines[i][1:]\n    seq = lines[i+1]\n    part, dir_ = header.split('_')\n    ann = seq[13:] # annealing part\n    tm = get_tm(ann)\n    print(f\"{header}: len(ann)={len(ann)}, Tm={tm}\")\n    assert 15 <= len(ann) <= 45, f\"Length {len(ann)} out of range for {header}\"\n    assert 58 <= tm <= 72, f\"Tm {tm} out of range for {header}\"\n    i += 2\n\nprint(\n\nprint(\"All verification checks passed successfully!\")\n\nEOF\npython3 verify_primers.py\n"]
