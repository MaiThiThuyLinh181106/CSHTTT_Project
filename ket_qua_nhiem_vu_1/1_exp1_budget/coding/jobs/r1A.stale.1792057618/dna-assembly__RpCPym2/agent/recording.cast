[312.077048, "i", "cat << 'EOF' > analyze12.py\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\nout = seqs['output']\nsnap_start = seqs['snap'][:30]\npos = out.find(snap_start)\nprint(\"snap start in out at:\", pos)\nprint(\"snap length:\", len(seqs['snap']))\nprint(\"out from pos to pos+len:\", out[pos:pos+len(seqs['snap'])])\nprint(\"matches exact snap?\", out[pos:pos+len(seqs['snap'])] == seqs['snap'])\nEOF\npython3 analyze12.py\n"]
