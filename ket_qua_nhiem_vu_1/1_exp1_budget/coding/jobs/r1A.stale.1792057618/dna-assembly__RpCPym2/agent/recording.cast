[196.173205, "i", "cat << 'EOF' > analyze8.py\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\ninp = seqs['input']\nout = seqs['output']\n\n# Input starts with:\nprint(\"inp[:100]:\", inp[:100])\nprint(\"out[:100]:\", out[:100])\n\n# Let's find where out diverges from inp at the start\nfor i in range(len(inp)):\n    if inp[i] != out[i]:\n        print(f\"Divergence at input idx {i}: inp={inp[i]}, out={out[i]}\")\n        print(\"inp around:\", inp[i-20:i+20])\n        print(\"out around:\", out[i-20:i+20])\n        break\n\n# And at the end / other junction:\n# output ends with suffix of input, let's find where output reconnects with input suffix\nsfx = inp[-50:]\np_sfx = out.find(sfx)\nprint(\"Input suffix starts in output at:\", p_sfx)\nprint(\"output[p_sfx-30:p_sfx+30]:\", out[p_sfx-30:p_sfx+30])\nprint(\"input ends with:\", inp[-30:])\n\nEOF\npython3 analyze8.py\n"]
