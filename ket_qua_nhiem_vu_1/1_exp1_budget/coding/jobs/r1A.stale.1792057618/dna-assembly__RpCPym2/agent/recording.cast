[503.721388, "i", "cat << 'EOF' > generate_primers.py\nimport subprocess\n\ndef get_tm(seq):\n    cmd = [\"oligotm\", \"-tp\", \"1\", \"-sc\", \"1\", \"-mv\", \"50\", \"-dv\", \"2\", \"-n\", \"0.8\", \"-d\", \"500\", seq]\n    res = subprocess.run(cmd, capture_output=True, text=True)\n    return float(res.stdout.strip())\n\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\nprint(\"Loaded sequences successfully.\")\nEOF\npython3 generate_primers.py\n"]
