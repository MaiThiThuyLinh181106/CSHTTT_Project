[140.326762, "i", "cat << 'EOF' > analyze5.py\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line);\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\nout = seqs['output']\nflag = seqs['flag']\nsnap = seqs['snap']\n\nfor start in range(915, 935):\n    for end in range(start + len(flag) - 5, start + len(flag) + 5):\n        if out[start:end] == flag:\n            print(f\"flag found at {start}:{end}\")\n\nfor start in range(1000, 1025):\n    for end in range(start + len(snap) - 5, start + len(snap) + 5):\n        if out[start:end] == snap:\n            print(f\"snap found at {start}:{end}\")\n\nEOF\npython3 analyze5.py\n"]
