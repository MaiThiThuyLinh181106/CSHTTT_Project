[20.012616, "i", "cat << 'EOF' > design.py\nimport subprocess\n\ndef get_tm(seq):\n    cmd = [\"oligotm\", \"-tp\", \"1\", \"-sc\", \"1\", \"-mv\", \"50\", \"-dv\", \"2\", \"-n\", \"0.8\", \"-d\", \"500\", \"-seq\", seq]\n    res = subprocess.run(cmd, capture_output=True, text=True)\n    return float(res.stdout.strip())\n\nprint(\"Oligotm test:\", get_tm(\"ATGCGATCGATCGATCGATC\"))\nEOF\npython3 design.py\n"]
