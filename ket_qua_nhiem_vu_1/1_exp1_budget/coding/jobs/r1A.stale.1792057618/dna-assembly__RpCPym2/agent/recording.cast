[93.318389, "o", "for name in ['egfp', 'flag', 'snap']:\r\n\u001b[?2004l\r\u001b[?2004h>     sub = seqs[name][:30]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.318591, "o", "    p = seqs['output'].find(sub)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.318767, "o", "    print(f\"{name} start ({sub}) in output at {p}\")\r\n\u001b[?2004l\r\u001b[?2004h>     sub2 = seqs[name][-30:]\r\n\u001b[?2004l\r"]
[93.318932, "o", "\u001b[?2004h> "]
[93.319113, "o", "    p2 = seqs['output'].find(sub2)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{name} end ({sub2}) in output at {p2}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[93.321099, "o", "\u001b[?2004hroot@d69d6517eb0b:/app# "]
[93.321358, "o", "python3 analyze.py\r\n\u001b[?2004l\r"]
[93.33353, "o", "Lengths:\r\ninput 2727\r\negfp 717\r\nflag 90\r\nsnap 549\r\noutput 3591\r\negfp start (atgagcaagggcgaggagctgttcaccggg) in output at 210\r\negfp end (actctcggcatggacgagctgtacaaataa) in output at -1\r\nflag start (atgggtagtggctccggtagcggtagcggc) in output at -1\r\nflag end (tccggttctggttcaggtagtggttcataa) in output at -1\r\nsnap start (atggacaaagactgcgaaatgaagcgcacc) in output at -1\r\n"]
[93.333831, "o", "snap end (cacagactgggtaagcctgggctgggttaa) in output at 1524\r\n"]
[93.336121, "o", "\u001b[?2004hroot@d69d6517eb0b:/app# "]
[100.758794, "i", "cat << 'EOF' > analyze2.py\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\nout = seqs['output']\negfp = seqs['egfp'][:-3] # remove stop codon\nflag = seqs['flag'][:-3] # remove stop codon\nsnap = seqs['snap']\n\nprint(\"egfp without stop in out?\", egfp in out)\nprint(\"flag without stop in out?\", flag in out)\nprint(\"snap in out?\", snap in out)\n\np1 = out.find(egfp)\np2 = out.find(flag)\np3 = out.find(snap)\nprint(\"egfp pos:\", p1, p1 + len(egfp))\nprint(\"flag pos:\", p2, p2 + len(flag))\nprint(\"snap pos:\", p3, p3 + len(snap))\n\n# What is before egfp and after snap in output?\n# output is circular. Let's find input parts in output.\nEOF\npython3 analyze2.py\n"]
[100.759185, "o", "cat << 'EOF' > analyze2.py\r\n\u001b[?2004l\r"]
