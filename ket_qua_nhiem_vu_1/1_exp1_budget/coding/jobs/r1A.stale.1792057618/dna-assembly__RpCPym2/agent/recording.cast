[641.521701, "i", "cat << 'EOF' > build_primers.py\nimport subprocess\n\ndef get_tm(seq):\n    cmd = [\"oligotm\", \"-tp\", \"1\", \"-sc\", \"1\", \"-mv\", \"50\", \"-dv\", \"2\", \"-n\", \"0.8\", \"-d\", \"500\", seq]\n    res = subprocess.run(cmd, capture_output=True, text=True)\n    return float(res.stdout.strip())\n\ndef rc(dna):\n    tr = str.maketrans(\"ATCGatcgNn\", \"TAGCtagcNn\")\n    return dna.translate(tr)[::-1]\n\nwith open('sequences.fasta') as f:\n    lines = f.read().splitlines()\n\nseqs = {}\ncurr = None\nfor line in lines:\n    if line.startswith('>'):\n        curr = line[1:]\n        seqs[curr] = []\n    else:\n        seqs[curr].append(line)\n\nfor k in seqs:\n    seqs[k] = ''.join(seqs[k])\n\ntemplates = {\n    'input': seqs['input'][690:] + seqs['input'][:214],\n    'egfp': seqs['egfp'][:-3],\n    'flag': seqs['flag'][3:-3],\n    'snap': seqs['snap'][3:]\n}\n\n# Let's define the 4 overhangs for the 4 parts in assembly order:\n# 1. input\n# 2. egfp\n# 3. flag\n# 4. snap\n# Assembly circle: input -> egfp -> flag -> snap -> input\n# Overhangs:\n# input fwd (start of input template, near 690) meets snap rev.\n# input rev (end of input template, near 214) meets egfp fwd.\n# egfp rev meets flag fwd.\n# flag rev meets snap fwd.\n\n# Let's use exact overhangs from output:\n# Between snap and input (around 1550): 'tgag'\n# Between input and egfp (around 210): 'atga'\n# Between egfp and flag (around 920): 'ggta'\n# Between flag and snap (around 1004): 'gaca'\n\n# So:\n# input fwd has overhang 'tgag'\n# input rev has overhang 'atga'\n# egfp fwd has overhang 'atga'\n# egfp rev has overhang 'ggta'\n# flag fwd has overhang 'ggta'\n# flag rev has overhang 'gaca'\n# snap fwd has overhang 'gaca'\n# snap rev has overhang 'tgag'\n\n# Let's find annealing regions (length 18 to 35) for each template such that Tm is between 58 and 72\nparts = ['input', 'egfp', 'flag', 'snap']\nprimer_data = {}\n\nfor name in parts:\n    tmpl = templates[name]\n    # Find fwd annealing (start of template)\n    best_fwd = None\n    best_fwd_tm = 0\n    for l in range(18, 36):\n        ann = tmpl[:l]\n        tm = get_tm(ann)\n        if 58 <= tm <= 72:\n            best_fwd = ann\n            best_fwd_tm = tm\n            break\n    if not best_fwd:\n        best_fwd = tmpl[:20]\n        best_fwd_tm = get_tm(best_fwd)\n\n    # Find rev annealing (end of template. Rev primer annealing sequence is rc of end of template)\n    best_rev_ann = None\n    best_rev_tm = 0\n    for l in range(18, 36):\n        ann_rc = rc(tmpl[-l:])\n        tm = get_tm(ann_rc)\n        if 58 <= tm <= 72:\n            best_rev_ann = ann_rc\n            best_rev_tm = tm\n            break\n    if not best_rev_ann:\n        best_rev_ann = rc(tmpl[-20:])\n        best_rev_tm = get_tm(best_rev_ann)\n\n    print(f\"{name}: fwd Tm={best_fwd_tm}, rev Tm={best_rev_tm}, diff={abs(best_fwd_tm - best_rev_tm)}\")\n    primer_data[name] = (best_fwd, best_fwd_tm, best_rev_ann, best_rev_tm)\n\nEOF\npython3 build_primers.py\n"]
