[15.142267, "i", "{\n  echo \"Subject: $(openssl x509 -noout -subject -in /app/ssl/server.crt)\"\n  echo \"Validity:\"\n  openssl x509 -noout -dates -in /app/ssl/server.crt\n  echo \"SHA-256 Fingerprint: $(openssl x509 -noout -fingerprint -sha256 -in /app/ssl/server.crt)\"\n} > /app/ssl/verification.txt\n"]
