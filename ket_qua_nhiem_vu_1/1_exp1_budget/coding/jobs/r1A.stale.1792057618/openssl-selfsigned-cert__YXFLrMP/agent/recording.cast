[16.155363, "i", "cat << 'EOF' > /app/check_cert.py\nimport os\nfrom datetime import datetime\nimport subprocess\n\ncert_path = '/app/ssl/server.crt'\nkey_path = '/app/ssl/server.key'\npem_path = '/app/ssl/server.pem'\n\nif not os.path.exists(cert_path) or not os.path.exists(key_path) or not os.path.exists(pem_path):\n    raise FileNotFoundError(\"Certificate, key, or PEM file not found\")\n\n# Use openssl to check\nsubject_out = subprocess.check_output(['openssl', 'x509', '-noout', '-subject', '-in', cert_path]).decode()\nprint(subject_out.strip())\n\ndates_out = subprocess.check_output(['openssl', 'x509', '-noout', '-dates', '-in', cert_path]).decode()\nprint(dates_out.strip())\n\nprint(\"Certificate verification successful\")\nEOF\npython3 /app/check_cert.py\n"]
[16.15562, "o", "cat << 'EOF' > /app/check_cert.py\r\n\u001b[?2004l\r"]
[16.155733, "o", "\u001b[?2004h> import os\r\n\u001b[?2004l\r"]
