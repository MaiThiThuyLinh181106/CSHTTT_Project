[593.010554, "o", "\u001b[?2004h>             (begin (display \"Failed to open file: \") (display filename) (newline))))\r\n\u001b[?2004l\r\u001b[?2004h>       (display \"No file provided to eval.scm\")))\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h"]
