[403.136966, "i", "\n      (apply proc args)))\n\n(define (map f lst)\n  (if (null? lst)\n      '()\n      (cons (f (car lst)) (map f (cdr lst)))))\n\n(define global-env\n  (list\n   (list\n    (cons '+ +)\n    (cons '- -)\n    (cons '* *)\n    (cons '/ /)\n    (cons '= =)\n    (cons '< <)\n    (cons '> >)\n    (cons '<= <=)\n    (cons '>= >=)\n    (cons 'cons cons)\n    (cons 'car car)\n    (cons 'cdr cdr)\n    (cons 'null? null?)\n    (cons 'pair? pair?)\n    (cons 'eq? eq?)\n    (cons 'equal? equal?)\n    (cons 'not not)\n    (cons 'and and)\n    (cons 'or or)\n    (cons 'read read)\n    (cons 'symbol symbol)\n    (cons 'symbol? symbol?)\n    (cons 'string? string?)\n    (cons 'number? number?)\n    (cons 'boolean? boolean?)\n    (cons 'set-car! set-car!)\n    (cons 'set-cdr! set-cdr!)\n    (cons 'else #t)\n    (cons 'display display)\n    (cons 'newline newline)\n    (cons 'fopen fopen)\n    (cons 'fclose fclose)\n    (cons 'getchr getchr)\n    (cons 'putchr putchr)\n    (cons 'chr chr)\n    (cons 'fgetchr fgetchr)\n    (cons 'fputchr fputchr)\n    (cons 'fdisplay fdispl"]
