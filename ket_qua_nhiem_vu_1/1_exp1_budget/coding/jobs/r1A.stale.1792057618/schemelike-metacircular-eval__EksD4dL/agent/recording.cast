[592.942667, "o", "    (cons 'list (lambda *args: __import__(\"functools\").reduce(lambda acc, x: Pair(x, acc), reversed(args), None))))\r\n\u001b[?2004l\r\u001b[?2004h"]
[592.942757, "o", "> "]
