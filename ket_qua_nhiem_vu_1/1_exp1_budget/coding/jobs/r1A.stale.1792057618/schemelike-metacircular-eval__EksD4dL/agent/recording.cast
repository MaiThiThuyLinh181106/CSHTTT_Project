[501.065748, "i", "cat << 'EOF' > check_parens.py\nwith open('eval.scm', 'r') as f:\n    content = f.read()\n\ndepth = 0\nfor i, c in enumerate(content):\n    if c == '(':\n        depth += 1\n    elif c == ')':\n        depth -= 1\n    if depth < 0:\n        print(f'Extra closing paren at index {i}, line/char roughly')\n        break\nprint('Final depth:', depth)\nEOF\npython3 check_parens.py\n"]
