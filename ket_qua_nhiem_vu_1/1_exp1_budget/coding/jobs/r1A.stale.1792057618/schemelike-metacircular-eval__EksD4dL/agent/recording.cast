[1148.788464, "i", "cat << 'EOF' > generate_eval.py\nimport sys\n\neval_code = '''\n;; Metacircular Evaluator in Scheme\n\n(define (lookup var env)\n  (if (null? env)\n      (begin (display \"Undefined variable: \") (display var) (newline) #f)\n      (let ((frame (car env)))\n        (let ((val (assoc var frame)))\n          (if val\n              (cdr val)\n              (lookup var (cdr env)))))))\n\n(define (assoc key alist)\n  (cond ((null? alist) #f)\n        ((eq? (car (car alist)) key) (car alist))\n        (else (assoc key (cdr alist)))))\n\n(define (extend-env vars vals base-env)\n  (let ((frame (if (symbol? vars)\n                   (cons (cons vars vals) '())\n                   (zip vars vals))))\n    (cons frame base-env)))\n\n(define (zip vars vals)\n  (if (null? vars)\n      '()\n      (cons (cons (car vars) (car vals))\n            (zip (cdr vars) (cdr vars)))))\n\n(define (define-var! var val env)\n  (let ((frame (car env)))\n    (set-car! env (cons (cons var val) frame))))\n\n(define (set-var! var val env)\n  (define (scanner e)\n    (if (null? e)\n  "]
[1148.788535, "i", "      #f\n        (let ((binding (assoc var (car e))))\n          (if binding\n              (begin (set-cdr! binding val) #t)\n              (scanner (cdr e))))))\n  (if (not (scanner env))\n      (begin (display \"Undefined variable for set!: \") (display var) (newline))\n      #f))\n\n(define (eval-expr expr env)\n  (cond\n   ((number? expr) expr)\n   ((boolean? expr) expr)\n   ((string? expr) expr)\n   ((symbol? expr) (lookup expr env))\n   ((null? expr) expr)\n   ((pair? expr)\n    (let ((car-expr (car expr)))\n      (cond\n       ((eq? car-expr 'quote)\n        (car (cdr expr)))\n       ((eq? car-expr 'if)\n        (if (eval-expr (car (cdr expr)) env)\n            (eval-expr (car (cdr (cdr expr))) env)\n            (let ((else-branch (cdr (cdr (cdr expr)))))\n              (if (null? else-branch)\n                  #f\n                  (eval-expr (car else-branch) env)))))\n       ((eq? car-expr 'define)\n        (let ((name-or-list (car (cdr expr))))\n          (if (pair? name-or-list)\n              (let ((name (car name-or-list))\n "]
[1148.788553, "i", "                   (params (cdr name-or-list))\n                    (body (cdr (cdr expr))))\n                (let ((proc (cons 'procedure (cons params (cons body (cons env '()))))))\n                  (define-var! name proc env)\n                  name))\n              (let ((name name-or-list)\n                    (val (eval-expr (car (cdr (cdr expr))) env)))\n                (define-var! name val env)\n                name))))\n       ((eq? car-expr 'set!)\n        (let ((name (car (cdr expr)))\n              (val (eval-expr (car (cdr (cdr expr))) env)))\n          (set-var! name val env)))\n       ((eq? car-expr 'lambda)\n        (let ((params (car (cdr expr)))\n              (body (cdr (cdr expr))))\n          (cons 'procedure (cons params (cons body (cons env '()))))))\n       ((eq? car-expr 'let)\n        (let ((bindings (car (cdr expr)))\n              (body (cdr (cdr expr))))\n          (let ((vars (map car bindings))\n                (vals (map (lambda (b) (eval-expr (car (cdr b)) env)) bindings)))\n            (let ((ne"]
[1148.788593, "i", "w-env (extend-env vars vals env)))\n              (eval-begin body new-env)))))\n       ((eq? car-expr 'begin)\n        (eval-begin (cdr expr) env))\n       ((eq? car-expr 'cond)\n        (eval-cond (cdr expr) env))\n       (else\n        (let ((proc (eval-expr car-expr env))\n              (args (map (lambda (e) (eval-expr e env)) (cdr expr))))\n          (apply-proc proc args))))))\n   (else expr)))\n\n(define (eval-begin body env)\n  (if (null? (cdr body))\n      (eval-expr (car body) env)\n      (begin\n        (eval-expr (car body) env)\n        (eval-begin (cdr body) env))))\n\n(define (eval-cond clauses env)\n  (if (null? clauses)\n      #f\n      (let ((clause (car clauses)))\n        (let ((test (car clause)))\n          (if (or (eq? test 'else) (eval-expr test env))\n              (eval-begin (cdr clause) env)\n              (eval-cond (cdr clauses) env))))))\n\n(define (apply-proc proc args)\n  (if (and (pair? proc) (eq? (car proc) 'procedure))\n      (let ((params (car (cdr proc)))\n            (body (car (cdr (cdr proc))))\n   "]
[1148.788608, "i", "         (env (car (cdr (cdr (cdr proc))))))\n        (let ((new-env (extend-env params args env)))\n          (eval-begin body new-env)))\n      (proc args)))\n\n(define (map f lst)\n  (if (null? lst)\n      '()\n      (cons (f (car lst)) (map f (cdr lst)))))\n\n'''\n\nprimitives = [\n    '+', '-', '*', '/', '=', '<', '>', '<=', '>=',\n    'cons', 'car', 'cdr', 'null?', 'pair?', 'eq?', 'equal?',\n    'not', 'and', 'or', 'read', 'symbol', 'symbol?', 'string?', 'number?',\n    'set-car!', 'set-cdr!', 'else', 'display', 'newline',\n    'fopen', 'fclose', 'getchr', 'putchr', 'chr', 'fgetchr',\n    'fputchr', 'fdisplay', 'fread', 'map'\n]\n\nalist_code = \"'()\"\nfor p in reversed(primitives):\n    if p == 'else':\n        alist_code = f\"(cons (cons '{p} #t) {alist_code})\"\n    else:\n        alist_code = f\"(cons (cons '{p} {p}) {alist_code})\"\n\nalist_code = f\"(cons (cons 'list (lambda (x) (cons x '()))) {alist_code})\"\n\nfull_code = eval_code + f\"\\n(define global-env (cons {alist_code} '()))\\n\\n\" + '''\n(let ((filename (read)))\n  (if filename\n"]
[1148.788624, "i", "      (let ((f (fopen filename \"r\")))\n        (if f\n            (let loop ()\n              (let ((expr (fread f)))\n                (if expr\n                    (begin\n                      (eval-expr expr global-env)\n                      (loop))\n                    (fclose f))))\n            (begin (display \"Failed to open file: \") (display filename) (newline))))\n      (display \"No file provided to eval.scm\")))\n'''\n\nwith open('eval.scm', 'w') as f:\n    f.write(full_code)\nEOF\npython3 generate_eval.py\npython3 parse_check.py\npython3 check_parens.py\n"]
