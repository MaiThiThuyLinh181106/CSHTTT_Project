[1241.580007, "o", ">         (let ((test (car clause)))\r\n\u001b[?2004l\r\u001b[?2004h>           (if (or (eq? test 'else) (eval-expr test env))\r\n\u001b[?2004l\r\u001b[?2004h>               (eval-begin (cdr clause) env)\r\n\u001b[?2004l\r\u001b[?2004h>               (eval-cond (cdr clauses) env))))))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> (define (apply-proc proc args)\r\n\u001b[?2004l\r\u001b[?2004h>   (if (and (pair? proc) (eq? (car proc) 'procedure))\r\n\u001b[?2004l\r\u001b[?2004h>       (let ((params (car (cdr proc))))\r\n\u001b[?2004l\r\u001b[?2004h>         (let ((body (car (cdr (cdr proc)))))\r\n\u001b[?2004l\r\u001b[?2004h>           (let ((env (car (cdr (cdr (cdr proc))))))\r\n\u001b[?2004l\r\u001b[?2004h>             (let ((new-env (extend-env params args env)))\r\n\u001b[?2004l\r\u001b[?2004h>               (eval-begin body new-env)))))\r\n\u001b[?2004l\r\u001b[?2004h>       (proc args)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> (define (map f lst)\r\n\u001b[?2004l\r\u001b[?2004h>   (if (null? lst)\r\n\u001b[?2004l\r\u001b[?2004h>       '()\r\n\u001b[?2004l\r\u001b[?2004h>       (cons (f (car lst)) (map f (cdr lst)))))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?"]
[1241.580131, "o", "2004h> \r\n\u001b[?2004l\r\u001b[?2004h> primitives = [\r\n\u001b[?2004l\r\u001b[?2004h>     '+', '-', '*', '/', '=', '<', '>', '<=', '>=',\r\n\u001b[?2004l\r\u001b[?2004h>     'cons', 'car', 'cdr', 'null?', 'pair?', 'eq?', 'equal?',\r\n\u001b[?2004l\r\u001b[?2004h>     'not', 'and', 'or', 'read', 'symbol', 'symbol?', 'string?', 'number?',\r\n"]
[1241.580184, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1241.580234, "o", "> "]
[1241.58051, "o", "    'set-car!', 'set-cdr!', 'else', 'display', 'newline',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.580809, "o", "    'fopen', 'fclose', 'getchr', 'putchr', 'chr', 'fgetchr',\r\n\u001b[?2004l\r\u001b[?2004h"]
[1241.580945, "o", "> "]
[1241.581339, "o", "    'fputchr', 'fdisplay', 'fread', 'map'\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[1241.581832, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> alist_code = \"'()\"\r\n\u001b[?2004l\r\u001b[?2004h> for p in reversed(primitives):\r\n\u001b[?2004l\r"]
[1241.582138, "o", "\u001b[?2004h>     if p == 'else':\r\n\u001b[?2004l\r\u001b[?2004h>         alist_code = f\"(cons (cons '{p} #t) {alist_code})\"\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.58231, "o", "        alist_code = f\"(cons (cons '{p} {p}) {alist_code})\"\r\n\u001b[?2004l\r"]
[1241.582368, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1241.582633, "o", "> "]
[1241.582758, "o", "alist_code = f\"(cons (cons 'list (lambda (x) (cons x '()))) {alist_code})\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.58281, "o", "\r\n\u001b[?2004l\r"]
[1241.583038, "o", "\u001b[?2004h> "]
[1241.590841, "o", "full_code = eval_code + f\"\\n(define global-env (cons {alist_code} '()))\\n\\n\" + '''"]
[1241.591417, "o", "\r\n"]
[1241.591994, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1241.595643, "o", "(let ((filename (read)))\r\n\u001b[?2004l\r\u001b[?2004h>   (if filename\r\n\u001b[?2004l\r\u001b[?2004h>       (let ((f (fopen filename \"r\")))\r\n\u001b[?2004l\r\u001b[?2004h>         (if f\r\n\u001b[?2004l\r\u001b[?2004h>             (let loop ()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.598839, "o", "              (let ((expr (fread f)))\r\n\u001b[?2004l\r"]
[1241.598985, "o", "\u001b[?2004h> "]
[1241.603757, "o", "                (if expr\r\n\u001b[?2004l\r\u001b[?2004h>                     (begin\r\n\u001b[?2004l\r\u001b[?2004h>                       (eval-expr expr global-env)\r\n\u001b[?2004l\r\u001b[?2004h>                       (loop))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1241.604225, "o", ">                     (fclose f))))"]
[1241.60428, "o", "\r\n\u001b[?2004l\r"]
[1241.604946, "o", "\u001b[?2004h>             (begin (display \"Failed to open file: \") (display filename) (newline))))\r\n\u001b[?2004l\r"]
[1241.605391, "o", "\u001b[?2004h> "]
[1241.605803, "o", "      (display \"No file provided to eval.scm\")))\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1241.606702, "o", "> "]
[1241.652175, "o", "with open('eval.scm', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     f.write(full_code)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
