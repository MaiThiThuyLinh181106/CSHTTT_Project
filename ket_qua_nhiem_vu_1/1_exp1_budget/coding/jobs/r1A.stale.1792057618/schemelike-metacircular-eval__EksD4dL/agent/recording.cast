[1942.070404, "o", "(define (define-var! var val env)\r\n  (let ((frame (car env)))\r\n    (set-car! env (cons (cons var val) frame))))\r\n\r\n(define (set-var! var val env)\r\n  (let ((scanner (lambda (e)\r\n                   (if (null? e)\r\n                       #f\r\n                       (let ((binding (assoc var (car e))))\r\n                         (if binding\r\n                             (begin\r\n                               (set-cdr! binding val)\r\n                               #t)\r\n                             (scanner (cdr e))))))))\r\n    (if (not (scanner env))\r\n        (begin\r\n          (display \"Undefined variable for set!: \")\r\n          (display var)\r\n          (newline))\r\n        #f))\r\n\r\n"]
