[1148.875827, "o", "    'fopen', 'fclose', 'getchr', 'putchr', 'chr', 'fgetchr',\r\n\u001b[?2004l\r\u001b[?2004h>     'fputchr', 'fdisplay', 'fread', 'map'\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> alist_code = \"'()\"\r\n\u001b[?2004l\r\u001b[?2004h> for p in reversed(primitives):\r\n\u001b[?2004l\r\u001b[?2004h>     if p == 'else':\r\n\u001b[?2004l\r\u001b[?2004h>         alist_code = f\"(cons (cons '{p} #t) {alist_code})\"\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         alist_code = f\"(cons (cons '{p} {p}) {alist_code})\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> alist_code = f\"(cons (cons 'list (lambda (x) (cons x '()))) {alist_code})\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> full_code = eval_code + f\"\\n(define global-env (cons {alist_code} '()))\\n\\n\" + '''\r\n\u001b[?2004l\r\u001b[?2004h> (let ((filename (read)))\r\n\u001b[?2004l\r\u001b[?2004h>   (if filename\r\n\u001b[?2004l\r\u001b[?2004h>       (let ((f (fopen filename \"r\")))\r\n\u001b[?2004l\r\u001b[?2004h>         (if f\r\n\u001b[?2004l\r\u001b[?2004h>             (let loop ()\r\n\u001b[?2004l\r"]
[1148.876283, "o", "\u001b[?2004h>               (let ((expr (fread f)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1148.878169, "o", "                (if expr\r\n\u001b[?2004l\r\u001b[?2004h>                     (begin\r\n\u001b[?2004l\r\u001b[?2004h>                       (eval-expr expr global-env)\r\n\u001b[?2004l\r\u001b[?2004h>                       (loop))\r\n\u001b[?2004l\r\u001b[?2004h>                     (fclose f))))\r\n\u001b[?2004l\r\u001b[?2004h>             (begin (display \"Failed to open file: \") (display filename) (newline))))\r\n\u001b[?2004l\r\u001b[?2004h>       (display \"No file provided to eval.scm\")))\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('eval.scm', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     f.write(full_code)\r\n\u001b[?2004l\r\u001b[?2004h> "]
