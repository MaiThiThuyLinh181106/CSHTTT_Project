[521.1608, "o", "(define global-env\r\n  (list\r\n   (list\r\n    (cons '+ +)\r\n    (cons '- -)\r\n    (cons '* *)\r\n    (cons '/ /)\r\n    (cons '= =)\r\n    (cons '< <)\r\n    (cons '> >)\r\n    (cons '<= <=)\r\n    (cons '>= >=)\r\n    (cons 'cons cons)\r\n    (cons 'car car)\r\n    (cons 'cdr cdr)\r\n    (cons 'null? null?)\r\n    (cons 'pair? pair?)\r\n    (cons 'eq? eq?)\r\n    (cons 'equal? equal?)\r\n    (cons 'not not)\r\n    (cons 'and and)\r\n    (cons 'or or)\r\n    (cons 'read read)\r\n    (cons 'symbol symbol)\r\n    (cons 'symbol? symbol?)\r\n    (cons 'string? string?)\r\n    (cons 'number? number?)\r\n    (cons 'boolean? boolean?)\r\n    (cons 'set-car! set-car!)\r\n    (cons 'set-cdr! set-cdr!)\r\n    (cons 'else #t)\r\n    (cons 'display display)\r\n    (cons 'newline newline)\r\n    (cons 'fopen fopen)\r\n    (cons 'fclose fclose)\r\n    (cons 'getchr getchr)\r\n    (cons 'putchr putchr)\r\n    (cons 'chr chr)\r\n    (cons 'fgetchr fgetchr)\r\n    (cons 'fputchr fputchr)\r\n    (cons 'fdisplay fdisplay)\r\n    (cons 'fread fread)\r\n    (cons 'apply apply)\r\n    (cons 'map map)\r\n    (con"]
[521.161174, "o", "s 'list (lambda *args: __import__(\"functools\").reduce(lambda acc, x: Pair(x, acc), reversed(args), None))))\r\n)\r\n\r\n(let ((filename (read)))\r\n  (if filename\r\n      (let ((f (fopen filename \"r\")))\r\n        (if f\r\n            (let loop ()\r\n              (let ((expr (fread f)))\r\n                (if expr\r\n                    (begin\r\n                      (eval-expr expr global-env)\r\n                      (loop))\r\n                    (fclose f))))\r\n            (begin (display \"Failed to open file: \") (display filename) (newline))))\r\n      (display \"No file provided to eval.scm\")))\r\n"]
