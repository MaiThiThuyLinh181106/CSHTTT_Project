[403.135764, "i", "cat << 'EOF' > generate_eval.py\nimport sys\n\neval_code = '''\n;; Metacircular Evaluator in Scheme\n\n(define (lookup var env)\n  (if (null? env)\n      (begin (display \"Undefined variable: \") (display var) (newline) #f)\n      (let ((frame (car env)))\n        (let ((val (assoc var frame)))\n          (if val\n              (cdr val)\n              (lookup var (cdr env)))))))\n\n(define (assoc key alist)\n  (cond ((null? alist) #f)\n        ((eq? (car (car alist)) key) (car alist))\n        (else (assoc key (cdr alist)))))\n\n(define (extend-env vars vals base-env)\n  (let ((frame (zip vars vals)))\n    (cons frame base-env)))\n\n(define (zip vars vals)\n  (if (null? vars)\n      '()\n      (cons (cons (car vars) (car vals))\n            (zip (cdr vars) (cdr vals)))))\n\n(define (define-var! var val env)\n  (let ((frame (car env)))\n    (set-car! env (cons (cons var val) frame))))\n\n(define (set-var! var val env)\n  (define (scanner e)\n    (if (null? e)\n        #f\n        (let ((binding (assoc var (car e))))\n          (if binding\n          "]
[403.13605, "i", "    (begin (set-cdr! binding val) #t)\n              (scanner (cdr e))))))\n  (if (not (scanner env))\n      (begin (display \"Undefined variable for set!: \") (display var) (newline))\n      #f))\n\n(define (eval-expr expr env)\n  (cond\n   ((number? expr) expr)\n   ((boolean? expr) expr)\n   ((string? expr) expr)\n   ((symbol? expr) (lookup expr env))\n   ((null? expr) expr)\n   ((pair? expr)\n    (let ((car-expr (car expr)))\n      (cond\n       ((eq? car-expr 'quote)\n        (car (cdr expr)))\n       ((eq? car-expr 'if)\n        (if (eval-expr (car (cdr expr)) env)\n            (eval-expr (car (cdr (cdr expr))) env)\n            (let ((else-branch (cdr (cdr (cdr expr)))))\n              (if (null? else-branch)\n                  #f\n                  (eval-expr (car else-branch) env)))))\n       ((eq? car-expr 'define)\n        (let ((name-or-list (car (cdr expr))))\n          (if (pair? name-or-list)\n              (let ((name (car name-or-list))\n                    (params (cdr name-or-list))\n                    (body (cdr (cdr exp"]
[403.136199, "i", "r))))\n                (let ((proc (list 'procedure params body env)))\n                  (define-var! name proc env)\n                  name))\n              (let ((name name-or-list)\n                    (val (eval-expr (car (cdr (cdr expr))) env)))\n                (define-var! name val env)\n                name))))\n       ((eq? car-expr 'set!)\n        (let ((name (car (cdr expr)))\n              (val (eval-expr (car (cdr (cdr expr))) env)))\n          (set-var! name val env)))\n       ((eq? car-expr 'lambda)\n        (let ((params (car (cdr expr)))\n              (body (cdr (cdr expr))))\n          (list 'procedure params body env)))\n       ((eq? car-expr 'let)\n        (let ((bindings (car (cdr expr)))\n              (body (cdr (cdr expr))))\n          (let ((vars (map car bindings))\n                (vals (map (lambda (b) (eval-expr (car (cdr b)) env)) bindings)))\n            (let ((new-env (extend-env vars vals env)))\n              (eval-begin body new-env)))))\n       ((eq? car-expr 'begin)\n        (eval-begin (cdr ex"]
