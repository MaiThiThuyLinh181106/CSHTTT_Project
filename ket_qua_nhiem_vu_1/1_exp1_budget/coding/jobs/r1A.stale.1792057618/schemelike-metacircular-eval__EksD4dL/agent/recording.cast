[592.953277, "o", "                (if expr\r\n\u001b[?2004l\r\u001b[?2004h>                     (begin\r\n\u001b[?2004l\r\u001b[?2004h>                       (eval-expr expr global-env)\r\n\u001b[?2004l\r\u001b[?2004h"]
[592.953495, "o", "> "]
