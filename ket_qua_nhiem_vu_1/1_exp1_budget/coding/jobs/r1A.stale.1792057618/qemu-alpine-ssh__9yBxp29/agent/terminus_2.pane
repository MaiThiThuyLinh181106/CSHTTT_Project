cat << 'EOF' > setup_vm.py
import pexpect
import sys
import time

f = open('setup.log', 'w')
child = pexpect.spawn('qemu-system-x86_64 -m 512 -cdrom /app/alpine.iso -net nic,model=virtio -net user,hostfwd=tcp::2222-:22 -nographic', encoding='utf-8', timeout=300)
child.logfile = f

child.expect('boot:', timeout=120)
f.write('Found boot prompt\n')
f.flush()
time.sleep(1)
child.sendline('lts console=ttyS0')

child.expect('login:', timeout=180)
f.write('Found login prompt\n')
f.flush()
child.sendline('root')

child.expect('#', timeout=60)
f.write('Logged in\n')
f.flush()

child.sendline('echo root:password123 | chpasswd')
child.expect('#', timeout=30)

child.sendline('apk update && apk add openssh')
child.expect('#', timeout=120)

child.sendline('sed -i "s/#PermitRootLogin.*/PermitRootLogin yes/" /etc/ssh/sshd_config')
child.expect('#', timeout=30)
child.sendline('sed -i "s/#PasswordAuthentication.*/PasswordAuthentication yes/" /etc/ssh/sshd_config')
child.expect('#', timeout=30)

child.sendline('rc-update add sshd')
child.expect('#', timeout=30)
child.sendline('/etc/init.d/sshd start')
child.expect('#', timeout=30)

f.write('Setup complete\n')
f.flush()

while True:
    time.sleep(10)
