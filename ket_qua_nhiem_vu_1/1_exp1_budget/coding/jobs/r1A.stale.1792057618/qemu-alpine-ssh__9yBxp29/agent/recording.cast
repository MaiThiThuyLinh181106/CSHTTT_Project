[683.714081, "o", "python3 -c 'import glob; [print(open(p).read()) for p in glob.glob(\"/proc/[0-9]*/cmdline\") if \"setup_vm\" in open(p).read()]'\r\n"]
[692.851485, "i", "python3 -c 'import os, glob\nfor p in glob.glob(\"/proc/[0-9]*/cmdline\"):\n    try:\n        with open(p) as f:\n            cmd = f.read()\n            if \"qemu\" in cmd or \"setup_vm\" in cmd:\n                pid = int(p.split(\"/\")[2])\n                os.kill(pid, 9)\n                print(f\"Killed {pid}\")\n    except Exception as e:\n        pass\n'\n"]
[692.85614, "o", "python3 -c 'import os, glob\r\nfor p in glob.glob(\"/proc/[0-9]*/cmdline\"):\r\n    try:\r\n        with open(p) as f:\r\n            cmd = f.read()\r\n            if \"qemu\" in cmd or \"setup_vm\" in cmd:\r\n                pid = int(p.split(\"/\")[2])\r\n                os.kill(pid, 9)\r\n                print(f\"Killed {pid}\")\r\n    except Exception as e:\r\n        pass\r\n'\r\n"]
[694.030876, "i", "cat << 'EOF' > setup_vm.py\nimport pexpect\nimport sys\nimport time\n\nf = open('setup.log', 'w')\nchild = pexpect.spawn('qemu-system-x86_64 -m 512 -cdrom /app/alpine.iso -net nic,model=virtio -net user,hostfwd=tcp::2222-:22 -nographic', encoding='utf-8', timeout=300)\nchild.logfile = f\n\nchild.expect('boot:', timeout=120)\nf.write('Found boot prompt\\n')\nf.flush()\ntime.sleep(1)\nchild.sendline('lts console=ttyS0')\n\nchild.expect('login:', timeout=180)\nf.write('Found login prompt\\n')\nf.flush()\nchild.sendline('root')\n\nchild.expect('#', timeout=60)\nf.write('Logged in\\n')\nf.flush()\n\nchild.sendline('echo root:password123 | chpasswd')\nchild.expect('#', timeout=30)\n\nchild.sendline('apk update && apk add openssh')\nchild.expect('#', timeout=120)\n\nchild.sendline('sed -i \"s/#PermitRootLogin.*/PermitRootLogin yes/\" /etc/ssh/sshd_config')\nchild.expect('#', timeout=30)\nchild.sendline('sed -i \"s/#PasswordAuthentication.*/PasswordAuthentication yes/\" /etc/ssh/sshd_config')\nchild.expect('#', timeout=30)\n\nchild.sendline('rc-update add ss"]
