[49.838492, "o", "('apk update && apk add openssh')\r\n\u001b[?2004l\r\u001b[?2004h> child.expect('#', timeout=60)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> child.sendline('sed -i \"s/#PermitRootLogin.*/PermitRootLogin yes/\" /etc/ssh/sshd_config')\r\n\u001b[?2004l\r\u001b[?2004h> child.expect('#', timeout=30)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> child.sendline('rc-update add sshd')\r\n\u001b[?2004l\r\u001b[?2004h> child.expect('#', timeout=30)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> child.sendline('/etc/init.d/sshd start')\r\n\u001b[?2004l\r\u001b[?2004h> child.expect('#', timeout=30)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('SSH server setup complete inside VM.')\r\n\u001b[?2004l\r\u001b[?2004h> # Keep running so the VM stays up\r\n\u001b[?2004l\r\u001b[?2004h> child.interact()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
