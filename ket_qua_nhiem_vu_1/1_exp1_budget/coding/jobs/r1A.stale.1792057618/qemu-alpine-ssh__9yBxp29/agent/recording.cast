[168.533274, "i", "python3 -c 'import os, glob\nfor p in glob.glob(\"/proc/[0-9]*/cmdline\"):\n    try:\n        with open(p) as f:\n            cmd = f.read()\n            if \"qemu\" in cmd:\n                pid = int(p.split(\"/\")[2])\n                os.kill(pid, 9)\n                print(f\"Killed {pid}\")\n    except Exception as e:\n        pass\n'\n"]
