[813.380839, "i", "cat << 'EOF' > setup_vm.py\nimport pexpect\nimport sys\nimport time\n\nf = open('setup.log', 'w')\ncmd = ('qemu-system-x86_64 -m 512 ' \\\n       '-kernel ./vmlinuz-lts -initrd ./initramfs-lts ' \\\n       '-append \"root=/dev/cdrom modules=loop,squashfs modloop=/boot/modloop-lts console=ttyS0\" ' \\\n       '-cdrom /app/alpine.iso ' \\\n       '-net nic,model=virtio -net user,hostfwd=tcp::2222-:22 -nographic')\n\nprint('Starting QEMU...')\nchild = pexpect.spawn(cmd, encoding='utf-8', timeout=300)\nchild.logfile = f\n\nchild.expect('login:', timeout=180)\nf.write('Found login prompt\\n')\nf.flush()\nprint('Found login prompt!')\n\nchild.sendline('root')\nchild.expect('#', timeout=60)\nf.write('Logged in\\n')\nf.flush()\nprint('Logged in as root!')\n\nchild.sendline('echo root:password123 | chpasswd')\nchild.expect('#', timeout=30)\n\nchild.sendline('apk update && apk add openssh')\nchild.expect('#', timeout=120)\n\nchild.sendline('sed -i \"s/#PermitRootLogin.*/PermitRootLogin yes/\" /etc/ssh/sshd_config')\nchild.expect('#', timeout=30)\nchild.sendline('"]
[813.381045, "i", "sed -i \"s/#PasswordAuthentication.*/PasswordAuthentication yes/\" /etc/ssh/sshd_config')\nchild.expect('#', timeout=30)\n\nchild.sendline('rc-update add sshd')\nchild.expect('#', timeout=30)\nchild.sendline('/etc/init.d/sshd start')\nchild.expect('#', timeout=30)\n\nf.write('Setup complete\\n')\nf.flush()\nprint('SSH setup complete!')\n\nwhile True:\n    time.sleep(10)\nEOF\n"]
