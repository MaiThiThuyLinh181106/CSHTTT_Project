[318.509861, "i", "cat << 'EOF' > setup_vm.py\nimport pexpect\nimport sys\nimport time\n\nprint('Starting QEMU with serial console...')\nchild = pexpect.spawn('qemu-system-x86_64 -m 512 -cdrom /app/alpine.iso -net nic,model=virtio -net user,hostfwd=tcp::2222-:22 -nographic', encoding='utf-8', timeout=300)\nchild.logfile = sys.stdout\n\n# Wait for boot prompt\nchild.expect('boot:', timeout=120)\nprint('Found boot prompt, sending boot args...')\n# Alpine default kernel is usually 'alpine' or we can pass console=ttyS0\nchild.sendline('alpine console=ttyS0')\n\nchild.expect('login:', timeout=180)\nprint('Logging in as root...')\nchild.sendline('root')\n\nchild.expect('#', timeout=60)\nprint('Logged in successfully!')\n\nprint('Setting root password...')\nchild.sendline('echo root:password123 | chpasswd')\nchild.expect('#', timeout=30)\n\nprint('Installing openssh...')\nchild.sendline('apk update && apk add openssh')\nchild.expect('#', timeout=120)\n\nprint('Configuring sshd...')\nchild.sendline('sed -i \"s/#PermitRootLogin.*/PermitRootLogin yes/\" /etc/ssh/sshd_co"]
[318.510106, "i", "nfig')\nchild.expect('#', timeout=30)\nchild.sendline('sed -i \"s/#PasswordAuthentication.*/PasswordAuthentication yes/\" /etc/ssh/sshd_config')\nchild.expect('#', timeout=30)\n\nprint('Enabling and starting sshd...')\nchild.sendline('rc-update add sshd')\nchild.expect('#', timeout=30)\nchild.sendline('/etc/init.d/sshd start')\nchild.expect('#', timeout=30)\n\nprint('SSH server setup complete inside VM. Keeping QEMU running...')\nwhile True:\n    time.sleep(10)\nEOF\n"]
