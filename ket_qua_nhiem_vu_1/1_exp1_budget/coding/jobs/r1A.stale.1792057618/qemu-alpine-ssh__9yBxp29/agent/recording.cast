[10.432874, "o", "\u001b[?2004hroot@e1ebecd34fa9:/app# "]
[17.539022, "i", "cat << 'EOF' > setup_vm.py\nimport pexpect\nimport sys\n\nchild = pexpect.spawn('qemu-system-x86_64 -m 512 -cdrom /app/alpine.iso -net nic,model=virtio -net user,hostfwd=tcp::2222-:22 -nographic', encoding='utf-8', timeout=120)\nchild.logfile = sys.stdout\n\nchild.expect('login:')\nchild.sendline('root')\n\nchild.expect('#')\nprint('Logged in successfully!')\n\n# Configure network / set password / install openssh\nchild.sendline('echo root:password123 | chpasswd')\nchild.expect('#')\n\nchild.sendline('apk update && apk add openssh')\nchild.expect('#')\n\nchild.sendline('sed -i \"s/#PermitRootLogin.*/PermitRootLogin yes/\" /etc/ssh/sshd_config')\nchild.expect('#')\n\nchild.sendline('rc-update add sshd')\nchild.expect('#')\n\nchild.sendline('/etc/init.d/sshd start')\nchild.expect('#')\n\nprint('SSH server setup complete inside VM.')\nEOF\n"]
[17.539649, "o", "cat << 'EOF' > setup_vm.py\r\n\u001b[?2004l\r\u001b[?2004h> import pexpect\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
