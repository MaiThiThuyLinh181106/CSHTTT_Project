[89.891664, "i", "cat << 'EOF' > /app/enc.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nint radix = 255;\nlong fraction = 0;\nlong range = 1;\nint cc[1000000];\n\nint OFF1 = 5;\nint OFF2 = 2;\nint INTOFF = 9;\nint LITSIZE = 4;\n\nFILE *out;\n\nvoid pc(int c) {\n  fputc(c, out);\n}\n\nvoid put_bit(int the_bit, int ctx) {\n  while (range < radix) {\n    long b = fraction / range;\n    pc(b + 1);\n    fraction %= range;\n    range *= radix;\n    fraction *= radix;\n  }\n  int *counts = cc + ctx * 2;\n  int split = range * -~*counts / (*counts + counts[ 1 ] + 2);\n  if (the_bit) {\n    fraction += split;\n    range -= split;\n  } else {\n    range = split;\n  }\n  counts[the_bit]++;\n}\n\nvoid put_integer(int val, int tmp, int ctx) {\n  int subtract_it = 1 << tmp;\n  int original_tmp = tmp;\n  val += subtract_it;\n  ctx *= 99;\n  \n  // In decoder:\n  // while (!get_bit(++tmp+ctx));\n  // tmp--;\n  // W { result_ans = result_ans*2 | get_bit(ctx); }\n  // return result_ans - subtract_it;\n  \n  // So to encode val + subtract_it:\n  // It outputs bits for val until leading 1 (encoded as bit 1 after tmp bits). \n  // Actually let's look at how get_integer works:\n  // tmp starts at initial tmp. ++tmp+ctx is the context. It reads bits until 1. \n  // Then it reads tmp bits for result_ans.\n  // Let's write put_integer properly.\n  \n  int bits_to_write[32];\n  int bit_count = 0;\n  int temp_val = val;\n  while (temp_val > 1) {\n    bits_to_write[bit_count++] = temp_val & 1;\n    temp_val >>= 1;\n  }\n  // bit_count is the number of bits after the leading 1.\n  // In decoder: while (!get_bit(++tmp+ctx)); tmp--; W { ... get_bit(ctx) ... }\n  // So it loops bit_count times where get_bit returns 0, then one get_bit returning 1.\n  for (int i = 0; i < bit_count; i++) {\n    put_bit(0, ++original_tmp + ctx);\n  }\n  put_bit(1, ++original_tmp + ctx);\n  \n  for (int i = bit_count - 1; i & 0x80000000 ? 0 : 1; i--) { // wait, MSB first or LSB first?\n    // W loop: for (i=0;i<tmp;i++) { result_ans = result_ans*2 | get_bit(ctx); }\n    // i goes 0 to tmp-1. So MSB to LSB.\n  }\n}\n\nint main() {\n  printf(\"Enc stub\\n\");\n}\nEOF\ngcc /app/enc.c -o /app/enc\n/app/enc\n"]
