[128.450522, "o", "\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdlib.h>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.4507, "o", "#include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.450975, "o", "int radix = 255;\r\n\u001b[?2004l\r\u001b[?2004h> long fraction = 0;\r\n\u001b[?2004l\r\u001b[?2004h> long range = 1;\r\n\u001b[?2004l\r"]
[128.451262, "o", "\u001b[?2004h> int cc[2000000];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int OFF1 = 5;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.451657, "o", "int OFF2 = 2;\r\n\u001b[?2004l\r\u001b[?2004h> int INTOFF = 9;\r\n\u001b[?2004l\r\u001b[?2004h> int LITSIZE = 4;\r\n\u001b[?2004l\r\u001b[?2004h"]
[128.451984, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> unsigned char out_buf[1000000];\r\n\u001b[?2004l\r\u001b[?2004h> int out_len = 0;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.452661, "o", "void pc(int c) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.453059, "o", "  out_buf[out_len++] = c;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.453183, "o", "}\r\n\u001b[?2004l\r"]
[128.454168, "o", "\u001b[?2004h"]
[128.45442, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> void put_bit(int the_bit, int ctx) {\r\n\u001b[?2004l\r\u001b[?2004h>   while (range < radix) {\r\n\u001b[?2004l\r\u001b[?2004h>     long b = fraction / range;\r\n\u001b[?2004l\r\u001b[?2004h>     pc(b + 1);\r\n\u001b[?2004l\r\u001b[?2004h>     fraction %= range;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.454569, "o", "    range *= radix;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.45496, "o", "    fraction *= radix;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   int *counts = cc + ctx * 2;\r\n\u001b[?2004l\r"]
[128.455696, "o", "\u001b[?2004h>   int split = range * -~*counts / (*counts + counts[ 1 ] + 2);\r\n\u001b[?2004l\r\u001b[?2004h>   if (the_bit) {\r\n\u001b[?2004l\r\u001b[?2004h>     fraction += split;\r\n\u001b[?2004l\r\u001b[?2004h>     range -= split;\r\n"]
[128.456851, "o", "\u001b[?2004l\r\u001b[?2004h>   } else {\r\n\u001b[?2004l\r\u001b[?2004h>     range = split;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   counts[the_bit]++;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> void put_integer(int val, int tmp, int ctx) {\r\n\u001b[?2004l\r\u001b[?2004h>   int subtract_it = 1 << tmp;\r\n\u001b[?2004l\r\u001b[?2004h>   int original_tmp = tmp;\r\n\u001b[?2004l\r\u001b[?2004h>   int target = val + subtract_it;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.45695, "o", "  ctx *= 99;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[128.456998, "o", "\u001b[?2004h> "]
[128.457197, "o", "  int m = 0;\r\n\u001b[?2004l\r\u001b[?2004h>   for (int i = 31; i >= 0; i--) {"]
[128.457429, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     if (target & (1 << i)) {\r\n\u001b[?2004l\r\u001b[?2004h>       m = i;\r\n"]
[128.457627, "o", "\u001b[?2004l\r\u001b[?2004h>       break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.457955, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   int cur_tmp = original_tmp;"]
[128.459002, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   while (cur_tmp < m) {\r\n\u001b[?2004l\r\u001b[?2004h>     put_bit(0, ++cur_tmp + ctx);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   put_bit(1, ++cur_tmp + ctx);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   for (int i = m - 1; i >= 0; i--) {\r\n\u001b[?2004l\r\u001b[?2004h>     int b = (target >> i) & 1;\r\n\u001b[?2004l\r\u001b[?2004h>     put_bit(b, cur_tmp + ctx);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[128.461947, "o", "\u001b[?2004h> void finish() {\r\n\u001b[?2004l\r\u001b[?2004h>   while (range < radix) {\r\n\u001b[?2004l\r\u001b[?2004h>     long b = fraction / range;\r\n\u001b[?2004l\r\u001b[?2004h>     pc(b + 1);\r\n\u001b[?2004l\r\u001b[?2004h>     fraction %= range;\r\n\u001b[?2004l\r\u001b[?2004h>     range *= radix;\r\n\u001b[?2004l\r\u001b[?2004h>     fraction *= radix;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int main() {\r\n\u001b[?2004l\r\u001b[?2004h>   FILE *f = fopen(\"/app/data.txt\", \"rb\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (!f) { perror(\"fopen\"); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h>   fseek(f, 0, SEEK_END);\r\n\u001b[?2004l\r\u001b[?2004h>   long size = ftell(f);\r\n\u001b[?2004l\r\u001b[?2004h>   fseek(f, 0, SEEK_SET);\r\n\u001b[?2004l\r\u001b[?2004h>   char *text = malloc(size + 1);\r\n\u001b[?2004l\r\u001b[?2004h>   fread(text, 1, size, f);\r\n\u001b[?2004l\r\u001b[?2004h>   fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // For now, let's fix the literal sign issue: text[i] as unsigned char\r\n\u001b[?2004l\r\u001b[?2004h>   // Wait, in decoder: (1 - 2*get_bit(8)) * get_integer(LITSIZE, 9)\r\n\u001b[?2004l\r\u001b[?2004h>   // If text[i] is unsigned char (0..255), what did decomp do?\r\n\u001b[?2004l\r\u001b[?2004h>   // char buf[10000]; *Q++ = ...\r\n\u001b[?2004l\r\u001b[?2004h>   // If we just send sign = 0 and val = (unsigned char)text[i], let's test if that fixes the first 15 lines.\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.462191, "o", "  // Also let's implement greedy LZ77 matching or just simple matching.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.462724, "o", "  // Max offset for OFF1 (5): 1<<5 = 32? Wait, get_integer(OFF1, 2) returns val - 32? No, subtract_it = 1<<5 = 32. get_integer returns result_ans - 32. So offset is 0 to 31 (32 possible values).\r\n\u001b[?2004l\r"]
[128.462918, "o", "\u001b[?2004h> "]
[128.463003, "o", "  // Max length for OFF2 (2): subtract_it = 1<<2 = 4. length-1 is 0 to 3 (so length 1 to 4).\r\n\u001b[?2004l\r\u001b[?2004h>   "]
[128.463294, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   out_len = 0;\r\n\u001b[?2004l\r\u001b[?2004h>   fraction = 0;\r\n\u001b[?2004l\r\u001b[?2004h>   range = 1;\r\n\u001b[?2004l\r\u001b[?2004h>   memset(cc, 0, sizeof(cc));\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.463469, "o", "  put_integer(size, INTOFF, 0);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   long pos = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.463636, "o", "  while (pos < size) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.463789, "o", "    // Try to find longest match in preceding window (up to 32 bytes back, max length 4)\r\n\u001b[?2004l\r\u001b[?2004h>     int best_len = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     int best_offset = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.46395, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     int max_window = 32;\r\n\u001b[?2004l\r\u001b[?2004h>     int start_w = pos - max_window;"]
[128.464193, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.464429, "o", "    if (start_w < 0) start_w = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for (int w = start_w; w < pos; w++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.464561, "o", "      int len = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.46475, "o", "      while (pos + len < size && len < 4 && text[w + len] == text[pos + len]) {\r\n\u001b[?2004l\r\u001b[?2004h>         len++;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       if (len > best_len) {"]
[128.464821, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.464867, "o", "        best_len = len;\r\n\u001b[?2004l\r"]
[128.46494, "o", "\u001b[?2004h> "]
[128.465169, "o", "        best_offset = (pos - 1) - w; // z = Q - offset - 1 => offset = (Q - 1) - z\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r"]
[128.465249, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.465291, "o", "    if (best_len >= 2) {\r\n\u001b[?2004l\r"]
[128.465344, "o", "\u001b[?2004h> "]
[128.465401, "o", "      // Match\r\n\u001b[?2004l\r"]
[128.465505, "o", "\u001b[?2004h> "]
[128.465576, "o", "      put_bit(1, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.466066, "o", "      put_integer(best_offset, OFF1, 2);\r\n\u001b[?2004l\r\u001b[?2004h>       put_integer(best_len - 1, OFF2, 3);\r\n\u001b[?2004l\r\u001b[?2004h>       pos += best_len;\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.466136, "o", "      // Literal\r\n\u001b[?2004l\r\u001b[?2004h>       put_bit(0, 1);\r\n\u001b[?2004l\r\u001b[?2004h>       unsigned char c = text[pos];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.466369, "o", "      put_bit(0, 8); // sign = 0\r\n\u001b[?2004l\r\u001b[?2004h>       put_integer(c, LITSIZE, 9);\r\n\u001b[?2004l\r\u001b[?2004h>       pos++;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.467451, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.467865, "o", "  finish();\r\n\u001b[?2004l\r"]
[128.467976, "o", "\u001b[?2004h"]
[128.468344, "o", "> "]
[128.468684, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.468952, "o", "  FILE *out = fopen(\"/app/data.comp\", \"wb\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.469462, "o", "  fwrite(out_buf, 1, out_len, out);\r\n"]
[128.469746, "o", "\u001b[?2004l\r\u001b[?2004h>   fclose(out);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[128.46991, "o", "> "]
[128.470102, "o", "  printf(\"Compressed size with LZ77: %d bytes\\n\", out_len);\r\n\u001b[?2004l\r"]
[128.470528, "o", "\u001b[?2004h>   return 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[128.470628, "o", "> }\r\n\u001b[?2004l\r"]
[128.470721, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
