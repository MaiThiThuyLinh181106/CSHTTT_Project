[44.524989, "o", "\u001b[32m\u001b[K1\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#include <stdio.h>\r\n\u001b[32m\u001b[K2\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#include <stdlib.h>\r\n\u001b[32m\u001b[K3\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define W for (i=0;i<tmp;i++)\r\n\u001b[32m\u001b[K4\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[32m\u001b[K5\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint i;\r\n\u001b[32m\u001b[K6\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint radix = 255;\r\n\u001b[32m\u001b[K7\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint fraction;\r\n\u001b[32m\u001b[K8\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Klong range = 1;\r\n\u001b[32m\u001b[K9\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint tmp;\r\n\u001b[32m\u001b[K10\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint cc[1000000];\r\n\u001b[32m\u001b[K11\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[32m\u001b[K12\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint OFF1 = 5;\r\n\u001b[32m\u001b[K13\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint OFF2 = 2;\r\n\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint INTOFF = 9;\r\n\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint LITSIZE = 4;\r\n\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint ll = 0;\r\n\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint gc() {\r\n\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  unsigned char c = (unsigned char)getchar();\r\n\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  return (int)c;\r\n\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint get_bit(int ctx) {\r\n\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  if ( range < radix ) {\r\n\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    range *= radix;\r\n\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fraction *= radix;\r\n\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n"]
[44.525096, "o", "\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fraction += gc()-1;\r\n\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  int *counts = cc + ctx * 2;\r\n\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  int split = range * -~*counts / (*counts + counts[ 1 ] + 2);\r\n"]
[44.525684, "o", "\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  int the_bit = fraction >= split;\r\n\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  fraction -= split*the_bit;\r\n\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  range = the_bit ? range-split : split;\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  counts[ the_bit ]++;\r\n\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  return the_bit;\r\n\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint get_integer(int tmp, int ctx) {\r\n\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  int subtract_it = 1<<tmp;\r\n\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  int result_ans = 1;\r\n\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  ctx*=99;\r\n\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  while (!get_bit(++tmp+ctx));\r\n\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  tmp--;\r\n\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  W {\r\n\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    result_ans = result_ans*2 | get_bit(ctx);\r\n\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  return result_ans - subtract_it;\r\n\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kint main() {\r\n\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  int tmp,i,j = get_integer(9, 0);\r\n\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  char* z;\r\n\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  char buf[10000];\r\n\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  char* Q = buf;\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  while (j--) {\r\n\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (get_bit(1)) {\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      z = Q - get_integer(OFF1, 2) - 1;\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      tmp = get_integer(OFF2, 3) + 1;\r\n\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        W {\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          *Q++ = *z++;\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    } else {\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      *Q++ = (1-2*get_bit(8)) * get_integer(LITSIZE, 9);\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  printf(\"%s\", buf);\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K}\r\n"]
