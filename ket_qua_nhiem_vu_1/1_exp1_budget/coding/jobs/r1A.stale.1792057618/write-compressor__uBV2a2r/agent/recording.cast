[100.436135, "o", "\u001b[?2004hroot@aa54aa2a770f:/app# "]
[114.90583, "i", "cat << 'EOF' > /app/enc.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nint radix = 255;\nlong fraction = 0;\nlong range = 1;\nint cc[2000000];\n\nint OFF1 = 5;\nint OFF2 = 2;\nint INTOFF = 9;\nint LITSIZE = 4;\n\nunsigned char out_buf[1000000];\nint out_len = 0;\n\nvoid pc(int c) {\n  out_buf[out_len++] = c;\n}\n\nvoid put_bit(int the_bit, int ctx) {\n  while (range < radix) {\n    long b = fraction / range;\n    pc(b + 1);\n    fraction %= range;\n    range *= radix;\n    fraction *= radix;\n  }\n  int *counts = cc + ctx * 2;\n  int split = range * -~*counts / (*counts + counts[ 1 ] + 2);\n  if (the_bit) {\n    fraction += split;\n    range -= split;\n  } else {\n    range = split;\n  }\n  counts[the_bit]++;\n}\n\nvoid put_integer(int val, int tmp, int ctx) {\n  int subtract_it = 1 << tmp;\n  int original_tmp = tmp;\n  int target = val + subtract_it;\n  ctx *= 99;\n\n  // Find highest bit of target\n  int m = 0;\n  for (int i = 31; i >= 0; i--) {\n    if (target & (1 << i)) {\n      m = i;\n      break;\n    }\n  }\n\n  // while (!get_bit(++tmp+ctx)); tmp--;\n  // This means for t = original_tmp + 1 up to m, get_bit returns 0, then at m+1 it returns 1.\n  int cur_tmp = original_tmp;\n  while (cur_tmp < m) {\n    put_bit(0, ++cur_tmp + ctx);\n  }\n  put_bit(1, ++cur_tmp + ctx);\n\n  // W loop: for (i=0; i<tmp; i++) { result_ans = result_ans*2 | get_bit(ctx); }\n  // cur_tmp is now m. tmp in decoder becomes m.\n  // result_ans starts at 1. The bits written are from m-1 down to 0.\n  for (int i = m - 1; i >= 0; i--) {\n    int b = (target >> i) & 1;\n    put_bit(b, cur_tmp + ctx);\n  }\n}\n\nvoid finish() {\n  while (range < radix) {\n    long b = fraction / range;\n    pc(b + 1);\n    fraction %= range;\n    range *= radix;\n    fraction *= radix;\n  }\n}\n\nint main() {\n  FILE *f = fopen(\"/app/data.txt\", \"rb\");\n  if (!f) { perror(\"fopen\"); return 1; }\n  fseek(f, 0, SEEK_END);\n  long size = ftell(f);\n  fseek(f, 0, SEEK_SET);\n  char *text = malloc(size + 1);\n  fread(text, 1, size, f);\n  fclose(f);\n\n  // Encode j = size\n  put_integer(size, INTOFF, 0);\n\n  for (long i = 0; i < size; i++) {\n    // literal: get_bit(1) = 0\n    put_bit(0, 1);\n    unsigned char c = text[i];\n    // literal value: (1 - 2 * get_bit(8)) * get_integer(LITSIZE, 9)\n    // Wait, in decoder:\n    // *Q++ = (1-2*get_bit(8)) * get_integer(LITSIZE, 9);\n    // If c is treated as signed char or unsigned char? \n    // In C, char* Q stores char. c can be negative or positive if cast to char, but text[i] is 0..255.\n    // Wait! Let's check how (1-2*get_bit(8)) * get_integer(LITSIZE, 9) produces c.\n    // If c >= 0 and c <= 127: get_bit(8) = 0 (sign +), get_integer = c.\n    // If c > 127: (1 - 2*1) * get_integer = - (256 - c) or similar? \n    // Wait! char in C is usually signed (-128 to 127). text[i] as char has values -128 to 127!\n    // Let's check if text[i] fits in signed char.\n    signed char sc = text[i];\n    int sign = sc < 0 ? 1 : 0;\n    int val = sc < 0 ? -sc : sc;\n    put_bit(sign, 8);\n    put_integer(val, LITSIZE, 9);\n  }\n\n  finish();\n\n  FILE *out = fopen(\"/app/data.comp\", \"wb\");\n  fwrite(out_buf, 1, out_len, out);\n  fclose(out);\n\n  printf(\"Compressed size: %d bytes\\n\", out_len);\n  return 0;\n}\nEOF\ngcc /app/enc.c -o /app/enc\n/app/enc\n/app/decomp < /app/data.comp > /app/output.txt\ndiff /app/data.txt /app/output.txt && echo \"SUCCESS!\"\nls -la /app/data.comp\n"]
[114.906401, "o", "cat << 'EOF' > /app/enc.c\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.906699, "o", "#include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.906899, "o", "#include <stdlib.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int radix = 255;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.907584, "o", "long fraction = 0;\r\n\u001b[?2004l\r\u001b[?2004h> long range = 1;\r\n\u001b[?2004l\r\u001b[?2004h> int cc[2000000];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int OFF1 = 5;\r\n\u001b[?2004l\r\u001b[?2004h> int OFF2 = 2;\r\n\u001b[?2004l\r\u001b[?2004h> int INTOFF = 9;\r\n\u001b[?2004l\r\u001b[?2004h> int LITSIZE = 4;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.907742, "o", "unsigned char out_buf[1000000];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.908172, "o", "int out_len = 0;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.908692, "o", "void pc(int c) {\r\n\u001b[?2004l\r\u001b[?2004h>   out_buf[out_len++] = c;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> void put_bit(int the_bit, int ctx) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.909238, "o", "  while (range < radix) {\r\n\u001b[?2004l\r\u001b[?2004h>     long b = fraction / range;\r\n\u001b[?2004l\r\u001b[?2004h>     pc(b + 1);\r\n\u001b[?2004l\r\u001b[?2004h>     fraction %= range;\r\n\u001b[?2004l\r\u001b[?2004h>     range *= radix;\r\n\u001b[?2004l\r\u001b[?2004h>     fraction *= radix;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[114.909822, "o", "\u001b[?2004h>   int *counts = cc + ctx * 2;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.910002, "o", "  int split = range * -~*counts / (*counts + counts[ 1 ] + 2);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.912329, "o", "  if (the_bit) {\r\n\u001b[?2004l\r\u001b[?2004h>     fraction += split;\r\n\u001b[?2004l\r\u001b[?2004h>     range -= split;\r\n\u001b[?2004l\r\u001b[?2004h>   } else {\r\n\u001b[?2004l\r\u001b[?2004h>     range = split;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   counts[the_bit]++;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> void put_integer(int val, int tmp, int ctx) {\r\n\u001b[?2004l\r\u001b[?2004h>   int subtract_it = 1 << tmp;\r\n\u001b[?2004l\r\u001b[?2004h>   int original_tmp = tmp;\r\n\u001b[?2004l\r\u001b[?2004h>   int target = val + subtract_it;\r\n\u001b[?2004l\r\u001b[?2004h>   ctx *= 99;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // Find highest bit of target\r\n\u001b[?2004l\r\u001b[?2004h>   int m = 0;\r\n\u001b[?2004l\r\u001b[?2004h>   for (int i = 31; i >= 0; i--) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (target & (1 << i)) {\r\n\u001b[?2004l\r\u001b[?2004h>       m = i;\r\n\u001b[?2004l\r\u001b[?2004h>       break;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // while (!get_bit(++tmp+ctx)); tmp--;\r\n\u001b[?2004l\r\u001b[?2004h>   // This means for t = original_tmp + 1 up to m, get_bit returns 0, then at m+1 it returns 1.\r\n\u001b[?2004l\r\u001b[?2004h>   int cur_tmp = original_tmp;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.912392, "o", "  while (cur_tmp < m) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.913259, "o", "    put_bit(0, ++cur_tmp + ctx);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   put_bit(1, ++cur_tmp + ctx);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // W loop: for (i=0; i<tmp; i++) { result_ans = result_ans*2 | get_bit(ctx); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.914263, "o", "  // cur_tmp is now m. tmp in decoder becomes m.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.914707, "o", "  // result_ans starts at 1. The bits written are from m-1 down to 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.915154, "o", "  for (int i = m - 1; i >= 0; i--) {\r\n\u001b[?2004l\r\u001b[?2004h>     int b = (target >> i) & 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.915594, "o", "    put_bit(b, cur_tmp + ctx);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.915877, "o", "void finish() {\r\n\u001b[?2004l\r\u001b[?2004h>   while (range < radix) {\r\n\u001b[?2004l\r\u001b[?2004h>     long b = fraction / range;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.916739, "o", "    pc(b + 1);\r\n\u001b[?2004l\r\u001b[?2004h>     fraction %= range;\r\n\u001b[?2004l\r\u001b[?2004h>     range *= radix;"]
[114.916893, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.917015, "o", "    fraction *= radix;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int main() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.917583, "o", "  FILE *f = fopen(\"/app/data.txt\", \"rb\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (!f) { perror(\"fopen\"); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.918273, "o", "  fseek(f, 0, SEEK_END);\r\n\u001b[?2004l\r\u001b[?2004h>   long size = ftell(f);\r\n\u001b[?2004l\r"]
[114.918729, "o", "\u001b[?2004h>   fseek(f, 0, SEEK_SET);\r\n\u001b[?2004l\r\u001b[?2004h>   char *text = malloc(size + 1);\r\n\u001b[?2004l\r\u001b[?2004h>   fread(text, 1, size, f);\r\n\u001b[?2004l\r\u001b[?2004h>   fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // Encode j = size\r\n\u001b[?2004l\r"]
[114.919076, "o", "\u001b[?2004h>   put_integer(size, INTOFF, 0);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   for (long i = 0; i < size; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.919461, "o", "    // literal: get_bit(1) = 0\r\n\u001b[?2004l\r\u001b[?2004h>     put_bit(0, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.919614, "o", "    unsigned char c = text[i];\r\n\u001b[?2004l\r\u001b[?2004h>     // literal value: (1 - 2 * get_bit(8)) * get_integer(LITSIZE, 9)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.919701, "o", "    // Wait, in decoder:\r\n\u001b[?2004l\r\u001b[?2004h>     // *Q++ = (1-2*get_bit(8)) * get_integer(LITSIZE, 9);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.919869, "o", "    // If c is treated as signed char or unsigned char? \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.919999, "o", "    // In C, char* Q stores char. c can be negative or positive if cast to char, but text[i] is 0..255.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.920459, "o", "    // Wait! Let's check how (1-2*get_bit(8)) * get_integer(LITSIZE, 9) produces c.\r\n\u001b[?2004l\r\u001b[?2004h>     // If c >= 0 and c <= 127: get_bit(8) = 0 (sign +), get_integer = c.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.920681, "o", "    // If c > 127: (1 - 2*1) * get_integer = - (256 - c) or similar? \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.920816, "o", "    // Wait! char in C is usually signed (-128 to 127). text[i] as char has values -128 to 127!\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.921028, "o", "    // Let's check if text[i] fits in signed char.\r\n\u001b[?2004l\r\u001b[?2004h>     signed char sc = text[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.921078, "o", "    int sign = sc < 0 ? 1 : 0;\r\n\u001b[?2004l\r\u001b[?2004h>     int val = sc < 0 ? -sc : sc;\r\n\u001b[?2004l\r"]
[114.921166, "o", "\u001b[?2004h"]
[114.921224, "o", ">     put_bit(sign, 8);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.921483, "o", "    put_integer(val, LITSIZE, 9);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   finish();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.921572, "o", "  FILE *out = fopen(\"/app/data.comp\", \"wb\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.921705, "o", "  fwrite(out_buf, 1, out_len, out);\r\n\u001b[?2004l\r\u001b[?2004h>   fclose(out);\r\n\u001b[?2004l\r"]
[114.92182, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.922007, "o", "  printf(\"Compressed size: %d bytes\\n\", out_len);\r\n\u001b[?2004l\r\u001b[?2004h>   return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[114.925667, "o", "\u001b[?2004hroot@aa54aa2a770f:/app# gcc /app/enc.c -o /app/enc\r\n\u001b[?2004l\r"]
[115.00623, "o", "\u001b[?2004hroot@aa54aa2a770f:/app# /app/enc\r\n\u001b[?2004l\r"]
[115.008623, "o", "Compressed size: 4327 bytes\r\n"]
[115.008972, "o", "\u001b[?2004hroot@aa54aa2a770f:/app# /app/decomp < /app/data.comp > /app/output.txt\r\n\u001b[?2004l\r"]
