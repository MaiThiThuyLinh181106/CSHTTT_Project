[128.557432, "o", "/app/enc\r\n\u001b[?2004l\r"]
[128.564422, "o", "Compressed size with LZ77: 3996 bytes\r\n"]
[128.565301, "o", "\u001b[?2004hroot@aa54aa2a770f:/app# "]
