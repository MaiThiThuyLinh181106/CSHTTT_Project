[168.467916, "i", "cat << 'EOF' > /app/enc.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nint radix = 255;\nlong fraction = 0;\nlong range = 1;\nint cc[3000000];\n\nint OFF1 = 14;\nint OFF2 = 8;\nint INTOFF = 9;\nint LITSIZE = 4;\n\nunsigned char out_buf[1000000];\nint out_len = 0;\n\nvoid pc(int c) {\n  out_buf[out_len++] = c;\n}\n\nvoid put_bit(int the_bit, int ctx) {\n  while (range < radix) {\n    long b = fraction / range;\n    pc(b + 1);\n    fraction %= range;\n    range *= radix;\n    fraction *= radix;\n  }\n  int *counts = cc + ctx * 2;\n  int split = range * -~*counts / (*counts + counts[ 1 ] + 2);\n  if (the_bit) {\n    fraction += split;\n    range -= split;\n  } else {\n    range = split;\n  }\n  counts[the_bit]++;\n}\n\nvoid put_integer(int val, int tmp, int ctx) {\n  int subtract_it = 1 << tmp;\n  int original_tmp = tmp;\n  int target = val + subtract_it;\n  ctx *= 99;\n\n  int m = 0;\n  for (int i = 31; i >= 0; i--) {\n    if (target & (1 << i)) {\n      m = i;\n      break;\n    }\n  }\n\n  int cur_tmp = original_tmp;\n  while (cur_tmp < m) {\n    put_bit(0, ++cur_tmp + ctx);\n  }\n  put_bit(1, ++cur_tmp + ctx);\n\n  for (int i = m - 1; i >= 0; i--) {\n    int b = (target >> i) & 1;\n    put_bit(b, cur_tmp + ctx);\n  }\n}\n\nvoid finish() {\n  while (range < radix) {\n    long b = fraction / range;\n    pc(b + 1);\n    fraction %= range;\n    range *= radix;\n    fraction *= radix;\n  }\n}\n\ntypedef struct {\n  int is_match;\n  int offset;\n  int len;\n  unsigned char lit;\n} Token;\n\nint main() {\n  FILE *f = fopen(\"/app/data.txt\", \"rb\");\n  if (!f) { perror(\"fopen\"); return 1; }\n  fseek(f, 0, SEEK_END);\n  long size = ftell(f);\n  fseek(f, 0, SEEK_SET);\n  char *text = malloc(size + 1);\n  fread(text, 1, size, f);\n  fclose(f);\n\n  Token *tokens = malloc(size * sizeof(Token));\n  int token_count = 0;\n\n  long pos = 0;\n  int max_window = 1 << OFF1;\n  int max_len = 1 << OFF2;\n\n  while (pos < size) {\n    int best_len = 0;\n    int best_offset = 0;\n    int start_w = pos - max_window;\n    if (start_w < 0) start_w = 0;\n\n    for (int w = start_w; w < pos; w++) {\n      int len = 0;\n      while (pos + len < size && len < max_len && text[w + len] == text[pos + len]) {\n        len++;\n      }\n      if (len > best_len) {\n        best_len = len;\n        best_offset = (pos - 1) - w;\n      }\n    }\n\n    Token t;\n    if (best_len >= 2) {\n      t.is_match = 1;\n      t.offset = best_offset;\n      t.len = best_len;\n      pos += best_len;\n    } else {\n      t.is_match = 0;\n      t.lit = text[pos];\n      pos++;\n    }\n    tokens[token_count++] = t;\n  }\n\n  out_len = 0;\n  fraction = 0;\n  range = 1;\n  memset(cc, 0, sizeof(cc));\n\n  put_integer(token_count, INTOFF, 0);\n\n  for (int i = 0; i < token_count; i++) {\n    if (tokens[i].is_match) {\n      put_bit(1, 1);\n      put_integer(tokens[i].offset, OFF1, 2);\n      put_integer(tokens[i].len - 1, OFF2, 3);\n    } else {\n      put_bit(0, 1);\n      signed char sc = tokens[i].lit;\n      int sign = sc < 0 ? 1 : 0;\n      int val = sc < 0 ? -sc : sc;\n      put_bit(sign, 8);\n      put_integer(val, LITSIZE, 9);\n    }\n  }\n\n  finish();\n\n  FILE *out = fopen(\"/app/data.comp\", \"wb\");\n  fwrite(out_buf, 1, out_len, out);\n  fclose(out);\n\n  printf(\"Compressed size: %d bytes\\n\", out_len);\n  return 0;\n}\nEOF\ngcc /app/enc.c -o /app/enc\n/app/enc\n/app/decomp < /app/data.comp > /app/output.txt\ndiff /app/data.txt /app/output.txt && echo \"SUCCESS!\"\nls -la /app/data.comp\n"]
[168.472139, "o", "cat << 'EOF' > /app/enc.c\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdlib.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int radix = 255;\r\n\u001b[?2004l\r\u001b[?2004h> long fraction = 0;\r\n\u001b[?2004l\r\u001b[?2004h> long range = 1;\r\n\u001b[?2004l\r\u001b[?2004h> int cc[3000000];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int OFF1 = 14;\r\n\u001b[?2004l\r\u001b[?2004h> int OFF2 = 8;\r\n\u001b[?2004l\r\u001b[?2004h> int INTOFF = 9;\r\n\u001b[?2004l\r\u001b[?2004h> int LITSIZE = 4;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> unsigned char out_buf[1000000];\r\n\u001b[?2004l\r\u001b[?2004h> int out_len = 0;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> void pc(int c) {\r\n\u001b[?2004l\r\u001b[?2004h>   out_buf[out_len++] = c;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> void put_bit(int the_bit, int ctx) {\r\n\u001b[?2004l\r\u001b[?2004h>   while (range < radix) {\r\n\u001b[?2004l\r\u001b[?2004h>     long b = fraction / range;\r\n\u001b[?2004l\r\u001b[?2004h>     pc(b + 1);\r\n\u001b[?2004l\r\u001b[?2004h>     fraction %= range;\r\n\u001b[?2004l\r\u001b[?2004h>     range *= radix;\r\n\u001b[?2004l\r\u001b[?2004h> "]
