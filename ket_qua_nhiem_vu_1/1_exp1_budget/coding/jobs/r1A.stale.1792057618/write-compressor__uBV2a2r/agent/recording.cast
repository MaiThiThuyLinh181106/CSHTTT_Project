[167.278931, "o", "  range = the_bit ? range-split : split;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   counts[ the_bit ]++;\r\n\u001b[?2004l\r\u001b[?2004h>   return the_bit;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int get_integer(int tmp, int ctx) {\r\n\u001b[?2004l\r\u001b[?2004h>   int subtract_it = 1<<tmp;\r\n\u001b[?2004l\r\u001b[?2004h>   int result_ans = 1;\r\n\u001b[?2004l\r\u001b[?2004h>   ctx*=99;\r\n\u001b[?2004l\r\u001b[?2004h>   while (!get_bit(++tmp+ctx));\r\n\u001b[?2004l\r\u001b[?2004h>   tmp--;\r\n\u001b[?2004l\r\u001b[?2004h>   W {\r\n\u001b[?2004l\r\u001b[?2004h>     result_ans = result_ans*2 | get_bit(ctx);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return result_ans - subtract_it;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int main() {\r\n\u001b[?2004l\r\u001b[?2004h>   int tmp,i,j = get_integer(9, 0);\r\n\u001b[?2004l\r\u001b[?2004h>   char* z;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   char *buf = malloc(100000);\r\n\u001b[?2004l\r\u001b[?2004h>   char* Q = buf;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   while (j--) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (get_bit(1)) {\r\n\u001b[?2004l\r\u001b[?2004h>       z = Q - get_integer(OFF1, 2) - 1;\r\n\u001b[?2004l\r\u001b[?2004h>       tmp = get_integer(OFF2, 3) + 1;\r\n\u001b[?2004l\r\u001b[?2004h>         W {\r\n\u001b[?2004l\r\u001b[?2004h>           *Q++ = *z++;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h>       *Q++ = (1-2*get_bit(8)) * get_integer(LITSIZE, 9);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   fwrite(buf, 1, Q - buf, stdout);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
