[151.798361, "i", "cat << 'EOF' > /app/enc.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nint radix = 255;\nlong fraction = 0;\nlong range = 1;\nint cc[2000000];\n\nint OFF1 = 12;\nint OFF2 = 6;\nint INTOFF = 9;\nint LITSIZE = 4;\n\nunsigned char out_buf[1000000];\nint out_len = 0;\n\nvoid pc(int c) {\n  out_buf[out_len++] = c;\n}\n\nvoid put_bit(int the_bit, int ctx) {\n  while (range < radix) {\n    long b = fraction / range;\n    pc(b + 1);\n    fraction %= range;\n    range *= radix;\n    fraction *= radix;\n  }\n  int *counts = cc + ctx * 2;\n  int split = range * -~*counts / (*counts + counts[ 1 ] + 2);\n  if (the_bit) {\n    fraction += split;\n    range -= split;\n  } else {\n    range = split;\n  }\n  counts[the_bit]++;\n}\n\nvoid put_integer(int val, int tmp, int ctx) {\n  int subtract_it = 1 << tmp;\n  int original_tmp = tmp;\n  int target = val + subtract_it;\n  ctx *= 99;\n\n  int m = 0;\n  for (int i = 31; i >= 0; i--) {\n    if (target & (1 << i)) {\n      m = i;\n      break;\n    }\n  }\n\n  int cur_tmp = original_tmp;\n  while (cur_tmp < m) {\n    put_bit(0, ++cur_tmp + ctx);\n  }\n  put_bit(1, ++cur_tmp + ctx);\n\n  for (int i = m - 1; i >= 0; i--) {\n    int b = (target >> i) & 1;\n    put_bit(b, cur_tmp + ctx);\n  }\n}\n\nvoid finish() {\n  while (range < radix) {\n    long b = fraction / range;\n    pc(b + 1);\n    fraction %= range;\n    range *= radix;\n    fraction *= radix;\n  }\n}\n\nint main() {\n  FILE *f = fopen(\"/app/data.txt\", \"rb\");\n  if (!f) { perror(\"fopen\"); return 1; }\n  fseek(f, 0, SEEK_END);\n  long size = ftell(f);\n  fseek(f, 0, SEEK_SET);\n  char *text = malloc(size + 1);\n  fread(text, 1, size, f);\n  fclose(f);\n\n  out_len = 0;\n  fraction = 0;\n  range = 1;\n  memset(cc, 0, sizeof(cc));\n\n  put_integer(size, INTOFF, 0);\n\n  long pos = 0;\n  while (pos < size) {\n    int best_len = 0;\n    int best_offset = 0;\n    \n    int max_window = 1 << OFF1;\n    int max_len = (1 << OFF2);\n    int start_w = pos - max_window;\n    if (start_w < 0) start_w = 0;\n    \n    for (int w = start_w; w < pos; w++) {\n      int len = 0;\n      while (pos + len < size && len < max_len && text[w + len] == text[pos + len]) {\n        len++;\n      }\n      if (len > best_len) {\n        best_len = len;\n        best_offset = (pos - 1) - w;\n      }\n    }\n\n    if (best_len >= 2) {\n      put_bit(1, 1);\n      put_integer(best_offset, OFF1, 2);\n      put_integer(best_len - 1, OFF2, 3);\n      pos += best_len;\n    } else {\n      put_bit(0, 1);\n      signed char sc = text[pos];\n      int sign = sc < 0 ? 1 : 0;\n      int val = sc < 0 ? -sc : sc;\n      put_bit(sign, 8);\n      put_integer(val, LITSIZE, 9);\n      pos++;\n    }\n  }\n\n  finish();\n\n  FILE *out = fopen(\"/app/data.comp\", \"wb\");\n  fwrite(out_buf, 1, out_len, out);\n  fclose(out);\n\n  printf(\"Compressed size: %d bytes\\n\", out_len);\n  return 0;\n}\nEOF\ngcc /app/enc.c -o /app/enc\n/app/enc\n/app/decomp < /app/data.comp > /app/output.txt\ndiff /app/data.txt /app/output.txt && echo \"SUCCESS!\"\nls -la /app/data.comp\n"]
