[168.493234, "o", "      put_bit(1, 1);\r\n\u001b[?2004l\r\u001b[?2004h>       put_integer(tokens[i].offset, OFF1, 2);\r\n\u001b[?2004l\r\u001b[?2004h>       put_integer(tokens[i].len - 1, OFF2, 3);\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h>       put_bit(0, 1);\r\n\u001b[?2004l\r\u001b[?2004h>       signed char sc = tokens[i].lit;\r\n\u001b[?2004l\r\u001b[?2004h>       int sign = sc < 0 ? 1 : 0;\r\n\u001b[?2004l\r\u001b[?2004h>       int val = sc < 0 ? -sc : sc;\r\n\u001b[?2004l\r\u001b[?2004h>       put_bit(sign, 8);\r\n\u001b[?2004l\r\u001b[?2004h>       put_integer(val, LITSIZE, 9);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
