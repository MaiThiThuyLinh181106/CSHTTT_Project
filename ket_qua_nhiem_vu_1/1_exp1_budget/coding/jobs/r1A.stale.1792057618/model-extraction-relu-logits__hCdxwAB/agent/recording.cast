[30.029382, "o", "grads = np.array(grads)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.029531, "o", "diff_list = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.029672, "o", "for i in range(len(grads)):\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(i+1, min(i+15, len(grads))):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.029716, "o", "        d = grads[i] - grads[j]\r\n\u001b[?2004l\r"]
[30.029835, "o", "\u001b[?2004h> "]
[30.029937, "o", "        norm = np.linalg.norm(d)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.03007, "o", "        if norm > 1e-3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.030149, "o", "            diff_list.append(d / norm)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.030282, "o", "diff_arr = np.array(diff_list)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.030374, "o", "kmeans = KMeans(n_clusters=20, random_state=42, n_init=10)\r\n\u001b[?2004l\r"]
[30.030455, "o", "\u001b[?2004h> "]
[30.03059, "o", "kmeans.fit(diff_arr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.0307, "o", "A1_est = kmeans.cluster_centers_\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.030844, "o", "np.save(\\\"/app/stolen_A1.npy\\\", A1_est)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.030949, "o", "print(\\\"Saved stolen_A1.npy with shape:\\\", A1_est.shape)"]
[30.031438, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"; open(\"/app/steal.py\", \"wb\").write(code)'\r\n\u001b[?2004l\r"]
