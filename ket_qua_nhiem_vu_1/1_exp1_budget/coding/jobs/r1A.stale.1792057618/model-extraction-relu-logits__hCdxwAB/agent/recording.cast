[22.099424, "i", "python3 -c 'import base64; code = b\"\"\"\np.random.seed(0)\nimport numpy as np\nfrom forward import forward\nfrom sklearn.cluster import KMeans\n\ndef get_grad(x, eps=1e-4):\n    grad = np.zeros_like(x)\n    for i in range(len(x)):\n        xp = x.copy(); xp[i] += eps\n        xm = x.copy(); xm[i] -= eps\n        grad[i] = (forward(xp) - forward(xm)) / (2 * eps)\n    return grad\n\ngrads = []\nfor _ in range(1200):\n    x = np.random.randn(10)\n    grads.append(get_grad(x))\n\ngrads = np.array(grads)\ndiff_list = []\nfor i in range(len(grads)):\n    for j in range(i+1, min(i+15, len(grads))):\n        d = grads[i] - grads[j]\n        norm = np.linalg.norm(d)\n        if norm > 1e-3:\n            diff_list.append(d / norm)\n\ndiff_arr = np.array(diff_list)\nkmeans = KMeans(n_clusters=20, random_state=42, n_init=10)\nkmeans.fit(diff_arr)\nA1_est = kmeans.cluster_centers_\nnp.save(\\\"/app/stolen_A1.npy\\\", A1_est)\nprint(\\\"Saved stolen_A1.npy with shape:\\\", A1_est.shape)\n\"\"\"; open(\"/app/steal.py\", \"wb\").write(code)'\npython3 /app/steal.py\n"]
