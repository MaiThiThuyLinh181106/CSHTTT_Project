[?2004l[?2004h>     print('Y range:', min(ys), max(ys))
[?2004l[?2004h>     # Simple ASCII art
[?2004l[?2004h>     min_x, max_x = min(xs), max(xs)
[?2004l[?2004h>     min_y, max_y = min(ys), max(ys)
[?2004l[?2004h>     w, h = 60, 20
