[104.278009, "i", "python3 -c \"\nwith open('text.gcode') as f:\n    lines = f.readlines()\n\ncapturing = False\ncoords = []\nx, y = 0.0, 0.0\nfor line in lines:\n    if 'M486 AEmbossed text' in line:\n        capturing = True\n        continue\n    elif capturing and 'M486 S-1' in line:\n        break\n    if capturing:\n        parts = line.split()\n        for p in parts:\n            if p.startswith('X'): x = float(p[1:])\n            elif p.startswith('Y'): y = float(p[1:])\n        if 'E' in line and any(p.startswith('E') and float(p[1:]) > 0 for p in parts):\n            coords.append((x, y))\n\nif coords:\n    xs = [c[0] for c in coords]\n    ys = [c[1] for c in coords]\n    print('X range:', min(xs), max(xs))\n    print('Y range:', min(ys), max(ys))\n    # Simple ASCII art\n    min_x, max_x = min(xs), max(xs)\n    min_y, max_y = min(ys), max(ys)\n    w, h = 60, 20\n    grid = [[' ' for _ in range(w)] for _ in range(h)]\n    for x, y in coords:\n        ix = int((x - min_x) / (max_x - min_x + 1e-5) * (w - 1))\n        iy = int((y - min_y) / (max_y - min"]
[104.278181, "i", "_y + 1e-5) * (h - 1))\n        grid[h - 1 - iy][ix] = '#'\n    for row in grid:\n        print(''.join(row))\n\"\n"]
