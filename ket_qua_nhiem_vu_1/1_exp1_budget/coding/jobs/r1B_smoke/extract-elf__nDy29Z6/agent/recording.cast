[75.329911, "i", "cat << 'EOF' > extract.js\nconst fs = require('fs');\n\nfunction extract(filename) {\n  const buffer = fs.readFileSync(filename);\n  // Basic ELF parsing\n  // For a 64-bit ELF:\n  // e_ident (16), e_type (2), e_machine (2), e_version (4), e_entry (8),\n  // e_phoff (8), e_shoff (8), e_flags (4), e_ehsize (2), e_phentsize (2),\n  // e_phnum (2), e_shentsize (2), e_shnum (2), e_shstrndx (2)\n  \n  const phoff = buffer.readBigUInt64LE(32);\n  const phentsize = buffer.readUInt16Index = buffer.readUInt16LE(54);\n  const phnum = buffer.readUInt16LE(56);\n  \n  const result = {};\n  \n  for (let i = 0; i < phnum; i++) {\n    const offset = Number(phoff) + i * 56; // phentsize for 64-bit ELF is usually 56\n    const p_type = buffer.readUInt32LE(offset);\n    if (p_type === 1) { // PT_LOAD\n      const p_offset = Number(buffer.readBigUInt64LE(offset + 8));\n      const p_vaddr = Number(buffer.readBigUInt64LE(offset + 16));\n      const p_filesz = Number(buffer.readBigUInt64LE(offset + 32));\n      const p_memsz = Number(buffer.readBigUInt64LE(offset + 40));\n      \n      // Read 32-bit integers from file data mapped to memory\n      for (let j = 0; j < p_filesz; j += 4) {\n        if (j + 4 <= buffer.length - p_offset) {\n          const addr = p_vaddr + j;\n          const val = buffer.readInt32LE(p_offset + j);\n          result[addr.toString()] = val;\n        }\n      }\n    }\n  }\n  console.log(JSON.stringify(result));\n}\n\nextract(process.argv[2]);\nEOF\n"]
[75.330383, "o", "cat << 'EOF' > extract.js\r\n\u001b[?2004l\r"]
