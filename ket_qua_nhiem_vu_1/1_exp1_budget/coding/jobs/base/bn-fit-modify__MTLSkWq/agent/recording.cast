[675.834165, "o", "Fitted model nodes/edges: ['M', 'U', 'Y', 'D', 'R'] [('M', 'U'), ('M', 'R'), ('Y', 'U'), ('D', 'U'), ('D', 'Y'), ('R', 'U')]\r\nIntervened edges: [('M', 'U'), ('D', 'U'), ('D', 'Y'), ('R', 'U'), ('M', 'R')]\r\n"]
[675.835489, "o", "Saved /app/intervened_dag.csv\r\n"]
[675.844641, "o", "Traceback (most recent call last):\r\n  File \"/app/full_pipeline.py\", line 37, in <module>\r\n"]
