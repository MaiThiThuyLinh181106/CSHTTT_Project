[605.499061, "o", "Help on function fit in module pgmpy.models.LinearGaussianBayesianNetwork:\r\n\r\nf\bfi\bit\bt(self, data: 'pd.DataFrame', estimator=None) -> 'LinearGaussianBayesianNetwork'\r\n    Estimates (fits) the Linear Gaussian CPDs from data.\r\n\r\n    Parameters\r\n    ----------\r\n    data : pd.DataFrame\r\n"]
[605.499161, "o", "        Continuous-valued data containing all model variables.\r\n\r\n    estimator : LinearGaussianMLE, optional\r\n        An initialized Gaussian parameter estimator from\r\n        `pgmpy.parameter_estimator`. If not specified, defaults to\r\n        ``LinearGaussianMLE()``.\r\n\r\n    Returns\r\n"]
[605.499499, "o", "    -------\r\n    self: LinearGaussianBayesianNetwork\r\n        Returns the model with fitted CPDs added. CPDs can be accessed via\r\n        ``model.cpds``.\r\n\r\n    Examples\r\n    --------\r\n    >>> import numpy as np\r\n    >>> import pandas as pd\r\n    >>> from pgmpy.models import LinearGaussianBayesianNetwork\r\n    >>> from pgmpy.parameter_estimator import LinearGaussianMLE\r\n    >>> rng = np.random.default_rng(42)\r\n    >>> df = pd.DataFrame(\r\n"]
[605.500512, "o", "    ...     rng.normal(0, 1, (100, 3)), columns=[\"x1\", \"x2\", \"x3\"]\r\n    ... )\r\n    >>> model = LinearGaussianBayesianNetwork([(\"x1\", \"x2\"), (\"x2\", \"x3\")])\r\n    >>> model.fit(df) # doctest: +ELLIPSIS\r\n    <pgmpy.models.LinearGaussianBayesianNetwork.LinearGaussianBayesianNetwork object at 0x...>\r\n    >>> model.cpds # doctest: +ELLIPSIS +NORMALIZE_WHITESPACE\r\n    [<LinearGaussianCPD: P(x1) = N(-0.029; 0.902) at 0x...,\r\n    <LinearGaussianCPD: P(x2 | x1) = N(0.046*x1 + -0.012; 0.981) at 0x...,\r\n"]
[605.500728, "o", "    <LinearGaussianCPD: P(x3 | x2) = N(0.172*x2 + -0.078; 0.908) at 0x...]\r\n\r\n"]
[605.688551, "o", "\u001b[?2004hroot@2836b8945244:/app# "]
[609.054596, "i", "cat << 'EOF' > full_pipeline.py\nimport pandas as pd\nimport numpy as np\nfrom pgmpy.models import LinearGaussianBayesianNetwork\nfrom pgmpy.parameter_estimator import LinearGaussianMLE\nfrom pgmpy.sampling import BayesianModelSampling\nfrom pgmpy.factors.continuous import LinearGaussianCPD\n\ndf = pd.read_csv('/app/bn_sample_10k.csv')\n\ncorrected_edges = [\n    ('M', 'U'),\n    ('Y', 'U'),\n    ('D', 'U'),\n    ('D', 'Y'),\n    ('R', 'U'),\n    ('M', 'R')\n]\n\n# 2) Learn Bayesian Network\nmodel = LinearGaussianBayesianNetwork(corrected_edges)\nmodel.fit(df)\nprint(\"Fitted model nodes/edges:\", model.nodes(), model.edges())\n\n# 3) Perform causal intervention on Y, setting its value to 0.0 (variance 1e-9)\nintervened_edges = [e for e in corrected_edges if e[0] != 'Y']\nprint(\"Intervened edges:\", intervened_edges)\n\n# Save intervened_dag.csv\ndf_intervened = pd.DataFrame(intervened_edges, columns=['to', 'from'])\ndf_intervened.to_csv('/app/intervened_dag.csv', index=False)\nprint(\"Saved /app/intervened_dag.csv\")\n\n# Create intervened model\nintervened_model = LinearGaussianBayesianNetwork(intervened_edges)\n\n# Also fit other CPDs from data or use fitted ones (excluding Y which we just set)\nfor node in intervened_model.nodes():\n    if node == 'Y':\n        cpd = LinearGaussianCPD('Y', beta=[0.0], variance=1e-9)\n    else:\n        estimator = LinearGaussianMLE(intervened_model, df)\n        cpd = estimator.estimate_cpd(node)\n    intervened_model.add_cpds(cpd)\n\nprint(\"Intervened model check:\", intervened_model.check_model())\n\n# 5) Sample 10k points\nsampler = BayesianModelSampling(intervened_model)\nsamples = sampler.forward_sample(size=10000)\nsamples = samples[df.columns]\nsamples.to_csv('/app/final_bn_sample.csv', index=False)\nprint(\"Saved /app/final_bn_sample.csv with shape:\", samples.shape)\nprint(samples.head())\n\nEOF\n./venv/bin/python full_pipeline.py\n"]
