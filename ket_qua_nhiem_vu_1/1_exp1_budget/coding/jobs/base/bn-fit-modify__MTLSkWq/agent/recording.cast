[698.380398, "o", "# 3) Perform causal intervention on Y, setting its value to 0.0 (variance 10e-9)\r\n\u001b[?2004l\r\u001b[?2004h> intervened_edges = [e for e in corrected_edges if e[0] != 'Y']\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Intervened edges:\", intervened_edges)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save intervened_dag.csv\r\n\u001b[?2004l\r\u001b[?2004h> df_intervened = pd.DataFrame(intervened_edges, columns=['to', 'from'])\r\n\u001b[?2004l\r\u001b[?2004h> df_intervened.to_csv('/app/intervened_dag.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Saved /app/intervened_dag.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Create intervened model and fit\r\n\u001b[?2004l\r\u001b[?2004h> intervened_model = LinearGaussianBayesianNetwork(intervened_edges)\r\n\u001b[?2004l\r\u001b[?2004h> intervened_model.fit(df)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Override CPD of Y to be deterministic / zero variance around 0.0 (std = sqrt(10e-9))\r\n\u001b[?2004l\r\u001b[?2004h> cpd_y = LinearGaussianCPD('Y', beta=[0.0], std=np.sqrt(10e-9), evidence=[])\r\n\u001b[?2004l\r\u001b[?2004h> "]
