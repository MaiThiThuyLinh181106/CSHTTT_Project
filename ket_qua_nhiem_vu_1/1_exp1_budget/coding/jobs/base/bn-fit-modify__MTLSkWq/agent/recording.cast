[6.136118, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom pgmpy.estimators import HillClimbSearch, BIC\nfrom pgmpy.models import BayesianNetwork\nfrom pgmpy.sampling import BayesianModelSampling\n\n# Load data\ndf = pd.read_csv('/app/bn_sample_10k.csv')\nprint(df.head())\nprint(df.columns)\n\n# Structure learning\nhc = HillClimbSearch(df)\nbest_model = hc.estimate(scoring_method=BIC(df))\nedges = list(best_model.edges())\nprint(\"Learned edges:\", edges)\n\n# Let's inspect nodes and edges\nnodes = list(df.columns)\nprint(\"Nodes:\", nodes)\nEOF\npython3 solution.py\n"]
[6.139789, "o", "cat << 'EOF' > solution.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from pgmpy.estimators import HillClimbSearch, BIC\r\n\u001b[?2004l\r\u001b[?2004h> from pgmpy.models import BayesianNetwork\r\n\u001b[?2004l\r\u001b[?2004h> from pgmpy.sampling import BayesianModelSampling\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data\r\n\u001b[?2004l\r\u001b[?2004h> df = pd.read_csv('/app/bn_sample_10k.csv')\r\n\u001b[?2004l\r\u001b[?2004h> print(df.head())\r\n\u001b[?2004l\r\u001b[?2004h> print(df.columns)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Structure learning\r\n\u001b[?2004l\r\u001b[?2004h> hc = HillClimbSearch(df)\r\n\u001b[?2004l\r\u001b[?2004h> best_model = hc.estimate(scoring_method=BIC(df))\r\n\u001b[?2004l\r\u001b[?2004h> edges = list(best_model.edges())\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Learned edges:\", edges)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's inspect nodes and edges\r\n\u001b[?2004l\r\u001b[?2004h> nodes = list(df.columns)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Nodes:\", nodes)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
