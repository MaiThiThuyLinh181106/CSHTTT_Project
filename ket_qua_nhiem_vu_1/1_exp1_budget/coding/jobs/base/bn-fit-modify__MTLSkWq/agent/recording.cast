[895.293035, "o", " |  c\bcl\ble\bea\bar\br_\b_e\bed\bdg\bge\bes\bs(self)\r\n |      Remove all edges from the graph without altering nodes.\r\n |\r\n |      Examples\r\n |      --------\r\n |      >>> G = nx.path_graph(4)  # or DiGraph, MultiGraph, MultiDiGraph, etc\r\n |      >>> G.clear_edges()\r\n |      >>> list(G.nodes)\r\n |      [0, 1, 2, 3]\r\n |      >>> list(G.edges)\r\n |      []\r\n |\r\n"]
[895.293149, "o", " |  d\bde\beg\bgr\bre\bee\be = <functools.cached_property object>\r\n |      A DegreeView for the Graph as G.degree or G.degree().\r\n |\r\n |      The node degree is the number of edges adjacent to the node.\r\n |      The weighted node degree is the sum of the edge weights for\r\n |      edges incident to that node.\r\n\u001b[7m--More--\u001b[27m\r\u001b[K\u001b[7mNo previous regular expression\u001b[27m"]
[895.293328, "o", "\r\r\u001b[K\r\n...skipping 1 line\r\n\r |      This object provides an iterator for (node, degree) as well as\r\n |      lookup for the degree for a single node.\r\n |\r\n |      Parameters\r\n |      ----------\r\n |      nbunch : single node, container, or all nodes (default= all nodes)\r\n |          The view will only report edges incident to these nodes."]
[895.293431, "o", "\r\n |\r\n |      weight : string or None, optional (default=None)\r\n |         The name of an edge attribute that holds the numerical value used\r\n |         as a weight.  If None, then each edge has weight 1.\r\n"]
[895.29363, "o", " |         The degree is the sum of the edge weights adjacent to the node.\r\n |\r\n |      Returns\r\n |      -------\r\n |      DiDegreeView or int\r\n |          If multiple nodes are requested (the default), returns a `DiDegreeView`\r\n |          mapping nodes to their degree.\r\n |          If a single node is requested, returns the degree of the node as an integer.\r\n |\r\n"]
[895.29381, "o", " |      See Also\r\n |      --------\r\n |      in_degree, out_degree\r\n |\r\n |      Examples\r\n |      --------\r\n |      >>> G = nx.DiGraph()  # or MultiDiGraph\r\n |      >>> nx.add_path(G, [0, 1, 2, 3])\r\n"]
[895.293953, "o", " |      >>> G.degree(0)  # node 0 with degree 1\r\n |      1\r\n |      >>> dict(G.degree([0, 1, 2]))\r\n |      {0: 1, 1: 2, 2: 2}\r\n |\r\n |  e\bed\bdg\bge\bes\bs = <functools.cached_property object>\r\n |      An OutEdgeView of the DiGraph as G.edges or G.edges().\r\n |\r\n |      edges(self, nbunch=None, data=False, default=None)\r\n |\r\n |      The OutEdgeView provides set-like operations on the edge-tuples\r\n\r\r\n...skipping 1 line\r\n"]
[895.294134, "o", "\r |      an EdgeDataView object which allows control of access to edge\r\n"]
[895.294272, "o", " |      attributes (but does not provide set-like operations).\r\n |      Hence, `G.edges[u, v]['color']` provides the value of the color\r\n |      attribute for edge `(u, v)` while\r\n |      `for (u, v, c) in G.edges.data('color', default='red'):`\r\n |      iterates through all the edges yielding the color attribute\r\n |      with default `'red'` if no color attribute exists.\r\n |\r\n |      Parameters\r\n |      ----------\r\n"]
[895.29447, "o", " |      nbunch : single node, container, or all nodes (default= all nodes)\r\n |          The view will only report edges from these nodes.\r\n |      data : string or bool, optional (default=False)\r\n |          The edge attribute returned in 3-tuple (u, v, ddict[data]).\r\n"]
[895.294612, "o", " |          If True, return edge attribute dict in 3-tuple (u, v, ddict).\r\n |          If False, return 2-tuple (u, v).\r\n |      default : value, optional (default=None)\r\n |          Value used for edges that don't have the requested attribute.\r\n |          Only relevant if data is not True or False.\r\n |\r\n |      Returns\r\n |      -------\r\n |      edges : OutEdgeView\r\n"]
[895.294718, "o", " |          A view of edge attributes, usually it iterates over (u, v)\r\n |          or (u, v, d) tuples of edges, but can also be used for\r\n |          attribute lookup as `edges[u, v]['foo']`.\r\n |\r\n |      See Also"]
[895.294909, "o", "\r\n |      --------\r\n |      in_edges, out_edges\r\n |\r\n |      Notes\r\n |      -----\r\n"]
