[726.904731, "o", "\u001b[?2004hroot@2836b8945244:/app# "]
[766.227821, "i", "cat << 'EOF' > run_final.py\nimport pandas as pd\nimport numpy as np\nfrom pgmpy.models import LinearGaussianBayesianNetwork\nfrom pgmpy.sampling import BayesianModelSampling\nfrom pgmpy.factors.continuous import LinearGaussianCPD\n\ndf = pd.read_csv('/app/bn_sample_10k.csv')\n\n# Edges as (parent, child) for pgmpy\nedges_parent_child = [\n    ('U', 'M'),\n    ('U', 'Y'),\n    ('U', 'D'),\n    ('Y', 'D'),\n    ('U', 'R'),\n    ('R', 'M')\n]\n\n# 1) Save learned_dag.csv in format to,from (i.e. child, parent)\ndf_learned = pd.DataFrame([(child, parent) for parent, child in edges_parent_child], columns=['to', 'from'])\ndf_learned.to_csv('/app/learned_dag.csv', index=False)\nprint(\"Saved /app/learned_dag.csv\")\n\n# 2) Learn Bayesian Network\nmodel = LinearGaussianBayesianNetwork(edges_parent_child)\nmodel.fit(df)\nprint(\"Model check:\", model.check_model())\n\n# 3) Perform causal intervention on Y: remove edges into Y ('U', 'Y')\nintervened_edges_pc = [e for e in edges_parent_child if e[1] != 'Y']\nprint(\"Intervened parent->child edges:\", intervened_edges_pc)\n\n# 4) Save intervened_dag.csv in to,from format (child, parent)\ndf_intervened = pd.DataFrame([(child, parent) for parent, child in intervened_edges_pc], columns=['to', 'from'])\ndf_intervened.to_csv('/app/intervened_dag.csv', index=False)\nprint(\"Saved /app/intervened_dag.csv\")\n\n# Create intervened model and fit\nintervened_model = LinearGaussianBayesianNetwork(intervened_edges_pc)\nintervened_model.fit(df)\n\n# Override CPD of Y to be deterministic / zero variance around 0.0 (std = 1e-4, no parents)\ncpd_y = LinearGaussianCPD('Y', beta=[0.0], std=1e-4, evidence=[])\nintervened_model.add_cpds(cpd_y)\n\nprint(\"Intervened model check:\", intervened_model.check_model())\n\n# 5) Sample 10k points\nsampler = BayesianModelSampling(intervened_model)\nsamples = sampler.forward_sample(size=10000)\nsamples = samples[df.columns]\nsamples.to_csv('/app/final_bn_sample.csv', index=False)\nprint(\"Saved /app/final_bn_sample.csv with shape:\", samples.shape)\nprint(samples.head())\nEOF\n./venv/bin/python run_final.py\n"]
