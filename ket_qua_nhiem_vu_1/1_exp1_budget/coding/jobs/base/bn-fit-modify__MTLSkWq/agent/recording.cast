[837.128945, "o", " |      [('X_2', 'X_0'), ('X_3', 'X_0'), ('X_4', 'X_0'), ('X_4', 'X_1'), ('X_4', 'X_2')]\r\n |      >>> sorted(model.cpds, key=lambda cpd: cpd.variable) # doctest: +ELLIPSIS +NORMALIZE_WHITESPACE\r\n |      [<LinearGaussianCPD: P(X_0 | X_4, X_2, X_3) = N(...) at 0x...,\r\n"]
