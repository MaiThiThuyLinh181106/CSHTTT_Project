[236.36427, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[236.364997, "o", "  if (K > 1) {\r\n\u001b[?2004l\r 100) {\r\n    mea\u001b[?2004h>     for (i in 1:(K - 1)) {\r\n\u001b[?2004l\r\u001b[?2004h>       denom <- dh[i] - dh[i+1]\r\n\u001b[?2004l\r"]
