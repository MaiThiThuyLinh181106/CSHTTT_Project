[263.669078, "o", "\u001b[?2004h>   z[1] <- hull$domain[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.669455, "o", "  z[K + 1] <- hull$domain[2]\r\n\u001b[?2004l\r\u001b[?2004h>   if (K > 1) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.669974, "o", "    for (i in 1:(K - 1)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.670313, "o", "      denom <- dh[i] - dh[i+1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.670593, "o", "      if (abs(denom) < 1e-12) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.671417, "o", "        z[i+1] <- (x[i] + x[i+1]) / 2\r\n\u001b[?2004l\r\u001b[?2004h>       } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.672792, "o", "        z_val <- (h[i+1] - h[i] - x[i+1]*dh[i+1] + x[i]*dh[i]) / denom\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.673132, "o", "        if (z_val <= x[i] || z_val >= x[i+1]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.674342, "o", "          z_val <- (x[i] + x[i+1]) / 2\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\rs.\u001b[?2004h> "]
[263.674742, "o", "        z[i+1] <- z_val\r\n\u001b[?2004l\r"]
[263.674915, "o", "\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     for (i in 2:K) {\r\n\u001b[?2004l\r (Expected: 1)\\n\", \u001b[?2004h> "]
[263.675811, "o", "      if (z[i] <= z[i-1]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.676954, "o", "        z[i] <- (x[i-1] + x[i]) / 2\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r 0.2 && \u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[263.677662, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   z\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r1.0\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.677917, "o", "ars <- function(density_function, domain, n = 1000) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.678206, "o", "  if (!is.function(density_function)) stop(\"density_function must be a function.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.67846, "o", "> "]
[263.679621, "o", "  if (!is.numeric(domain) || length(domain) != 2 || domain[1] >= domain[2]) stop(\"Invalid domain.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.679848, "o", "> "]
[263.680246, "o", "  if (!is.numeric(n) || length(n) != 1 || n <= 0 || n != round(n)) stop(\"Invalid n.\")\r\n\u001b[?2004l\r"]
[263.680462, "o", "\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   hull <- ars_init(density_function, domain)\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.680578, "o", ">   samples <- numeric(n)\r\n\u001b[?2004l\r"]
[263.680659, "o", "\u001b[?2004h"]
[263.680702, "o", ">   accepted <- 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.681479, "o", "  max_iters <- n * 100\r\n\u001b[?2004l\r\u001b[?2004h>   iters <- 0\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.681931, "o", "  while (accepted < n && iters < max_iters) {\r\n\u001b[?2004l\r"]
[263.682122, "o", "\u001b[?2004h> "]
[263.682441, "o", "    iters <- iters + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.682626, "o", "    z <- get_upper_hull_z(hull)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.68278, "o", "    x <- hull$x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.683052, "o", "    h <- hull$h\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.683172, "o", ">     dh <- hull$dh\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.683447, "o", "    K <- length(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.68365, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     log_weights <- numeric(K)\r\n\u001b[?2004l\r"]
[263.683858, "o", "\u001b[?2004h> "]
[263.684056, "o", "    for (i in 1:K) {\r\n\u001b[?2004l\r"]
[263.684255, "o", "\u001b[?2004h>       zi <- z[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.684332, "o", "      zi1 <- z[i+1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.684615, "o", "      dhi <- dh[i]\r\n\u001b[?2004l\r\u001b[?2004h>       hi <- h[i]\r\n\u001b[?2004l\r\u001b[?2004h>       xi <- x[i]"]
[263.684748, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>       \r\n\u001b[?2004l\rean_va\u001b[?2004h> "]
[263.685118, "o", "      if (abs(dhi) < 1e-10) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.685987, "o", "        log_weights[i] <- hi - dhi*xi + log(max(1e-12, zi1 - zi))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.686101, "o", "      } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.686501, "o", "        a <- dhi * zi1\r\n\u001b[?2004l\r\u001b[?2004h>         b <- dhi * zi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.687081, "o", "        base_val <- hi - dhi * xi\r\n\u001b[?2004l\r"]
[263.687653, "o", "\u001b[?2004h>         if (dhi > 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.687896, "o", "          log_diff <- a + log1p(-exp(b - a))\r\n\u001b[?2004l\r\u001b[?2004h>         } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.688305, "o", "          log_diff <- b + log1p(-exp(a - b))\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\rNENTIAL_TEST: FAIL\\n\u001b[?2004h"]
[263.68847, "o", "> "]
[263.688734, "o", "        log_weights[i] <- base_val + log_diff - log(abs(dhi))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.688894, "o", "      }\r\n\u001b[?2004l\ret\u001b[?2004h> "]
[263.689086, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[263.689194, "o", "> "]
[263.689432, "o", "    max_lw <- max(log_weights)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.690049, "o", "    weights <- exp(log_weights - max_lw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.690225, "o", "> "]
[263.690692, "o", "    if (sum(weights) == 0 || any(is.na(weights))) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.690997, "o", "      weights <- rep(1/K, K)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.691208, "o", "    }\r\n\u001b[?2004l\r"]
[263.691412, "o", "\u001b[?2004h> "]
[263.691585, "o", "    probs <- weights / sum(weights)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.691728, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.692061, "o", "    interval_idx <- sample(K, 1, prob = probs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.692183, "o", "> "]
[263.692475, "o", "    zi <- z[interval_idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.692627, "o", "> "]
[263.692963, "o", "    zi1 <- z[interval_idx+1]\r\n\u001b[?2004l\rC\u001b[?2004h> "]
[263.693052, "o", "    dhi <- dh[interval_idx]\r\n\u001b[?2004l\r"]
[263.693496, "o", "\u001b[?2004h>     xi <- x[interval_idx]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r1\r\n  }"]
[263.693782, "o", "\u001b[?2004h>     u_rand <- runif(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.694181, "o", "    if (abs(dhi) < 1e-10) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.694469, "o", "> "]
[263.694829, "o", "      x_star <- zi + u_rand * (zi1 - zi)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.695003, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.6953, "o", "      term_low <- dhi * (zi - xi)\r\n\u001b[?2004l\rt\u001b[?2004h> "]
[263.695626, "o", "      term_high <- dhi * (zi1 - xi)\r\n\u001b[?2004l\r\u001b[?2004h>       if (dhi > 0) {\r\n\u001b[?2004l\r"]
[263.695892, "o", "\u001b[?2004h> "]
[263.696662, "o", "        arg <- exp(term_low) + u_rand * (exp(term_high) - exp(term_low))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.696906, "o", "        arg <- max(1e-300, arg)\r\n\u001b[?2004l\r\u001b[?2004h>         x_star <- xi + log(arg) / dhi\r\n\u001b[?2004l\r"]
[263.697084, "o", "\u001b[?2004h>       } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.697289, "o", "        term_low <- dhi * (zi - xi)\r\n\u001b[?2004l\r\u001b[?2004h>         term_high <- dhi * (zi1 - xi)\r\n\u001b[?2004l\r"]
[263.697492, "o", "\u001b[?2004h> "]
[263.697716, "o", "        arg <- exp(term_low) - u_rand * (exp(term_low) - exp(term_high))\r\n\u001b[?2004l\r\u001b[?2004h>         arg <- max(1e-300, arg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.697973, "o", "        x_star <- xi + log(arg) / dhi\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[263.698167, "o", "\u001b[?2004h> "]
[263.698285, "o", "    x_star <- max(zi, min(zi1, x_star))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.698554, "o", "    eval_star <- tryCatch(log_density_grad(density_function, x_star), error = function(e) NULL)\r\n\u001b[?2004l\r"]
[263.698745, "o", "\u001b[?2004h> "]
[263.698907, "o", "    if (is.null(eval_star)) next\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[263.699255, "o", "\u001b[?2004h>     h_star <- eval_star$h\r\n\u001b[?2004l\r"]
[263.699381, "o", "\u001b[?2004h>     dh_star <- eval_star$dh\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.699624, "o", "    u_star <- h[interval_idx] + dh[interval_idx] * (x_star - x[interval_idx])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.699735, "o", "    u_rand2 <- runif(1)\r\n\u001b[?2004l\r"]
[263.700133, "o", "\u001b[?2004h> "]
[263.700332, "o", "    if (log(u_rand2) <= h_star - u_star) {\r\n\u001b[?2004l\r\u001b[?2004h>       accepted <- accepted + 1\r\n\u001b[?2004l\r\u001b[?2004h>       samples[accepted] <- x_star\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.700713, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     new_x <- sort(c(x, x_star))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.700935, "o", "    new_evals <- lapply(new_x, function(xx) {\r\n\u001b[?2004l\r"]
[263.701172, "o", "\u001b[?2004h>       if (xx == x_star) list(h = h_star, dh = dh_star)"]
[263.70129, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>       else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.701353, "o", "        idx <- which(x == xx)\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.701676, "o", "> "]
[263.701853, "o", "        list(h = h[idx], dh = dh[idx])\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.702003, "o", "    new_dh <- sapply(new_evals, function(e) e$dh)\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.702211, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.702554, "o", "    log_concave_ok <- TRUE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.702822, "o", "    for (i in 1:(length(new_x) - 1)) {\r\n\u001b[?2004l\r\u001b[?2004h>       if (new_dh[i] < new_dh[i+1] - 0.2) {\r\n\u001b[?2004l\r\u001b[?2004h>         log_concave_ok <- FALSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.7029, "o", "        break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.703745, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.703868, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     if (!log_concave_ok) {\r\n\u001b[?2004l\r\u001b[?2004h>       stop(paste0(\"Non-log-concave density detected at x = \", x_star))\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[263.703971, "o", "\u001b[?2004h> "]
[263.704046, "o", "    hull$x <- new_x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.766035, "o", "    hull$h <- sapply(new_evals, function(e) e$h)\r\n\u001b[?2004l\r\u001b[?2004h>     hull$dh <- sapply(new_evals, function(e) e$dh)\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   if (accepted < n) {\r\n\u001b[?2004l\r\u001b[?2004h>     warning(\"Reached max iterations.\")\r\n\u001b[?2004l\r\u001b[?2004h>     samples <- samples[1:accepted]\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   samples\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test <- function() {\r\n\u001b[?2004l\r\u001b[?2004h>   cat(\"Running Adaptive Rejection Sampling (ARS) Formal Tests...\\n\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>   passed_tests <- 0\r\n\u001b[?2004l\r\u001b[?2004h>   total_tests <- 3\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   cat(\"Test 1: Standard Normal Distribution\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>   dnorm_unnorm <- function(x) exp(-0.5 * x^2)\r\n\u001b[?2004l\r\u001b[?2004h>   set.seed(42)\r\n\u001b[?2004l\r\u001b[?2004h>   samples_norm <- tryCatch(ars(dnorm_unnorm, c(-4, 4), n = 1000), error = function(e) {\r\n\u001b[?2004l\r\u001b[?2004h>     message(\"Error: \", e$message)\r\n\u001b[?2004l\r\u001b[?2004h>     NULL\r\n\u001b[?2004l\r\u001b[?2004h>   })\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   if (!is.null(samples_norm) && length(samples_norm) > 100) {\r\n\u001b[?2004l\r\u001b[?2004h>     mean_val <- mean(samples_norm)\r\n\u001b[?2004l\r"]
[263.766223, "o", "\u001b[?2004h>     sd_val <- sd(samples_norm)\r\n\u001b[?2004l\r\u001b[?2004h>     cat(sprintf(\"  Generated %d samples.\\n  Mean: %.4f (Expected: 0)\\n  SD: %.4f (Expected: 1)\\n\", length(samples_norm), mean_val, sd_val))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.766416, "o", "    if (abs(mean_val) < 0.2 && abs(sd_val - 1.0) < 0.2) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.766641, "o", "      cat(\"NORMAL_TEST: PASS\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>       passed_tests <- passed_tests + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.766817, "o", "      writeLines(as.character(samples_norm), \"/app/normal_samples.txt\")\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r"]
[263.767001, "o", "\u001b[?2004h> "]
[263.76721, "o", "      cat(\"NORMAL_TEST: FAIL\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   } else {\r\n\u001b[?2004l\r"]
[263.767315, "o", "\u001b[?2004h>     cat(\"NORMAL_TEST: FAIL\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.767547, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h>   cat(\"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r"]
[263.76766, "o", "\u001b[?2004h> "]
[263.767861, "o", "  cat(\"Test 2: Exponential Distribution\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.767983, "o", "  dexp_unnorm <- function(x) ifelse(x >= 0, exp(-x), 0)\r\n\u001b[?2004l\r\u001b[?2004h>   set.seed(42)\r\n\u001b[?2004l\r"]
[263.768204, "o", "\u001b[?2004h> "]
[263.768372, "o", "  samples_exp <- tryCatch(ars(dexp_unnorm, c(0.01, 10), n = 1000), error = function(e) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.768468, "o", "> "]
[263.768658, "o", "    message(\"Error: \", e$message)\r\n\u001b[?2004l\r\u001b[?2004h>     NULL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.768822, "o", "  })\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.769006, "o", "  if (!is.null(samples_exp) && length(samples_exp) > 100) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.769169, "o", "> "]
