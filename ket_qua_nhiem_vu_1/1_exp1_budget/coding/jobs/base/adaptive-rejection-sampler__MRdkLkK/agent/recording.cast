[236.38289, "o", "    max_lw <- max(log_weights)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.383168, "o", "    weights <- exp(log_weights - max_lw)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.383402, "o", "    probs <- weights / sum(weights)\r\n\u001b[?2004l\r\u001b[?2004h> "]
