[236.389051, "o", "        x_star <- xi + log(arg) / dhi\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     x_star <- max(zi, min(zi1, x_star))\r\n\u001b[?2004l\r"]
[236.389244, "o", "\u001b[?2004h> "]
