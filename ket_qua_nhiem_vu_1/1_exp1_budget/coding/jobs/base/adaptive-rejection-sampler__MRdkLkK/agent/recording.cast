[263.771815, "o", "  d_nonlogconcave <- function(x) exp(-x^2) + 2 * exp(-0.5*(x-4)^2)\r\n\u001b[?2004l\r\u001b[?2004h>   error_caught <- FALSE\r\n\u001b[?2004l\r"]
[263.771994, "o", "\u001b[?2004h> "]
[263.77221, "o", "  tryCatch(ars(d_nonlogconcave, c(-2, 6), n = 100), error = function(e) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
