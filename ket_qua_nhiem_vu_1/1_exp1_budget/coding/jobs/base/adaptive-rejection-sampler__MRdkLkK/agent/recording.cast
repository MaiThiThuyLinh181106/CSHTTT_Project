[236.377391, "o", "\u001b[?2004h> "]
[236.378051, "o", "    log_weights <- numeric(K)\r\n\u001b[?2004l\r"]
[236.378307, "o", "\u001b[?2004h> "]
[236.378593, "o", "    for (i in 1:K) {\r\n\u001b[?2004l\r\u001b[?2004h>       zi <- z[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.378847, "o", "      zi1 <- z[i+1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.379228, "o", ">       dhi <- dh[i]"]
[236.379529, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>       hi <- h[i]\r\n"]
[236.379689, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[236.380043, "o", "      xi <- x[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.380436, "o", "      if (abs(dhi) < 1e-10) {\r\n\u001b[?2004l\r\"\u001b[?2004h> "]
[236.380903, "o", "        log_weights[i] <- hi - dhi*xi + log(zi1 - zi)\r\n\u001b[?2004l\r\u001b[?2004h>       } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.381102, "o", "        term1 <- dhi * (zi1 - xi)\r\n\u001b[?2004l\r\u001b[?2004h>         term2 <- dhi * (zi - xi)\r\n\u001b[?2004l\r"]
[236.381303, "o", "\u001b[?2004h> "]
[236.381475, "o", "        if (dhi > 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.381861, "o", "          log_w <- hi - dhi*xi + term1 + log(1 - exp(term2 - term1))\r\n\u001b[?2004l\r\u001b[?2004h>         } else {\r\n"]
[236.3821, "o", "\u001b[?2004l\r"]
[236.382215, "o", "\u001b[?2004h>           log_w <- hi - dhi*xi + term2 + log(exp(term1 - term2) - 1)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.382402, "o", "        log_weights[i] <- log_w\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
