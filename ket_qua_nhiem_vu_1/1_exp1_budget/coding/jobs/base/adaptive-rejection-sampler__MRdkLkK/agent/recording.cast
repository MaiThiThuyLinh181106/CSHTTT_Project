[236.387009, "o", "      term_high <- dhi * (zi1 - xi)\r\n\u001b[?2004l\r\u001b[?2004h>       if (dhi > 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.387201, "o", "        arg <- exp(term_low) + u_rand * (exp(term_high) - exp(term_low))\r\n\u001b[?2004l\r\u001b[?2004h> "]
