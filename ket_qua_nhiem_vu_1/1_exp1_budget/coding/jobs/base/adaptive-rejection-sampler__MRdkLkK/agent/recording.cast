[236.36976, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.370085, "o", "ars <- function(density_function, domain, n = 1000) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.370833, "o", "  if (!is.function(density_function)) stop(\"density_function must be a function.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.371502, "o", "  if (!is.numeric(domain) || length(domain) != 2 || domain[1] >= domain[2]) stop(\"Invalid domain.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.371899, "o", "  if (!is.numeric(n) || length(n) != 1 || n <= 0 || n != round(n)) stop(\"Invalid n.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
