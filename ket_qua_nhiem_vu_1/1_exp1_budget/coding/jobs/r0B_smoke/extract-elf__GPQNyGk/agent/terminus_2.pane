[?2004hroot@5a0cf8745ee1:/app# cat extract.js
[?2004lconst fs = require('fs');

function extractMemory(filePath) {
    const buffer = fs.readFileSync(filePath);
    const result = {};

    // Parse ELF64 header
    // e_phoff is at offset 32 (8 bytes)
    // e_phentsize is at offset 54 (2 bytes)
    // e_phnum is at offset 56 (2 bytes)
    const e_phoff = Number(buffer.readBigUInt64LE(32));
    const e_phentsize = buffer.readUInt16LE(54);
    const e_phnum = buffer.readUInt16LE(56);

    const base = 0x400000;

    for (let i = 0; i < e_phnum; i++) {
        const ph_offset = e_phoff + i * e_phentsize;
        const p_type = buffer.readUInt32LE(ph_offset);
        if (p_type === 1) { // PT_LOAD
            const p_offset = Number(buffer.readBigUInt64LE(ph_offset + 8));
            const p_vaddr = Number(buffer.readBigUInt64LE(ph_offset + 16));
            const p_filesz = Number(buffer.readBigUInt64LE(ph_offset + 32));

            const startAddr = (p_vaddr < 0x400000) ? p_vaddr + base : p_vaddr;

            for (let off = 0; off < p_filesz; off += 4) {
                if (off + 4 <= p_filesz) {
                    const val = buffer.readUInt32LE(p_offset + off);
                    const addr = startAddr + off;
                    result[addr.toString()] = val;
                }
            }
        }
    }

    console.log(JSON.stringify(result));
}

extractMemory(process.argv[2]);
