[54.056143, "i", "cat << 'EOF' > test_ptload.py\nimport struct\n\nwith open('a.out', 'rb') as f:\n    data = f.read()\n\nvals = struct.unpack('<16sHHIQQQIHHHHHH', data[:64])\ne_phoff = vals[5]\ne_phentsize = vals[9]\ne_phnum = vals[10]\n\ntotal_words = 0\nfor i in range(e_phnum):\n    ph = struct.unpack_from('<IIQQQQQQ', data, e_phoff + i * e_phentsize)\n    p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align = ph\n    if p_type == 1: # PT_LOAD\n        print(f'PT_LOAD {i}: vaddr={hex(p_vaddr)}, filesz={hex(p_filesz)}, memsz={hex(p_memsz)}')\n        n_words = p_filesz // 4\n        total_words += n_words\nprint('Total words (filesz):', total_words)\nEOF\npython3 test_ptload.py\n"]
