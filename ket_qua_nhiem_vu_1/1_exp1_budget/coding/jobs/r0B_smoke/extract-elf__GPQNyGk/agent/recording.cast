[22.857586, "i", "cat << 'EOF' > inspect_elf.py\nimport struct\n\nwith open('a.out', 'rb') as f:\n    data = f.read()\n\n# ELF64 header:\n# unsigned char e_ident[EI_NIDENT]; (16 bytes)\n# Elf64_Half    e_type;\n# Elf64_Half    e_machine;\n# Elf64_Word    e_version;\n# Elf64_Addr    e_entry;\n# Elf64_Off     e_phoff;\n# Elf64_Off     e_shoff;\n# Elf64_Word    e_flags;\n# Elf64_Half    e_ehsize;\n# Elf64_Half    e_phentsize;\n# Elf64_Half    e_phnum;\n# Elf64_Half    e_shentsize;\n# Elf64_Half    e_shnum;\n# Elf64_Half    e_shstrndx;\n\n# Format: < 16x (skip ident) + HHIQQQIHHHHHH = 16 + 2+2+4+8+8+8+4+2+2+2+2+2+2 = 64 bytes\nfmt = '<16sHHIQQQIHHHHHH'\nvals = struct.unpack(fmt, data[:64])\nprint('e_type:', vals[1])\nprint('e_machine:', vals[2])\nprint('e_entry:', hex(vals[4]))\nprint('e_phoff:', vals[5])\nprint('e_shoff:', vals[6])\nprint('e_phentsize:', vals[9])\nprint('e_phnum:', vals[10])\nprint('e_shentsize:', vals[11])\nprint('e_shnum:', vals[12])\nprint('e_shstrndx:', vals[13])\n\ne_phoff = vals[5]\ne_phentsize = vals[9]\ne_phnum = vals[10]\n\nfor i in range(e_phnum):\n    ph_offset = e_phoff + i * e_phentsize\n    ph = struct.unpack_from('<IIQQQQQQ', data, ph_offset)\n    print(f'  PH {i}: type={ph[0]}, flags={ph[1]}, offset={ph[2]}, vaddr={hex(ph[3])}, filesz={ph[5]}, memsz={ph[6]}')\n\nEOF\npython3 inspect_elf.py\n"]
