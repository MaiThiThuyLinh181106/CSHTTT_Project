[72.886216, "o", "const fs = require('fs');\r\n\r\nfunction extractMemory(filePath) {\r\n    const buffer = fs.readFileSync(filePath);\r\n    const result = {};\r\n\r\n    // Parse ELF64 header\r\n    // e_phoff is at offset 32 (8 bytes)\r\n    // e_phentsize is at offset 54 (2 bytes)\r\n    // e_phnum is at offset 56 (2 bytes)\r\n    const e_phoff = Number(buffer.readBigUInt64LE(32));\r\n    const e_phentsize = buffer.readUInt16LE(54);\r\n    const e_phnum = buffer.readUInt16LE(56);\r\n\r\n    const base = 0x400000;\r\n\r\n    for (let i = 0; i < e_phnum; i++) {\r\n        const ph_offset = e_phoff + i * e_phentsize;\r\n        const p_type = buffer.readUInt32LE(ph_offset);\r\n        if (p_type === 1) { // PT_LOAD\r\n            const p_offset = Number(buffer.readBigUInt64LE(ph_offset + 8));\r\n            const p_vaddr = Number(buffer.readBigUInt64LE(ph_offset + 16));\r\n            const p_filesz = Number(buffer.readBigUInt64LE(ph_offset + 32));\r\n\r\n            const startAddr = (p_vaddr < 0x400000) ? p_vaddr + base : p_vaddr;\r\n\r\n            for (let off = 0; off < p_filesz; off += 4) {\r\n                if (off + 4 <= p_filesz) {\r\n                    const val = buffer.readUInt32LE(p_offset + off);\r\n                    const addr = startAddr + off;\r\n                    result[addr.toString()] = val;\r\n                }\r\n            }\r\n        }\r\n    }\r\n\r\n    console.log(JSON.stringify(result));\r\n}\r\n\r\nextractMemory(process.argv[2]);\r\n"]
[72.886853, "o", "\u001b[?2004hroot@5a0cf8745ee1:/app# "]
