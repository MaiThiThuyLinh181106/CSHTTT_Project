[17.381249, "i", "cat << 'EOF' > inspect_elf.py\nimport struct\n\nwith open('a.out', 'rb') as f:\n    data = f.read()\n\nprint('File size:', len(data))\n# ELF header\nident = data[:16]\nprint('Magic:', ident[:4])\nprint('Class (32/64):', data[4])\nprint('Endianness:', data[5])\n\n# Let's use struct to parse ELF64 header\nif data[4] == 2: # 64-bit\n    fmt = '<HHIQQQIHHHHHH'\n    # e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags, e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx\n    header_vals = struct.unpack_from('<HHIQQQIHHHHHH', data, 16)\n    print('ELF64 Header:', header_vals)\n    e_phoff = header_vals[3]\n    e_phentsize = header_vals[8]\n    e_phnum = header_vals[9]\n    \n    print(f'Program headers at {e_phoff}, size {e_phentsize}, count {e_phnum}')\n    for i in range(e_phnum):\n        ph_offset = e_phoff + i * e_phentsize\n        # p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align\n        ph = struct.unpack_from('<IIQQQQQQ', data, ph_offset)\n        print(f'  PH {i}: type={ph[0]}, flags={ph[1]}, offset={ph[2]}, vaddr={hex(ph[3])}, filesz={ph[5]}, memsz={ph[6]}')\nEOF\npython3 inspect_elf.py\n"]
