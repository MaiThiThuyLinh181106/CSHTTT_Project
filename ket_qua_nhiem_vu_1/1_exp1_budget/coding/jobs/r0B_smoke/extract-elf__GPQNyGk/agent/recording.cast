[44.618986, "i", "cat << 'EOF' > test_extract.py\nimport struct\n\nwith open('a.out', 'rb') as f:\n    data = f.read()\n\n# Let's parse program headers and sections\nfmt = '<16sHHIQQQIHHHHHH'\nvals = struct.unpack(fmt, data[:64])\ne_phoff = vals[5]\ne_phentsize = vals[9]\ne_phnum = vals[10]\n\nfor i in range(e_phnum):\n    ph = struct.unpack_from('<IIQQQQQQ', data, e_phoff + i * e_phentsize)\n    p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align = ph\n    if p_type == 1: # PT_LOAD\n        print(f'PT_LOAD vaddr={hex(p_vaddr)}, offset={hex(p_offset)}, filesz={hex(p_filesz)}, memsz={hex(p_memsz)}')\n        # Let's check data at p_offset of size p_filesz\n        segment_data = data[p_offset:p_offset+p_filesz]\n        # Print first few integers at vaddr + 0x400000\n        base = 0x400000\n        for off in range(0, min(32, len(segment_data)), 4):\n            val = struct.unpack_from('<I', segment_data, off)[0]\n            print(f'  addr {hex(base + p_vaddr + off)} ({base + p_vaddr + off}): {val}')\nEOF\npython3 test_extract.py\n"]
