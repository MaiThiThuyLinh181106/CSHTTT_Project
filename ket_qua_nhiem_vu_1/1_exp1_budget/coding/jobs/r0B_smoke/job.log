Sending keys: ['cat << \'EOF\' > extract.js\nconst fs = require(\'fs\');\n\nfunction extractMemory(filePath) {\n    const buffer = fs.readFileSync(filePath);\n    const result = {};\n\n    // Parse ELF64 header\n    // e_phoff is at offset 32 (8 bytes)\n    // e_phentsize is at offset 54 (2 bytes)\n    // e_phnum is at offset 56 (2 bytes)\n    const e_phoff = Number(buffer.readBigUInt64LE(32));\n    const e_phentsize = buffer.readUInt16LE(54);\n    const e_phnum = buffer.readUInt16LE(56);\n\n    const base = 0x400000;\n\n    for (let i = 0; i < e_phnum; i++) {\n        const ph_offset = e_phoff + i * e_phentsize;\n        const p_type = buffer.readUInt32LE(ph_offset);\n        if (p_type === 1) { // PT_LOAD\n            const p_offset = Number(buffer.readBigUInt64LE(ph_offset + 8));\n            const p_vaddr = Number(buffer.readBigUInt64LE(ph_offset + 16));\n            const p_filesz = Number(buffer.readBigUInt64LE(ph_offset + 32));\n\n            const startAddr = (p_vaddr < 0x400000) ? p_vaddr + base : p_vaddr;\n\n            for (let off = 0; off < p_filesz; off += 4) {\n                if (off + 4 <= p_filesz) {\n                    const val = buffer.readUInt32LE(p_offset + off);\n                    const addr = startAddr + off;\n                    result[addr.toString()] = val;\n                }\n            }\n        }\n    }\n\n    console.log(JSON.stringify(result));\n}\n\nextractMemory(process.argv[2]);\nEOF\nnode extract.js /app/a.out > out.json\nhead -c 200 out.json\necho ""\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
