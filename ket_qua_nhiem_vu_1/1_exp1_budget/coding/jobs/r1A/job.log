Sending keys: ["cat << 'EOF' > test_extract.js\nconst fs = require('fs');\nconst buf = fs.readFileSync(process.argv[2] || '/app/a.out');\nconst e_phoff = Number(buf.readBigUInt64LE(0x20));\nconst e_phentsize = buf.readUInt16LE(0x36);\nconst e_phnum = buf.readUInt16LE(0x38);\n\nconst result = {};\nfor (let i = 0; i < e_phnum; i++) {\n  const ph_offset = e_phoff + i * e_phentsize;\n  const p_type = buf.readUInt32LE(ph_offset);\n  if (p_type === 1) { // PT_LOAD\n    const p_offset = Number(buf.readBigUInt64LE(ph_offset + 8));\n    const p_vaddr = Number(buf.readBigUInt64LE(ph_offset + 16));\n    const p_filesz = Number(buf.readBigUInt64LE(ph_offset + 32));\n    const p_memsz = Number(buf.readBigUInt64LE(ph_offset + 40));\n    \n    // read file bytes and zero-pad up to memsz if filesz < memsz\n    for (let addr = p_vaddr; addr < p_vaddr + p_memsz; addr += 4) {\n      const file_pos = p_offset + (addr - p_vaddr);\n      let val = 0;\n      if (file_pos + 4 <= p_offset + p_filesz) {\n        val = buf.readInt32LE(file_pos);\n      } else if (file_pos < p_offset + p_filesz) {\n        // partial\n        let b = Buffer.alloc(4);\n        const available = (p_offset + p_filesz) - file_pos;\n        buf.copy(b, 0, file_pos, file_pos + available);\n        val = b.readInt32LE(0);\n      } else {\n        val = 0;\n      }\n      result[addr.toString()] = val;\n    }\n  }\n}\nconsole.log(JSON.stringify(result, null, 2).slice(0, 500));\nconsole.log('Total keys:', Object.keys(result).length);\nEOF\nnode test_extract.js /app/a.out\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
