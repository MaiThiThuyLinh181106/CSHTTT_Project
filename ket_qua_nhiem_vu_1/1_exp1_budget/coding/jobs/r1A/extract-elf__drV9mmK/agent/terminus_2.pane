[35m[K/usr/share/nodejs/@types/node/ts4.8/v8.d.ts[m[K[36m[K:[m[K[32m[K74[m[K[36m[K:[m[K     *   total_heap_size_executable: [01;31m[K4194304[m[K,
[35m[K/usr/share/nodejs/@types/node/v8.d.ts[m[K[36m[K:[m[K[32m[K74[m[K[36m[K:[m[K     *   total_heap_size_executable: [01;31m[K4194304[m[K,
cat << 'EOF' > test_extract.js
const fs = require('fs');
const buf = fs.readFileSync(process.argv[2] || '/app/a.out');
const e_phoff = Number(buf.readBigUInt64LE(0x20));
const e_phentsize = buf.readUInt16LE(0x36);
const e_phnum = buf.readUInt16LE(0x38);

const result = {};
for (let i = 0; i < e_phnum; i++) {
  const ph_offset = e_phoff + i * e_phentsize;
  const p_type = buf.readUInt32LE(ph_offset);
  if (p_type === 1) { // PT_LOAD
    const p_offset = Number(buf.readBigUInt64LE(ph_offset + 8));
    const p_vaddr = Number(buf.readBigUInt64LE(ph_offset + 16));
    const p_filesz = Number(buf.readBigUInt64LE(ph_offset + 32));
    const p_memsz = Number(buf.readBigUInt64LE(ph_offset + 40));
    
    // read file bytes and zero-pad up to memsz if filesz < memsz
    for (let addr = p_vaddr; addr < p_vaddr + p_memsz; addr += 4) {
      const file_pos = p_offset + (addr - p_vaddr);
      let val = 0;
      if (file_pos + 4 <= p_offset + p_filesz) {
        val = buf.readInt32LE(file_pos);
      } else if (file_pos < p_offset + p_filesz) {
        // partial
        let b = Buffer.alloc(4);
        const available = (p_offset + p_filesz) - file_pos;
        buf.copy(b, 0, file_pos, file_pos + available);
        val = b.readInt32LE(0);
      } else {
        val = 0;
      }
      result[addr.toString()] = val;
    }
  }
}
console.log(JSON.stringify(result, null, 2).slice(0, 500));
console.log('Total keys:', Object.keys(result).length);
