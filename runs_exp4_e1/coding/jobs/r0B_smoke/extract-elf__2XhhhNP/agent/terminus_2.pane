[?2004l[?2004h>   const is64 = buf.readUInt8(4) === 2;
[?2004l[?2004h>   const le = buf.readUInt8(5) === 1;
[?2004l[?2004h> 
[?2004l[?2004h>   // Parse ELF header
[?2004l[?2004h>   const phoff = is64 ? Number(buf.readBigUInt64LE(32)) : buf.readUInt32LE(28);
[?2004l[?2004h>   const phentsize = is64 ? buf.readUInt16LE(54) : buf.readUInt16LE(42);
[?2004l[?2004h>   const phnum = is64 ? buf.readUInt16LE(56) : buf.readUInt16LE(44);
[?2004l[?2004h> 
[?2004l[?2004h>   const result = {};
[?2004l[?2004h>   const baseAddr = 0x400000; // standard base address for executables
[?2004l[?2004h> 
[?2004l[?2004h>   for (let i = 0; i < phnum; i++) {
[?2004l[?2004h>     const phoff_i = phoff + i * phentsize;
[?2004l[?2004h>     const type = buf.readUInt32LE(phoff_i);
[?2004l[?2004h>     if (type === 1) { // PT_LOAD
[?2004l[?2004h>       const offset = is64 ? Number(buf.readBigUInt64LE(phoff_i + 8)) : buf.readUInt32LE(phoff_i + 4);
[?2004l[?2004h>       const vaddr = is64 ? Number(buf.readBigUInt64LE(phoff_i + 16)) : buf.readUInt32LE(phoff_i + 8);
[?2004l[?2004h>       const filesz = is64 ? Number(buf.readBigUInt64LE(phoff_i + 32)) : buf.readUInt32LE(phoff_i + 16);
[?2004l[?2004h>       const memsz = is64 ? Number(buf.readBigUInt64LE(phoff_i + 40)) : buf.readUInt32LE(phoff_i + 20);
[?2004l[?2004h> 
[?2004l[?2004h>       const startAddr = vaddr + baseAddr;
[?2004l[?2004h>       for (let off = 0; off < filesz; off += 4) {
[?2004l[?2004h>         if (offset + off + 4 <= buf.length) {
[?2004l[?2004h>           const val = buf.readUInt32LE(offset + off);
[?2004l[?2004h>           result[String(startAddr + off)] = val;
[?2004l[?2004h>         }
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h>   console.log(JSON.stringify(result, null, 2));
[?2004l[?2004h> }
[?2004l[?2004h> 
