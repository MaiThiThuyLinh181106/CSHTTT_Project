[117.360522, "o", "\r\u001b[K\u001b[7mFinishing logfile... (interrupt to abort)\u001b[27m\r\u001b[K...skipping...\r\n* \u001b[33md7d3e4b\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD -> \u001b[m\u001b[1;32mmaster\u001b[m\u001b[33m)\u001b[m off the job market woo\u001b[m\r\n* \u001b[33mc4e38a1\u001b[m Add code link for BLADE\u001b[m\r\n* \u001b[33m6f46fa0\u001b[m CV Update\u001b[m\r\n* \u001b[33mdd7e395\u001b[m Adds BLADE to bib\u001b[m\r\n* \u001b[33m2cd355a\u001b[m n+1 (for the last time???)\u001b[m\r\n* \u001b[33m8eaf505\u001b[m Add BLADE\u001b[m\r\n* \u001b[33mcc2ec78\u001b[m Underline\u001b[m\r\n* \u001b[33md71094e\u001b[m Underline Conferences\u001b[m\r\n* \u001b[33m232b279\u001b[m Remove posters\u001b[m\r\n* \u001b[33m3fdf5f5\u001b[m Add NeurIPS\u001b[m\r\n* \u001b[33m8c4731d\u001b[m Add EMNLP acceptance\u001b[m\r\n* \u001b[33mf54f66b\u001b[m Add GR link\u001b[m\r\n* \u001b[33m18d2430\u001b[m Add other links\u001b[m\r\n* \u001b[33m1dd055e\u001b[m Ignore Gemfile, etc\u001b[m\r\n* \u001b[33m5c77a6d\u001b[m Dont overwrite\u001b[m\r\n* \u001b[33mc7d2f95\u001b[m Delete unsused files\u001b[m\r\n* \u001b[33m20b05d9\u001b[m Remove more unused files\u001b[m\r\n* \u001b[33m2d144f7\u001b[m Add yamls for new papers\u001b[m\r\n* \u001b[33m7882f2d\u001b[m Don't track _site\u001b[m\r\n* \u001b[33mcd2b8de\u001b[m Add new papers\u001b[m\r\n* \u001b[33m26dc65c\u001b[m Fix author\u001b[m\r\n* \u001b[33mbc1962c\u001b[m Interests update\u001b[m\r\n* \u001b[33m257eba8\u001b[m More spa"]
[117.36062, "o", "ce for interests\u001b[m\r\n* \u001b[33mff6a94a\u001b[m Bib update\u001b[m\r\n* \u001b[33m97c4a55\u001b[m Underline bold\u001b[m\r\n* \u001b[33ma320806\u001b[m Other fixes, new paper\u001b[m\r\n* \u001b[33m2cb7243\u001b[m New PDFs\u001b[m\r\n* \u001b[33m7321328\u001b[m PDF update\u001b[m\r\n* \u001b[33mf1e3860\u001b[m Deletions\u001b[m\r\n* \u001b[33m7b4d171\u001b[m Update Bio\u001b[m\r\n* \u001b[33m073117a\u001b[m Another update\u001b[m\r\n* \u001b[33mcb63517\u001b[m Another CV Updatee\u001b[m\r\n* \u001b[33m192ae7b\u001b[m update headshot\u001b[m\r\n* \u001b[33m7fb9365\u001b[m Update about and contact\u001b[m\r\n* \u001b[33m54ef19d\u001b[m CV Update\u001b[m\r\n* \u001b[33mb0fb76a\u001b[m Add GR\u001b[m\r\n* \u001b[33m6adfab9\u001b[m n plus one\u001b[m\r\n* \u001b[33m8a5509d\u001b[m Needs to be a string\u001b[m\r\n* \u001b[33me2f686e\u001b[m Add Gemfile\u001b[m\r\n:\u001b[K\r\u001b[K* \u001b[33mfa098ef\u001b[m properly handle class\u001b[m\r\n:\u001b[K"]
