[227.716963, "i", "cat << 'EOF' > test_load.js\nconst fs = require(\"fs\");\nconst buf = fs.readFileSync(\"/app/a.out\");\nconst e_phoff = Number(buf.readBigUInt64LE(32));\nconst e_phentsize = buf.readUInt16LE(54);\nconst e_phnum = buf.readUInt16LE(56);\n\nconst result = {};\nfor (let i = 0; i < e_phnum; i++) {\n  const offset = e_phoff + i * e_phentsize;\n  const p_type = buf.readUInt32LE(offset);\n  if (p_type === 1) {\n    const p_offset = Number(buf.readBigUInt64LE(offset + 8));\n    const p_vaddr = Number(buf.readBigUInt64LE(offset + 16));\n    const p_filesz = Number(buf.readBigUInt64LE(offset + 32));\n    const p_memsz = Number(buf.readBigUInt64LE(offset + 40));\n    \n    const baseAddr = 0x400000 + p_vaddr;\n    for (let off = 0; off < p_memsz; off += 4) {\n      const addr = baseAddr + off;\n      let val = 0;\n      if (off < p_filesz && p_offset + off + 4 <= buf.length) {\n        val = buf.readUInt32LE(p_offset + off);\n      }\n      result[addr] = val;\n    }\n  }\n}\nconsole.log(Object.keys(result).length);\nEOF\nnode test_load.js\n"]
