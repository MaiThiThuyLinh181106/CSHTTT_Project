[166.247141, "i", "cat << 'EOF' > inspect.js\nconst fs = require(\"fs\");\nconst buf = fs.readFileSync(\"/app/a.out\");\nconst e_phoff = buf.readBigUInt64LE(32);\nconst e_phentsize = buf.readUInt16LE(54);\nconst e_phnum = buf.readUInt16LE(56);\nconsole.log({e_phoff: Number(e_phoff), e_phentsize, e_phnum});\nfor (let i = 0; i < e_phnum; i++) {\n  const offset = Number(e_phoff) + i * e_phentsize;\n  const p_type = buf.readUInt32LE(offset);\n  const p_flags = buf.readUInt32LE(offset + 4);\n  const p_offset = buf.readBigUInt64LE(offset + 8);\n  const p_vaddr = buf.readBigUInt64LE(offset + 16);\n  const p_filesz = buf.readBigUInt64LE(offset + 32);\n  const p_memsz = buf.readBigUInt64LE(offset + 40);\n  console.log(i, {p_type, p_offset: Number(p_offset), p_vaddr: \"0x\" + Number(p_vaddr).toString(16), p_filesz: Number(p_filesz), p_memsz: Number(p_memsz)});\n}\nEOF\nnode inspect.js\n"]
