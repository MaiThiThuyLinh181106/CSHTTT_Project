[85.238306, "i", "python3 -c 'import struct\nwith open(\"a.out\", \"rb\") as f:\n    data = f.read()\nphoff = struct.unpack(\"<Q\", data[32:40])[0]\nphentsize = struct.unpack(\"<H\", data[54:56])[0]\nphnum = struct.unpack(\"<H\", data[56:58])[0]\nfor i in range(phnum):\n    ph = data[phoff + i*phentsize : phoff + (i+1)*phentsize]\n    p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align = struct.unpack(\"<IIQQQQQQ\", ph)\n    if p_type == 1:\n        print(f\"LOAD vaddr {p_vaddr:#x} filesz {p_filesz:#x} memsz {p_memsz:#x}\")\n'\n"]
