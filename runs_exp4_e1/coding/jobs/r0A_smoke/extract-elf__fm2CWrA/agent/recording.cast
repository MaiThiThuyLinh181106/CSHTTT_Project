[193.335118, "i", "cat << 'EOF' > extract.js\nconst fs = require('fs');\n\nfunction extractMemory(filePath) {\n    const buffer = fs.readFileSync(filePath);\n    const magic = buffer.readUInt32LE(0);\n    if (magic !== 0x464c457f) {\n        throw new Error('Not a valid ELF file');\n    }\n    const e_type = buffer.readUInt16LE(16);\n    const e_phoff = Number(buffer.readBigUInt64LE(32));\n    const e_phentsize = buffer.readUInt16LE(54);\n    const e_phnum = buffer.readUInt16LE(56);\n    const memory = {};\n    const baseAddress = (e_type === 3) ? 0x400000 : 0;\n    for (let i = 0; i < e_phnum; i++) {\n        const phoff = e_phoff + i * e_phentsize;\n        const p_type = buffer.readUInt32LE(phoff);\n        if (p_type === 1) {\n            const p_offset = Number(buffer.readBigUInt64LE(phoff + 8));\n            const p_vaddr = Number(buffer.readBigUInt64LE(phoff + 16));\n            const p_filesz = Number(buffer.readBigUInt64LE(phoff + 32));\n            const p_memsz = Number(buffer.readBigUInt64LE(phoff + 40));\n            const startVaddr = p_vaddr + baseAddress;\n            for (let offset = 0; offset < p_memsz; offset += 4) {\n                const currentVaddr = startVaddr + offset;\n                let val = 0;\n                if (offset < p_filesz) {\n                    const filePos = p_offset + offset;\n                    if (filePos + 4 <= buffer.length) {\n                        val = buffer.readUInt32LE(filePos);\n                    } else if (filePos < buffer.length) {\n                        const partial = Buffer.alloc(4, 0);\n                        buffer.copy(partial, 0, filePos, buffer.length);\n                        val = partial.readUInt32LE(0);\n                    }\n                } else {\n                    val = 0;\n                }\n                memory[currentVaddr.toString()] = val;\n            }\n        }\n    }\n    console.log(JSON.stringify(memory));\n}\nif (process.argv.length < 3) {\n    process.exit(1);\n}\nextractMemory(process.argv[2]);\nEOF\n"]
